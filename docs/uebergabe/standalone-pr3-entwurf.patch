+using Microsoft.Extensions.FileProviders;
+
+namespace AispaStudio.Api.System;
+
+/// <summary>
+/// Liefert die gebaute Web-Oberfläche aus der API aus, wenn <c>Hosting:WebRoot</c> gesetzt ist (ADR 0041). Im Einzelplatz-Betrieb
+/// startet die Windows-App die API mit diesem Ordner, damit die Team-Oberfläche ohne nginx im Browser unter derselben Adresse läuft.
+/// Im Server-Betrieb macht das weiter nginx oder ein anderer Webserver davor.
+/// </summary>
+internal static class TeamWebRoot
+{
+    // Teil-Oberflächen mit eigener index.html, wie in docker/nginx.conf.
+    private static readonly string[] Apps = ["buchen", "mein-tag", "betreiber"];
+
+    public static WebApplication UseTeamWebRoot(this WebApplication app)
+    {
+        var root = app.Configuration["Hosting:WebRoot"];
+        if (string.IsNullOrWhiteSpace(root))
+        {
+            return app;
+        }
+
+        var path = Path.GetFullPath(root);
+        if (!File.Exists(Path.Combine(path, "index.html")))
+        {
+            app.Logger.LogWarning("Hosting:WebRoot {Path} enthält keine index.html; die Web-Oberfläche wird nicht ausgeliefert.", path);
+            return app;
+        }
+
+        var files = new PhysicalFileProvider(path);
+        app.UseDefaultFiles(new DefaultFilesOptions { FileProvider = files });
+        app.UseStaticFiles(new StaticFileOptions { FileProvider = files });
+        app.MapFallback(async context =>
+        {
+            var request = context.Request.Path;
+            if (request.StartsWithSegments("/api") || request.StartsWithSegments("/hubs") || Path.HasExtension(request.Value))
+            {
+                context.Response.StatusCode = StatusCodes.Status404NotFound;
+                return;
+            }
+
+            var sub = Apps.FirstOrDefault(a => request.StartsWithSegments($"/{a}"));
+            var index = files.GetFileInfo(sub is null ? "index.html" : $"{sub}/index.html");
+            if (!index.Exists)
+            {
+                context.Response.StatusCode = StatusCodes.Status404NotFound;
+                return;
+            }
+
+            context.Response.ContentType = "text/html; charset=utf-8";
+            context.Response.Headers.CacheControl = "no-cache";
+            await context.Response.SendFileAsync(index);
+        });
+        return app;
+    }
+}
