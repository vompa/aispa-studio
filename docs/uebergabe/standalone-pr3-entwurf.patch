@@ -0,0 +1,61 @@
+using System.Net;
+using System.Net.Http.Json;
+using AispaStudio.Contracts;
+using AispaStudio.Desktop.Services;
+
+namespace AispaStudio.Desktop.Tests;
+
+/// <summary>
+/// Einzelplatz mit dem echten Windows-Paket (PostgreSQL, API, Web-Oberfläche): läuft in der CI nach dem Veröffentlichen,
+/// wenn <c>AISPA_LOCAL_PACKAGE</c> auf den Paketordner zeigt; sonst übersprungen.
+/// </summary>
+public sealed class LocalServerPackageTests
+{
+    private static CancellationToken Ct => TestContext.Current.CancellationToken;
+
+    [Fact]
+    public async Task Paket_startet_Datenbank_und_API_richtet_ein_und_startet_erneut()
+    {
+        var package = Environment.GetEnvironmentVariable("AISPA_LOCAL_PACKAGE");
+        if (string.IsNullOrWhiteSpace(package))
+        {
+            Assert.Skip("AISPA_LOCAL_PACKAGE ist nicht gesetzt.");
+        }
+
+        var data = Directory.CreateTempSubdirectory("aispa-einzelplatz-");
+        var paths = new LocalServerPaths(package, data.FullName);
+        var server = new LocalServer(paths, new SystemProcessRunner(), new PlainProtector());
+        try
+        {
+            await server.StartAsync(ct: Ct);
+            using var http = new HttpClient { BaseAddress = server.ApiAddress };
+
+            var modules = await http.GetFromJsonAsync<SystemModules>("api/system/modules", ApiClient.Json, Ct);
+            Assert.True(modules!.Standalone);
+            Assert.Contains("<html", await http.GetStringAsync("", Ct), StringComparison.OrdinalIgnoreCase);
+            var setup = await http.PostAsJsonAsync("api/auth/standalone/setup",
+                new StandaloneSetup("Spa am See", "AT", "Gmunden", "Eva Huber", "eva", "seeblick-2026"), ApiClient.Json, Ct);
+            Assert.Equal(HttpStatusCode.OK, setup.StatusCode);
+
+            // Neustart wie am nächsten Morgen: dieselbe Datenbank, das Konto ist noch da.
+            await server.StopAsync();
+            var again = new LocalServer(paths, new SystemProcessRunner(), new PlainProtector());
+            await again.StartAsync(ct: Ct);
+            server = again;
+            var login = await http.PostAsJsonAsync("api/auth/standalone/login", new PasswordLogin("eva", "seeblick-2026"), ApiClient.Json, Ct);
+            Assert.Equal(HttpStatusCode.OK, login.StatusCode);
+        }
+        finally
+        {
+            await server.StopAsync();
+            try
+            {
+                data.Delete(recursive: true);
+            }
+            catch (IOException)
+            {
+                // Protokolldateien können unter Windows kurz gesperrt bleiben.
+            }
+        }
+    }
+}
diff --git a/tests/AispaStudio.Desktop.Tests/LocalServerTests.cs b/tests/AispaStudio.Desktop.Tests/LocalServerTests.cs
new file mode 100644
index 0000000..7e3735a
--- /dev/null
+++ b/tests/AispaStudio.Desktop.Tests/LocalServerTests.cs
@@ -0,0 +1,222 @@
+using System.Text;
+using AispaStudio.Desktop.Services;
+
+namespace AispaStudio.Desktop.Tests;
+
+/// <summary>Einzelplatz-Betrieb (ADR 0041): Die App legt Datenbank und API auf diesem PC an und startet sie.</summary>
+public sealed class LocalServerTests : IDisposable
+{
+    private readonly DirectoryInfo _root = Directory.CreateTempSubdirectory("aispa-local-");
+
+    private static CancellationToken Ct => TestContext.Current.CancellationToken;
+
+    private LocalServerPaths Paths => new(Path.Combine(_root.FullName, "app"), Path.Combine(_root.FullName, "daten"));
+
+    public void Dispose() => _root.Delete(recursive: true);
+
+    private void InstallPackage()
+    {
+        foreach (var file in new[] { Paths.Tool("pg_ctl"), Paths.Tool("initdb"), Paths.Tool("psql"), Paths.Tool("createdb"), Paths.Api })
+        {
+            Directory.CreateDirectory(Path.GetDirectoryName(file)!);
+            File.WriteAllText(file, "");
+        }
+    }
+
+    [Fact]
+    public async Task Erster_Start_legt_Datenbank_an_startet_sie_und_dann_die_API()
+    {
+        InstallPackage();
+        var runner = new FakeRunner(Paths);
+        var ready = 0;
+        var server = new LocalServer(Paths, runner, new PlainProtector(), (_, _) => Task.FromResult(runner.ApiStarted && ++ready > 1));
+        var steps = new List<string>();
+
+        await server.StartAsync(new SyncProgress(steps), Ct);
+
+        Assert.Equal(["initdb", "pg_ctl status", "pg_ctl start", "psql", "createdb", "api"], runner.Calls);
+        Assert.Equal(["Lege die lokale Datenbank an …", "Starte die lokale Datenbank …", "Starte AISPA Studio auf diesem PC …"], steps);
+        Assert.Equal(new Uri($"http://127.0.0.1:{server.Config.ApiPort}/"), server.ApiAddress);
+        Assert.False(File.Exists(Path.Combine(Paths.DataDirectory, "initdb.tmp")));
+
+        var env = runner.ApiEnvironment!;
+        Assert.Equal("true", env["Hosting__Standalone"]);
+        Assert.Equal(Paths.WebRoot, env["Hosting__WebRoot"]);
+        Assert.Equal($"http://127.0.0.1:{server.Config.ApiPort}", env["ASPNETCORE_URLS"]);
+        Assert.Contains($"Port={server.Config.DatabasePort};Database=aispadb;Username=aispa;Password=", env["ConnectionStrings__aispadb"], StringComparison.Ordinal);
+        Assert.Equal(32, Convert.FromBase64String(env["HealthData__Keys__lokal1"]).Length);
+        Assert.Contains($"-p {server.Config.DatabasePort} -c listen_addresses=127.0.0.1", runner.StartArgs, StringComparison.Ordinal);
+        Assert.Equal(runner.InitPassword, runner.PsqlPassword);
+    }
+
+    [Fact]
+    public async Task Zweiter_Start_behaelt_Ports_Passwort_und_Schluessel_und_legt_nichts_neu_an()
+    {
+        InstallPackage();
+        var first = new FakeRunner(Paths);
+        var server = new LocalServer(Paths, first, new PlainProtector(), (_, _) => Task.FromResult(first.ApiStarted));
+        await server.StartAsync(ct: Ct);
