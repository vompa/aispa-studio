<Project Sdk="Microsoft.NET.Sdk">

  <!-- Starter-App der Live-Tests (ADR 0090): Rolle und Themen wählen, Lauf mit Knöpfen steuern, Schritte live sehen.
       Wie der Tester nur für Windows und bewusst nicht in AispaStudio.slnx (die CI baut sie unter Linux). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AispaStudio.LiveTests\AispaStudio.LiveTests.csproj" />
  </ItemGroup>

</Project>
