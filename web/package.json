{
  "name": "aispa-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:bundle": "node scripts/check-bundles.mjs",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "knip": "knip",
    "test": "vitest run",
    "gen:api": "openapi-typescript openapi/aispa-api.json -o src/api/schema.d.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "knip": "^6.44.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.91.0",
    "playwright-core": "1.65.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
