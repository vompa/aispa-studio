<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.SyncView"
             x:DataType="vm:SyncViewModel"
             x:Name="Root">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
      <StackPanel>
        <TextBlock Text="Abgleich" Classes="h1" />
        <TextBlock Text="Dieser PC arbeitet mit eigener Datenbank. Mit einer zentralen Datenbank gleicht er sich jede Minute ab, auch mit anderen Standorten."
                   Classes="muted" TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:Icon Data="{x:Static ui:Icons.Refresh}" Width="18" Height="18" />
            <TextBlock Text="Stand" Classes="h2" />
            <ui:HelpButton Topic="abgleich" Section="stand" />
            <Button Classes="ghost" Content="Neu laden" Command="{Binding RefreshCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding CentralText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding StateText}" TextWrapping="Wrap" IsVisible="{Binding HasCentral}" />
          <ui:InfoBar Severity="Warning" Message="{Binding ErrorText}" IsVisible="{Binding HasError}" />
          <TextBlock Text="{Binding PendingText}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsEnabled}" />
        </StackPanel>
      </Border>

      <!-- Abgelehnte Zeilen: die Rezeption klärt sie, dann „Erledigt“ -->
      <Border Classes="card" IsVisible="{Binding HasConflicts}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Beim Abgleich abgelehnt" Classes="h2" />
            <ui:HelpButton Topic="abgleich" Section="abgelehnt" />
          </StackPanel>
          <TextBlock Text="Jede Seite behält ihre eigene Zeile. Bitte klären, welche gilt, und die andere anpassen oder löschen."
                     Classes="muted small" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Conflicts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SyncConflictItem">
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <StackPanel>
                    <TextBlock TextWrapping="Wrap">
                      <Run Text="{Binding Area}" FontWeight="SemiBold" />
                      <Run Text=" · " />
                      <Run Text="{Binding When}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Reason}" Classes="muted small" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ghost" Content="Erledigt" Margin="8,0,0,0" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding ResolveName}"
                          IsVisible="{Binding #Root.((vm:SyncViewModel)DataContext).CanResolve}"
                          Command="{Binding #Root.((vm:SyncViewModel)DataContext).ResolveCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding CanConfigure}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Zentrale Datenbank" Classes="h2" />
            <ui:HelpButton Topic="abgleich" Section="zentrale-datenbank" />
          </StackPanel>
          <TextBlock Text="Die Verbindungsangabe zur zentralen Datenbank liegt geschützt nur auf diesem PC."
                     Classes="muted small" TextWrapping="Wrap" />
          <ui:TechnicalDetails Text="PostgreSQL mit eigenem Konto und TLS, z. B. Host=db.meinspa.at;Database=aispadb;Username=gmunden;Password=…;SSL Mode=Require" />
          <ui:FormField Label="Verbindungsangabe">
            <TextBox Text="{Binding ConnectionInput}" PasswordChar="•" PlaceholderText="Host=…;Database=…;Username=…;Password=…" />
          </ui:FormField>
          <TextBlock Text="Schlüsselcode des Spas: damit lesen alle Stellen die Anamnesen der anderen. Bei der ersten Stelle leer lassen, die App erzeugt ihn; bei jeder weiteren den Code der ersten eintragen."
                     Classes="muted small" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ui:FormField Label="Schlüsselcode des Spas">
              <TextBox Text="{Binding ShareCodeInput}" PlaceholderText="z. B. K7QM-2XRT-H9PW-4CNE-YB3D-ZF6A" />
            </ui:FormField>
            <Button Grid.Column="1" Classes="primary" Content="Eintragen" Command="{Binding ConnectCommand}" VerticalAlignment="Bottom" />
          </Grid>
          <ui:InfoBar Severity="Warning" IsVisible="{Binding HasShownCode}" Title="Schlüsselcode notieren"
                      Message="Jede weitere Stelle braucht ihn beim Verbinden. Sicher aufbewahren."
                      ActionText="Verstanden" ActionCommand="{Binding CodeNotedCommand}">
            <ui:InfoBar.Detail>
              <SelectableTextBlock Text="{Binding ShownCode}" FontFamily="Consolas, Menlo, monospace" FontSize="22" FontWeight="SemiBold" />
            </ui:InfoBar.Detail>
          </ui:InfoBar>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="ghost" Content="Schlüsselcode anzeigen" Command="{Binding ShowCodeCommand}" IsVisible="{Binding HasShareCode}" />
            <Button Classes="ghost" Content="Abgleich ausschalten" Command="{Binding DisconnectCommand}" IsVisible="{Binding HasCentral}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                 IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
