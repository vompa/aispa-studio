<views:FocusRequestView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:vm="using:AispaStudio.Desktop.ViewModels"
                         xmlns:ui="using:AispaStudio.Desktop.Controls"
                         xmlns:views="using:AispaStudio.Desktop.Views"
                         x:Class="AispaStudio.Desktop.Views.StoragePlacesSection"
                         x:DataType="vm:StoragePlacesViewModel">
  <!--
    Lagerorte (R05 Slice 101, ADR 0068) nach web/src/stock/StoragePlacesAdmin.tsx: links die Liste mit „Neuer Lagerort“, rechts das Formular mit Name, Art, Raum, Beschreibung, Aktiv und
    den Mindestmengen je Material. Das Hauptlager gibt es immer; es lässt sich umbenennen, aber weder löschen noch deaktivieren. „Speichern / Verwerfen“ steht am Ende des Formulars (Strg+S).
  -->
  <Grid ColumnDefinitions="300,*">
    <Border Classes="card" Padding="8" Margin="0,0,16,0" VerticalAlignment="Top">
      <ListBox x:Name="PlaceList" Classes="plain" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutomationProperties.Name="Lagerorte">
        <ListBox.Styles>
          <!-- Der Name der Zeile nennt Lagerort und Art; sonst liest der Screenreader den Record-Typ -->
          <Style Selector="ListBoxItem" x:DataType="vm:StoragePlaceRow">
            <Setter Property="AutomationProperties.Name" Value="{Binding Summary}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:StoragePlaceRow">
            <StackPanel Spacing="2" Margin="0,2">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Sub}" Classes="muted small" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Border Grid.Column="1" Classes="card">
      <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding HeadingText}" Classes="h2" VerticalAlignment="Center" TextWrapping="Wrap" />
          <ui:HelpButton Grid.Column="1" Topic="lager-lagerorte" Section="lagerorte" />
        </Grid>

        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,200" ColumnSpacing="12">
            <ui:FormField Label="Name" IsRequired="True" Error="{Binding NameError}">
              <TextBox x:Name="PlaceNameField" Text="{Binding PlaceName}" MaxLength="60" />
            </ui:FormField>
            <ui:FormField Grid.Column="1" Label="Art">
              <ComboBox x:Name="PlaceKindField" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}" IsEnabled="{Binding CanEditKind}" HorizontalAlignment="Stretch" />
            </ui:FormField>
          </Grid>
          <ui:FormField Label="Raum" IsVisible="{Binding ShowRoom}">
            <ComboBox x:Name="PlaceRoomField" ItemsSource="{Binding RoomOptions}" SelectedItem="{Binding SelectedRoom}" MinWidth="240" HorizontalAlignment="Left" />
          </ui:FormField>
          <ui:FormField Label="Beschreibung">
            <TextBox x:Name="PlaceDescriptionField" Text="{Binding Description}" MaxLength="160" />
          </ui:FormField>
          <StackPanel Spacing="4">
            <CheckBox x:Name="PlaceActiveBox" IsChecked="{Binding IsActive}" IsEnabled="{Binding CanEditKind}" Content="Aktiv" />
            <TextBlock Text="Das Hauptlager bleibt immer aktiv." Classes="muted small" IsVisible="{Binding IsMain}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Mindestmengen" Classes="h3" VerticalAlignment="Center" />
            <ui:HelpButton Grid.Column="1" Topic="lager-lagerorte" Section="mindestmengen" />
          </Grid>
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Fällt der Bestand an diesem Ort darunter, steht er im Bestand als „unter Minimum“. Ohne Eintrag gilt hier kein Mindestwert. Bei einem Raumschrank sind die Mindestmengen die Raumausstattung: Nach der Behandlung prüft das Team, was fehlt. Die Höchstmenge ist freiwillig: Bis dahin füllt der Bestellvorschlag auf." />
          <Grid ColumnDefinitions="*,120,120,28" ColumnSpacing="8" IsVisible="{Binding HasMinimums}">
            <TextBlock Text="Material" Classes="muted small" />
            <TextBlock Grid.Column="1" Text="Mindestmenge" Classes="muted small" />
            <TextBlock Grid.Column="2" Text="Höchstmenge" Classes="muted small" />
          </Grid>
          <ItemsControl x:Name="MinimumList" ItemsSource="{Binding Minimums}" IsVisible="{Binding HasMinimums}" AutomationProperties.Name="Mindestmengen">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MinimumRow">
                <Grid ColumnDefinitions="*,120,120,Auto" ColumnSpacing="8" Margin="0,2">
                  <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Item}" HorizontalAlignment="Stretch" AutomationProperties.Name="Material der Mindestmenge" />
                  <TextBox Grid.Column="1" Text="{Binding Amount}" Classes="num" AutomationProperties.Name="{Binding AmountName}" />
                  <TextBox Grid.Column="2" Text="{Binding Maximum}" Classes="num" AutomationProperties.Name="{Binding MaximumName}" />
                  <Button Grid.Column="3" Classes="ghost icon" Width="28" Height="28" MinHeight="28" Command="{Binding RemoveCommand}" ToolTip.Tip="Entfernen"
                          AutomationProperties.Name="{Binding RemoveName}" VerticalAlignment="Center">
                    <ui:Icon Data="{x:Static ui:Icons.Close}" Width="16" Height="16" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="AddMinimumButton" Classes="small" Content="Mindestmenge hinzufügen" Command="{Binding AddMinimumCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasCopySources}">
            <ComboBox x:Name="CopySourceField" ItemsSource="{Binding CopySources}" SelectedItem="{Binding CopySource}" MinWidth="200" PlaceholderText="Lagerort wählen"
                      AutomationProperties.Name="Lagerort, von dem die Mindestmengen übernommen werden" />
            <Button x:Name="CopyMinimumsButton" Classes="small" Content="Von Raum … übernehmen" Command="{Binding CopyMinimumsCommand}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="Footer" Spacing="12">
          <ui:InfoBar Severity="Error" Title="Nicht gespeichert" Message="{Binding Error}" IsVisible="{Binding HasError}" CloseCommand="{Binding CloseErrorCommand}" />
          <StackPanel Orientation="Horizontal" Spacing="24">
            <ui:SaveBar SaveCommand="{Binding SaveCommand}" DiscardCommand="{Binding DiscardCommand}" CanDiscard="{Binding HasUnsavedChanges}" />
            <Button x:Name="DeletePlaceButton" Classes="danger" Content="Löschen" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</views:FocusRequestView>
