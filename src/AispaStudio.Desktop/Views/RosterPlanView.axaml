<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.RosterPlanView"
             x:DataType="vm:RosterPlanViewModel">
  <!--
    Dienstplan einer Woche (R05 Slice 99, Ä191, Ä250; R07 Slice 142, Ä350), nach web/src/roster/RosterPage.tsx: Standort, Wochenwahl, Band für Entwürfe, eine Zeile je Person auf einer Fläche mit
    feinen Linien. Dienste sind Chips ohne Personenfarbe (die steht als Punkt vor dem Namen), Abwesenheiten ein Balken über die Tage, Stunden und Soll stehen beim Namen, die Spalte von heute ist ein durchgehender Streifen hinter der Tabelle, unten zählt die Summenzeile „Besetzung“.
    Die Tabelle füllt die Breite der Ansicht (sieben gleich breite Spalten, kein Rollbalken; T-100, Paket C) und steht im Wochenplan des Teams auf einer Karte; auf der Personenkarte nicht, dort hat sie die feste Breite 912 und einen waagrechten Rollbalken.
    Der Kopf der Spalte von heute heißt „Heute · Do. 26.11.“ (Stand T-100, Paket D).
    Eine Zelle ist ein Knopf (nur mit dem Recht zu planen); ein Entwurf trägt einen gestrichelten Rand. Der Balken liegt über den Zellen und fängt keine Klicks ab: jeder Tag bleibt einzeln anklickbar.
    Farben nur über Ressourcen; Chip und Dienst an einem anderen Standort nach Brief 5.8 (T-100, Paket B): Stilklassen chip und chip.elsewhere, in der Spalte von heute (cellToday) auf surface mit accent-line.
    Ein Klick auf eine Zelle öffnet den Tag als Popover direkt unter der Zelle (Ä370, T-017): DayHost liegt in derselben Ansicht über der Tabelle (kein Flyout, damit Fokus, Strg+S und
    DataContext im selben Baum bleiben); die Lage setzt RosterPlanView.axaml.cs. Weil DayHost ein Kind der Wurzel mit Margin ist, wächst die Ansicht mit und nichts wird abgeschnitten.
  -->
  <UserControl.Resources>
    <DataTemplate x:Key="RosterCellContent" x:DataType="vm:RosterCellViewModel">
      <StackPanel Spacing="2" HorizontalAlignment="Stretch" Classes.cellToday="{Binding IsToday}">
        <ItemsControl ItemsSource="{Binding Chips}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RosterChipViewModel">
              <Border Classes="chip" Classes.elsewhere="{Binding IsElsewhere}" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Time}" Classes="num" Classes.planned="{Binding IsPlanned}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                             AutomationProperties.AccessibilityView="Raw" />
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" HorizontalAlignment="Center" IsVisible="{Binding IsElsewhere}"
                        ToolTip.Tip="{Binding Location}">
                    <ui:Icon Data="{x:Static ui:Icons.Location}" Width="12" Height="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Location}" Classes="small" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="frei" Classes="small muted" HorizontalAlignment="Center" IsVisible="{Binding IsFree}" AutomationProperties.AccessibilityView="Raw" />
        <ItemsControl ItemsSource="{Binding Warnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Classes="small" Foreground="{DynamicResource WarnBrush}" FontWeight="Medium" TextWrapping="Wrap" MaxWidth="70" AutomationProperties.AccessibilityView="Raw" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.rcell, ContentControl.rcell">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0,6" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    </Style>
    <Style Selector="Button.rcell.open">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBlock.planned">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Dienst-Chip (Brief 5.8): Höhe 28, Fläche surface-3 mit Rahmen line; in der Spalte von heute surface mit accent-line -->
    <Style Selector="Border.chip">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    </Style>
    <Style Selector="StackPanel.cellToday Border.chip">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    </Style>
    <!-- Dienst an einem anderen Standort (Brief 5.8): keine Fläche, fg-2, Rahmen line-strong, zwei Zeilen -->
    <Style Selector="Border.chip.elsewhere">
            <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    </Style>
    <Style Selector="Border.chip.elsewhere TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
    </Style>
    <Style Selector="Border.chip.elsewhere ui|Icon">
      <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
    </Style>
    <Style Selector="StackPanel.cellToday Border.chip.elsewhere">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    </Style>
    <!-- Ohne Karte auf der Personenkarte (die Karte der Person ist schon die Fläche) -->
    <Style Selector="Border.card.plain">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <!-- Im Wochenplan des Teams füllt die Tabelle die Breite, nie ein Rollbalken. Auf der schmaleren Personenkarte hat sie eine feste Breite (Name 72 plus sieben Tage zu 120) und rollt dort waagrecht. -->
    <Style Selector="ScrollViewer.planscroll">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ScrollViewer.planscroll.cardscroll">
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
    <!-- Die Breite sitzt am gemeinsamen Panel, damit der Streifen für heute dieselbe Spaltenteilung hat wie die Tabelle. -->
    <Style Selector="Panel.cardtable">
      <Setter Property="Width" Value="912" />
    </Style>
    <Style Selector="ContentPresenter:nth-child(1) > Border.rrow">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBlock.coverage">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.coverage.zero">
      <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.today">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.bar">
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
    </Style>
    <Style Selector="Border.bar > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.bar.single > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.bar.dayoff">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.bar.dayoff > TextBlock">
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.bar.vacation">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Border.bar.vacation > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.bar.sick">
      <Setter Property="Background" Value="{DynamicResource CritSoftBrush}" />
    </Style>
    <Style Selector="Border.bar.sick > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource CritBrush}" />
    </Style>
    <Style Selector="Border.bar.training">
      <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
    </Style>
    <Style Selector="Border.bar.training > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
    </Style>
  </UserControl.Styles>

  <Panel x:Name="PlanRoot">
  <StackPanel Spacing="12">
    <ui:InfoBar Severity="Error" Title="Dienstplan nicht geladen" Message="{Binding LoadError}" IsVisible="{Binding HasLoadError}"
                ActionText="Erneut laden" ActionCommand="{Binding LoadCommand}" />

    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
      <ComboBox x:Name="RosterLocation" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" MinWidth="200" VerticalAlignment="Center"
                AutomationProperties.Name="Standort" />
      <Button x:Name="PreviousWeekButton" Content="‹" Command="{Binding PreviousWeekCommand}" Classes="icon" AutomationProperties.Name="Vorherige Woche" ToolTip.Tip="Vorherige Woche" />
      <Button x:Name="ThisWeekButton" Content="Diese Woche" Command="{Binding ThisWeekCommand}" />
      <Button x:Name="NextWeekButton" Content="›" Command="{Binding NextWeekCommand}" Classes="icon" AutomationProperties.Name="Nächste Woche" ToolTip.Tip="Nächste Woche" />
      <TextBlock x:Name="WeekTitleText" Text="{Binding WeekTitle}" Classes="h3" VerticalAlignment="Center" />
      <!-- Export des Dienstplans und der Abwesenheiten der Woche, nur für Inhaberin und Geschäftsführung (Export/Import, Aufgabe D) -->
      <ui:ExportButton x:Name="RosterExportButton" DataContext="{Binding Export}" VerticalAlignment="Center" />
      <TextBlock x:Name="RosterExportSaved" Text="{Binding ExportSaved}" Classes="muted small" IsVisible="{Binding HasExportSaved}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      <ui:HelpButton Topic="seite-roster" VerticalAlignment="Center" IsVisible="{Binding !IsCard}" />
      <Button x:Name="RosterDocumentButton" Content="Aushang als PDF" Command="{Binding ToggleDocumentCommand}" IsVisible="{Binding CanOfferDocument}"
              ToolTip.Tip="Druckt oder speichert den veröffentlichten Dienstplan dieser Woche als Aushang." />
      <!-- Anträge (ADR 0098): öffnet die Seitenleiste „Anträge“ über dem Wochenplan; die Zahl steht nur bei offenen Anträgen -->
      <Button x:Name="RequestsButton" Command="{Binding ToggleRequestsCommand}" IsVisible="{Binding HasRequests}"
              AutomationProperties.Name="{Binding RequestsButtonName}" ToolTip.Tip="Offene Abwesenheitsanträge genehmigen oder ablehnen">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Anträge" VerticalAlignment="Center" />
          <Border x:Name="RequestsCount" Classes="pill warn" IsVisible="{Binding HasOpenRequests}">
            <TextBlock Text="{Binding OpenRequests}" Classes="num" />
          </Border>
        </StackPanel>
      </Button>
    </WrapPanel>

    <!-- Aushang (PDF-Ausgaben F): „Aushang als PDF“ öffnet den Knopfblock ohne Senden; nur der veröffentlichte Stand, ohne Entwürfe -->
    <Border x:Name="RosterDocumentCard" Classes="section" IsVisible="{Binding IsDocumentOpen}" HorizontalAlignment="Left">
      <StackPanel Spacing="8">
        <TextBlock Text="Dienstplan-Aushang" FontWeight="Medium" />
        <TextBlock Text="{Binding DocumentHint}" Classes="muted small" TextWrapping="Wrap" MaxWidth="480" />
        <ui:DocumentActions DataContext="{Binding Document}" />
        <TextBlock Text="{Binding DocumentMessage}" Classes="secondary small" AutomationProperties.LiveSetting="Polite"
                   IsVisible="{Binding DocumentMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <Border x:Name="DraftBand" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8"
            IsVisible="{Binding CanPublish}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock x:Name="DraftBandText" Text="{Binding DraftBandText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="PublishButton" Classes="primary" Content="Veröffentlichen" Command="{Binding PublishCommand}" />
          <Button x:Name="DiscardDraftsButton" Classes="ghost danger" Content="Verwerfen" Command="{Binding DiscardDraftsCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    <TextBlock Text="{Binding LastPublishedText}" Classes="muted small" IsVisible="{Binding HasLastPublished}" />

    <ui:InfoBar x:Name="PublishInfo" Severity="{Binding PublishSeverity}" Message="{Binding PublishMessage}" IsVisible="{Binding HasPublishMessage}"
                CloseCommand="{Binding ClosePublishMessageCommand}" />
    <ui:InfoBar Severity="Error" Title="Nicht erledigt" Message="{Binding Error}" IsVisible="{Binding HasError}" CloseCommand="{Binding CloseErrorCommand}" />

    <TextBlock Text="Lade Dienstplan …" Classes="muted" IsVisible="{Binding !IsLoaded}" />
    <TextBlock x:Name="RosterEmpty" Text="{Binding EmptyText}" Classes="muted" IsVisible="{Binding IsEmpty}" />

    <Border x:Name="RosterCard" Classes="card" Classes.plain="{Binding IsCard}" IsVisible="{Binding IsLoaded}">
    <ScrollViewer Classes="planscroll" Classes.cardscroll="{Binding IsCard}">
    <Panel Classes.cardtable="{Binding IsCard}">
      <!-- Heute: ein durchgehender Streifen hinter Kopf, Zeilen und Besetzung (Brief 6 Punkt 8), in derselben Spaltenteilung wie die Tabelle -->
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasToday}" IsHitTestVisible="False">
        <Border Width="{Binding NameColumnWidth}" />
        <Grid Grid.Column="1" ColumnDefinitions="*,*,*,*,*,*,*">
          <Border x:Name="TodayStripe" Grid.Column="{Binding TodayColumn}" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" />
        </Grid>
      </Grid>
      <StackPanel x:Name="RosterTable" AutomationProperties.Name="Dienstplan">
        <Border BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,6">
        <Grid ColumnDefinitions="Auto,*">
          <Border Width="{Binding NameColumnWidth}" />
          <ItemsControl Grid.Column="1" ItemsSource="{Binding Heads}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RosterHeadViewModel">
                <TextBlock Text="{Binding Label}" Classes="group" Classes.today="{Binding IsToday}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RosterRowViewModel">
              <Border Classes="rrow" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" MinHeight="44">
                <Grid ColumnDefinitions="Auto,*">
                  <StackPanel Width="{Binding NameColumnWidth}" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowsName}">
                      <Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center" />
                      <Button Classes="link" Content="{Binding Name}" Command="{Binding OpenPersonCommand}" IsVisible="{Binding CanOpenPerson}"
                              AutomationProperties.Name="{Binding OpenPersonName}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" IsVisible="{Binding IsPlainName}" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <Border x:Name="RosterNoteSymbol" Background="Transparent" VerticalAlignment="Center" IsVisible="{Binding HasNote}"
                              ToolTip.Tip="{Binding NoteText}" ui:ToolTipBehavior.Reachable="True" AutomationProperties.Name="{Binding NoteText, StringFormat='Hinweis: {0}'}"
                              AutomationProperties.ControlTypeOverride="Text" AutomationProperties.AccessibilityView="Content">
                        <ui:Icon Data="{x:Static ui:Icons.Note}" Width="16" Height="16" Foreground="{DynamicResource Fg2Brush}" />
                      </Border>
                    </StackPanel>
                    <TextBlock x:Name="RosterHours" Text="{Binding HoursText}" Classes="num small secondary" Margin="16,0,0,0" ToolTip.Tip="{Binding HoursTip}" ui:ToolTipBehavior.Reachable="True" />
                    <ItemsControl ItemsSource="{Binding Warnings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" Classes="small" Foreground="{DynamicResource WarnBrush}" FontWeight="Medium" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <Panel Grid.Column="1">
                    <ItemsControl ItemsSource="{Binding Cells}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RosterCellViewModel">
                          <Panel>
                            <Button Classes="rcell" Classes.open="{Binding IsOpen}" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}"
                                    AutomationProperties.Name="{Binding AutomationName}" Content="{Binding}" ContentTemplate="{StaticResource RosterCellContent}" />
                            <!-- Ohne Recht zu planen ist die Zelle Text, kein abgeschalteter Knopf (Deckkraft 0,5): der Plan muss gut lesbar bleiben. -->
                            <ContentControl Classes="rcell" IsVisible="{Binding !CanOpen}" AutomationProperties.Name="{Binding AutomationName}"
                                            AutomationProperties.ControlTypeOverride="Text" Content="{Binding}" ContentTemplate="{StaticResource RosterCellContent}" />
                            <Rectangle Classes="draft" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="8" RadiusY="8" Margin="2"
                                       IsVisible="{Binding IsDraft}" IsHitTestVisible="False" />
                          </Panel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Bars}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <Grid ColumnDefinitions="*,*,*,*,*,*,*" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="vm:RosterBarViewModel">
                          <Setter Property="Grid.Column" Value="{Binding Column}" />
                          <Setter Property="Grid.ColumnSpan" Value="{Binding Span}" />
                        </Style>
                      </ItemsControl.Styles>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RosterBarViewModel">
                          <Border Classes="bar" Classes.single="{Binding IsSingleDay}" Classes.dayoff="{Binding IsDayOff}" Classes.vacation="{Binding IsVacation}" Classes.sick="{Binding IsSick}" Classes.training="{Binding IsTraining}">
                            <TextBlock Text="{Binding Text}" Classes="small" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Panel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border x:Name="RosterCoverage" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="0,1,0,0" Padding="0,8" IsVisible="{Binding ShowsCoverage}"
                ToolTip.Tip="Wie viele Personen an dem Tag am Standort im Dienst sind">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Text="Besetzung" Classes="group" Width="160" VerticalAlignment="Center" ui:ToolTipBehavior.Reachable="True"
                       ToolTip.Tip="Wie viele Personen an dem Tag am Standort im Dienst sind" />
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Coverage}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RosterCoverageViewModel">
                  <TextBlock Text="{Binding Text}" Classes="coverage num" Classes.today="{Binding IsToday}" Classes.zero="{Binding IsZero}" HorizontalAlignment="Center"
                             AutomationProperties.Name="{Binding AutomationName}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      </StackPanel>
    </Panel>
    </ScrollViewer>
    </Border>
  </StackPanel>

  <ContentControl x:Name="DayHost" Content="{Binding Day}" IsVisible="{Binding HasDay}" HorizontalAlignment="Left" VerticalAlignment="Top" ZIndex="1" />
  </Panel>
</UserControl>
