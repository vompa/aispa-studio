<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             xmlns:local="using:AispaStudio.Desktop.Views"
             x:Class="AispaStudio.Desktop.Views.LocationsView"
             x:DataType="vm:LocationsViewModel"
             ui:SaveShortcut.IsScope="True">
  <!--
    Standorte & Räume (R05 Slice 95), native Maske nach web/src/admin/LocationsTab.tsx: links die Standorte, rechts das Formular des gewählten Standorts
    (Gruppen mit Überschrift und Fragezeichen am Titel, Brief 5.11), darunter die Abschnitte Online-Buchung, Räume, Tagesstart-Kontrolle und Geräte, jeder mit
    eigenem Speichern wie im Web. „Speichern / Verwerfen“ steht am Ende des Formulars (Strg+S speichert den Standort), nicht im Fuß, weil die Abschnitte danach
    eigene Knöpfe haben.
  -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:OnlineRulesViewModel">
      <local:OnlineRulesSection />
    </DataTemplate>
    <DataTemplate DataType="vm:RoomChecklistViewModel">
      <local:ChecklistSection />
    </DataTemplate>
  </UserControl.DataTemplates>
  <Grid ColumnDefinitions="220,*">
    <Border Classes="card" Padding="8" Margin="0,0,16,0" VerticalAlignment="Top">
      <ListBox x:Name="LocationList" Classes="plain" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" AutomationProperties.Name="Standorte">
        <ListBox.Styles>
          <!-- Der Name der Zeile ist ihr Titel; sonst liest der Screenreader den Typnamen -->
          <Style Selector="ListBoxItem" x:DataType="vm:LocationChoice">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LocationChoice">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <ScrollViewer Grid.Column="1" x:Name="FieldsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="20" MaxWidth="800" HorizontalAlignment="Left" Margin="0,0,16,16">
        <ui:InfoBar Severity="Error" Title="Standorte nicht geladen" Message="{Binding LoadError}" IsVisible="{Binding HasLoadError}"
                    ActionText="Erneut laden" ActionCommand="{Binding LoadCommand}" />
        <TextBlock Text="Lade Standorte …" Classes="muted" IsVisible="{Binding !IsLoaded}" />

        <StackPanel Spacing="20" IsVisible="{Binding IsLoaded}">
          <!-- Standort -->
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding HeadingText}" Classes="h2" VerticalAlignment="Center" />
              <ui:HelpButton Grid.Column="1" Topic="standorte" Section="standort" />
            </Grid>
            <ui:FormField Label="Name" IsRequired="True" Error="{Binding NameError}">
              <TextBox x:Name="NameField" Text="{Binding Name}" />
            </ui:FormField>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
              <ui:FormField Label="Zeitzone">
                <ComboBox x:Name="TimeZoneField" ItemsSource="{Binding TimeZones}" SelectedItem="{Binding TimeZone}" HorizontalAlignment="Stretch" />
              </ui:FormField>
              <ui:FormField Grid.Column="1" Label="Währung">
                <ComboBox ItemsSource="{x:Static vm:LocationsViewModel.Currencies}" SelectedItem="{Binding Currency}" HorizontalAlignment="Stretch" />
              </ui:FormField>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="0,4,0,0">
              <ui:FormField Label="Bundesland / Kanton" Help="Bestimmt die gesetzlichen Feiertage, auch für den KI-Assistenten.">
                <ComboBox x:Name="RegionField" ItemsSource="{Binding Regions}" SelectedItem="{Binding Region}" HorizontalAlignment="Stretch" MaxDropDownHeight="360" />
              </ui:FormField>
              <ui:HelpButton Grid.Column="1" Topic="standorte" Section="bundesland-kanton" VerticalAlignment="Top" Margin="0,22,0,0" />
            </Grid>
          </StackPanel>

          <!-- Anschrift und Kontakt -->
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Anschrift und Kontakt" Classes="h2" VerticalAlignment="Center" />
              <ui:HelpButton Grid.Column="1" Topic="standorte" Section="anschrift" />
            </Grid>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Erscheinen im Kundenbereich und in den Mails an Gäste." />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
              <ui:FormField Grid.ColumnSpan="2" Label="Straße und Nummer">
                <TextBox x:Name="StreetField" Text="{Binding Street}" />
              </ui:FormField>
              <Grid Grid.Row="1" ColumnDefinitions="100,*" ColumnSpacing="12" Grid.ColumnSpan="2">
                <ui:FormField Label="PLZ">
                  <TextBox Text="{Binding PostalCode}" />
                </ui:FormField>
                <ui:FormField Grid.Column="1" Label="Ort">
                  <TextBox Text="{Binding City}" />
                </ui:FormField>
              </Grid>
              <ui:FormField Grid.Row="2" Label="Telefon">
                <TextBox x:Name="PhoneField" Text="{Binding Phone}" />
              </ui:FormField>
              <ui:FormField Grid.Row="2" Grid.Column="1" Label="E-Mail für Gäste">
                <TextBox x:Name="EmailField" Text="{Binding Email}" />
              </ui:FormField>
            </Grid>
          </StackPanel>

          <!-- Anreise und Parkplätze -->
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Anreise und Parkplätze" Classes="h2" VerticalAlignment="Center" />
              <ui:HelpButton Grid.Column="1" Topic="standorte" Section="anreise" />
            </Grid>
            <ui:FormField Label="Anreise und Parkplätze"
                          Help="Gäste lesen ihn im Kundenbereich und in der Bestätigungsmail.">
              <TextBox x:Name="DirectionsField" Text="{Binding Directions}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxLength="500"
                       PlaceholderText="z. B. U1 bis Stephansplatz, Garage Am Graben 2 Minuten zu Fuß." />
            </ui:FormField>
          </StackPanel>

          <!-- Eigene Gesellschaft -->
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Eigene Gesellschaft" Classes="h2" VerticalAlignment="Center" />
              <ui:HelpButton Grid.Column="1" Topic="standorte" Section="eigene-gesellschaft" />
            </Grid>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Nur ausfüllen, wenn dieser Standort zu einer anderen Gesellschaft gehört. Leer gelten die Firmendaten des Spas; sie stehen auf Kassenbeleg und Rechnung, wenn der Belegkopf sie nicht schon nennt." />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
              <ui:FormField Label="Firmenwortlaut">
                <TextBox Text="{Binding LegalName}" />
              </ui:FormField>
              <ui:FormField Grid.Column="1" Label="UID-Nummer">
                <TextBox Text="{Binding VatId}" />
              </ui:FormField>
              <ui:FormField Grid.Row="1" Label="Firmenbuch- bzw. Handelsregisternummer">
                <TextBox Text="{Binding RegisterNumber}" />
              </ui:FormField>
              <ui:FormField Grid.Row="1" Grid.Column="1" Label="Firmenbuchgericht">
                <TextBox Text="{Binding RegisterCourt}" />
              </ui:FormField>
            </Grid>
          </StackPanel>

          <!-- Öffnungszeiten -->
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Öffnungszeiten" Classes="h2" VerticalAlignment="Center" />
              <ui:HelpButton Grid.Column="1" Topic="standorte" Section="oeffnungszeiten" />
            </Grid>
            <ItemsControl x:Name="DaysList" ItemsSource="{Binding Days}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OpeningDayViewModel">
                  <Grid ColumnDefinitions="160,Auto,Auto,Auto" ColumnSpacing="8">
                    <CheckBox x:Name="DayOpen" IsChecked="{Binding IsOpen}" Content="{Binding Label}" />
                    <ui:TimeField Grid.Column="1" CommittedText="{Binding OpensText}" IsVisible="{Binding IsOpen}" AutomationProperties.Name="{Binding OpensName}" />
                    <TextBlock Grid.Column="2" Text="–" VerticalAlignment="Center" IsVisible="{Binding IsOpen}" />
                    <ui:TimeField Grid.Column="3" CommittedText="{Binding ClosesText}" IsVisible="{Binding IsOpen}" AutomationProperties.Name="{Binding ClosesName}" />
                    <TextBlock Grid.Column="1" Text="geschlossen" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding !IsOpen}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding HoursError}" Classes="small error" TextWrapping="Wrap" IsVisible="{Binding HoursError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>

          <StackPanel x:Name="Footer" Spacing="12">
            <ui:InfoBar Severity="Error" Title="Nicht gespeichert" Message="{Binding Error}" IsVisible="{Binding HasError}"
                        ActionText="Erneut versuchen" ActionCommand="{Binding SaveCommand}" CloseCommand="{Binding CloseErrorCommand}" />
            <ui:SaveBar SaveCommand="{Binding SaveCommand}" DiscardCommand="{Binding DiscardCommand}" CanDiscard="{Binding HasUnsavedChanges}" Status="{Binding StatusText}" />
          </StackPanel>

          <!-- Abschnitte des gewählten Standorts, jeder mit eigenem Speichern -->
          <StackPanel Spacing="24" IsVisible="{Binding HasLocation}">
            <Border Classes="divider" />
            <ContentControl Content="{Binding OnlineRules}" />
            <local:RoomsSection />
            <ContentControl Content="{Binding Checklist}" />
            <local:EquipmentSection />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
