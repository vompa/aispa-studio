<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             xmlns:c="using:AispaStudio.Contracts"
             x:Class="AispaStudio.Desktop.Views.FreeTimeView"
             x:DataType="vm:FreeTimeViewModel">
  <!-- „Freie Zeit suchen“: in der Seitenleiste des Kalenders und rechts neben der Nachricht im Posteingang (dort merkt der Knopf die Zeit vor, ADR 0083) -->
  <StackPanel Spacing="12">
    <!-- Suche: die Angaben in einer Karte (5.12, Punkt 5) -->
    <Border Classes="panelcard">
      <StackPanel Spacing="12">
        <!-- Gast: ein gewählter Vorschlag lässt sich gleich für ihn buchen; seine Wünsche fließen in die Suche ein. Im Posteingang ist der Gast die Anfrage -->
        <StackPanel IsVisible="{Binding ShowGuest}">
          <TextBlock Text="Gast (optional)" Classes="label" />
          <ContentControl Content="{Binding Guest}" />
          <TextBlock Text="{Binding GuestHint}" IsVisible="{Binding HasGuestHint}" Classes="small secondary" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <ui:FormField Label="Behandlung">
          <ComboBox x:Name="FreeTimeTreatment" ItemsSource="{Binding Treatments}" SelectedItem="{Binding Treatment}" HorizontalAlignment="Stretch"
                    PlaceholderText="Behandlung wählen">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="c:TreatmentDto">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding DurationMinutes, StringFormat='{}{0} Min.'}" Classes="muted small" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </ui:FormField>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <ui:FormField Label="Bei">
            <ComboBox ItemsSource="{Binding People}" SelectedItem="{Binding Person}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PersonChoice">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </ui:FormField>
          <ui:FormField Grid.Column="1" Label="Raum">
            <ComboBox ItemsSource="{Binding Rooms}" SelectedItem="{Binding Room}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RoomChoice">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </ui:FormField>
        </Grid>
        <ui:FormField Label="Tageszeit">
          <ComboBox ItemsSource="{x:Static vm:DayPartChoice.All}" SelectedItem="{Binding Part}" HorizontalAlignment="Stretch" />
        </ui:FormField>
        <!-- Beschriftung mit Fragezeichen daneben (Brief 5.11): per LabeledBy verbunden, nicht im FormField -->
        <!-- „Sprache des Gastes“ ausgeblendet am 27.10.2026 (Auftraggeber), für eine mögliche spätere Nutzung (Ä157): Logik im ViewModel bleibt -->
        <StackPanel IsVisible="{Binding ShowLanguage}">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="FreeTimeLanguageLabel" Text="Sprache des Gastes" Classes="label" />
            <ui:HelpButton Topic="sprachen-und-quelle" Section="freie-zeit" Margin="6,0,0,0" />
          </StackPanel>
          <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" HorizontalAlignment="Stretch"
                    AutomationProperties.LabeledBy="{Binding #FreeTimeLanguageLabel}" />
        </StackPanel>
        <StackPanel IsVisible="{Binding HasGenders}">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="FreeTimeGenderLabel" Text="Gast wünscht" Classes="label" />
            <ui:HelpButton Topic="kunden-termine-am-liebsten" Section="therapeutin" Margin="6,0,0,0" />
          </StackPanel>
          <ComboBox ItemsSource="{x:Static vm:GenderChoice.All}" SelectedItem="{Binding Gender}" HorizontalAlignment="Stretch"
                    AutomationProperties.LabeledBy="{Binding #FreeTimeGenderLabel}" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="{Binding Summary}" Classes="muted small" TextWrapping="Wrap" VerticalAlignment="Center" />
      <ui:HelpButton Grid.Column="1" Topic="kalender-freie-zeit-suchen" Margin="6,0,0,0" />
    </Grid>
    <ui:InfoBar Severity="Error" Message="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <!-- Nichts frei: Ursache und Weg als Meldung (meldungen.md M8), nicht als kleiner grauer Text -->
    <ui:InfoBar Severity="Warning" Message="{Binding NoSlotsMessage}" IsVisible="{Binding HasNoSlots}" ActionText="{Binding RelaxText}" ActionCommand="{Binding RelaxCommand}" />
    <!-- Ist am Tag nichts mehr frei, kommen die Vorschläge von den Folgetagen; der Hinweis steht klein darüber -->
    <TextBlock Text="{Binding DayHint}" IsVisible="{Binding HasDayHint}" Classes="small warn" FontWeight="SemiBold" TextWrapping="Wrap" />
    <Border Classes="panelcard" Padding="4" IsVisible="{Binding HasSlots}">
      <ListBox Classes="plain" ItemsSource="{Binding Slots}" SelectedItem="{Binding Active, Mode=OneWay}" MaxHeight="420"
               x:Name="FreeTimeList">
        <ListBox.Styles>
          <!-- Der Name der Zeile ist ihr sichtbarer Inhalt; sonst liest der Screenreader den Record-Typ -->
          <Style Selector="ListBoxItem" x:DataType="vm:FreeSlotRow">
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:FreeSlotRow">
            <Grid ColumnDefinitions="96,*,Auto" Background="Transparent" Tapped="OnSlotTapped">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding DayText}" IsVisible="{Binding HasDay}" Classes="small warn" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Time}" FontWeight="SemiBold" Classes="num" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <Ellipse Width="8" Height="8" Fill="{Binding WhoColor}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Who}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock Text="{Binding Room}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SpeaksLanguage}" Classes="small" Foreground="{DynamicResource AccentBrush}"
                           IsVisible="{Binding HasLanguage}" />
                <TextBlock Text="{Binding OutsideWish}" Classes="small warn" TextWrapping="Wrap" IsVisible="{Binding HasOutsideWish}" />
                <TextBlock Text="{Binding GapNote}" Classes="small" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding HasGapNote}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                <Border Classes="pill" IsVisible="{Binding IsSnug}" ToolTip.Tip="Schließt ohne Lücke an">
                  <TextBlock Text="passt genau" />
                </Border>
                <Border Classes="pill accent" IsVisible="{Binding IsWishPerson}" ToolTip.Tip="Die bevorzugte oder feste Therapeut:in des Gastes">
                  <TextBlock Text="Wunsch" />
                </Border>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding BookActiveCommand}"
            IsVisible="{Binding HasSlots}" Content="{Binding BookText}" Margin="0,4,0,0" />
  </StackPanel>
</UserControl>
