<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.EquipmentSection"
             x:DataType="vm:LocationsViewModel">
  <!-- Geräte des Standorts (R05 Slice 95), nach EquipmentList in web/src/admin/LocationsTab.tsx: Zeile zum Hinzufügen fest über der Liste, je Gerät das Menü „⋯“ mit „Nicht mehr verwenden“ und „Löschen …“ (ADR 0099) -->
  <StackPanel Spacing="8" AutomationProperties.Name="Geräte">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="Geräte" Classes="h2" VerticalAlignment="Center" />
      <ui:HelpButton Grid.Column="1" Topic="standorte" Section="geraete" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox x:Name="NewEquipmentField" Text="{Binding NewEquipmentName}" PlaceholderText="Neues Gerät" AutomationProperties.Name="Neues Gerät" MaxLength="100" />
      <Button Grid.Column="1" Content="Hinzufügen" Command="{Binding AddEquipmentCommand}" ui:DisabledHint.Text="Verfügbar, sobald ein Name eingetragen ist." />
    </Grid>
    <TextBlock x:Name="EquipmentEmpty" Text="Noch kein Gerät angelegt." Classes="muted" IsVisible="{Binding !Equipment.Count}" />
    <ItemsControl x:Name="EquipmentList" ItemsSource="{Binding Equipment}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="4" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:EquipmentRowViewModel">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            <ui:MoreMenuButton Grid.Column="1" Subject="{Binding Name}" DeactivateCommand="{Binding RemoveCommand}" DeleteCommand="{Binding DeleteCommand}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ItemsControl x:Name="FormerEquipmentList" ItemsSource="{Binding FormerEquipment}" IsVisible="{Binding ShowFormerEquipment}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="4" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:FormerRowViewModel">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" AutomationProperties.Name="{Binding RowName}">
            <TextBlock Text="{Binding Name}" Classes="muted" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
            <Border Grid.Column="1" Classes="tag" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
              <TextBlock Text="Nicht mehr verwendet" />
            </Border>
            <ui:MoreMenuButton Grid.Column="2" Subject="{Binding Name}" DeactivateText="Wieder verwenden" DeactivateCommand="{Binding ReactivateCommand}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <CheckBox x:Name="ShowFormerEquipmentBox" Content="Nicht mehr verwendete zeigen" IsChecked="{Binding ShowFormerEquipment}" IsVisible="{Binding CanShowFormer}" />
    <ui:InfoBar Severity="Success" Message="{Binding EquipmentNotice}" IsVisible="{Binding HasEquipmentNotice}" CloseCommand="{Binding CloseEquipmentNoticeCommand}" />
    <ui:InfoBar Severity="Error" Message="{Binding EquipmentMessage}" IsVisible="{Binding HasEquipmentMessage}" />
  </StackPanel>
</UserControl>
