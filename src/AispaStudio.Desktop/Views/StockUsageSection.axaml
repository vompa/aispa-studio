<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.StockUsageSection"
             x:DataType="vm:StockUsageViewModel">
  <!--
    Verbrauch (R05 Slice 116, Ä271; Überarbeitung P6): je Material Soll (laut Rezept gebuchter Verbrauch), Ist (Soll plus Abweichung aus den Inventuren), Abweichung in Menge und Prozent und der Mehrverbrauch
    als Wert der Abweichung. Höchstens 900 breit; als Standard nur Abweichungen, nach Wert sortiert (die API sortiert); die Behandlungen je Material klappen auf. Die Summe steht nur in der Kachel der Übersicht.
    Alle Zahlen stammen aus der API; den Wert in Euro gibt es nur mit dem Recht „Berichte mit Beträgen“.
  -->
  <Border x:Name="UsageCard" Classes="card" MaxWidth="900" HorizontalAlignment="Left">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="Verbrauch" Classes="h2" VerticalAlignment="Center" />
        <ui:HelpButton Grid.Column="1" Topic="lager" Section="verbrauch" />
      </Grid>
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Soll ist der Verbrauch laut Rezept der gebuchten Behandlungen. Ist ist das Soll plus die Abweichung, die die Inventuren gezeigt haben, in Menge und in Prozent vom Soll. Der Mehrverbrauch ist ihr Wert zum Einstandspreis." />
      <StackPanel Orientation="Horizontal" Spacing="24">
        <ui:FormField Label="Zeitraum">
          <ComboBox x:Name="UsagePeriodField" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" MinWidth="200" />
        </ui:FormField>
        <ToggleSwitch x:Name="OnlyDeviationsField" Content="Nur Abweichungen" IsChecked="{Binding OnlyDeviations}" VerticalAlignment="Bottom" />
      </StackPanel>
      <ui:InfoBar Severity="Error" Title="Verbrauch nicht geladen" Message="{Binding LoadError}" IsVisible="{Binding HasLoadError}" ActionText="Erneut laden" ActionCommand="{Binding LoadCommand}" />
      <TextBlock Text="Im Zeitraum gibt es keinen Verbrauch zu zeigen." Classes="muted" IsVisible="{Binding ShowEmpty}" />
      <TextBlock Text="Im Zeitraum gibt es keine Abweichung." Classes="muted" IsVisible="{Binding ShowNoDeviation}" />
      <TextBlock Text="Den Wert in Euro zeigt der Bericht nur mit dem Recht „Berichte mit Beträgen“." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding AmountsHidden}" />

      <StackPanel Spacing="0" IsVisible="{Binding HasRows}">
        <Grid ColumnDefinitions="*,90,90,150,130" AutomationProperties.AccessibilityView="Raw" Margin="0,0,0,6">
          <TextBlock Text="Material" Classes="group" />
          <TextBlock Grid.Column="1" Text="Soll" Classes="group" TextAlignment="Right" />
          <TextBlock Grid.Column="2" Text="Ist" Classes="group" TextAlignment="Right" />
          <TextBlock Grid.Column="3" Text="Abweichung" Classes="group" TextAlignment="Right" />
          <TextBlock Grid.Column="4" Text="Mehrverbrauch" Classes="group" TextAlignment="Right" IsVisible="{Binding !AmountsHidden}" />
        </Grid>
        <ItemsControl x:Name="UsageList" ItemsSource="{Binding Rows}" AutomationProperties.Name="Verbrauch je Material">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:UsageRow">
              <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,2">
                <StackPanel Spacing="2">
                  <Grid ColumnDefinitions="*,90,90,150,130" AutomationProperties.Name="{Binding Summary}">
                    <Button x:Name="UsageDetailsButton" Classes="ghost" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Padding="4,6" MinHeight="32"
                            Command="{Binding ToggleCommand}" IsVisible="{Binding HasTreatments}" AutomationProperties.Name="{Binding ToggleName}" ToolTip.Tip="{Binding ToggleTip}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Glyph}" Classes="muted" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Material}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Material}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="26,0,0,0" IsVisible="{Binding !HasTreatments}" />
                    <TextBlock Grid.Column="1" Text="{Binding PlannedText}" Classes="num" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding ActualText}" Classes="num" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding DeviationText}" Classes="num" Classes.warn="{Binding IsLoss}" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding ValueText}" Classes="num" Classes.crit="{Binding ValueIsNegative}" TextAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Treatments}" Margin="26,0,0,4" IsVisible="{Binding IsExpanded}" AutomationProperties.Name="{Binding Material, StringFormat='Behandlungen mit {0}'}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:UsageTreatmentRow">
                        <Grid ColumnDefinitions="*,90,90,150,130" AutomationProperties.Name="{Binding Summary}" MinHeight="24">
                          <TextBlock Text="{Binding Name}" Classes="muted small" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding PlannedText}" Classes="muted small num" TextAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding AppointmentsText}" Classes="muted small" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding HasHidden}">
        <TextBlock Text="{Binding HiddenText}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Classes="link" Content="Alle zeigen" Command="{Binding ShowAllCommand}" AutomationProperties.Name="Alle zeigen" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
