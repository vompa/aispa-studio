<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.TeamView"
             x:DataType="vm:TeamViewModel"
             ui:SaveShortcut.IsScope="True">
  <!--
    Team (R05 Slice 98, P5): links „Person hinzufügen“ und „Person einladen“ fest über der Liste, Suche, Standorte, alle Personen mit Rolle und einem Kennzeichen bei Abweichung, „Ausgeschiedene zeigen“, rechts die
    Personenkarte (PersonCardView). Leiste „Speichern / Verwerfen“ fest im Fuß für die ganze Karte, Strg+S speichert (SaveShortcut).
  -->
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Spacing="8" Margin="0,0,16,0">
      <ui:InfoBar Severity="Error" Title="Team nicht geladen" Message="{Binding LoadError}" IsVisible="{Binding HasLoadError}"
                  ActionText="Erneut laden" ActionCommand="{Binding LoadCommand}" />
      <TextBlock Text="Lade Team …" Classes="muted" IsVisible="{Binding !IsLoaded}" />
    </StackPanel>

    <!-- Ansichten (Slice 99, ADR 0098): Personen, Wochenplan, Zeiten, Lohn, Rechte und Zuständigkeiten; die Leiste steht nur, wenn es mehr als eine gibt -->
    <Border Grid.Row="1" x:Name="TeamModes" Classes="segmented" HorizontalAlignment="Left" Margin="0,0,0,12" IsVisible="{Binding ShowsModesBar}"
            AutomationProperties.Name="Ansicht des Teams">
      <ItemsControl ItemsSource="{Binding Modes}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CardTab">
            <ui:TabButton Content="{Binding Label}" IsSelected="{Binding IsOn}" Command="{Binding SelectCommand}" Padding="10,3" MinWidth="0"
                          AutomationProperties.Name="{Binding Label}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <ScrollViewer Grid.Row="2" x:Name="RosterScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowsRosterView}">
      <ContentControl x:Name="PlanHost" Content="{Binding Plan}" Margin="0,0,16,16" />
    </ScrollViewer>

    <ScrollViewer Grid.Row="2" x:Name="TimesScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowsTimesView}">
      <ContentControl x:Name="TimesPlanHost" Content="{Binding Times}" Margin="0,0,16,16" />
    </ScrollViewer>

    <!--
      Seitenleiste „Anträge“ des Wochenplans (ADR 0098, Brief 5.12): liegt rechts über dem Wochenraster, denn das Raster braucht mit der Namensspalte 904 px und beim
      Mindestfenster stehen 964 zur Verfügung; daneben blieben 604.
    -->
    <ui:SidePanel Grid.Row="2" x:Name="RequestsPanel" Title="Anträge" HorizontalAlignment="Right"
                  DataContext="{Binding Plan}" x:DataType="vm:RosterPlanViewModel" IsOpen="{Binding IsRequestsOpen, Mode=TwoWay}">
      <ui:SidePanel.HeaderAction>
        <ui:HelpButton Topic="dienstplan-antrag-entscheiden" Margin="0,0,4,0" />
      </ui:SidePanel.HeaderAction>
      <ui:SidePanel.Body>
        <ScrollViewer Classes="panelbody" Padding="16,12,16,32" HorizontalScrollBarVisibility="Disabled">
          <ContentControl x:Name="RequestsHost" Content="{Binding Requests}" />
        </ScrollViewer>
      </ui:SidePanel.Body>
    </ui:SidePanel>

    <ScrollViewer Grid.Row="2" x:Name="PayrollScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowsPayrollView}">
      <ContentControl x:Name="PayrollViewHost" Content="{Binding Payroll}" Margin="0,0,16,16" />
    </ScrollViewer>

    <!-- Rechte und Zuständigkeiten (ADR 0098): „Wer darf was?“ und „Zuständigkeiten“ als Abschnitte untereinander, jeder nur mit seinem Recht -->
    <ScrollViewer Grid.Row="2" x:Name="RightsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowsRightsView}">
      <Grid Margin="0,0,16,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="980" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="20">
          <StackPanel x:Name="PowersSection" Spacing="8" IsVisible="{Binding ShowsPowersSection}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="4">
              <TextBlock Text="Wer darf was, wer ist zuständig?" Classes="h3" VerticalAlignment="Center" />
              <ui:HelpButton Topic="regelungen-vollmachten" Section="wer-darf-was" Grid.Column="1" />
              <ComboBox Grid.Column="3" x:Name="RightsLocationBox" ItemsSource="{Binding Powers?.Locations}" SelectedItem="{Binding Powers?.SelectedLocation}" MinWidth="180"
                        IsVisible="{Binding ShowsRightsLocations}" AutomationProperties.Name="Standort der Tabelle">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:RightsLocation">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <ContentControl x:Name="PowersHost" Content="{Binding Powers}" />
          </StackPanel>
          <StackPanel x:Name="DutiesSection" Spacing="8" IsVisible="{Binding ShowsDutiesSection}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Zertifikate und Liste der Zuständigkeiten" Classes="h3" VerticalAlignment="Center" />
              <ui:HelpButton Topic="zustaendigkeiten-zertifikate" Section="liste" Grid.Column="1" />
            </Grid>
            <ContentControl x:Name="DutiesOverviewHost" Content="{Binding Duties}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Grid Grid.Row="2" ColumnDefinitions="270,*" IsVisible="{Binding ShowsPeopleView}">
      <!-- Liste (ADR 0099 Regel 1, ADR 0098 Nachtrag P5): „Person hinzufügen“ fest über der Liste, darunter Suche, Standorte als Chips und die Personen; ein Kennzeichen am Zeilenende nur bei einer Abweichung -->
      <Border Classes="card" Padding="8" Margin="0,0,16,0">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8">
          <Button x:Name="AddPersonButton" Classes="primary" Command="{Binding AddPersonCommand}" IsVisible="{Binding CanAddPerson}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" AutomationProperties.Name="Person hinzufügen">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Icon Data="{x:Static ui:Icons.Plus}" Width="16" Height="16" />
              <TextBlock Text="Person hinzufügen" />
            </StackPanel>
          </Button>
          <Button Grid.Row="1" x:Name="NewAccessButton" Command="{Binding InviteCommand}" IsVisible="{Binding CanInvite}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="{Binding InviteLabel}" AutomationProperties.Name="{Binding InviteLabel}" />
          <ui:SearchField Grid.Row="2" x:Name="TeamSearch" Text="{Binding Search}" PlaceholderText="Name oder E-Mail" ShowAdd="False" AutomationProperties.Name="Team durchsuchen" />
          <ItemsControl Grid.Row="3" x:Name="LocationChips" ItemsSource="{Binding LocationChips}" IsVisible="{Binding ShowsLocationChips}" AutomationProperties.Name="Standort der Liste">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="6" LineSpacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CardTab">
                <ui:TabButton Classes="headchip" IsSelected="{Binding IsOn}" Content="{Binding Label}" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Label}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ListBox Grid.Row="4" x:Name="TeamList" Classes="plain" ItemsSource="{Binding Entries}" SelectedItem="{Binding ListSelection}" AutomationProperties.Name="Team">
            <ListBox.Styles>
              <!-- Der Name der Zeile ist Name, Rolle und Kennzeichen; sonst liest der Screenreader den Record-Typ -->
              <Style Selector="ListBoxItem" x:DataType="vm:TeamEntry">
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TeamEntry">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                    <TextBlock Text="{Binding Role}" Classes="muted small" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasRole}" />
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasFlags}">
                      <ui:Icon Data="{x:Static ui:Icons.Warning}" Width="12" Height="12" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" IsVisible="{Binding HasFlagWarning}" />
                      <TextBlock Text="{Binding FlagText}" Classes="muted small" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FlagText}" />
                    </StackPanel>
                  </StackPanel>
                  <Border Grid.Column="1" Classes="pill crit" IsVisible="{Binding BadgeIsCritical}" VerticalAlignment="Top"><TextBlock Text="{Binding Badge}" /></Border>
                  <Border Grid.Column="1" Classes="pill warn" IsVisible="{Binding BadgeIsWarning}" VerticalAlignment="Top"><TextBlock Text="{Binding Badge}" /></Border>
                  <Border Grid.Column="1" Classes="pill" IsVisible="{Binding BadgeIsNeutral}" VerticalAlignment="Top"><TextBlock Text="{Binding Badge}" /></Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="4" x:Name="TeamEmpty" Text="Niemand gefunden. Mit „Person hinzufügen“ legst du die erste Person an." Classes="muted" TextWrapping="Wrap" Margin="8,4"
                     IsVisible="{Binding HasNoEntries}" />
          <StackPanel Grid.Row="5">
            <CheckBox x:Name="OnlyWithoutAccessBox" Content="Nur ohne Zugang" IsChecked="{Binding OnlyWithoutAccess}" IsVisible="{Binding CanFilterWithoutAccess}" />
            <CheckBox x:Name="ShowFormerBox" Content="Ausgeschiedene zeigen" IsChecked="{Binding ShowFormer}" IsVisible="{Binding CanShowFormer}" />
          </StackPanel>
        </Grid>
      </Border>

      <ContentControl Grid.Column="1" x:Name="CardHost" Content="{Binding Card}" />
      <TextBlock Grid.Column="1" Text="Keine Person gewählt." Classes="muted" VerticalAlignment="Top" IsVisible="{Binding Card, Converter={x:Static ObjectConverters.IsNull}}" />

      <!-- Verlauf der Person als Seitenleiste (ADR 0098, Brief 5.12): liegt rechts über der Karte, denn beim Mindestfenster bliebe neben Liste und Leiste zu wenig für das Profil -->
      <ui:HistoryPanel Grid.Column="1" x:Name="CardHistory" HorizontalAlignment="Right" DataContext="{Binding Card}" x:DataType="vm:PersonCardViewModel"
                       Sections="{Binding HistorySections}" Subtitle="{Binding Title}" IsOpen="{Binding IsHistoryOpen, Mode=TwoWay}" />
    </Grid>

    <StackPanel x:Name="Footer" Grid.Row="3" Spacing="12" MaxWidth="760" HorizontalAlignment="Left" Margin="270,12,16,0" IsVisible="{Binding ShowsPeopleView}">
      <ui:InfoBar Severity="Warning" Message="{Binding Notice}" IsVisible="{Binding HasNotice}" CloseCommand="{Binding CloseNoticeCommand}" />
      <ui:InfoBar Severity="Error" Title="Nicht gespeichert" Message="{Binding Error}" IsVisible="{Binding HasError}"
                  ActionText="Erneut versuchen" ActionCommand="{Binding SaveCommand}" CloseCommand="{Binding CloseErrorCommand}" />
      <Grid ColumnDefinitions="*" IsVisible="{Binding HasSaveBar}">
        <ui:SaveBar SaveCommand="{Binding SaveCommand}" DiscardCommand="{Binding DiscardChangesCommand}" CanDiscard="{Binding HasUnsavedChanges}" />
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
