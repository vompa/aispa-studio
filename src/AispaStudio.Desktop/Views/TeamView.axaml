<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.TeamView"
             x:DataType="vm:TeamViewModel"
             ui:SaveShortcut.IsScope="True">
  <!--
    Team (R05 Slice 98): links alle Personen mit Suche, Rolle und Status, „Ausgeschiedene zeigen“ und „Person anlegen“ bzw. „Person einladen“, rechts die
    Personenkarte (PersonCardView). Leiste „Speichern / Verwerfen“ fest im Fuß für die ganze Karte, Strg+S speichert (SaveShortcut).
  -->
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Spacing="8" Margin="0,0,16,0">
      <ui:InfoBar Severity="Error" Title="Team nicht geladen" Message="{Binding LoadError}" IsVisible="{Binding HasLoadError}"
                  ActionText="Erneut laden" ActionCommand="{Binding LoadCommand}" />
      <TextBlock Text="Lade Team …" Classes="muted" IsVisible="{Binding !IsLoaded}" />
    </StackPanel>

    <!-- Ansichten (Slice 99): Personen, Wochenplan, Zeiten, Anträge; die Leiste steht nur, wenn es mehr als eine gibt -->
    <Border Grid.Row="1" x:Name="TeamModes" Classes="segmented" HorizontalAlignment="Left" Margin="0,0,0,12" IsVisible="{Binding ShowsModesBar}"
            AutomationProperties.Name="Ansicht des Teams">
      <ItemsControl ItemsSource="{Binding Modes}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CardTab">
            <ui:TabButton Content="{Binding Label}" IsSelected="{Binding IsOn}" Command="{Binding SelectCommand}" Padding="10,3" MinWidth="0"
                          AutomationProperties.Name="{Binding Label}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <ScrollViewer Grid.Row="2" x:Name="RosterScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowsRosterView}">
      <ContentControl x:Name="PlanHost" Content="{Binding Plan}" Margin="0,0,16,16" />
    </ScrollViewer>

    <ScrollViewer Grid.Row="2" x:Name="TimesScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowsTimesView}">
      <ContentControl x:Name="TimesPlanHost" Content="{Binding Times}" Margin="0,0,16,16" />
    </ScrollViewer>

    <ScrollViewer Grid.Row="2" x:Name="RequestsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowsRequestsView}">
      <ContentControl x:Name="RequestsHost" Content="{Binding Requests}" Margin="0,0,16,16" />
    </ScrollViewer>

    <ScrollViewer Grid.Row="2" x:Name="PayrollScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowsPayrollView}">
      <ContentControl x:Name="PayrollViewHost" Content="{Binding Payroll}" Margin="0,0,16,16" />
    </ScrollViewer>

    <ScrollViewer Grid.Row="2" x:Name="PowersScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowsPowersView}">
      <ContentControl x:Name="PowersHost" Content="{Binding Powers}" Margin="0,0,16,16" />
    </ScrollViewer>

    <ScrollViewer Grid.Row="2" x:Name="DutiesScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowsDutiesView}">
      <ContentControl x:Name="DutiesOverviewHost" Content="{Binding Duties}" Margin="0,0,16,16" />
    </ScrollViewer>

    <Grid Grid.Row="2" ColumnDefinitions="260,*" IsVisible="{Binding ShowsPeopleView}">
      <Border Classes="card" Padding="8" Margin="0,0,16,0" VerticalAlignment="Top">
        <StackPanel Spacing="8">
          <ui:SearchField x:Name="TeamSearch" Text="{Binding Search}" PlaceholderText="Name oder E-Mail" ShowAdd="False" AutomationProperties.Name="Team durchsuchen" />
          <CheckBox x:Name="ShowFormerBox" Content="Ausgeschiedene zeigen" IsChecked="{Binding ShowFormer}" IsVisible="{Binding CanShowFormer}" />
          <ListBox x:Name="TeamList" Classes="plain" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" AutomationProperties.Name="Team">
            <ListBox.Styles>
              <!-- Der Name der Zeile ist Name und „Rolle · Status“; sonst liest der Screenreader den Record-Typ -->
              <Style Selector="ListBoxItem" x:DataType="vm:TeamEntry">
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TeamEntry">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                  <TextBlock Text="{Binding Subtitle}" Classes="muted small" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasSubtitle}" />
                  <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasFlags}">
                    <ui:Icon Data="{x:Static ui:Icons.Warning}" Width="12" Height="12" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" IsVisible="{Binding HasFlagWarning}" />
                    <TextBlock Text="{Binding FlagText}" Classes="muted small" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FlagText}" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <ContentControl Grid.Column="1" x:Name="CardHost" Content="{Binding Card}" />
    </Grid>

    <StackPanel x:Name="Footer" Grid.Row="3" Spacing="12" MaxWidth="760" HorizontalAlignment="Left" Margin="260,12,16,0" IsVisible="{Binding ShowsPeopleView}">
      <ui:InfoBar Severity="Warning" Message="{Binding Notice}" IsVisible="{Binding HasNotice}" CloseCommand="{Binding CloseNoticeCommand}" />
      <ui:InfoBar Severity="Error" Title="Nicht gespeichert" Message="{Binding Error}" IsVisible="{Binding HasError}"
                  ActionText="Erneut versuchen" ActionCommand="{Binding SaveCommand}" CloseCommand="{Binding CloseErrorCommand}" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding HasSaveBar}">
        <ui:SaveBar SaveCommand="{Binding SaveCommand}" DiscardCommand="{Binding DiscardChangesCommand}" CanDiscard="{Binding HasUnsavedChanges}"
                    Status="{Binding StatusText}" />
        <Button Grid.Column="1" x:Name="RemoveButton" Classes="ghost danger" Content="Aus dem Team nehmen" Command="{Binding RemoveCommand}"
                IsVisible="{Binding CanRemove}" ToolTip.Tip="Die Person wird nicht mehr eingeplant; sie steht danach unter „Ausgeschiedene“." />
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
