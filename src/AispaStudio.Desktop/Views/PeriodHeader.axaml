<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.PeriodHeader"
             x:DataType="vm:PeriodAreaViewModel">
  <!--
    Kopf der Abschnitte „Schließzeiten“ und „Raumsperren“ (R05 Slice 95; ADR 0098: beide stehen auf einer Seite): der Titel des Abschnitts mit dem Fragezeichen der Hilfe,
    darunter der Satz, was die Sperre bewirkt; rechts bei mehreren Standorten die Wahl des Standorts und „Neu“. „Beendete zeigen“ steht über der Liste (PeriodList).
  -->
  <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <TextBlock x:Name="SectionTitle" Text="{Binding Title}" Classes="h1" VerticalAlignment="Center" />
      <ui:HelpButton Topic="{Binding HelpTopic}" Section="{Binding HelpSection}" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock Grid.Row="1" Text="{Binding HintText}" Classes="muted" TextWrapping="Wrap" />
    <ui:FormField Grid.Column="1" Grid.RowSpan="2" Label="Standort" VerticalAlignment="Bottom" IsVisible="{Binding HasSeveralLocations}">
      <ComboBox x:Name="LocationField" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" MinWidth="200" />
    </ui:FormField>
    <Button Grid.Column="2" Grid.RowSpan="2" x:Name="NewButton" Classes="primary" Command="{Binding NewCommand}" VerticalAlignment="Bottom" AutomationProperties.Name="{Binding NewText}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ui:Icon Data="{x:Static ui:Icons.Plus}" Width="16" Height="16" />
        <TextBlock Text="{Binding NewText}" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
  </Grid>
</UserControl>
