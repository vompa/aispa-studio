<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.SubscriptionsView"
             x:DataType="vm:SubscriptionsViewModel"
             ui:SaveShortcut.IsScope="True">
  <!--
    Kalender-Abos (R05 Slice 95, ADR 0075), native Maske nach web/src/subscriptions/SubscriptionsPage.tsx: links die Abos mit Art, Stand des Abrufs und Geltung, rechts das Formular
    in Gruppen mit Überschrift und Fragezeichen am Titel (Brief 5.11): Abo, Gilt für, Zustand (mit „Jetzt abrufen“, „Datei importieren“ und „Im Kalender zeigen“) und bei Feiertags-Abos die
    Widersprüche zu den Feiertagsregeln. „Speichern / Verwerfen“ steht am Ende des Formulars (Strg+S), „Löschen“ daneben.
  -->
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
      <TextBlock Text="Feiertage, Schulferien und Hinweise aus öffentlichen Kalender-Adressen. Die Quelle bestätigt der Betrieb." Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
      <ui:HelpButton Grid.Column="1" Topic="kalender-abos" Section="kalender-abos" VerticalAlignment="Center" />
      <Button Grid.Column="2" x:Name="NewButton" Classes="primary" Command="{Binding NewCommand}" VerticalAlignment="Center" AutomationProperties.Name="Neues Abo">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ui:Icon Data="{x:Static ui:Icons.Plus}" Width="16" Height="16" />
          <TextBlock Text="Neues Abo" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <ui:InfoBar Grid.Row="1" Severity="{Binding MessageSeverity}" Message="{Binding Message}" IsVisible="{Binding HasMessage}" CloseCommand="{Binding CloseMessageCommand}" />

    <Grid Grid.Row="2" ColumnDefinitions="300,*">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
        <Border Classes="card" Padding="8" VerticalAlignment="Top">
          <StackPanel Spacing="8">
            <ui:InfoBar Severity="Error" Title="Die Kalender-Abos konnten nicht geladen werden." Message="{Binding LoadError}" IsVisible="{Binding HasLoadError}"
                        ActionText="Erneut laden" ActionCommand="{Binding LoadCommand}" />
            <TextBlock Text="Wird geladen …" Classes="muted" Margin="8,4" IsVisible="{Binding !IsLoaded}" />
            <TextBlock Text="Es gibt noch kein Kalender-Abo." Classes="muted" TextWrapping="Wrap" Margin="8,4" IsVisible="{Binding ShowEmpty}" />
            <ListBox x:Name="SubscriptionList" Classes="plain" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutomationProperties.Name="Kalender-Abos">
              <ListBox.Styles>
                <!-- Der Name der Zeile nennt Abo, Zustand, Art, Stand und Geltung; sonst liest der Screenreader den Typnamen -->
                <Style Selector="ListBoxItem" x:DataType="vm:SubscriptionRow">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SubscriptionRow">
                  <StackPanel Spacing="2" Margin="0,2">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Badges}" Classes="small error" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasBadges}" />
                    <TextBlock Text="{Binding Detail}" Classes="muted small" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Places}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
      </ScrollViewer>

      <ScrollViewer Grid.Column="1" x:Name="FormScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="800" HorizontalAlignment="Left" Margin="0,0,16,16">
          <Border Classes="card" Padding="16" IsVisible="{Binding ShowSelectHint}">
            <TextBlock Text="Links ein Abo wählen oder mit „Neues Abo“ eines anlegen." Classes="muted" TextWrapping="Wrap" />
          </Border>

          <StackPanel Spacing="20" IsVisible="{Binding HasForm}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="{Binding HeadingText}" Classes="h2" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Border Grid.Column="1" Classes="pill" IsVisible="{Binding IsPreset}">
                <TextBlock Text="Voreingestellt" />
              </Border>
            </Grid>

            <!-- Abo -->
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Abo" Classes="h2" VerticalAlignment="Center" />
                <ui:HelpButton Grid.Column="1" Topic="kalender-abos" Section="abo" />
              </Grid>
              <ui:FormField Label="Name" IsRequired="True" Error="{Binding NameError}" Help="So heißt das Abo in der Liste und im Kalender, z. B. „Feiertage Salzburg“.">
                <TextBox x:Name="NameField" Text="{Binding Name}" MaxLength="120" />
              </ui:FormField>
              <ui:FormField Label="Art" Help="{Binding KindEffect}">
                <ComboBox x:Name="KindField" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" IsEnabled="{Binding CanChooseKind}" MinWidth="280" HorizontalAlignment="Left" />
              </ui:FormField>
              <ui:FormField Label="Quelle wählen" Help="{Binding SourceHint}" IsVisible="{Binding HasSources}">
                <ComboBox x:Name="SourceField" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" MinWidth="280" HorizontalAlignment="Left" />
              </ui:FormField>
              <ui:FormField Label="Adresse" Error="{Binding UrlError}" Help="https:// oder webcal://, nur öffentliche Adressen ohne Zugangsdaten. Leer: nur Datei-Import.">
                <TextBox x:Name="UrlField" Text="{Binding Url}" MaxLength="500" PlaceholderText="z. B. https://example.org/feiertage.ics" />
              </ui:FormField>
            </StackPanel>

            <!-- Gilt für -->
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Gilt für" Classes="h2" VerticalAlignment="Center" />
                <ui:HelpButton Grid.Column="1" Topic="kalender-abos" Section="gilt-fuer" />
              </Grid>
              <ui:FormField Label="Standort" Help="Alle Standorte: das Abo gilt überall dort, wo die Region passt.">
                <ComboBox x:Name="LocationField" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" MinWidth="280" HorizontalAlignment="Left" />
              </ui:FormField>
              <ui:FormField Label="Region" Error="{Binding RegionError}" Help="Land (AT) oder Bundesland, Kanton (AT-9, CH-ZH). Leer: überall." HorizontalAlignment="Left">
                <AutoCompleteBox x:Name="RegionField" Text="{Binding Region, Mode=TwoWay}" ItemsSource="{Binding RegionSuggestions}" ValueMemberBinding="{Binding Code, DataType=vm:RegionSuggestion}"
                                 MinimumPrefixLength="0" MaxLength="10" PlaceholderText="z. B. AT-5" Width="160" HorizontalAlignment="Left">
                  <AutoCompleteBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:RegionSuggestion">
                      <TextBlock Text="{Binding}" />
                    </DataTemplate>
                  </AutoCompleteBox.ItemTemplate>
                </AutoCompleteBox>
              </ui:FormField>
            </StackPanel>

            <!-- Zustand -->
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Zustand" Classes="h2" VerticalAlignment="Center" />
                <ui:HelpButton Grid.Column="1" Topic="kalender-abos" Section="zustand" />
              </Grid>
              <CheckBox x:Name="ActiveCheck" IsChecked="{Binding IsActive}" Content="Aktiv" />
              <TextBlock Text="Aus: kein Abruf und keine Anzeige (Kalender, Assistent), für alle. Im Kalender ausblenden kann jede Person für sich." Classes="muted small" TextWrapping="Wrap" />
              <StackPanel Spacing="8" IsVisible="{Binding IsExisting}">
                <TextBlock x:Name="StatusLineText" Text="{Binding StatusLine}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding LastErrorText}" Classes="small error" TextWrapping="Wrap" IsVisible="{Binding HasLastError}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="FetchButton" Content="Jetzt abrufen" Command="{Binding FetchNowCommand}" />
                  <Button x:Name="ImportButton" Content="Datei importieren" Command="{Binding ImportCommand}" />
                </StackPanel>
                <TextBlock Text="Datei: ICS oder CSV mit „Datum;Titel“ bzw. „Von;Bis;Titel“, höchstens 2 MB. Sie gilt für das laufende Jahr und die zwei folgenden." Classes="muted small" TextWrapping="Wrap" />
                <CheckBox x:Name="ShowCheck" Content="Im Kalender zeigen (nur für mich)" IsChecked="{Binding ShowInCalendar, Mode=OneWay}" Command="{Binding ToggleShowCommand}" />
              </StackPanel>
            </StackPanel>

            <!-- Widersprüche -->
            <StackPanel Spacing="8" IsVisible="{Binding HasConflicts}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Widersprüche" Classes="h2" VerticalAlignment="Center" />
                <ui:HelpButton Grid.Column="1" Topic="kalender-abos" Section="widersprueche" />
              </Grid>
              <TextBlock Text="{Binding ConflictsHint}" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              <ItemsControl x:Name="ConflictList" ItemsSource="{Binding Conflicts}" AutomationProperties.Name="Widersprüche zu den Feiertagsregeln">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConflictRowViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4" AutomationProperties.Name="{Binding GroupName}">
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding Date}" Classes="num" />
                          <TextBlock Text="{Binding Title}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" Classes="muted small" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <CheckBox Content="Übernehmen" IsChecked="{Binding IsAccepted, Mode=OneWay}" Command="{Binding AcceptCommand}" AutomationProperties.Name="{Binding AcceptName}" />
                        <CheckBox Content="Ignorieren" IsChecked="{Binding IsIgnored, Mode=OneWay}" Command="{Binding IgnoreCommand}" AutomationProperties.Name="{Binding IgnoreName}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel x:Name="Footer" Spacing="12">
              <ui:InfoBar Severity="Error" Title="Nicht gespeichert" Message="{Binding Error}" IsVisible="{Binding HasError}"
                          ActionText="Erneut versuchen" ActionCommand="{Binding SaveCommand}" CloseCommand="{Binding CloseErrorCommand}" />
              <StackPanel Orientation="Horizontal" Spacing="24">
                <ui:SaveBar SaveCommand="{Binding SaveCommand}" DiscardCommand="{Binding DiscardCommand}" CanDiscard="{Binding HasUnsavedChanges}" Status="{Binding StatusText}" />
                <Button x:Name="DeleteButton" Classes="danger" Content="Löschen" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
