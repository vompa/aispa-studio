<views:FocusRequestView xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:vm="using:AispaStudio.Desktop.ViewModels"
                        xmlns:ui="using:AispaStudio.Desktop.Controls"
                        xmlns:views="using:AispaStudio.Desktop.Views"
                        x:Class="AispaStudio.Desktop.Views.PromotionsView"
                        x:DataType="vm:PromotionsViewModel"
                        ui:SaveShortcut.IsScope="True">
  <!--
    Aktionen (R05 Slice 101, ADR 0071), native Maske nach web/src/promotions/PromotionsPage.tsx: links die Liste mit dem Zustand jeder Aktion (Läuft, Geplant, Pausiert, Abgelaufen;
    archivierte auf Wunsch) und „Neue Aktion“, rechts das Formular in Gruppen mit Überschrift und Fragezeichen am Titel (Brief 5.11). Pausieren, Archivieren und Zurückholen sind
    umkehrbar und fragen nicht. „Speichern / Verwerfen“ steht am Ende des Formulars (Strg+S).
  -->
  <Grid ColumnDefinitions="300,*">
    <Border Classes="card" Padding="8" Margin="0,0,16,0" VerticalAlignment="Top">
      <StackPanel Spacing="8">
        <Button x:Name="NewPromotionButton" Content="Neue Aktion" Command="{Binding NewCommand}" HorizontalAlignment="Stretch" />
        <CheckBox x:Name="ShowArchivedBox" IsChecked="{Binding ShowArchived}" Content="Archivierte anzeigen" Margin="4,0" />
        <ui:InfoBar Severity="Error" Title="Aktionen nicht geladen" Message="{Binding LoadError}" IsVisible="{Binding HasLoadError}"
                    ActionText="Erneut laden" ActionCommand="{Binding LoadCommand}" />
        <TextBlock Text="Wird geladen …" Classes="muted" Margin="8,4" IsVisible="{Binding !IsLoaded}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Margin="8,4" IsVisible="{Binding ShowEmpty}" Text="Noch keine Aktion angelegt." />
        <ListBox x:Name="PromotionList" Classes="plain" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutomationProperties.Name="Aktionen">
          <ListBox.Styles>
            <!-- Der Name der Zeile nennt Zustand, Rabatt, Zeitraum und Standorte; sonst liest der Screenreader den Record-Typ -->
            <Style Selector="ListBoxItem" x:DataType="vm:PromotionRow">
              <Setter Property="AutomationProperties.Name" Value="{Binding SpokenName}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PromotionRow">
              <StackPanel Spacing="4" Margin="0,4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="pill">
                    <TextBlock Text="{Binding PhaseText}" />
                  </Border>
                </Grid>
                <TextBlock Text="{Binding Detail}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding PlacesText}" Classes="muted small" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1" x:Name="FormScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,16,16" IsVisible="{Binding IsLoaded}">
        <ui:InfoBar Severity="Success" Message="{Binding Message}" IsVisible="{Binding HasMessage}" CloseCommand="{Binding CloseMessageCommand}" />

        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding HeadingText}" Classes="h2" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Border Classes="pill" IsVisible="{Binding HasPhase}" VerticalAlignment="Center">
              <TextBlock Text="{Binding PhaseText}" />
            </Border>
          </StackPanel>
          <Button Grid.Column="1" x:Name="PauseButton" Content="{Binding PauseText}" Command="{Binding TogglePauseCommand}" IsVisible="{Binding CanPause}" />
          <Button Grid.Column="2" x:Name="ArchiveButton" Content="Archivieren" Command="{Binding ArchiveCommand}" IsVisible="{Binding CanArchive}" />
          <Button Grid.Column="3" x:Name="UnarchiveButton" Content="Zurückholen" Command="{Binding UnarchiveCommand}" IsVisible="{Binding CanUnarchive}" />
          <ui:HelpButton Grid.Column="4" Topic="aktionen" Section="aktionen" />
        </Grid>
        <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Die Kassa schlägt eine laufende Aktion vor; den Rabatt setzt sie erst auf Klick." />
        <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsArchived}"
                   Text="Diese Aktion ist archiviert und läuft nicht mehr. Mit „Zurückholen“ lässt sie sich wieder bearbeiten." />

        <StackPanel Spacing="20" IsEnabled="{Binding IsEditable}">
          <!-- Aktion -->
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Aktion" Classes="h2" VerticalAlignment="Center" />
              <ui:HelpButton Grid.Column="1" Topic="aktionen" Section="aktion" />
            </Grid>
            <ui:FormField Label="Name" IsRequired="True" Error="{Binding NameError}" Help="Steht auf dem Beleg, z. B. „Herbst“.">
              <TextBox x:Name="PromotionNameField" Text="{Binding PromotionName}" MaxLength="40" />
            </ui:FormField>
            <ui:FormField Label="Gästetext" IsRequired="True" Error="{Binding GuestTextError}" Help="Kurz, für Gäste und den Assistenten, z. B. „10 % auf alle Massagen im Oktober“.">
              <TextBox x:Name="PromotionGuestTextField" Text="{Binding GuestText}" MaxLength="200" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
            </ui:FormField>
          </StackPanel>

          <!-- Rabatt -->
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Rabatt" Classes="h2" VerticalAlignment="Center" />
              <ui:HelpButton Grid.Column="1" Topic="aktionen" Section="rabatt" />
            </Grid>
            <StackPanel Spacing="4" AutomationProperties.Name="Art des Rabatts">
              <RadioButton x:Name="PercentOption" GroupName="PromotionKind" IsChecked="{Binding IsPercent}" Content="Prozent" />
              <RadioButton x:Name="AmountOption" GroupName="PromotionKind" IsChecked="{Binding IsAmount}" Content="Betrag" />
            </StackPanel>
            <ui:FormField Label="{Binding ValueLabel}" IsRequired="True" Error="{Binding ValueError}" Help="{Binding ValueHint}" HorizontalAlignment="Left">
              <TextBox x:Name="PromotionValueField" Text="{Binding DiscountValue}" Classes="num" Width="160" PlaceholderText="{Binding ValuePlaceholder}" />
            </ui:FormField>
          </StackPanel>

          <!-- Zeitraum -->
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Zeitraum" Classes="h2" VerticalAlignment="Center" />
              <ui:HelpButton Grid.Column="1" Topic="aktionen" Section="zeitraum" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <ui:FormField Label="Von" IsRequired="True" Error="{Binding FromError}">
                <ui:DateField x:Name="PromotionFromField" Value="{Binding ValidFrom}" />
              </ui:FormField>
              <ui:FormField Label="Bis" IsRequired="True" Error="{Binding UntilError}">
                <ui:DateField x:Name="PromotionUntilField" Value="{Binding ValidUntil}" />
              </ui:FormField>
            </StackPanel>
            <CheckBox x:Name="ActiveBox" IsChecked="{Binding IsActive}" Content="Aktiv" />
            <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Eine pausierte Aktion wird an der Kassa nicht vorgeschlagen." />
          </StackPanel>

          <!-- Gilt für -->
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Gilt für" Classes="h2" VerticalAlignment="Center" />
              <ui:HelpButton Grid.Column="1" Topic="aktionen" Section="gilt-fuer" />
            </Grid>
            <StackPanel Spacing="4" AutomationProperties.Name="Wofür die Aktion gilt">
              <RadioButton x:Name="ScopeAllOption" GroupName="PromotionScope" IsChecked="{Binding ScopeAll}" Content="Alle Behandlungen" />
              <RadioButton x:Name="ScopeTreatmentsOption" GroupName="PromotionScope" IsChecked="{Binding ScopeTreatments}" Content="Ausgewählte Behandlungen" />
              <RadioButton x:Name="ScopePackagesOption" GroupName="PromotionScope" IsChecked="{Binding ScopePackages}" Content="Pakete ausgewählter Behandlungen" />
            </StackPanel>
            <ui:FormField Label="Behandlung hinzufügen" Error="{Binding TreatmentsError}" Help="{Binding TreatmentHint}" IsVisible="{Binding ShowTreatmentPicker}">
              <ComboBox x:Name="TreatmentPickerField" ItemsSource="{Binding CatalogTreatments}" SelectedItem="{Binding PickedTreatment}" HorizontalAlignment="Stretch" />
            </ui:FormField>
            <ItemsControl x:Name="ChosenList" ItemsSource="{Binding Chosen}" IsVisible="{Binding HasChosen}" AutomationProperties.Name="Gewählte Behandlungen">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChosenTreatment">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Classes="small" Content="Entfernen" Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding RemoveName}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Standorte -->
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Standorte" Classes="h2" VerticalAlignment="Center" />
              <ui:HelpButton Grid.Column="1" Topic="aktionen" Section="standorte" />
            </Grid>
            <StackPanel Spacing="4" AutomationProperties.Name="Wo die Aktion gilt">
              <RadioButton x:Name="AllLocationsOption" GroupName="PromotionPlaces" IsChecked="{Binding AllLocations}" Content="Alle Standorte" />
              <RadioButton x:Name="SomeLocationsOption" GroupName="PromotionPlaces" IsChecked="{Binding SomeLocations}" Content="Ausgewählte Standorte" />
            </StackPanel>
            <ItemsControl x:Name="LocationList" ItemsSource="{Binding Locations}" IsVisible="{Binding ShowLocationList}" AutomationProperties.Name="Standorte" Margin="24,0,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PromotionLocationChoice">
                  <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding LocationsError}" Classes="small error" TextWrapping="Wrap" IsVisible="{Binding HasLocationsError}" />
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="Footer" Spacing="12">
          <ui:InfoBar Severity="Error" Title="Nicht gespeichert" Message="{Binding Error}" IsVisible="{Binding HasError}"
                      ActionText="Erneut versuchen" ActionCommand="{Binding SaveCommand}" CloseCommand="{Binding CloseErrorCommand}" />
          <ui:SaveBar SaveCommand="{Binding SaveCommand}" DiscardCommand="{Binding DiscardCommand}" CanDiscard="{Binding HasUnsavedChanges}" Status="{Binding StatusText}"
                      IsVisible="{Binding IsEditable}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</views:FocusRequestView>
