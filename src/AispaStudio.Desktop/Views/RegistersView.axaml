<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             xmlns:views="using:AispaStudio.Desktop.Views"
             x:Class="AispaStudio.Desktop.Views.RegistersView"
             x:DataType="vm:RegistersViewModel">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
      <TextBlock Text="Kassen" Classes="h2" VerticalAlignment="Center" />
      <ui:HelpButton Grid.Column="1" Topic="kassa-einrichten" />
      <Button Grid.Column="2" Classes="icon" Command="{Binding LoadCommand}"
              ToolTip.Tip="Aktualisieren" AutomationProperties.Name="Kassen aktualisieren">
        <ui:Icon Data="{x:Static ui:Icons.Refresh}" />
      </Button>
      <Button Grid.Column="3" x:Name="CreateRegisterButton" Classes="primary"
              Content="Kassa anlegen" Command="{Binding StartRegisterWizardCommand}" />
    </Grid>

    <StackPanel Grid.Row="1" Spacing="8">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" AutomationProperties.Name="Kassen werden geladen" />
      <ui:InfoBar Severity="Error" Title="{Binding LoadStatusTitle}"
                  Message="{Binding LoadError}" IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ActionText="Erneut laden" ActionCommand="{Binding LoadCommand}" />
      <ui:InfoBar Severity="Error" Message="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Text="Es ist noch keine Kassa eingerichtet." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding ShowEmpty}" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="240,*" ColumnSpacing="16" IsVisible="{Binding HasSelection}">
      <Border Classes="card" Padding="8">
        <ListBox x:Name="RegisterList" Classes="plain" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                 AutomationProperties.Name="Kassen" SelectionMode="AlwaysSelected"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.Styles>
            <Style Selector="ListBoxItem" x:DataType="vm:RegisterRow">
              <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RegisterRow">
              <StackPanel Spacing="4" Margin="0,4">
                <TextBlock Text="{Binding Code}" Classes="listname" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Place}" Classes="muted small" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding Status}" Classes="secondary small" />
                  <Border Classes="pill warn" IsVisible="{Binding IsPractice}" AutomationProperties.AccessibilityView="Raw">
                    <TextBlock Text="Übungskassa" />
                  </Border>
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="0,0,8,16">
          <Border Classes="card" Padding="16">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding SelectedRow.Code}" Classes="h2" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedRow.Place}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedRow.Status}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding SelectedRow.Reasons}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ui:InfoBar Severity="Warning" Title="Übungskassa" Message="Diese Kassa erstellt nur Übungsbelege."
                          IsVisible="{Binding SelectedRow.IsPractice}" />
              <Button x:Name="DecommissionRegisterButton" Content="Außer Betrieb nehmen" Classes="danger secondary"
                      Command="{Binding DecommissionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <views:RegisterFiscalView DataContext="{Binding Fiscal}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
