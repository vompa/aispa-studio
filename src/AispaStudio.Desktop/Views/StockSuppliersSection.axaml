<views:FocusRequestView xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:vm="using:AispaStudio.Desktop.ViewModels"
                         xmlns:ui="using:AispaStudio.Desktop.Controls"
                         xmlns:views="using:AispaStudio.Desktop.Views"
                         x:Class="AispaStudio.Desktop.Views.StockSuppliersSection"
                         x:DataType="vm:StockSuppliersViewModel">
  <!--
    Lieferanten (R05 Slice 112): links die Liste mit „Neuer Lieferant“, rechts das Formular mit Kontakt, Lieferzeit, Mindestbestellwert und Bestellweg. Löschen gibt es nicht, nur Deaktivieren.
    „Speichern / Verwerfen“ steht am Ende des Formulars (Strg+S).
  -->
  <Grid ColumnDefinitions="300,*">
    <Border Classes="card" Padding="8" Margin="0,0,16,0" VerticalAlignment="Top">
      <ListBox x:Name="SupplierList" Classes="plain" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutomationProperties.Name="Lieferanten">
        <ListBox.Styles>
          <!-- Der Name der Zeile nennt Lieferant und Angaben; sonst liest der Screenreader den Record-Typ -->
          <Style Selector="ListBoxItem" x:DataType="vm:StockSupplierRow">
            <Setter Property="AutomationProperties.Name" Value="{Binding Summary}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:StockSupplierRow">
            <StackPanel Spacing="2" Margin="0,2">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Sub}" Classes="muted small" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Border Grid.Column="1" Classes="card">
      <StackPanel Spacing="16" MaxWidth="720">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding HeadingText}" Classes="h2" VerticalAlignment="Center" TextWrapping="Wrap" />
          <ui:HelpButton Grid.Column="1" Topic="lager-lieferanten" />
        </Grid>

        <StackPanel Spacing="12">
          <ui:FormField Label="Name" IsRequired="True" Error="{Binding NameError}">
            <TextBox x:Name="SupplierNameField" Text="{Binding SupplierName}" MaxLength="200" />
          </ui:FormField>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <ui:FormField Label="Ansprechperson">
              <TextBox x:Name="SupplierContactField" Text="{Binding ContactPerson}" MaxLength="200" />
            </ui:FormField>
            <ui:FormField Grid.Column="1" Label="Telefon">
              <TextBox x:Name="SupplierPhoneField" Text="{Binding Phone}" MaxLength="40" />
            </ui:FormField>
          </Grid>
          <ui:FormField Label="Mail für Bestellungen" Error="{Binding EmailError}">
            <TextBox x:Name="SupplierEmailField" Text="{Binding Email}" MaxLength="254" />
          </ui:FormField>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <ui:FormField Label="Lieferzeit in Tagen" Error="{Binding LeadTimeError}">
              <TextBox x:Name="SupplierLeadTimeField" Text="{Binding LeadTimeDays}" Classes="num" />
            </ui:FormField>
            <ui:FormField Grid.Column="1" Label="Mindestbestellwert netto" Help="In Euro, ohne Umsatzsteuer." Error="{Binding MinimumOrderError}">
              <TextBox x:Name="SupplierMinimumOrderField" Text="{Binding MinimumOrderValue}" Classes="num" />
            </ui:FormField>
            <ui:FormField Grid.Column="2" Label="Bestellweg">
              <ComboBox x:Name="SupplierChannelField" ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding SelectedChannel}" HorizontalAlignment="Stretch" />
            </ui:FormField>
          </Grid>
          <CheckBox x:Name="SupplierActiveBox" IsChecked="{Binding IsActive}" Content="Aktiv" />
        </StackPanel>

        <StackPanel x:Name="Footer" Spacing="12">
          <ui:InfoBar Severity="Error" Title="Nicht gespeichert" Message="{Binding Error}" IsVisible="{Binding HasError}" CloseCommand="{Binding CloseErrorCommand}" />
          <ui:SaveBar SaveCommand="{Binding SaveCommand}" DiscardCommand="{Binding DiscardCommand}" CanDiscard="{Binding HasUnsavedChanges}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</views:FocusRequestView>
