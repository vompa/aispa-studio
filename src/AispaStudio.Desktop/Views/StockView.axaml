<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             xmlns:views="using:AispaStudio.Desktop.Views"
             x:Class="AispaStudio.Desktop.Views.StockView"
             x:DataType="vm:StockViewModel"
             ui:SaveShortcut.IsScope="True">
  <!--
    Lager (R05 Slice 101, ADR 0084; Aufbau nach ADR 0098, masken.md R15): eine Schiene mit vier Reitern, Übersicht, Bestand, Bestellen (mit dem Recht zu buchen oder für den Standort) und
    Inventur (Recht für den Standort). Rechts daneben die Werkzeuge: „Material suchen oder scannen“, Standort, Export, „Einrichtung“, das Fragezeichen und „Bewegung buchen“; reicht die Breite
    nicht, stehen sie rechtsbündig in einer zweiten Zeile (ReflowRow), die Schiene bricht nie um. Der Bestand hat darunter seine eigene Zeile mit der Ansicht (Material, Chargen, Bewegungen) und
    dem Lagerort. „Einrichtung“ ist eine eigene Seite mit „Zurück“: Lagerorte (Recht für den Standort) und Lieferanten (Recht auf den Katalog). Der Verbrauch (nur mit ViewFinance) ist ein
    Abschnitt der Übersicht. Rechts neben dem Inhalt die Leiste „Bewegung buchen“.
  -->
  <Grid>
  <ScrollViewer x:Name="StockScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="0,0,16,16">
      <ui:ReflowRow x:Name="StockHeader" Spacing="12" LineSpacing="12" IsVisible="{Binding ShowContent}">
        <Panel VerticalAlignment="Bottom">
          <Border Classes="segmented" x:Name="Tabs" HorizontalAlignment="Left" IsVisible="{Binding !IsSetup}" AutomationProperties.Name="Reiter des Lagers">
            <StackPanel Orientation="Horizontal">
              <ui:TabButton x:Name="OverviewTabButton" Content="Übersicht" IsSelected="{Binding IsOverviewTab}" Command="{Binding ShowOverviewCommand}" Padding="12,3" AutomationProperties.Name="Übersicht" />
              <ui:TabButton x:Name="StockTabButton" Content="Bestand" IsSelected="{Binding IsStockTab}" Command="{Binding ShowStockCommand}" Padding="12,3" AutomationProperties.Name="Bestand" />
              <ui:TabButton x:Name="OrdersTabButton" Content="Bestellen" IsSelected="{Binding IsOrdersTab}" Command="{Binding ShowOrdersCommand}" Padding="12,3" IsVisible="{Binding CanSeeOrdersTab}" AutomationProperties.Name="Bestellen" />
              <ui:TabButton x:Name="CountTabButton" Content="Inventur" IsSelected="{Binding IsCountTab}" Command="{Binding ShowCountCommand}" Padding="12,3" IsVisible="{Binding CanManage}" AutomationProperties.Name="Inventur" />
            </StackPanel>
          </Border>
          <!-- Einrichtung: eigene Seite, „Zurück“ führt an den Ort davor; die Schiene wechselt nur mit beiden Rechten zwischen Lagerorten und Lieferanten -->
          <StackPanel x:Name="SetupHead" Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsSetup}">
            <Button x:Name="SetupBackButton" Command="{Binding CloseSetupCommand}" VerticalAlignment="Center" AutomationProperties.Name="Zurück zum Lager">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:Icon Data="{x:Static ui:Icons.ChevronLeft}" Width="16" Height="16" />
                <TextBlock Text="Zurück" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock x:Name="SetupTitle" Text="Einrichtung" Classes="h2" VerticalAlignment="Center" />
            <Border Classes="segmented" x:Name="SetupTabs" VerticalAlignment="Center" IsVisible="{Binding HasSetupChoice}" AutomationProperties.Name="Reiter der Einrichtung">
              <StackPanel Orientation="Horizontal">
                <ui:TabButton x:Name="PlacesTabButton" Content="Lagerorte" IsSelected="{Binding IsPlacesSetup}" Command="{Binding ShowPlacesCommand}" Padding="12,3" AutomationProperties.Name="Lagerorte" />
                <ui:TabButton x:Name="SuppliersTabButton" Content="Lieferanten" IsSelected="{Binding IsSuppliersSetup}" Command="{Binding ShowSuppliersCommand}" Padding="12,3" AutomationProperties.Name="Lieferanten" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Panel>
        <StackPanel x:Name="StockTools" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
          <ui:FormField Label="Material suchen oder scannen" IsVisible="{Binding ShowSearch}">
            <TextBox x:Name="ScanField" Text="{Binding ScanText}" Width="200" PlaceholderText="Name oder Code" AutomationProperties.Name="Material suchen oder scannen">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ScanCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
          </ui:FormField>
          <ui:FormField Label="Standort" IsVisible="{Binding HasSeveralLocations}">
            <ComboBox x:Name="LocationField" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" Width="180" />
          </ui:FormField>
          <!-- Export der Lager-Listen, nur für Inhaberin und Geschäftsführung (Export/Import, Aufgabe D) -->
          <Button x:Name="StockExportButton" Command="{Binding OpenExportCommand}" IsVisible="{Binding CanExport}" VerticalAlignment="Bottom" ToolTip.Tip="Eine Liste des Lagers als Datei speichern"
                  AutomationProperties.Name="Exportieren">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Icon Data="{x:Static ui:Icons.Download}" Width="16" Height="16" />
              <TextBlock Text="Exportieren" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="SetupButton" Content="Einrichtung" Command="{Binding OpenSetupCommand}" IsVisible="{Binding ShowSetupButton}" VerticalAlignment="Bottom"
                  ToolTip.Tip="Lagerorte und Lieferanten einrichten" />
          <ui:HelpButton Topic="lager" VerticalAlignment="Bottom" Margin="0,0,0,6" />
          <Button x:Name="BookMovementButton" Classes="primary" Command="{Binding OpenBookingPanelCommand}" IsVisible="{Binding ShowBookButton}" VerticalAlignment="Bottom"
                  AutomationProperties.Name="Bewegung buchen">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ui:Icon Data="{x:Static ui:Icons.Plus}" Width="16" Height="16" />
              <TextBlock Text="Bewegung buchen" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </ui:ReflowRow>

      <ui:InfoBar Severity="Error" Title="Lager nicht geladen" Message="{Binding LoadError}" IsVisible="{Binding HasLoadError}" ActionText="Erneut laden" ActionCommand="{Binding LoadCommand}" />
      <ui:InfoBar Severity="Success" Message="{Binding Message}" IsVisible="{Binding HasMessage}" CloseCommand="{Binding CloseMessageCommand}" />
      <ui:InfoBar Severity="Error" Title="Nicht gebucht" Message="{Binding Error}" IsVisible="{Binding HasError}" CloseCommand="{Binding CloseErrorCommand}" />
      <ui:InfoBar x:Name="ExportErrorBar" Severity="Error" Title="Export nicht erstellt" Message="{Binding ExportError}" IsVisible="{Binding HasExportError}" ActionText="Erneut versuchen"
                  ActionCommand="{Binding OpenExportCommand}" CloseCommand="{Binding CloseExportErrorCommand}" />
      <TextBlock Text="Wird geladen …" Classes="muted" IsVisible="{Binding !IsLoaded}" />
      <TextBlock Text="Noch kein Standort angelegt. Lege zuerst einen Standort an, dann führt das Lager seinen Bestand." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding ShowEmpty}" />

      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowContent}">
        <StackPanel Spacing="16">
          <StackPanel Spacing="16" IsVisible="{Binding IsOverviewTab}">
            <views:StockTodoSection DataContext="{Binding Todo}" />
            <StackPanel x:Name="UsageArea" IsVisible="{Binding CanViewUsage}">
              <views:StockUsageSection DataContext="{Binding Usage}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="16" IsVisible="{Binding IsStockTab}">
            <!-- Werkzeugzeile des Bestands: die Ansicht als Optionsfelder (design.md 5.3; die Zahl offener Chargen bleibt in jeder Ansicht sichtbar), rechts der Lagerort für Material und Bewegungen -->
            <Grid x:Name="StockViewRow" ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="4" VerticalAlignment="Bottom">
                <TextBlock x:Name="StockViewLabel" Text="Ansicht" Classes="label" />
                <StackPanel x:Name="StockViews" Orientation="Horizontal" Spacing="16" MinHeight="34" AutomationProperties.Name="Ansicht des Bestands">
                  <RadioButton x:Name="ItemsViewButton" GroupName="StockView" Content="Material" IsChecked="{Binding IsItemsView, Mode=OneWay}" Command="{Binding ShowStockCommand}" VerticalAlignment="Center" />
                  <RadioButton x:Name="BatchesViewButton" GroupName="StockView" Content="{Binding BatchesViewLabel}" IsChecked="{Binding IsBatchesView, Mode=OneWay}" Command="{Binding ShowTasksCommand}"
                               IsVisible="{Binding CanManage}" VerticalAlignment="Center" />
                  <RadioButton x:Name="MovementsViewButton" GroupName="StockView" Content="Bewegungen" IsChecked="{Binding IsMovementsView, Mode=OneWay}" Command="{Binding ShowMovementsCommand}" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
              <ui:FormField Grid.Column="1" Label="Lagerort" IsVisible="{Binding ShowPlaceFilter}" VerticalAlignment="Bottom">
                <ComboBox x:Name="PlaceFilterField" ItemsSource="{Binding PlaceFilter}" SelectedItem="{Binding SelectedPlace}" Width="200" />
              </ui:FormField>
            </Grid>
            <StackPanel Spacing="16" IsVisible="{Binding IsItemsView}">
              <views:StockOverviewSection DataContext="{Binding Overview}" />
              <StackPanel IsVisible="{Binding CanCatalog}">
                <views:StockItemFormSection DataContext="{Binding ItemForm}" />
              </StackPanel>
            </StackPanel>
            <StackPanel IsVisible="{Binding IsBatchesView}">
              <views:StockTasksSection DataContext="{Binding Tasks}" />
            </StackPanel>
            <StackPanel Spacing="16" IsVisible="{Binding IsMovementsView}">
              <views:StockMovementsSection DataContext="{Binding Movements}" />
              <StackPanel IsVisible="{Binding CanManage}">
                <views:StockBatchTraceSection DataContext="{Binding BatchTrace}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="16" IsVisible="{Binding IsOrdersTab}">
            <StackPanel IsVisible="{Binding CanBook}">
              <views:StockDemandSection DataContext="{Binding Demand}" />
            </StackPanel>
            <StackPanel IsVisible="{Binding CanManage}">
              <views:StockOrdersSection DataContext="{Binding Orders}" />
            </StackPanel>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsCountTab}">
            <views:StockCountSection DataContext="{Binding Count}" />
          </StackPanel>
          <StackPanel IsVisible="{Binding IsPlacesSetup}">
            <views:StoragePlacesSection DataContext="{Binding PlacesAdmin}" />
          </StackPanel>
          <StackPanel IsVisible="{Binding IsSuppliersSetup}">
            <views:StockSuppliersSection DataContext="{Binding SuppliersAdmin}" />
          </StackPanel>
        </StackPanel>
        <views:MovementBookingPanel Grid.Column="1" DataContext="{Binding Booking}" IsVisible="{Binding IsOpen}" Width="340" Margin="16,0,0,0" VerticalAlignment="Top" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
  </Grid>
</UserControl>
