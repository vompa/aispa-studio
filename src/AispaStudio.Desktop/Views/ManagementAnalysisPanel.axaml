<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:AispaStudio.Desktop.Views"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             xmlns:svc="using:AispaStudio.Desktop.Services"
             x:Class="AispaStudio.Desktop.Views.ManagementAnalysisPanel"
             x:DataType="vm:ManagementAnalysisViewModel">
  <!--
    Inhalt der Seitenleiste „Mit KI auswerten“ (T-096 E2, neu gestaltet T-104, ADR 0066): vor der ersten Auswertung Schwerpunkt und eigene Frage; ist sie fertig, klappt das Formular
    zur Zeile „KI · Schwerpunkt … · Ändern“ ein, und das Ergebnis bekommt die restliche Höhe. Im Fuß fest der Hinweis der KI und „Auswerten“ bzw. „Neu auswerten“ (masken.md R5).
    Gescheitert: was passiert ist und zwei Wege, einer ohne KI (responsible-ai.md).
  -->
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Eingeklappt: Pille, Schwerpunkt (mit Frage) und „Ändern“ -->
    <Grid x:Name="AnalysisSummary" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="20,12,20,0" IsVisible="{Binding IsFormCollapsed}">
      <views:AiPill VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding ResultTitle}" Classes="muted small" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="2" x:Name="AnalysisEdit" Classes="link" Content="Ändern" Command="{Binding EditCommand}" VerticalAlignment="Center"
              AutomationProperties.Name="Schwerpunkt und Frage ändern" />
    </Grid>

    <ScrollViewer Grid.Row="1" x:Name="AnalysisScroll" Classes="panelbody" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16" Margin="20,12,20,16">
        <StackPanel x:Name="AnalysisForm" Spacing="16" IsVisible="{Binding IsFormOpen}">
          <TextBlock Text="{x:Static vm:ManagementAnalysisViewModel.IntroText}" Classes="muted small" TextWrapping="Wrap" />
          <ui:FormField Label="Schwerpunkt">
            <ComboBox x:Name="AnalysisFocusField" ItemsSource="{x:Static vm:ManagementAnalysisViewModel.FocusChoices}" SelectedItem="{Binding SelectedFocus}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Schwerpunkt" />
          </ui:FormField>
          <ui:FormField Label="Eigene Frage (freiwillig)">
            <StackPanel Spacing="4">
              <TextBox x:Name="AnalysisQuestionField" Text="{Binding Question}" MaxLength="{x:Static vm:ManagementAnalysisViewModel.MaxQuestionLength}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" AutomationProperties.Name="Eigene Frage"
                       AutomationProperties.HelpText="{x:Static vm:ManagementAnalysisViewModel.QuestionHint}" />
              <TextBlock Text="{Binding QuestionCount}" Classes="muted small" HorizontalAlignment="Right" />
              <TextBlock x:Name="AnalysisQuestionHint" Text="{x:Static vm:ManagementAnalysisViewModel.QuestionHint}" Classes="muted small" TextWrapping="Wrap" />
            </StackPanel>
          </ui:FormField>
        </StackPanel>

        <!-- Läuft -->
        <StackPanel x:Name="AnalysisRunning" Spacing="8" IsVisible="{Binding IsRunning}">
          <ProgressBar IsIndeterminate="True" />
          <TextBlock Text="{x:Static vm:ManagementAnalysisViewModel.RunningText}" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- Gescheitert: nichts von der KI anzeigen -->
        <ui:InfoBar x:Name="AnalysisFailed" Severity="Error" Title="Auswertung gescheitert" Message="{Binding FailureText}" IsVisible="{Binding IsFailed}"
                    ActionText="Erneut versuchen" ActionCommand="{Binding AnalyzeCommand}" />

        <!-- Fertig: Kernaussagen als Liste, Auffälligkeiten als Karten, Maßnahmen als nummerierte Liste; die Pille steht in der Zeile darüber, der Hinweis im Fuß -->
        <StackPanel x:Name="AnalysisResult" Spacing="20" IsVisible="{Binding IsDone}">
          <StackPanel Spacing="8">
            <TextBlock Text="Kernaussagen" Classes="h3" />
            <ItemsControl x:Name="AnalysisKeyFindings" ItemsSource="{Binding KeyFindings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Grid ColumnDefinitions="16,*" Margin="0,0,0,4">
                    <TextBlock Text="•" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding Findings.Count}">
            <TextBlock Text="Auffälligkeiten" Classes="h3" />
            <ItemsControl x:Name="AnalysisFindings" ItemsSource="{Binding Findings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AnalysisFindingRow">
                  <!-- Karte je Auffälligkeit (Brief 5.12 Punkt 5): Aussage, Pille „Vermutung“ vor der Ursache, Kennzahl als Chip; mit Kachel im Bericht ist der Chip ein Knopf -->
                  <Border Classes="panelcard" Margin="0,0,0,12">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding Observation}" TextWrapping="Wrap" />
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <!-- Pille (20 hoch) und erste Zeile der Ursache (Stufe Klein, 16 hoch) haben dieselbe Mitte: die Ursache rückt 2 px nach unten -->
                        <Border Classes="pill" VerticalAlignment="Top">
                          <TextBlock Text="Vermutung" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding CauseText}" Classes="muted small" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,2,0,0" />
                      </Grid>
                      <Button Classes="chip" Content="{Binding Kpi}" Command="{Binding Mark}" IsVisible="{Binding HasTile}" HorizontalAlignment="Left"
                              ToolTip.Tip="Kachel im Bericht zeigen" AutomationProperties.Name="{Binding MarkName}" />
                      <Border Classes="tag" HorizontalAlignment="Left" Margin="0" IsVisible="{Binding !HasTile}">
                        <TextBlock Text="{Binding Kpi}" Classes="small" />
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding Measures.Count}">
            <TextBlock Text="Maßnahmen" Classes="h3" />
            <ItemsControl x:Name="AnalysisMeasures" ItemsSource="{Binding Measures}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AnalysisMeasureRow">
                  <Grid ColumnDefinitions="16,*" Margin="0,0,0,8">
                    <TextBlock Text="•" AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding Action}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding SuccessSign}" Classes="muted small" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding NotShown.Count}">
            <TextBlock Text="Was die Zahlen nicht zeigen" Classes="h3" />
            <ItemsControl x:Name="AnalysisNotShown" ItemsSource="{Binding NotShown}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Grid ColumnDefinitions="16,*" Margin="0,0,0,4">
                    <TextBlock Text="•" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Hinweiszeile unter der Ausgabe (Brief 5.28): Hinweis des Servers (AI Act Art. 50) mit „Warum?“; ob er in den Fuß wandert, ist eine offene Frage an den Auftraggeber -->
          <views:AiFooter x:Name="AnalysisNotice" Disclaimer="{Binding Notice}" Why="{x:Static svc:AiLabels.WhyManagementAnalysis}" />

          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button x:Name="AnalysisCopy" Content="Kopieren" Click="OnCopy" />
            <Button x:Name="AnalysisAdopt" Content="In den Bericht übernehmen" Command="{Binding AdoptCommand}" IsVisible="{Binding CanAdopt}" />
          </WrapPanel>
          <TextBlock Text="{Binding CopyStatus}" Classes="muted small" IsVisible="{Binding CopyStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- Übernommen: steht in PDF, Word und Excel; wieder herausnehmen geht jederzeit -->
        <StackPanel x:Name="AnalysisAdopted" Spacing="4" IsVisible="{Binding IsAdopted}">
          <TextBlock Text="{x:Static vm:ManagementAnalysisViewModel.AdoptedText}" Classes="small" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <Button x:Name="AnalysisRemove" Classes="link" Content="Aus dem Bericht nehmen" Command="{Binding RemoveCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!--
      Fuß: nur der Knopf. Rechts bleiben 76 px frei (runder Knopf „KI und Hilfe“ 48 mit 20 Rand und 8 Luft, Brief 5.28): er steht neben dem Knopf
      statt darüber, und der Fuß braucht unten keine 60 px Leerraum mehr (T-104).
    -->
    <StackPanel x:Name="AnalysisFooter" Grid.Row="2">
      <Border Classes="divider" />
      <StackPanel Spacing="12" Margin="20,12,76,20">
        <Button x:Name="AnalysisRun" Classes="primary" Content="{Binding RunLabel}" Command="{Binding AnalyzeCommand}" HorizontalAlignment="Left"
                ui:DisabledHint.Text="{x:Static vm:ManagementAnalysisViewModel.RunningHint}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
