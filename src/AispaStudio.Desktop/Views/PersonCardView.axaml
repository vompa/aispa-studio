<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.PersonCardView"
             x:DataType="vm:PersonCardViewModel">
  <!--
    Personenkarte (R05 Slice 98, ADR 0098): Kopf mit Name, „Rolle · Status“, Kennzeichen und „Verlauf“ (Seitenleiste in TeamView), darunter eine Schiene (Brief 5.4) mit höchstens
    vier Bereichen: Übersicht · Profil (Stammdaten, Zugang und Rolle, Qualifikationen, Zuständigkeiten) · Arbeitszeit (Dienstplan und Abwesenheit, Zeiten) · Lohn und Akte (Lohn,
    Personalakte, Regelungen und Vollmachten), je nach Recht. Die Abschnitte eines Bereichs stehen untereinander mit 20 px Abstand (Brief 4.1); Formulare höchstens 760 breit,
    Übersicht, Wochenplan und Zeiten in voller Breite. Gespeichert wird mit der Leiste im Fuß der Seite (TeamView).
  -->
  <ScrollViewer x:Name="CardScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="20" Margin="0,0,16,16">

      <StackPanel Spacing="4" IsVisible="{Binding ShowsHeader}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock x:Name="CardTitle" Text="{Binding Title}" Classes="h2" VerticalAlignment="Center" TextWrapping="Wrap" />
          <ui:HelpButton Topic="team" Section="person" Grid.Column="1" />
          <Button Grid.Column="2" x:Name="HistoryButton" Classes="ghost" Command="{Binding ToggleHistoryCommand}" IsVisible="{Binding HasHistory}"
                  ToolTip.Tip="Wer was wann geändert hat" AutomationProperties.Name="Verlauf">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ui:Icon Data="{x:Static ui:Icons.History}" Width="16" Height="16" />
              <TextBlock Text="Verlauf" />
            </StackPanel>
          </Button>
        </Grid>
        <TextBlock Text="{Binding StatusLine}" Classes="muted" IsVisible="{Binding HasStatusLine}" />
        <TextBlock Text="Ausgeschieden: Die Angaben sind nur lesbar." Classes="muted" IsVisible="{Binding IsReadOnly}" />
        <ItemsControl x:Name="CardFlags" ItemsSource="{Binding FlagItems}" IsVisible="{Binding HasFlags}" AutomationProperties.Name="Kennzeichen" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FlagLine">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ui:Icon Data="{x:Static ui:Icons.Warning}" Width="16" Height="16" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Top" IsVisible="{Binding IsWarning}" />
                <TextBlock Text="{Binding Text}" Classes="small" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Schiene in einer Zeile (Brief 5.4, ADR 0098 Regel 1): ein Tab-Stopp, Pfeiltasten über TabStripBehavior -->
      <Border Classes="segmented" x:Name="CardTabs" HorizontalAlignment="Left" IsVisible="{Binding ShowsTabs}" AutomationProperties.Name="Bereiche der Personenkarte">
        <ItemsControl ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CardTab">
              <ui:TabButton Content="{Binding Label}" IsSelected="{Binding IsOn}" Command="{Binding SelectCommand}" Padding="10,3" MinWidth="0"
                            AutomationProperties.Name="{Binding Label}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- Übersicht: Kennzahl-Kacheln in voller Breite -->
      <ContentControl x:Name="OverviewHost" Content="{Binding Overview}" IsVisible="{Binding ShowsOverview}" />

      <!-- Profil -->
      <StackPanel x:Name="DetailsBlock" Spacing="8" MaxWidth="760" HorizontalAlignment="Left" IsVisible="{Binding ShowsDetails}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Stammdaten" Classes="h3" VerticalAlignment="Center" />
          <ui:HelpButton Topic="team" Section="person" Grid.Column="1" />
        </Grid>
        <ContentControl x:Name="DetailsHost" Content="{Binding Details}" />
      </StackPanel>
      <ContentControl x:Name="AccessHost" Content="{Binding Access}" MaxWidth="760" HorizontalAlignment="Left" IsVisible="{Binding ShowsAccess}" />
      <ContentControl x:Name="QualificationsHost" Content="{Binding Qualifications}" MaxWidth="760" HorizontalAlignment="Left" IsVisible="{Binding ShowsQualifications}" />
      <ContentControl x:Name="DutiesHost" Content="{Binding Duties}" MaxWidth="760" HorizontalAlignment="Left" IsVisible="{Binding ShowsDuties}" />

      <!-- Arbeitszeit: Dienstplan und Abwesenheit (Slice 99) mit Urlaubskonto und Kalenderdatei, darunter die Zeiten; Wochenraster in voller Breite -->
      <StackPanel x:Name="RosterSection" Spacing="12" IsVisible="{Binding ShowsRoster}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Dienstplan und Abwesenheit" Classes="h3" VerticalAlignment="Center" />
          <ui:HelpButton Topic="dienstplan-tag-planen" Grid.Column="1" />
        </Grid>
        <ContentControl x:Name="RosterHost" Content="{Binding Roster}" />
        <!-- Urlaubskonto (ADR 0097): Anspruch, genommen, geplant und Rest des Jahres -->
        <ContentControl x:Name="LeaveHost" Content="{Binding Leave}" IsVisible="{Binding HasLeave}" MaxWidth="760" HorizontalAlignment="Left" />
        <!-- Dienste und Termine als Kalenderdatei für den privaten Kalender (Export/Import, Aufgabe C): nur Leitung und die Person selbst, ohne Namen der Gäste -->
        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding HasCalendarFile}">
          <Button x:Name="CalendarFileButton" DataContext="{Binding CalendarFile}" x:DataType="vm:ExportViewModel" Command="{Binding ExportCommand}" CommandParameter="{Binding Options[0]}"
                  ToolTip.Tip="Dienste und Termine der nächsten 90 Tage als Datei für den eigenen Kalender, ohne Namen der Gäste">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ui:Icon Data="{x:Static ui:Icons.Download}" Width="16" Height="16" />
              <TextBlock Text="Kalenderdatei …" />
            </StackPanel>
          </Button>
          <TextBlock x:Name="CalendarFileSavedText" Text="{Binding CalendarFileSaved}" Classes="muted small" VerticalAlignment="Center"
                     IsVisible="{Binding CalendarFileSaved, Converter={x:Static ObjectConverters.IsNotNull}}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </StackPanel>

      <!-- Zeiten (Slice 99): die Zeiterfassung der Person, ein Tag lässt sich ansehen, nachtragen und ändern -->
      <StackPanel x:Name="TimesSection" Spacing="12" IsVisible="{Binding ShowsTimes}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Zeiten" Classes="h3" VerticalAlignment="Center" />
          <ui:HelpButton Topic="zeiten-nachtragen" Grid.Column="1" />
        </Grid>
        <ContentControl x:Name="TimesHost" Content="{Binding Times}" />
      </StackPanel>

      <!-- Lohn und Akte: Lohn (Slice 100) mit Personalnummer und Monatswerten, Personalakte (Slice 110), Regelungen und Vollmachten (Slice 111) -->
      <StackPanel x:Name="PayrollSection" Spacing="8" MaxWidth="760" HorizontalAlignment="Left" IsVisible="{Binding ShowsPayroll}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Lohn" Classes="h3" VerticalAlignment="Center" />
          <ui:HelpButton Topic="lohn" Grid.Column="1" />
        </Grid>
        <ContentControl x:Name="PayrollHost" Content="{Binding Payroll}" />
      </StackPanel>
      <ContentControl x:Name="HrFileHost" Content="{Binding HrFile}" MaxWidth="760" HorizontalAlignment="Left" IsVisible="{Binding ShowsHrFile}" />
      <ContentControl x:Name="RegulationsHost" Content="{Binding Regulations}" MaxWidth="760" HorizontalAlignment="Left" IsVisible="{Binding ShowsRegulations}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
