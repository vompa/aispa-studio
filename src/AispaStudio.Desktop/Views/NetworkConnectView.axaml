<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.NetworkConnectView"
             x:DataType="vm:NetworkConnectViewModel">
  <StackPanel Spacing="8" Margin="0,8,0,0">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Mit Haupt-PC im Netz verbinden" Classes="h2" />
      <ui:HelpButton Topic="im-netz" Section="verbinden" />
    </StackPanel>
    <TextBlock Text="Arbeitet das Spa ohne Server, steht am Haupt-PC unter „Im Netz“ die Adresse und der Verbindungscode."
               Classes="muted small" TextWrapping="Wrap" />
    <ui:FormField Label="Adresse" Help="Mit https:// und Port." IsRequired="True">
      <TextBox Text="{Binding Address}" PlaceholderText="z. B. https://empfang-pc:55443" />
    </ui:FormField>
    <ui:FormField Label="Verbindungscode" Help="Steht am Haupt-PC unter „Im Netz“." IsRequired="True">
      <TextBox Text="{Binding Code}" PlaceholderText="z. B. 3F9A-12C4-77B0-E1D2-9A0B" />
    </ui:FormField>
    <ui:InfoBar Severity="Error" Message="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Button Classes="primary" Content="Verbinden" Command="{Binding ConnectCommand}" />
      <Button Classes="ghost" Content="Eintrag vergessen" Command="{Binding ForgetCommand}" IsVisible="{Binding HasSaved}" />
    </StackPanel>
    <TextBlock Text="{Binding SavedText}" Classes="muted small" IsVisible="{Binding HasSaved}" />
  </StackPanel>
</UserControl>
