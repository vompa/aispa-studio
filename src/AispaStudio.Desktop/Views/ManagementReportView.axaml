<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:AispaStudio.Desktop.Views"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.ManagementReportView"
             x:DataType="vm:ManagementReportViewModel">
  <!-- Reiter „Management“ nach web/src/reports/ManagementView.tsx und BenchmarkView.tsx. Der Vergleich zeigt die Werte als Text; ein Balken wäre eine eigene Zeichnung (Ä226). -->
  <StackPanel Spacing="16">
    <WrapPanel ItemSpacing="12" LineSpacing="12">
      <ui:FormField Label="Zeitraum">
        <ComboBox x:Name="ManagementQuickRangeField" ItemsSource="{x:Static vm:ManagementReportViewModel.QuickRanges}" SelectedItem="{Binding SelectedQuickRange}"
                  PlaceholderText="Schnellwahl" Width="160" />
      </ui:FormField>
      <ui:FormField Label="Von">
        <ui:DateField x:Name="ManagementFromField" Value="{Binding From}" />
      </ui:FormField>
      <ui:FormField Label="Bis">
        <ui:DateField x:Name="ManagementUntilField" Value="{Binding Until}" />
      </ui:FormField>
      <ui:FormField Label="Vergleichen mit">
        <ComboBox x:Name="ManagementComparisonField" ItemsSource="{x:Static vm:ManagementReportViewModel.CompareChoices}" SelectedItem="{Binding SelectedComparison}" Width="160" />
      </ui:FormField>
      <CheckBox x:Name="ManagementCompareField" Content="Mit anderen Spas vergleichen" IsChecked="{Binding Compare}" VerticalAlignment="Bottom" />
      <!-- Wochenbericht montags, Monatsbericht am Ersten, je für die angemeldete Person; abbestellen jederzeit hier -->
      <CheckBox x:Name="ManagementMailField" Content="Wochen- und Monatsbericht per Mail" IsChecked="{Binding MailReports}" IsVisible="{Binding CanMailReports}"
                VerticalAlignment="Bottom" ToolTip.Tip="Montags der Bericht der Vorwoche, am Monatsersten der des Vormonats, an Ihre Mailadresse" />
      <!-- Der Bericht als PDF: Drucken, speichern, per Mail senden (T-095 D2, ADR 0092) -->
      <Panel IsVisible="{Binding Document, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Bottom">
        <ui:DocumentActions x:Name="ManagementDocument" DataContext="{Binding Document}" />
      </Panel>
      <!-- KI-Auswertung per Knopf (T-096 E2): öffnet die Seitenleiste; ohne Claude-Schlüssel gesperrt mit Grund -->
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
        <Button x:Name="ManagementAnalyzeButton" Command="{Binding Analysis.OpenCommand}" IsEnabled="{Binding AiAnalysisAvailable}"
                ui:DisabledHint.Text="{x:Static vm:ManagementReportViewModel.AnalysisUnavailableHint}" AutomationProperties.Name="Mit KI auswerten">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <views:AiPill />
            <TextBlock Text="Mit KI auswerten" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <ui:HelpButton Topic="berichte-mit-ki-auswerten" VerticalAlignment="Center" />
      </StackPanel>
      <!-- Export der Kennzahlen des Zeitraums (Export/Import, Aufgabe D) -->
      <ui:ExportButton x:Name="ManagementExportButton" DataContext="{Binding Export}" VerticalAlignment="Bottom" />
      <TextBlock x:Name="ManagementExportSaved" Text="{Binding ExportSaved}" Classes="muted small" IsVisible="{Binding HasExportSaved}" VerticalAlignment="Bottom" AutomationProperties.LiveSetting="Polite" />
      <Button x:Name="ManagementOpenFolder" Classes="link" Content="{x:Static vm:ManagementReportViewModel.OpenFolderText}" Command="{Binding OpenFolderCommand}"
              IsVisible="{Binding HasSavedPath}" VerticalAlignment="Bottom" />
    </WrapPanel>
    <!-- Womit die Kacheln vergleichen, und dass der heutige Tag noch läuft -->
    <TextBlock x:Name="ManagementCompareInfo" Text="{Binding CompareInfo}" Classes="muted small" IsVisible="{Binding CompareInfo, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <TextBlock x:Name="ManagementTodayOpen" Text="{x:Static vm:ManagementReportViewModel.TodayOpenText}" Classes="muted small" IsVisible="{Binding IsTodayOpen}" />
    <ui:InfoBar Severity="Error" Message="{Binding Error}" IsVisible="{Binding HasError}" CloseCommand="{Binding CloseErrorCommand}" />
    <ui:InfoBar Severity="Error" Title="Bericht nicht geladen" Message="{Binding LoadError}" IsVisible="{Binding HasLoadError}"
                ActionText="Erneut laden" ActionCommand="{Binding RetryCommand}" />
    <ui:InfoBar Severity="Info" Message="{x:Static vm:ManagementReportViewModel.AmountsHint}" IsVisible="{Binding AmountsHidden}" />
    <!-- KI-Kommentar zu genau diesen Zahlen (ab sieben Tagen); kommt im Hintergrund nach, wie im Tagesstart -->
    <TextBlock Text="Die KI kommentiert den Zeitraum …" Classes="muted" IsVisible="{Binding IsAiPending}" AutomationProperties.LiveSetting="Polite" />
    <Border x:Name="ManagementAiSummary" Classes="section" IsVisible="{Binding HasAiSummary}">
      <StackPanel Spacing="4">
        <views:AiPill HorizontalAlignment="Left" />
        <TextBlock Text="{Binding AiSummary}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding AiNotice}" Classes="muted small" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <ItemsControl ItemsSource="{Binding Alerts}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <ui:InfoBar Severity="Warning" Message="{Binding}" Margin="0,0,0,8" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Vergleich mit anderen Spas -->
    <StackPanel Spacing="8" IsVisible="{Binding Compare}">
      <TextBlock Text="Vergleich mit anderen Spas" Classes="h2" />
      <ui:FormField Label="Zeitraum">
        <ComboBox x:Name="BenchmarkPeriodField" ItemsSource="{Binding BenchmarkPeriods}" SelectedItem="{Binding SelectedPeriod}" Width="160" />
      </ui:FormField>
      <ui:InfoBar Severity="Error" Title="Vergleich nicht geladen" Message="{Binding BenchmarkError}" IsVisible="{Binding HasBenchmarkError}" />
      <StackPanel Spacing="8" IsVisible="{Binding HasBenchmark}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding BenchmarkTitle}" TextWrapping="Wrap" />
          <Border Classes="pill" IsVisible="{Binding BenchmarkIsSample}">
            <TextBlock Text="Beispieldaten" Classes="small" />
          </Border>
        </StackPanel>
        <TextBlock Text="{Binding BenchmarkSummary}" Classes="muted" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding BenchmarkRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BenchmarkRow">
              <Border Classes="card" Padding="12" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <TextBlock Text="{Binding Label}" FontWeight="Medium" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{Binding Own}" Classes="num" />
                    <TextBlock Grid.Column="2" Text="{Binding Rating}" Classes="muted" />
                  </Grid>
                  <TextBlock Text="{Binding Range}" Classes="muted small" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Tip}" TextWrapping="Wrap" IsVisible="{Binding HasTip}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding BenchmarkNotes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Classes="muted small" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>

    <!-- Kacheln in Gruppen mit Überschrift (Umsatz und Ertrag, Auslastung, Gäste, Ausfälle), Reihenfolge und Gruppe aus der API -->
    <ItemsControl x:Name="ManagementKpiGroups" ItemsSource="{Binding KpiGroups}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:KpiGroupRow">
          <StackPanel Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" Classes="h2" />
            <ItemsControl ItemsSource="{Binding Kpis}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="12" LineSpacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KpiRow">
                  <ui:StatTile Width="200" VerticalAlignment="Stretch" Label="{Binding Label}" Value="{Binding Value}" Hint="{Binding Hint}" State="{Binding State}" AccessibleHint="{Binding Spoken}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Verlauf je Tag (über 62 Tage je Woche): drei kleine Diagramme mit eigener Skala statt einer Doppelachse; Werte je Diagramm auch als Tabelle -->
    <StackPanel x:Name="ManagementTrend" Spacing="8" IsVisible="{Binding HasTrend}">
      <TextBlock Text="Verlauf" Classes="h2" />
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="24">
        <ui:TrendBars x:Name="TrendRevenueChart" Title="Umsatz ohne Gutscheinverkauf (netto)" Bars="{Binding TrendRevenue}" IsVisible="{Binding HasTrendRevenue}" />
        <ui:TrendBars x:Name="TrendAppointmentsChart" Grid.Column="1" Title="Behandlungen" Bars="{Binding TrendAppointments}" />
        <ui:TrendBars x:Name="TrendUtilizationChart" Grid.Column="2" Title="Auslastung Personal" Bars="{Binding TrendUtilization}" />
      </Grid>
    </StackPanel>

    <!-- Auslastung Personal je Wochentag und Tageszeit; schwache Felder tragen „schwach“ im Text und eine Warnfläche, nie nur Farbe -->
    <StackPanel x:Name="ManagementLoadByWeekday" Spacing="8" Grid.IsSharedSizeScope="True" IsVisible="{Binding LoadByWeekday.Count}">
      <TextBlock Text="Auslastung nach Wochentag und Tageszeit" Classes="h2" />
      <TextBlock Text="{Binding WeakLoadInfo}" Classes="muted small" TextWrapping="Wrap" />
      <Grid ColumnSpacing="12" AutomationProperties.AccessibilityView="Raw">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="Day" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Part" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Part" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Part" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Part" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Wochentag" Classes="group" />
        <TextBlock Grid.Column="1" Text="Vormittag (bis 11)" Classes="group" />
        <TextBlock Grid.Column="2" Text="Mittag (11–14)" Classes="group" />
        <TextBlock Grid.Column="3" Text="Nachmittag (14–17)" Classes="group" />
        <TextBlock Grid.Column="4" Text="Abend (ab 17)" Classes="group" />
      </Grid>
      <ItemsControl ItemsSource="{Binding LoadByWeekday}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WeekdayLoadRow">
            <Grid ColumnSpacing="12" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Day" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Part" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Part" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Part" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Part" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Day}" VerticalAlignment="Center" />
              <Border Grid.Column="1" Classes="loadcell" Classes.weak="{Binding Morning.IsWeak}" AutomationProperties.Name="{Binding Morning.Spoken}">
                <TextBlock Text="{Binding Morning.Text}" Classes="num" />
              </Border>
              <Border Grid.Column="2" Classes="loadcell" Classes.weak="{Binding Midday.IsWeak}" AutomationProperties.Name="{Binding Midday.Spoken}">
                <TextBlock Text="{Binding Midday.Text}" Classes="num" />
              </Border>
              <Border Grid.Column="3" Classes="loadcell" Classes.weak="{Binding Afternoon.IsWeak}" AutomationProperties.Name="{Binding Afternoon.Spoken}">
                <TextBlock Text="{Binding Afternoon.Text}" Classes="num" />
              </Border>
              <Border Grid.Column="4" Classes="loadcell" Classes.weak="{Binding Evening.IsWeak}" AutomationProperties.Name="{Binding Evening.Spoken}">
                <TextBlock Text="{Binding Evening.Text}" Classes="num" />
              </Border>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Vorschau: gebuchter Stand der nächsten vier Wochen, rein gerechnet, keine KI -->
    <StackPanel x:Name="ManagementForecast" Spacing="8" Grid.IsSharedSizeScope="True" IsVisible="{Binding Forecast.Count}">
      <TextBlock Text="Vorschau nächste vier Wochen" Classes="h2" />
      <TextBlock Text="{Binding ForecastInfo}" Classes="muted small" TextWrapping="Wrap" />
      <Grid ColumnSpacing="12" AutomationProperties.AccessibilityView="Raw">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Count" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Revenue" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Use" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Woche" Classes="group" />
        <TextBlock Grid.Column="1" Text="Termine" Classes="group" />
        <TextBlock Grid.Column="2" Text="Gebuchter Umsatz (brutto)" Classes="group" IsVisible="{Binding ShowAmounts}" />
        <TextBlock Grid.Column="3" Text="Gebuchte Auslastung" Classes="group" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Forecast}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ReportRow">
            <Grid ColumnSpacing="12" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Count" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Revenue" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Use" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" />
              <TextBlock Grid.Column="1" Text="{Binding First}" Classes="num" />
              <TextBlock Grid.Column="2" Text="{Binding Second}" Classes="num" />
              <TextBlock Grid.Column="3" Text="{Binding Third}" Classes="num" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel x:Name="ManagementRooms" Spacing="8" Grid.IsSharedSizeScope="True" IsVisible="{Binding Rooms.Count}">
      <TextBlock Text="Räume" Classes="h2" />
      <Grid ColumnSpacing="12" AutomationProperties.AccessibilityView="Raw">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Use" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Count" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Raum" Classes="group" />
        <TextBlock Grid.Column="1" Text="Auslastung" Classes="group" />
        <TextBlock Grid.Column="2" Text="Termine" Classes="group" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Rooms}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ReportRow">
            <Grid ColumnSpacing="12" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Use" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Count" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Text="{Binding First}" Classes="num" />
              <TextBlock Grid.Column="2" Text="{Binding Second}" Classes="num" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel Spacing="8" IsVisible="{Binding ShowAmounts}">
      <TextBlock Text="Umsatz nach Erlöskonto" Classes="h2" />
      <TextBlock x:Name="RevenueByAccountEmpty" Text="Keine Umsätze im Zeitraum." Classes="muted" IsVisible="{Binding !RevenueByAccount.Count}" />
      <ItemsControl ItemsSource="{Binding RevenueByAccount}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RevenueRow">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,0,0,4">
              <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Text="{Binding Gross}" Classes="num" />
              <TextBlock Grid.Column="2" Text="{Binding Net}" Classes="muted num" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Umsatz nach Zahlungsart" Classes="h2" />
      <TextBlock x:Name="RevenueByPaymentEmpty" Text="Keine Umsätze im Zeitraum." Classes="muted" IsVisible="{Binding !RevenueByPayment.Count}" />
      <ItemsControl ItemsSource="{Binding RevenueByPayment}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RevenueRow">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,4">
              <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Text="{Binding Gross}" Classes="num" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel Spacing="8" Grid.IsSharedSizeScope="True">
      <TextBlock Text="Personal" Classes="h2" />
      <TextBlock x:Name="EmployeesEmpty" Text="Keine Dienste im Zeitraum." Classes="muted" IsVisible="{Binding !Employees.Count}" />
      <Grid ColumnSpacing="12" AutomationProperties.AccessibilityView="Raw" IsVisible="{Binding Employees.Count}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Shift" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Treatment" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Use" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="PerHour" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Person" Classes="group" />
        <TextBlock Grid.Column="1" Text="Dienststunden" Classes="group" />
        <TextBlock Grid.Column="2" Text="Behandlungsstunden" Classes="group" />
        <TextBlock Grid.Column="3" Text="Auslastung" Classes="group" />
        <TextBlock Grid.Column="4" Text="Umsatz je Stunde" Classes="group" IsVisible="{Binding ShowAmounts}" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Employees}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:EmployeeKpiRow">
            <Grid ColumnSpacing="12" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Shift" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Treatment" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Use" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PerHour" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" />
              <TextBlock Grid.Column="1" Text="{Binding ShiftHours}" Classes="num" />
              <TextBlock Grid.Column="2" Text="{Binding TreatmentHours}" Classes="num" />
              <TextBlock Grid.Column="3" Text="{Binding Utilization}" Classes="num" />
              <TextBlock Grid.Column="4" Text="{Binding RevenuePerHour}" Classes="num" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel Spacing="8" Grid.IsSharedSizeScope="True">
      <TextBlock Text="Behandlungen" Classes="h2" />
      <TextBlock x:Name="TreatmentsEmpty" Text="Keine Behandlungen im Zeitraum." Classes="muted" IsVisible="{Binding !Treatments.Count}" />
      <Grid ColumnSpacing="12" AutomationProperties.AccessibilityView="Raw" IsVisible="{Binding Treatments.Count}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Count" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Revenue" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Margin" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Behandlung" Classes="group" />
        <TextBlock Grid.Column="1" Text="Termine" Classes="group" />
        <TextBlock Grid.Column="2" Text="Umsatz netto" Classes="group" IsVisible="{Binding ShowAmounts}" />
        <TextBlock Grid.Column="3" Text="Marge je Termin (Vollkosten)" Classes="group" IsVisible="{Binding ShowAmounts}" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Treatments}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TreatmentKpiRow">
            <Grid ColumnSpacing="12" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Count" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Revenue" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Margin" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Text="{Binding Appointments}" Classes="num" />
              <TextBlock Grid.Column="2" Text="{Binding Revenue}" Classes="num" />
              <TextBlock Grid.Column="3" Text="{Binding Margin}" Classes="num" Classes.error="{Binding IsLoss}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Wirkung der Aktionen (ADR 0071): nur Positionen, die mit Aktion kassiert wurden; Stornos abgezogen -->
    <StackPanel x:Name="ManagementPromotions" Spacing="8" Grid.IsSharedSizeScope="True" IsVisible="{Binding Promotions.Count}">
      <TextBlock Text="Aktionen" Classes="h2" />
      <Grid ColumnSpacing="12" AutomationProperties.AccessibilityView="Raw">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Positions" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Guests" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="New" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Discount" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Revenue" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Aktion" Classes="group" />
        <TextBlock Grid.Column="1" Text="Positionen" Classes="group" />
        <TextBlock Grid.Column="2" Text="Gäste" Classes="group" />
        <TextBlock Grid.Column="3" Text="davon neu" Classes="group" />
        <TextBlock Grid.Column="4" Text="Rabatt" Classes="group" IsVisible="{Binding ShowAmounts}" />
        <TextBlock Grid.Column="5" Text="Umsatz brutto" Classes="group" IsVisible="{Binding ShowAmounts}" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Promotions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PromotionKpiRow">
            <Grid ColumnSpacing="12" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Positions" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Guests" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="New" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Discount" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Revenue" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Text="{Binding Positions}" Classes="num" />
              <TextBlock Grid.Column="2" Text="{Binding Guests}" Classes="num" />
              <TextBlock Grid.Column="3" Text="{Binding NewGuests}" Classes="num" />
              <TextBlock Grid.Column="4" Text="{Binding Discount}" Classes="num" />
              <TextBlock Grid.Column="5" Text="{Binding Revenue}" Classes="num" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Buchungen nach der Herkunft, die der Termin speichert -->
    <StackPanel x:Name="ManagementChannels" Spacing="8" Grid.IsSharedSizeScope="True" IsVisible="{Binding Channels.Count}">
      <TextBlock Text="Buchungen nach Kanal" Classes="h2" />
      <Grid ColumnSpacing="12" AutomationProperties.AccessibilityView="Raw">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Count" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Kanal" Classes="group" />
        <TextBlock Grid.Column="1" Text="Termine" Classes="group" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Channels}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ReportRow">
            <Grid ColumnSpacing="12" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Count" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" />
              <TextBlock Grid.Column="1" Text="{Binding First}" Classes="num" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Gäste: nur mit dem Recht, Kunden zu sehen (wie die Kundenliste); die Namen gehen nie an die KI -->
    <StackPanel x:Name="ManagementTopGuests" Spacing="8" Grid.IsSharedSizeScope="True" IsVisible="{Binding TopGuests.Count}">
      <TextBlock Text="Beste Gäste" Classes="h2" />
      <Grid ColumnSpacing="12" AutomationProperties.AccessibilityView="Raw">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Visits" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Spent" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Gast" Classes="group" />
        <TextBlock Grid.Column="1" Text="Besuche" Classes="group" />
        <TextBlock Grid.Column="2" Text="Ausgaben" Classes="group" IsVisible="{Binding ShowAmounts}" />
      </Grid>
      <ItemsControl ItemsSource="{Binding TopGuests}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ReportRow">
            <Grid ColumnSpacing="12" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Visits" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Spent" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Text="{Binding First}" Classes="num" />
              <TextBlock Grid.Column="2" Text="{Binding Second}" Classes="num" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel x:Name="ManagementLapsingGuests" Spacing="8" Grid.IsSharedSizeScope="True" IsVisible="{Binding LapsingGuests.Count}">
      <TextBlock Text="Abwandernde Stammgäste" Classes="h2" />
      <TextBlock Text="Mindestens drei Besuche, seit über 90 Tagen keiner und kein Termin geplant. Stand heute." Classes="muted small" TextWrapping="Wrap" />
      <Grid ColumnSpacing="12" AutomationProperties.AccessibilityView="Raw">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Last" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Visits" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Gast" Classes="group" />
        <TextBlock Grid.Column="1" Text="Letzter Besuch" Classes="group" />
        <TextBlock Grid.Column="2" Text="Besuche" Classes="group" />
      </Grid>
      <ItemsControl ItemsSource="{Binding LapsingGuests}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ReportRow">
            <Grid ColumnSpacing="12" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Last" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Visits" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Text="{Binding First}" Classes="num" />
              <TextBlock Grid.Column="2" Text="{Binding Second}" Classes="num" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
