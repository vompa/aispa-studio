<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:AispaStudio.Desktop.Views"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.ClosuresPageView"
             x:DataType="vm:ClosuresPageViewModel">
  <!--
    Seite „Schließzeiten“ (ADR 0098, masken.md R15): Schließzeiten des ganzen Standorts und Raumsperren in einer Liste, kommende zuerst, Vergangenes eingeklappt; die Art ist ein Kennzeichen
    an der Zeile. Oben stehen Titel mit Fragezeichen, Standort, „Einrichtung“ (Wartezeit vor der Nachricht an den Gast) und fest „Neue Schließzeit“. Eine Zeile öffnet ihr Formular in der
    Seitenleiste (Brief 5.12); darin wählt man bei einem neuen „Ganzer Standort“ oder „Einzelner Raum“. Rückmeldungen nach Speichern und Löschen sind ein Toast unten (meldungen.md M1).
  -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:ClosuresViewModel">
      <views:ClosuresView />
    </DataTemplate>
    <DataTemplate DataType="vm:RoomClosuresViewModel">
      <views:RoomClosuresView />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <!-- Kopf: Titel mit Fragezeichen und Satz darunter; rechts Standort, Einrichtung und Neu -->
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock x:Name="PageTitle" Text="Schließzeiten und Raumsperren" Classes="h1" VerticalAlignment="Center" />
        <ui:HelpButton Topic="schliesszeiten" Section="schliesszeiten" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Grid.Row="1" Text="{x:Static vm:ClosuresPageViewModel.HintText}" Classes="muted" TextWrapping="Wrap" />
      <ui:FormField Grid.Column="1" Grid.RowSpan="2" Label="Standort" VerticalAlignment="Bottom" IsVisible="{Binding HasSeveralLocations}">
        <ComboBox x:Name="LocationField" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" MinWidth="200" />
      </ui:FormField>
      <Button Grid.Column="2" Grid.RowSpan="2" x:Name="SetupButton" Command="{Binding OpenSetupCommand}" VerticalAlignment="Bottom" Content="Einrichtung" />
      <Button Grid.Column="3" Grid.RowSpan="2" x:Name="NewButton" Classes="primary" Command="{Binding NewCommand}" VerticalAlignment="Bottom" AutomationProperties.Name="Neue Schließzeit">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ui:Icon Data="{x:Static ui:Icons.Plus}" Width="16" Height="16" />
          <TextBlock Text="Neue Schließzeit" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <ui:InfoBar Grid.Row="1" Severity="{Binding MessageSeverity}" Message="{Binding Message}" IsVisible="{Binding HasMessage}" CloseCommand="{Binding CloseMessageCommand}" />

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <ScrollViewer x:Name="ListScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Margin="0,0,16,16">
          <ui:InfoBar Severity="Error" Title="Die Schließzeiten konnten nicht geladen werden" Message="{Binding LoadError}" IsVisible="{Binding HasLoadError}"
                      ActionText="Erneut laden" ActionCommand="{Binding LoadCommand}" />
          <TextBlock Text="Wird geladen …" Classes="muted" IsVisible="{Binding !IsLoaded}" />
          <TextBlock Text="Es gibt noch keinen Standort." Classes="muted" IsVisible="{Binding HasNoLocation}" />

          <!-- Leerzustand mit der ersten Aktion statt einer leeren Liste -->
          <Border x:Name="EmptyState" Classes="card" Padding="24" IsVisible="{Binding ShowEmpty}">
            <StackPanel Spacing="12" HorizontalAlignment="Left">
              <TextBlock Text="{Binding EmptyTitle}" Classes="h2" TextWrapping="Wrap" />
              <TextBlock Text="{x:Static vm:ClosuresPageViewModel.EmptyText}" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="EmptyNewClosureButton" Classes="primary" Content="Schließzeit anlegen" Command="{Binding NewLocationCommand}" />
                <Button x:Name="EmptyNewRoomButton" Content="Raum sperren" Command="{Binding NewRoomCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel Spacing="12" IsVisible="{Binding ShowList}">
            <!-- Filter nach Art (ADR 0098, Regel 6: Filter statt Zustandsreiter) -->
            <Border x:Name="FilterBar" Classes="segmented" HorizontalAlignment="Left" AutomationProperties.Name="Art der Einträge">
              <ItemsControl ItemsSource="{Binding Filters}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ClosureFilterOption">
                    <ui:TabButton Content="{Binding Label}" IsSelected="{Binding IsOn}" Command="{Binding SelectCommand}" Padding="10,3" MinWidth="0"
                                  AutomationProperties.Name="{Binding Label}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <TextBlock Text="Es gibt keine kommende Schließzeit und keine kommende Raumsperre." Classes="muted" IsVisible="{Binding ShowNoUpcoming}" TextWrapping="Wrap" />
            <TextBlock Text="Für diese Auswahl gibt es keine Einträge." Classes="muted" IsVisible="{Binding ShowNoMatch}" />

            <!-- Kommende: laufende und geplante, nach Beginn -->
            <ListBox x:Name="UpcomingList" Classes="plain" ItemsSource="{Binding Upcoming}" SelectedItem="{Binding SelectedUpcoming}" AutoScrollToSelectedItem="False"
                     AutomationProperties.Name="Kommende Schließzeiten und Raumsperren">
              <ListBox.Styles>
                <!-- Der Name der Zeile nennt Art, Zeitraum, Grund, Termine und Zustand; sonst liest der Screenreader den Typnamen -->
                <Style Selector="ListBoxItem" x:DataType="vm:ClosureEntryRow">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ClosureEntryRow">
                  <views:ClosureEntryLine />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Vergangene: eingeklappt, bis man sie aufklappt -->
            <StackPanel Spacing="8" IsVisible="{Binding HasPast}">
              <Button x:Name="PastToggle" Classes="ghost" Command="{Binding TogglePastCommand}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding PastLabel}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ui:Icon Data="{x:Static ui:Icons.ChevronRight}" Foreground="{DynamicResource Fg2Brush}" Width="16" Height="16" IsVisible="{Binding !IsPastOpen}" />
                  <ui:Icon Data="{x:Static ui:Icons.ChevronDown}" Foreground="{DynamicResource Fg2Brush}" Width="16" Height="16" IsVisible="{Binding IsPastOpen}" />
                  <TextBlock Text="{Binding PastLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <ListBox x:Name="PastList" Classes="plain" ItemsSource="{Binding Past}" SelectedItem="{Binding SelectedPast}" AutoScrollToSelectedItem="False" IsVisible="{Binding IsPastOpen}"
                       AutomationProperties.Name="Vergangene Schließzeiten und Raumsperren">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem" x:DataType="vm:ClosureEntryRow">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ClosureEntryRow">
                    <views:ClosureEntryLine />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Formular des Eintrags als Seitenleiste (Brief 5.12): Speichern, Verwerfen und Löschen fest im Fuß -->
      <ui:SidePanel Grid.Column="1" x:Name="EditPanel" Title="{Binding PanelTitle}" IsOpen="{Binding IsPanelOpen, Mode=TwoWay}" ui:SaveShortcut.IsScope="True">
        <ui:SidePanel.HeaderAction>
          <ui:HelpButton Topic="{Binding Editor.HelpTopic}" Section="{Binding Editor.HelpSection}" Margin="0,0,4,0" />
        </ui:SidePanel.HeaderAction>
        <ui:SidePanel.Body>
          <Grid RowDefinitions="*,Auto">
            <ScrollViewer x:Name="PanelScroll" Classes="panelbody" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="20" Margin="20,12,20,16">
                <!-- Nur bei einem neuen Eintrag: gilt er dem ganzen Standort oder einem Raum? -->
                <StackPanel x:Name="NewKindChoice" Spacing="4" IsVisible="{Binding Editor.IsCreating}" AutomationProperties.Name="Gilt für">
                  <TextBlock Text="Gilt für" Classes="label" />
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton x:Name="NewKindLocation" GroupName="NewClosureKind" Content="Ganzer Standort" IsChecked="{Binding NewIsLocation}" />
                    <RadioButton x:Name="NewKindRoom" GroupName="NewClosureKind" Content="Einzelner Raum" IsChecked="{Binding NewIsRoom}" IsEnabled="{Binding CanSelectRoomKind}" />
                  </StackPanel>
                </StackPanel>
                <Border x:Name="PhasePill" Classes="pill" HorizontalAlignment="Left" IsVisible="{Binding Editor.HasPhase}">
                  <TextBlock Text="{Binding Editor.PhaseText}" />
                </Border>
                <ContentControl x:Name="EditorHost" Content="{Binding Editor}" />
              </StackPanel>
            </ScrollViewer>
            <!-- 60 unten: die runde KI-Schaltfläche der Shell liegt unten rechts über der Seitenleiste und würde „Löschen“ verdecken -->
            <StackPanel x:Name="Footer" Grid.Row="1" Spacing="12" Margin="20,12,20,60">
              <ui:InfoBar Severity="Error" Title="Nicht gespeichert" Message="{Binding Editor.Error}" IsVisible="{Binding Editor.HasError}"
                          ActionText="Erneut versuchen" ActionCommand="{Binding Editor.SaveCommand}" CloseCommand="{Binding Editor.CloseErrorCommand}" />
              <Border Classes="divider" />
              <StackPanel Orientation="Horizontal" Spacing="16">
                <ui:SaveBar SaveCommand="{Binding Editor.SaveCommand}" DiscardCommand="{Binding Editor.DiscardCommand}" CanDiscard="{Binding Editor.HasUnsavedChanges}" />
                <Button x:Name="DeleteButton" Classes="danger" Content="Löschen" Command="{Binding Editor.DeleteCommand}" IsVisible="{Binding Editor.CanDelete}" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </ui:SidePanel.Body>
      </ui:SidePanel>

      <!-- Einrichtung: die Wartezeit vor der Nachricht an den Gast (ADR 0098, Regel 4) -->
      <ui:SidePanel Grid.Column="1" x:Name="SetupPanel" Title="Einrichtung" Subtitle="Schließzeiten" IsOpen="{Binding IsSetupOpen, Mode=TwoWay}">
        <ui:SidePanel.HeaderAction>
          <ui:HelpButton Topic="schliesszeiten" Section="wartezeit" Margin="0,0,4,0" />
        </ui:SidePanel.HeaderAction>
        <ui:SidePanel.Body>
          <ScrollViewer Classes="panelbody" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="20,12,20,16">
              <TextBlock Text="Nachricht an den Gast bei einer Absage" Classes="h2" TextWrapping="Wrap" />
              <TextBlock Text="Nicht eingerichtet: Die Wartezeit des Standorts ließ sich nicht laden." Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding !Setup.HasGuestDelay}" />
              <StackPanel Spacing="4" IsVisible="{Binding Setup.HasGuestDelay}">
                <TextBlock Text="Senden nach (Minuten)" Classes="label" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ui:NumberField x:Name="GuestDelayField" Value="{Binding Setup.GuestDelayMinutes}" Minimum="0" Maximum="60" Width="100"
                                  AutomationProperties.Name="Wartezeit vor der Nachricht an den Gast in Minuten" />
                  <Button x:Name="GuestDelayButton" Classes="primary" Content="Wartezeit speichern" Command="{Binding Setup.SaveGuestDelayCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Setup.GuestDelayError}" Classes="small error" TextWrapping="Wrap" IsVisible="{Binding Setup.GuestDelayError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{x:Static vm:ClosureSetupViewModel.GuestDelayHint}" Classes="muted small" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </ui:SidePanel.Body>
      </ui:SidePanel>
    </Grid>
  </Grid>
</UserControl>
