<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.PeriodList"
             x:DataType="vm:PeriodAreaViewModel">
  <!-- Die Einträge (R05 Slice 95): Art, Zeitraum und eine Nebenzeile; leer sagt der Text, was fehlt. „Beendete zeigen“ steht über der Liste wie „Ausgeschiedene zeigen“ im
       Team (ADR 0098); beendete Einträge stehen nach den aktuellen und tragen das Wort „Beendet“ -->
  <Border Classes="card" Padding="8" VerticalAlignment="Top">
    <StackPanel Spacing="8">
      <CheckBox x:Name="ShowEndedBox" Content="{Binding ShowEndedLabel}" IsChecked="{Binding ShowEnded}" />
      <ui:InfoBar Severity="Error" Title="{Binding LoadFailedText}" Message="{Binding LoadError}" IsVisible="{Binding HasLoadError}"
                  ActionText="Erneut laden" ActionCommand="{Binding LoadCommand}" />
      <TextBlock Text="Wird geladen …" Classes="muted" Margin="8,4" IsVisible="{Binding !IsLoaded}" />
      <TextBlock Text="{Binding EmptyText}" Classes="muted" TextWrapping="Wrap" Margin="8,4" IsVisible="{Binding ShowEmpty}" />
      <!-- Die Liste holt die gewählte Zeile nicht selbst ins Bild: Sie rollt nicht für sich, und auf der Seite mit zwei Abschnitten rollte sonst beim Öffnen die ganze Seite
           zur gewählten Raumsperre (gemessen: 521 px) -->
      <ListBox x:Name="PeriodListBox" Classes="plain" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoScrollToSelectedItem="False"
               AutomationProperties.Name="{Binding ListLabel}">
        <ListBox.Styles>
          <!-- Der Name der Zeile nennt Art, Zeitraum und Nebenzeile; sonst liest der Screenreader den Typnamen -->
          <Style Selector="ListBoxItem" x:DataType="vm:PeriodRow">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PeriodRow">
            <StackPanel Spacing="2" Margin="0,2">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="Beendet" Classes="muted small" VerticalAlignment="Center" IsVisible="{Binding IsEnded}" />
              </Grid>
              <TextBlock Text="{Binding Period}" Classes="muted small num" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Detail}" Classes="muted small" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </Border>
</UserControl>
