<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.AbsenceRequestsView"
             x:DataType="vm:AbsenceRequestsViewModel">
  <!--
    Offene Abwesenheitsanträge aus der Handy-App (R05 Slice 99): je Antrag Person, Art, Zeitraum, Anmerkung und die Zahl der Termine in der Zeit, mit Genehmigen und Ablehnen.
    Steht seit ADR 0098 in der Seitenleiste „Anträge“ des Wochenplans (Breite 360, Brief 5.12): Titel und Fragezeichen trägt der Kopf der Leiste, je Antrag eine Karte,
    unten links „Ablehnen“ (sekundär), rechts „Genehmigen“ (primär).
  -->
  <StackPanel Spacing="12">
    <ui:InfoBar Severity="Error" Title="Anträge nicht geladen" Message="{Binding LoadError}" IsVisible="{Binding HasLoadError}"
                ActionText="Erneut laden" ActionCommand="{Binding LoadCommand}" />
    <ui:InfoBar x:Name="RequestMessage" Severity="{Binding MessageSeverity}" Message="{Binding Message}" IsVisible="{Binding HasMessage}" CloseCommand="{Binding CloseMessageCommand}" />
    <TextBlock Text="Lade Anträge …" Classes="muted" IsVisible="{Binding !IsLoaded}" />
    <TextBlock x:Name="RequestsEmpty" Text="Es gibt keine offenen Anträge." Classes="muted" IsVisible="{Binding IsEmpty}" />
    <TextBlock Text="{Binding CountText}" Classes="group" IsVisible="{Binding !IsEmpty}" />
    <ItemsControl x:Name="RequestList" ItemsSource="{Binding Rows}" AutomationProperties.Name="Offene Anträge">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="12" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AbsenceRequestRow">
          <Border Classes="panelcard" Padding="16,12">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Name}" FontWeight="Medium" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Description}" Classes="num" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
                <TextBlock Text="{Binding AffectedText}" Classes="small" Foreground="{DynamicResource WarnBrush}" FontWeight="Medium" TextWrapping="Wrap" IsVisible="{Binding HasAffected}" />
                <TextBlock Text="{Binding RequestedText}" Classes="muted small" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Content="Ablehnen" Command="{Binding RejectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="{Binding RejectName}" />
                <Button Grid.Column="1" Content="Genehmigen" Classes="primary" Command="{Binding ApproveCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="{Binding ApproveName}" />
              </Grid>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
