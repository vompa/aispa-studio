<views:PeriodAreaView xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:views="using:AispaStudio.Desktop.Views"
                      xmlns:vm="using:AispaStudio.Desktop.ViewModels"
                      xmlns:ui="using:AispaStudio.Desktop.Controls"
                      x:Class="AispaStudio.Desktop.Views.RoomClosuresView"
                      x:DataType="vm:RoomClosuresViewModel">
  <!--
    Formular „Raumsperre“ (R05 Slice 95, ADR 0076; seit ADR 0098 der Inhalt der Seitenleiste der Seite „Schließzeiten“), nach web/src/closures/RoomClosuresPage.tsx: Meldung, Warnung über offene Termine, Raum,
    Zeitraum sowie Art und Grund (Gruppen mit Überschrift und Fragezeichen am Titel, Brief 5.11). „Speichern / Verwerfen“ und „Löschen“ stehen fest im Fuß der Seitenleiste (Strg+S), nicht hier.
  -->
  <StackPanel Spacing="20">
    <ui:InfoBar x:Name="FormMessage" Severity="{Binding MessageSeverity}" Message="{Binding Message}" IsVisible="{Binding HasMessage}" CloseCommand="{Binding CloseMessageCommand}" />

    <ui:InfoBar Severity="Warning" Message="{Binding OpenNotice}" IsVisible="{Binding HasOpenNotice}" />

    <!-- Raum -->
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Raum" Classes="h2" VerticalAlignment="Center" />
        <ui:HelpButton Grid.Column="1" Topic="raumsperren" Section="raum" />
      </Grid>
      <ui:FormField Label="Gesperrter Raum" IsRequired="True" Error="{Binding RoomError}" IsVisible="{Binding CanSelectRoom}">
        <ComboBox x:Name="RoomField" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" IsEnabled="{Binding CanSelectRoom}" MinWidth="200" HorizontalAlignment="Left" />
      </ui:FormField>
      <!-- Der Raum einer bestehenden Sperre bleibt: ein dauerhaft unveränderlicher Wert ist Text, kein gesperrtes Feld (design.md 5.16) -->
      <StackPanel x:Name="RoomFixed" Spacing="4" IsVisible="{Binding !CanSelectRoom}">
        <TextBlock Text="Gesperrter Raum" Classes="label" />
        <TextBlock x:Name="RoomFixedText" Text="{Binding RoomName}" Classes="value" AutomationProperties.Name="Gesperrter Raum" />
        <TextBlock Text="Der Raum einer Sperre lässt sich nicht ändern." Classes="muted small" />
      </StackPanel>
    </StackPanel>

    <views:PeriodSection />

    <!-- Art und Grund -->
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Art und Grund" Classes="h2" VerticalAlignment="Center" />
        <ui:HelpButton Grid.Column="1" Topic="raumsperren" Section="art" />
      </Grid>
      <StackPanel Spacing="4" AutomationProperties.Name="Art der Raumsperre">
        <RadioButton x:Name="KindMaintenance" GroupName="RoomClosureKind" IsChecked="{Binding Kinds[0].IsSelected}" Content="{Binding Kinds[0].Label}" />
        <RadioButton x:Name="KindDamage" GroupName="RoomClosureKind" IsChecked="{Binding Kinds[1].IsSelected}" Content="{Binding Kinds[1].Label}" />
        <RadioButton x:Name="KindRenovation" GroupName="RoomClosureKind" IsChecked="{Binding Kinds[2].IsSelected}" Content="{Binding Kinds[2].Label}" />
        <RadioButton x:Name="KindOther" GroupName="RoomClosureKind" IsChecked="{Binding Kinds[3].IsSelected}" Content="{Binding Kinds[3].Label}" />
      </StackPanel>
      <ui:FormField Label="Grund für das Team" Error="{Binding ReasonError}"
                    Help="Steht im Kalender im Kopf des Raums, z. B. „Wasserschaden, Trocknung bis Freitag“.">
        <TextBox x:Name="ReasonField" Text="{Binding Reason}" MaxLength="200" />
      </ui:FormField>
    </StackPanel>

    <TextBlock Text="{Binding CreatedText}" Classes="muted small" IsVisible="{Binding HasCreatedText}" TextWrapping="Wrap" />
  </StackPanel>
</views:PeriodAreaView>
