<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16">
    <!-- Kopfzeile -->
    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="Verlauf" Classes="h1" />
      <TextBlock Text="Was im Betrieb passiert ist: Buchungen, Stornos, Zahlungen und mehr" Classes="muted" />
    </StackPanel>

    <!-- Suche und Zeitraum -->
    <WrapPanel Grid.Row="1" ItemSpacing="8" LineSpacing="8" Margin="0,0,0,8">
      <ui:SearchField x:Name="SearchBox" Width="360" Text="{Binding Query}" PlaceholderText="Gast, Behandlung, Person oder Grund"
                      AutomationProperties.Name="Verlauf durchsuchen" ToolTip.Tip="Der Server sucht in Gast, Behandlung, Person und Grund (Strg+F)." />
      <ui:TabButton x:Name="PeriodToday" Classes="headchip" Content="Heute" Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static vm:ActivityPeriod.Today}"
              IsSelected="{Binding Period, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActivityPeriod.Today}, Mode=OneWay}"
              AutomationProperties.Name="Zeitraum Heute" />
      <ui:TabButton x:Name="PeriodYesterday" Classes="headchip" Content="Gestern" Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static vm:ActivityPeriod.Yesterday}"
              IsSelected="{Binding Period, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActivityPeriod.Yesterday}, Mode=OneWay}"
              AutomationProperties.Name="Zeitraum Gestern" />
      <ui:TabButton x:Name="PeriodWeek" Classes="headchip" Content="7 Tage" Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static vm:ActivityPeriod.Week}"
              IsSelected="{Binding Period, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActivityPeriod.Week}, Mode=OneWay}"
              AutomationProperties.Name="Zeitraum 7 Tage" />
      <ui:TabButton x:Name="PeriodMonth" Classes="headchip" Content="30 Tage" Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static vm:ActivityPeriod.Month}"
              IsSelected="{Binding Period, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActivityPeriod.Month}, Mode=OneWay}"
              AutomationProperties.Name="Zeitraum 30 Tage" />
      <ui:TabButton x:Name="PeriodCustom" Classes="headchip" Content="Zeitraum" Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static vm:ActivityPeriod.Custom}"
              IsSelected="{Binding IsCustomPeriod, Mode=OneWay}" AutomationProperties.Name="Zeitraum frei wählen" />
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCustomPeriod}">
        <ui:DateField x:Name="FromField" Value="{Binding CustomFrom}" AutomationProperties.Name="Von" />
        <TextBlock Text="bis" Classes="muted" VerticalAlignment="Center" />
        <ui:DateField x:Name="UntilField" Value="{Binding CustomUntil}" AutomationProperties.Name="Bis" />
      </StackPanel>
    </WrapPanel>

    <!-- Arten, Person, Kanal -->
    <WrapPanel Grid.Row="2" ItemSpacing="8" LineSpacing="8" Margin="0,0,0,12">
      <ItemsControl ItemsSource="{Binding KindChips}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemSpacing="8" LineSpacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ActivityKindChip">
            <Button x:Name="KindChip" Classes="headchip" Classes.on="{Binding IsOn}" Content="{Binding Label}" Command="{Binding ToggleCommand}"
                    ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Label}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ComboBox x:Name="PersonBox" ItemsSource="{Binding People}" SelectedItem="{Binding Person}" MinWidth="180" IsVisible="{Binding HasPersonChoice}"
                AutomationProperties.Name="Person" ToolTip.Tip="Zeigt nur, was diese Person gemacht hat." />
      <ComboBox x:Name="ChannelBox" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" MinWidth="160"
                AutomationProperties.Name="Kanal" ToolTip.Tip="Zeigt nur Einträge, die über diesen Weg entstanden sind." />
      <Button x:Name="ResetChip" Classes="headchip on" Content="Zurücksetzen" Command="{Binding ResetCommand}" IsVisible="{Binding IsModified}"
              AutomationProperties.Name="Filter zurücksetzen" ToolTip.Tip="Setzt alle Filter und den Zeitraum zurück." />
    </WrapPanel>

    <!-- Liste nach Tagen -->
    <Border Grid.Row="3" Classes="card" Padding="12">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <ui:InfoBar Severity="Error" Margin="0,0,0,8" Message="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Grid.Row="1" Text="Wird geladen …" Classes="muted" IsVisible="{Binding ShowLoading}" />
        <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Left" IsVisible="{Binding ShowEmpty}">
          <TextBlock x:Name="EmptyText" Text="{Binding EmptyText}" Classes="muted" />
          <Button x:Name="EmptyResetButton" Content="Filter zurücksetzen" Command="{Binding ResetCommand}" HorizontalAlignment="Left" IsVisible="{Binding HasFilter}" />
        </StackPanel>
        <ListBox x:Name="List" Grid.Row="2" Classes="plain" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedItem}" AutomationProperties.Name="Verlauf">
          <ListBox.Styles>
            <!-- Der Name der Zeile ist ihr Satz; ein Tageskopf ist weder wählbar noch ein Ziel der Pfeiltasten -->
            <Style Selector="ListBoxItem" x:DataType="vm:ActivityListItem">
              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
              <Setter Property="Focusable" Value="{Binding CanSelect}" />
              <Setter Property="IsHitTestVisible" Value="{Binding CanSelect}" />
            </Style>
          </ListBox.Styles>
          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:ActivityDayHeader">
              <TextBlock Text="{Binding Title}" Classes="h3" Margin="0,12,0,4" />
            </DataTemplate>
            <DataTemplate DataType="vm:ActivityRow">
              <Grid ColumnDefinitions="52,24,*,Auto" MinHeight="34" ColumnSpacing="8">
                <TextBlock Text="{Binding Time}" Classes="num" Foreground="{DynamicResource Fg2Brush}" VerticalAlignment="Center" />
                <ui:Icon Grid.Column="1" Classes="kind" Data="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center"
                         Classes.warn="{Binding IsWarn}" Classes.ok="{Binding IsOk}" Classes.accent="{Binding IsAccent}" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,4">
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Detail}" Classes="small" Foreground="{DynamicResource Fg2Brush}" IsVisible="{Binding HasDetail}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Border Classes="pill warn" IsVisible="{Binding IsLate}"><TextBlock Text="Kurzfristig" /></Border>
                  <Border Classes="pill accent" IsVisible="{Binding IsOnline}"><TextBlock Text="Online" /></Border>
                  <Border Classes="pill" IsVisible="{Binding IsAssistant}"><TextBlock Text="Terminannahme" /></Border>
                  <Border Classes="pill" IsVisible="{Binding IsBackground}"><TextBlock Text="Hintergrund" /></Border>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
        <Button x:Name="MoreButton" Grid.Row="3" Content="Weitere laden" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Center" Margin="0,8,0,0"
                IsVisible="{Binding ShowMore}" />
      </Grid>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="ui|Icon.kind">
      <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
    </Style>
    <Style Selector="ui|Icon.kind.warn">
      <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
    </Style>
    <Style Selector="ui|Icon.kind.ok">
      <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
    </Style>
    <Style Selector="ui|Icon.kind.accent">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>
</UserControl>
