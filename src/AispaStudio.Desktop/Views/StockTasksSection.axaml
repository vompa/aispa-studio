<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.StockTasksSection"
             x:DataType="vm:StockTasksViewModel">
  <!--
    Aufgaben des Lagers (R05 Slice 112): „Bald ablaufend“, „Abverkaufsliste“ und „Abgelaufen“. Erledigt ist eine Aufgabe, wenn die Charge verbraucht oder ausgebucht ist.
  -->
  <StackPanel Spacing="16">
    <ui:InfoBar Severity="Error" Title="Aufgaben nicht geladen" Message="{Binding LoadError}" IsVisible="{Binding HasLoadError}" />

    <!-- Ablaufliste als PDF (PDF-Ausgaben F, ADR 0091): „Ablaufliste als PDF“ öffnet die Wahl des Zeitraums und den Knopfblock ohne Senden -->
    <Border Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Ablaufliste" Classes="h2" VerticalAlignment="Center" />
          <Button x:Name="ExpiringDocumentButton" Grid.Column="1" Content="Ablaufliste als PDF" Command="{Binding ToggleDocumentCommand}"
                  ToolTip.Tip="Druckt oder speichert die Chargen, die in den nächsten Tagen ablaufen." />
        </Grid>
        <StackPanel x:Name="ExpiringDocumentCard" Spacing="8" IsVisible="{Binding IsDocumentOpen}">
          <ui:FormField Label="Zeitraum">
            <ComboBox x:Name="ExpiringDays" ItemsSource="{Binding DaysOptions}" SelectedItem="{Binding SelectedDays}" MinWidth="160" HorizontalAlignment="Left"
                      AutomationProperties.Name="Zeitraum der Ablaufliste">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:Int32">
                  <TextBlock Text="{Binding StringFormat='{}{0} Tage'}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </ui:FormField>
          <TextBlock Text="Druckt die Chargen, die in diesem Zeitraum ablaufen, zuerst ablaufend zuerst." Classes="muted small" TextWrapping="Wrap" />
          <ui:DocumentActions DataContext="{Binding Document}" />
          <TextBlock Text="{Binding DocumentMessage}" Classes="secondary small" AutomationProperties.LiveSetting="Polite"
                     IsVisible="{Binding DocumentMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Classes="card" IsVisible="{Binding ShowEmpty}">
      <TextBlock Text="Keine Aufgaben. Es läuft gerade keine Charge ab." Classes="muted" />
    </Border>

    <Border Classes="card" IsVisible="{Binding HasExpiring}">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Bald ablaufend" Classes="h2" VerticalAlignment="Center" />
          <ui:HelpButton Grid.Column="1" Topic="lager-ablauf-aufgaben" />
        </Grid>
        <TextBlock Text="Chargen innerhalb der Ablaufwarnung ihres Materials, zuerst ablaufend zuerst." Classes="muted small" TextWrapping="Wrap" />
        <ItemsControl x:Name="TaskExpiringList" ItemsSource="{Binding Expiring}" AutomationProperties.Name="Bald ablaufend">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StockTaskRow">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,4">
                <TextBlock Text="{Binding Material}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding BatchText}" MinWidth="80" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding PlaceName}" MinWidth="120" Margin="12,0,0,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" MinWidth="176" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ExpiryText}" Classes="num" />
                  <TextBlock Text="{Binding DueText}" Classes="warn small" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="4" Text="{Binding QuantityText}" Classes="num" MinWidth="96" Margin="12,0,0,0" TextAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding HasSellOff}">
      <StackPanel Spacing="12">
        <TextBlock Text="Abverkaufsliste" Classes="h2" />
        <TextBlock Text="Bald ablaufende Chargen, die an der Kassa verkauft werden können. Abgelaufenes steht nie auf dieser Liste." Classes="muted small" TextWrapping="Wrap" />
        <ItemsControl x:Name="TaskSellOffList" ItemsSource="{Binding SellOff}" AutomationProperties.Name="Abverkaufsliste">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StockTaskRow">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,4">
                <TextBlock Text="{Binding ArticleText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding PlaceName}" MinWidth="120" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding DueText}" Classes="warn small" MinWidth="96" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding QuantityText}" Classes="num" MinWidth="96" Margin="12,0,0,0" TextAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding HasExpired}">
      <StackPanel Spacing="12">
        <TextBlock Text="Abgelaufen" Classes="h2" />
        <TextBlock Text="Diese Chargen darfst du nicht mehr verwenden. Buche sie aus, sobald sie entsorgt sind." Classes="muted small" TextWrapping="Wrap" />
        <ItemsControl x:Name="TaskExpiredList" ItemsSource="{Binding Expired}" AutomationProperties.Name="Abgelaufen">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StockTaskRow">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="0,4">
                <TextBlock Text="{Binding Material}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding BatchText}" MinWidth="80" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding PlaceName}" MinWidth="120" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding DueText}" Classes="crit small" MinWidth="176" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding QuantityText}" Classes="num" MinWidth="96" Margin="12,0,0,0" TextAlignment="Right" VerticalAlignment="Center" />
                <Button Grid.Column="5" Content="Ausbuchen" Classes="small" Margin="12,0,0,0" Command="{Binding WriteOffCommand}" AutomationProperties.Name="{Binding WriteOffName}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
