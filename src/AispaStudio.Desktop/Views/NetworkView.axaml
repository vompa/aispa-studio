<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.NetworkView"
             x:DataType="vm:NetworkViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
      <StackPanel>
        <TextBlock Text="Im Netz" Classes="h1" />
        <TextBlock Text="Weitere PCs im Spa, z. B. in den Behandlungsräumen oder an einer zweiten Kassa, arbeiten mit derselben Datenbank wie dieser PC. Die Verbindung ist verschlüsselt; die Datenbank selbst bleibt nur auf diesem PC erreichbar. Dieser PC muss dafür an sein und die App offen haben."
                   Classes="muted" TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:Icon Data="{x:Static ui:Icons.Wifi}" Width="18" Height="18" />
            <TextBlock Text="Freigabe" Classes="h2" />
            <ui:HelpButton Topic="im-netz" Section="freigabe" />
          </StackPanel>
          <TextBlock Text="{Binding StateText}" TextWrapping="Wrap" />
          <StackPanel Spacing="6" IsVisible="{Binding IsShared}">
            <TextBlock Text="Adresse (eine davon)" Classes="muted small" />
            <SelectableTextBlock Text="{Binding AddressesText}" FontFamily="Consolas, Menlo, monospace" />
            <TextBlock Text="Verbindungscode" Classes="muted small" />
            <SelectableTextBlock Text="{Binding Code}" FontFamily="Consolas, Menlo, monospace" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Am anderen PC Adresse und Verbindungscode unter „Mit Haupt-PC im Netz verbinden“ eintragen. Die Anmeldung dort ist dieselbe wie hier: Benutzername und Passwort."
                       Classes="muted small" TextWrapping="Wrap" />
            <ui:TechnicalDetails Text="Die App am anderen PC ohne „--standalone“ starten. Im Browser warnt die Seite einmal vor dem eigenen Zertifikat." />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding CanConfigure}">
            <Button Classes="primary" Content="Im Netz freigeben" Command="{Binding ShareCommand}" IsVisible="{Binding !IsShared}" />
            <Button Content="Freigabe zurücknehmen" Command="{Binding StopSharingCommand}" IsVisible="{Binding IsShared}" />
            <TextBlock Text="{Binding Message}" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
