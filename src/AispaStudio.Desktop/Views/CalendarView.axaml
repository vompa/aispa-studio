<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:c="using:AispaStudio.Contracts"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             xmlns:local="using:AispaStudio.Desktop.Views"
             xmlns:svc="using:AispaStudio.Desktop.Services"
             x:Class="AispaStudio.Desktop.Views.CalendarView"
             x:DataType="vm:CalendarViewModel"
             x:Name="Root"
             Focusable="True"
             FocusAdorner="{x:Null}">

  <UserControl.DataTemplates>
    <!-- Konfliktmeldung in Ortszeit (Design-Brief 5.9): in jedem Panel als ContentControl an „Conflict“ gebunden -->
    <DataTemplate DataType="vm:ConflictNotice">
      <local:ConflictNoticeView />
    </DataTemplate>
    <!-- Ausgewählter Termin -->
    <DataTemplate DataType="vm:AppointmentViewModel">
      <StackPanel Spacing="12">
        <!-- Meldung zum Termin oben im Panel (meldungen.md, M2); der Kopf mit Gast, Stift, Status und Dauer steht fest im Rahmen der Seitenleiste -->
        <ui:InfoBar Severity="Error" Message="{Binding Error}" IsVisible="{Binding ErrorOnTop}"
                    CloseCommand="{Binding ClearErrorCommand}" />
        <ContentControl Content="{Binding Conflict}" IsVisible="{Binding ConflictOnTop}" />
        <!-- Auftrag aus „KI und Hilfe“ (Ä319): Hinweis auf den Vorschlag der KI, gespeichert wird erst mit dem Knopf im Termin -->
        <ui:InfoBar Severity="Info" Message="{Binding AssistantNote}" IsVisible="{Binding AssistantNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Spacing="12">

        <Border Classes="panelcard">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ui:Icon Data="{x:Static ui:Icons.Clock}" Foreground="{DynamicResource AccentBrush}" Width="20" Height="20" />
              <StackPanel>
                <TextBlock Text="{Binding TimeText}" FontSize="18" FontWeight="SemiBold" Classes="num" />
                <TextBlock Text="{Binding DateText}" Classes="muted small" />
              </StackPanel>
            </StackPanel>
            <!-- Zeitbalken (5.12, Punkt 5): Abschnitte nach Minuten; ein Klick auf Vor- oder Nachbereitung öffnet die Zahlenfelder -->
            <StackPanel Spacing="4">
              <ui:TimeBar Segments="{Binding TimeBar}" Status="{Binding TimeBarStatus}" CanEdit="{Binding CanChangeTimes}"
                          EditCommand="{Binding BeginEditTimesCommand}" />
              <Grid ColumnDefinitions="*,*">
                <TextBlock Text="{Binding TimeBarFrom}" Classes="muted small num" />
                <TextBlock Grid.Column="1" Text="{Binding TimeBarUntil}" Classes="muted small num" HorizontalAlignment="Right" />
              </Grid>
            </StackPanel>
            <TextBlock Text="{Binding BoundText}" Classes="secondary small" TextWrapping="Wrap" />
            <!-- Vor- und Nachbereitung nur dieses Termins (Mehr › Zeiten dieses Termins ändern …); Esc bricht ab -->
            <StackPanel Spacing="8" IsVisible="{Binding IsEditingTimes}">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <ui:FormField Label="Vorbereitung (min)" IsRequired="True">
                  <ui:NumberField x:Name="PreparationBox" Value="{Binding TimesPreparation}" Minimum="0" Maximum="120" Increment="5" LargeIncrement="15" ShowSpinner="True"
                                  AutomationProperties.Name="Vorbereitung in Minuten" />
                </ui:FormField>
                <ui:FormField Grid.Column="1" Label="Nachbereitung (min)" IsRequired="True">
                  <ui:NumberField x:Name="FollowUpBox" Value="{Binding TimesFollowUp}" Minimum="0" Maximum="120" Increment="5" LargeIncrement="15" ShowSpinner="True"
                                  AutomationProperties.Name="Nachbereitung in Minuten" />
                </ui:FormField>
              </Grid>
              <TextBlock Text="Gilt nur für diesen Termin; der Planer prüft Person, Raum und Gerät zur selben Startzeit." Classes="muted small" TextWrapping="Wrap" />
              <UniformGrid Columns="2" ColumnSpacing="8">
                <Button Classes="primary" Content="Übernehmen" Command="{Binding ApplyTimesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        IsDefault="True" ui:SaveShortcut.IsSave="True" ToolTip.Tip="Übernehmen (Strg+S)">
                  <Button.IsEnabled>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="IsValid" ElementName="PreparationBox" />
                      <Binding Path="IsValid" ElementName="FollowUpBox" />
                    </MultiBinding>
                  </Button.IsEnabled>
                </Button>
                <Button Classes="ghost" Content="Abbrechen" Command="{Binding CancelEditTimesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              </UniformGrid>
            </StackPanel>
            <Border Classes="divider" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
              <ui:Icon Data="{x:Static ui:Icons.User}" Foreground="{DynamicResource Fg2Brush}" Width="16" Height="16" />
              <TextBlock Grid.Column="1" Text="{Binding EmployeeName}" VerticalAlignment="Center" />
              <ui:Icon Grid.Row="1" Data="{x:Static ui:Icons.Door}" Foreground="{DynamicResource Fg2Brush}" Width="16" Height="16" />
              <!-- Klick (Enter, Leertaste) auf den Raum zeigt Raumart, Raumpflege, Behandlungen und die Termine des Raums an dem Tag -->
              <Button Grid.Row="1" Grid.Column="1" Classes="ghost" Padding="0" MinHeight="0" Background="Transparent" HorizontalAlignment="Left"
                      IsEnabled="{Binding RoomInfo, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Raum-Infos" Click="OnRoomInfoClick"
                      AutomationProperties.Name="{Binding RoomName, StringFormat='Raum-Infos {0}'}">
                <TextBlock Text="{Binding RoomName}" VerticalAlignment="Center" TextDecorations="Underline" />
                <!-- Die Karte hängt an der Seitenleiste, nicht am Knopf: sie steht links daneben und verdeckt das Panel nicht -->
                <FlyoutBase.AttachedFlyout>
                  <Flyout Placement="LeftEdgeAlignedTop">
                    <ContentControl Content="{Binding RoomInfo}" AutomationProperties.Name="{Binding RoomInfo.AccessibleName}" />
                  </Flyout>
                </FlyoutBase.AttachedFlyout>
              </Button>
              <ui:Icon Grid.Row="2" Data="{x:Static ui:Icons.Register}" Foreground="{DynamicResource Fg2Brush}" Width="16" Height="16" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Price}" VerticalAlignment="Center" Classes="num" />
            </Grid>
            <!-- Notiz zu diesem Termin (Runde 5, Ä33): ohne Notiz ein Link, mit Notiz die Hinweisfläche darunter -->
            <Button x:Name="AddNoteLink" Classes="link" HorizontalAlignment="Left" Command="{Binding BeginEditNoteCommand}" IsVisible="{Binding CanAddNote}"
                    IsEnabled="{Binding !IsEditingTimes}" ToolTip.Tip="Notiz nur zu diesem Termin schreiben">
              <TextBlock Text="Notiz hinzufügen" />
            </Button>
          </StackPanel>
        </Border>

        <!-- Geburtstag des Gastes (Ä45): heute mit Alter, drei Tage davor und danach als Hinweis -->
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0" IsVisible="{Binding HasBirthday}">
          <ui:Icon Data="{x:Static ui:Icons.Gift}" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Birthday}" VerticalAlignment="Center" />
        </StackPanel>

        <Border Classes="hint warn" IsVisible="{Binding ShowNote}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <ui:Icon Data="{x:Static ui:Icons.Note}" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{Binding Note}" TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" />
            <Button x:Name="EditNoteButton" Grid.Column="2" Classes="ghost icon" Width="28" Height="28" MinHeight="28" Margin="0,-4,-6,-4" VerticalAlignment="Top" Command="{Binding BeginEditNoteCommand}"
                    IsVisible="{Binding CanChangeNote}" IsEnabled="{Binding !IsEditingTimes}" ToolTip.Tip="Notiz ändern" AutomationProperties.Name="Notiz ändern">
              <ui:Icon Data="{x:Static ui:Icons.Pencil}" Width="16" Height="16" Foreground="{DynamicResource WarnBrush}" />
            </Button>
          </Grid>
        </Border>

        <!-- Notiz schreiben oder ändern: mehrzeilig (Höhe 68, Zähler), Strg+Enter speichert, Esc stellt zurück und beim zweiten Mal bricht es ab -->
        <Border Classes="panelcard" IsVisible="{Binding IsEditingNote}">
          <StackPanel Spacing="8">
            <ui:FormField Label="Notiz zum Termin" Help="Nur für diesen Termin." Error="{Binding NoteError}">
              <TextBox x:Name="AppointmentNoteBox" Text="{Binding NoteText}" AcceptsReturn="True" MaxLength="500" AutomationProperties.Name="Notiz zum Termin"
                       PlaceholderText="z. B. Lavendelöl, wenig Gespräch" />
            </ui:FormField>
            <UniformGrid Columns="2" ColumnSpacing="8">
              <Button Classes="ghost" Content="Abbrechen" Command="{Binding CancelEditNoteCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Abbrechen (Esc)" />
              <Button Classes="primary" Content="Notiz speichern" Command="{Binding SaveNoteCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      IsDefault="True" IsEnabled="{Binding !IsSavingNote}" ui:SaveShortcut.IsSave="True" ToolTip.Tip="Speichern (Strg+S oder Strg+Enter)" />
            </UniformGrid>
          </StackPanel>
        </Border>

        <!-- Aktionsblock (5.12, Punkt 6): direkt unter Termin-Infos und Notiz (Auftraggeber, 05.11.2026), vor Kunde, Verlauf und den übrigen Karten, primär in voller Breite, darunter sekundär, „Mehr“ als Ghost -->
        <StackPanel Spacing="8" Margin="0,4,0,0">
          <Button Classes.primary="{Binding !IsEditingCard}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding AskRestoreCommand}" IsVisible="{Binding ShowRestore}" ToolTip.Tip="Der Termin ist danach wieder gebucht, wenn Zeit, Person und Raum frei sind">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ui:Icon Data="{x:Static ui:Icons.Undo}" Width="16" Height="16" />
              <TextBlock Text="Stornierung zurücknehmen" />
            </StackPanel>
          </Button>
          <Button Classes.primary="{Binding !IsEditingCard}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding CheckInCommand}" IsVisible="{Binding ShowCheckIn}" ToolTip.Tip="Einchecken (E)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ui:Icon Data="{x:Static ui:Icons.Check}" />
              <TextBlock Text="Einchecken" />
            </StackPanel>
          </Button>
          <Button Classes.primary="{Binding !IsEditingCard}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding CheckoutCommand}" IsVisible="{Binding CanCheckout}" ToolTip.Tip="Kassieren (K)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ui:Icon Data="{x:Static ui:Icons.Register}" Width="16" Height="16" />
              <TextBlock Text="Kassieren" />
            </StackPanel>
          </Button>
          <!-- „Passt dazu“ (Slice 115): nach dem Abschließen Artikel mit Bestand am Verkaufsregal; „Mit kassieren“ öffnet die Kassa mit Termin und Artikel -->
          <ItemsControl ItemsSource="{Binding Recommendations}" IsVisible="{Binding HasRecommendations}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PanelRecommendation">
                <Border Classes="hint">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel>
                      <TextBlock Text="Passt dazu" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Text}" Classes="muted small" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="small" Content="Mit kassieren" VerticalAlignment="Center" AutomationProperties.Name="{Binding CheckoutName}"
                            ToolTip.Tip="Kassa mit diesem Termin öffnen und den Artikel auf die Rechnung legen"
                            Command="{Binding #Root.((vm:CalendarViewModel)DataContext)?.Selected?.CheckoutWithArticleCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Verschieben …" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding AskMoveToDayCommand}" ToolTip.Tip="Termin auf einen anderen Tag oder eine andere Uhrzeit verschieben">
            <Button.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="CanMoveToDay" />
                <Binding Path="!IsMovingToDay" />
              </MultiBinding>
            </Button.IsVisible>
          </Button>
          <Border Classes="panelcard" IsVisible="{Binding IsMovingToDay}">
            <StackPanel Spacing="8">
              <TextBlock Text="Verschieben" FontWeight="Medium" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <ui:FormField Label="Tag">
                  <ui:DateField x:Name="MoveDateBox" CommittedText="{Binding MoveDateText}" Minimum="{Binding Today}" />
                </ui:FormField>
                <ui:FormField Label="Beginn">
                  <ui:TimeField CommittedText="{Binding MoveTimeText}" />
                </ui:FormField>
              </StackPanel>
              <UniformGrid Columns="3" ColumnSpacing="6">
                <Button Classes="ghost" Content="+1 Tag" Command="{Binding MoveDaysCommand}" CommandParameter="1" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                <Button Classes="ghost" Content="+1 Woche" Command="{Binding MoveDaysCommand}" CommandParameter="7" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                <Button Classes="ghost" Content="−1 Tag" Command="{Binding MoveDaysCommand}" CommandParameter="-1" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
              </UniformGrid>
              <TextBlock Text="Person und Raum bleiben, wenn sie frei sind; sonst wählt das Programm passende." Classes="muted small" TextWrapping="Wrap" />
              <!-- Meldung über dem Knopf der Aktion (meldungen.md, M7) -->
              <ui:InfoBar Severity="Error" Message="{Binding Error}" IsVisible="{Binding ErrorInMove}" CloseCommand="{Binding ClearErrorCommand}" />
              <ContentControl Content="{Binding Conflict}" IsVisible="{Binding ConflictInMove}" />
              <UniformGrid Columns="2" ColumnSpacing="8">
                <Button Classes="primary" Content="Verschieben" Command="{Binding MoveToDayCommand}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" IsDefault="True" ui:SaveShortcut.IsSave="True" ToolTip.Tip="Verschieben (Strg+S)"
                        ui:DisabledHint.Text="Verfügbar für heute oder einen späteren Tag." />
                <Button Classes="ghost" Content="Abbrechen" Command="{Binding CancelMoveToDayCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              </UniformGrid>
            </StackPanel>
          </Border>
          <Button Content="Einchecken zurücknehmen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding UndoCheckInCommand}" ToolTip.Tip="Der Termin steht wieder auf Gebucht, solange noch nicht kassiert ist">
            <Button.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="ShowUndoCheckIn" />
                <Binding Path="!IsEditingCard" />
              </MultiBinding>
            </Button.IsVisible>
          </Button>
          <!-- Stornieren ohne Einchecken erreichbar (Ä81); wie die übrigen Aktionen aus, solange eine Karte (Zeiten, Notiz, Serie, Verschieben) offen ist -->
          <Button Classes="danger" Content="Termin stornieren …" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding AskCancelCommand}" ToolTip.Tip="Stornieren (Entf)">
            <Button.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="CanCancel" />
                <Binding Path="!IsEditingCard" />
              </MultiBinding>
            </Button.IsVisible>
          </Button>
          <ui:AccordionHeader x:Name="MoreToggle" Classes="more" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              IsVisible="{Binding HasMore}" ToolTip.Tip="Weitere Status und die Zeiten des Termins ändern">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
              <TextBlock Text="Mehr" />
              <ui:Icon Classes="chevron" Data="{x:Static ui:Icons.ChevronRight}" Width="14" Height="14" Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center" />
            </StackPanel>
            <ui:AccordionHeader.Styles>
              <!-- nach unten: es gibt mehr; nach oben, wenn aufgeklappt -->
              <Style Selector="ui|Icon.chevron">
                <Setter Property="RenderTransform" Value="rotate(90deg)" />
              </Style>
              <Style Selector="ToggleButton:checked ui|Icon.chevron">
                <Setter Property="RenderTransform" Value="rotate(-90deg)" />
              </Style>
            </ui:AccordionHeader.Styles>
          </ui:AccordionHeader>
          <StackPanel Spacing="8" IsVisible="{Binding #MoreToggle.IsChecked}">
            <UniformGrid Columns="2" ColumnSpacing="8" IsVisible="{Binding CanChangeStatus}">
              <Button Content="Erledigt" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Command="{Binding CompleteCommand}" IsEnabled="{Binding ShowComplete}" ui:DisabledHint.Text="{Binding CompleteHint}" />
              <Button Content="Nicht erschienen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Command="{Binding NoShowCommand}" IsEnabled="{Binding ShowNoShow}" ui:DisabledHint.Text="{Binding NoShowHint}" />
            </UniformGrid>
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding EditSeriesCommand}" IsVisible="{Binding ShowRepeat}" ToolTip.Tip="Serie ab diesem Termin">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <ui:Icon Data="{x:Static ui:Icons.Refresh}" Width="16" Height="16" />
                <TextBlock Text="Wiederholen …" />
              </StackPanel>
            </Button>
            <Button Content="Zeiten dieses Termins ändern …" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding BeginEditTimesCommand}" IsVisible="{Binding CanChangeTimes}"
                    ToolTip.Tip="Vor- und Nachbereitung nur dieses Termins ändern" />
          </StackPanel>
        </StackPanel>

        <!-- Abschnitt „Kunde“ (Runde 5, Ä34): eingeklappt mit vier Kennzahlen, aufgeklappt Kundennotiz, Zuletzt, Kontakt und die Kundenkarte -->
        <ContentControl Content="{Binding CustomerSection}" />

        <!-- Abschnitt „Verlauf“ (Ä184): eingeklappt, lädt beim Aufklappen -->
        <ContentControl Content="{Binding HistorySection}" />

        <Border Classes="hint ok" IsVisible="{Binding HasPaymentText}">
          <TextBlock Text="{Binding PaymentText}" TextWrapping="Wrap" MaxWidth="280" Foreground="{DynamicResource OkBrush}" />
        </Border>

        <!-- Stand der Anzahlung für alle (Ä285). Retournieren (Ä47): nur Inhaber und Manager, solange es eine offene Anzahlung gibt; der Knopf fragt nach und stellt erst dann den Storno-Beleg aus -->
        <Border x:Name="DepositCard" Classes="panelcard" IsVisible="{Binding HasDepositCard}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding DepositTitle}" FontWeight="Medium" />
            <TextBlock Text="{Binding DepositStateText}" TextWrapping="Wrap" MaxWidth="280" IsVisible="{Binding HasDepositState}" />
            <ItemsControl ItemsSource="{Binding DepositLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" Classes="muted small" TextWrapping="Wrap" MaxWidth="280" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding DepositText}" Classes="muted small" TextWrapping="Wrap" MaxWidth="280" IsVisible="{Binding HasReturnableDeposit}" />
            <Button x:Name="ReturnDepositButton" Classes="danger" Content="Anzahlung retournieren …" HorizontalAlignment="Left" Command="{Binding ReturnDepositCommand}" IsVisible="{Binding HasReturnableDeposit}" />
          </StackPanel>
        </Border>

        <!-- Kartengarantie (Ä285): Gebühr, Fälligkeit und Hinweise kommen vom Server; Belasten nur mit Kassenaufsicht und nach Rückfrage -->
        <Border x:Name="CardGuaranteeCard" Classes="panelcard" IsVisible="{Binding HasCardSection}">
          <StackPanel Spacing="6">
            <TextBlock Text="Ausfallgebühr" FontWeight="Medium" />
            <TextBlock Text="{Binding CardStateText}" TextWrapping="Wrap" MaxWidth="280" IsVisible="{Binding HasCardState}" />
            <ItemsControl ItemsSource="{Binding CardLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" Classes="muted small" TextWrapping="Wrap" MaxWidth="280" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="RequestCardButton" Content="{Binding RequestCardText}" HorizontalAlignment="Left" Command="{Binding RequestCardCommand}" IsVisible="{Binding CanRequestCard}" />
            <Button x:Name="ChargeFeeButton" Classes="danger" Content="Ausfallgebühr belasten …" HorizontalAlignment="Left" Command="{Binding ChargeFeeCommand}" IsVisible="{Binding CanChargeFee}" />
          </StackPanel>
        </Border>

        <!-- Erinnerungsverlauf (Ä285): ohne Erinnerungen keine Karte -->
        <Border x:Name="RemindersCard" Classes="panelcard" IsVisible="{Binding HasReminders}">
          <StackPanel Spacing="6">
            <TextBlock Text="Terminerinnerungen" FontWeight="Medium" />
            <ItemsControl ItemsSource="{Binding Reminders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" Classes="muted small" TextWrapping="Wrap" MaxWidth="280" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Einwilligung für Wiederbuchungs-Hinweise (Ä292): Stand und Texte kommen vom Server; Anfragen und Widerrufen nur mit dem Recht zum Buchen -->
        <Border x:Name="ConsentCard" Classes="panelcard" IsVisible="{Binding HasConsent}">
          <StackPanel Spacing="6">
            <TextBlock Text="Wiederbuchungs-Hinweis" FontWeight="Medium" TextWrapping="Wrap" MaxWidth="280" />
            <TextBlock Text="Werbe-Mail einige Wochen nach der letzten Behandlung. Braucht die Einwilligung des Gastes." Classes="muted small" TextWrapping="Wrap" MaxWidth="280" />
            <TextBlock Text="{Binding ConsentText}" TextWrapping="Wrap" MaxWidth="280" />
            <ui:FormField Label="Sprache der Mail" IsVisible="{Binding CanRequestConsent}">
              <ComboBox x:Name="ConsentLanguageBox" ItemsSource="{Binding ConsentLanguages}" SelectedItem="{Binding ConsentMailLanguage}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConsentLanguage">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </ui:FormField>
            <Button x:Name="RequestConsentButton" Content="Einwilligung anfragen" HorizontalAlignment="Left" Command="{Binding RequestConsentCommand}" IsVisible="{Binding CanRequestConsent}" />
            <Button x:Name="WithdrawConsentButton" Classes="ghost" Content="Widerrufen" HorizontalAlignment="Left" Command="{Binding WithdrawConsentCommand}" IsVisible="{Binding CanWithdrawConsent}" />
          </StackPanel>
        </Border>

        <!-- Anamnese (Ä300): Stand und Antworten mit dem Recht zum Lesen; Tablet, Papier und Foto nur mit dem Recht zum Buchen -->
        <Border x:Name="AnamnesisCard" Classes="panelcard" IsVisible="{Binding HasAnamnesis}">
          <StackPanel Spacing="6">
            <TextBlock Text="Anamnese" FontWeight="Medium" />
            <TextBlock Text="{Binding AnamnesisStateText}" TextWrapping="Wrap" MaxWidth="280" />
            <Button x:Name="ShowRecordButton" Classes="ghost" Content="{Binding ShowRecordText}" AutomationProperties.Name="{Binding ShowRecordName}" HorizontalAlignment="Left" Command="{Binding ToggleAnamnesisRecordCommand}" IsVisible="{Binding CanReadAnamnesisRecord}" />
            <ItemsControl ItemsSource="{Binding AnamnesisAnswers}" IsVisible="{Binding ShowAnamnesisRecord}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AnamnesisAnswerRow">
                  <StackPanel Margin="0,2">
                    <TextBlock Text="{Binding Question}" Classes="muted small" TextWrapping="Wrap" MaxWidth="280" />
                    <TextBlock Text="{Binding Answer}" Classes.warn="{Binding IsFlagged}" TextWrapping="Wrap" MaxWidth="280" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding AnamnesisScans}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AnamnesisScanRow">
                  <StackPanel Spacing="4" Margin="0,2">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="280" />
                    <Button x:Name="ReviewScanButton" Content="Prüfen" HorizontalAlignment="Left" Command="{Binding Review}" IsVisible="{Binding CanReview}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Spacing="6" IsVisible="{Binding CanRunAnamnesisFlows}">
              <ui:FormField Label="Sprache des Bogens">
                <ComboBox x:Name="AnamnesisLanguageBox" ItemsSource="{Binding ConsentLanguages}" SelectedItem="{Binding AnamnesisLanguage}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConsentLanguage">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </ui:FormField>
              <Button x:Name="TabletLinkButton" Classes="ghost" Content="Am Tablet ausfüllen" HorizontalAlignment="Left" Command="{Binding CreateTabletLinkCommand}" />
              <Button x:Name="PaperSheetButton" Classes="ghost" Content="Papierbogen drucken" HorizontalAlignment="Left" Command="{Binding PrintPaperSheetCommand}" />
              <Button x:Name="UploadPhotoButton" Classes="ghost" Content="Foto hochladen" HorizontalAlignment="Left" Command="{Binding UploadPhotoCommand}" />
            </StackPanel>
            <TextBlock x:Name="AnamnesisMessageText" Text="{Binding AnamnesisMessage}" IsVisible="{Binding HasAnamnesisMessage}" TextWrapping="Wrap" MaxWidth="280" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Spacing="6" IsVisible="{Binding HasTabletLink}">
              <Image x:Name="TabletQr" Source="{Binding TabletQr}" Width="180" Height="180" HorizontalAlignment="Left" AutomationProperties.Name="QR-Code für das Tablet" />
              <TextBlock Text="Mit dem Tablet scannen oder im Browser öffnen." TextWrapping="Wrap" MaxWidth="280" />
              <TextBlock Text="{Binding TabletLinkUrl}" Classes="muted small" TextWrapping="Wrap" MaxWidth="280" />
              <TextBlock Text="{Binding TabletLinkValidity}" TextWrapping="Wrap" MaxWidth="280" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="OpenTabletLinkButton" Classes="ghost" Content="Im Browser öffnen" Command="{Binding OpenTabletLinkCommand}" />
                <Button x:Name="CloseTabletLinkButton" Classes="ghost" Content="Schließen" Command="{Binding CloseTabletLinkCommand}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Zum Termin bereitstellen: Tee, Früchteteller … mit Uhrzeit und Haken; die Anamnese nur als Hinweis -->
        <Border Classes="panelcard" IsVisible="{Binding HasServings}">
          <StackPanel Spacing="6" DataContext="{Binding Servings}" x:DataType="vm:ServingPanelViewModel">
            <TextBlock Text="Bereitstellen" FontWeight="Medium" />
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ServingRow">
                  <Grid ColumnDefinitions="*,Auto">
                    <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" IsEnabled="{Binding CanCheck}" Command="{Binding ToggleCommand}" MinHeight="0"
                              Content="{Binding Text}" />
                    <TextBlock Grid.Column="1" Text="{Binding Time}" Classes="num secondary" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding WishesText}" IsVisible="{Binding HasWishes}" Classes="small secondary" TextWrapping="Wrap" MaxWidth="280" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding AnamnesisOnFile}">
              <ui:Icon Data="{x:Static ui:Icons.Note}" Width="14" Height="14" Foreground="{DynamicResource WarnBrush}" />
              <TextBlock Text="Anamnese beachten" Classes="small warn" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <ui:InfoBar Severity="Error" Message="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>

        <Border Classes="hint warn"
                IsVisible="{Binding ShowAcceptPending}">
          <StackPanel Spacing="6">
            <TextBlock Text="In Treatwell noch annehmen" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}" />
            <TextBlock Text="Die Buchung steht im Kalender, gilt bei Treatwell aber erst, wenn Sie sie dort annehmen." Classes="muted small"
                       TextWrapping="Wrap" MaxWidth="280" />
            <Button Content="Erledigt" HorizontalAlignment="Left" Command="{Binding PlatformAcceptedCommand}" IsEnabled="{Binding CanConfirmAccepted}"
                    ToolTip.Tip="Ich habe die Buchung in Treatwell angenommen" />
          </StackPanel>
        </Border>

        <Border Classes="hint warn"
                IsVisible="{Binding ShowAssignmentOpen}">
          <TextBlock Text="Zuordnung offen: Der Gast ist vorläufig angelegt. Unter „Anfragen“ klären, wer das ist." TextWrapping="Wrap" MaxWidth="280"
                     Foreground="{DynamicResource WarnBrush}" />
        </Border>

        <Border Classes="panelcard" IsVisible="{Binding CanNameGuest}">
          <StackPanel Spacing="8">
            <TextBlock Text="Name nachtragen" FontWeight="Medium" />
            <TextBlock Text="{Binding BookedBy}" Classes="muted small" TextWrapping="Wrap" />
            <ContentControl Content="{Binding GuestSearch}" />
            <Button Content="Gast eintragen" Command="{Binding NameGuestCommand}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" ui:DisabledHint.Text="Verfügbar, sobald ein Gast gewählt ist." />
          </StackPanel>
        </Border>

        <Border Classes="panelcard" IsVisible="{Binding IsGroup}">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ui:Icon Data="{x:Static ui:Icons.Users}" Foreground="{DynamicResource Fg2Brush}" Width="16" Height="16" />
              <TextBlock Text="{Binding GroupTitle}" Classes="group" VerticalAlignment="Center" />
            </StackPanel>
            <!-- Alle Teile der Buchung: Zeit, Gast, Behandlung, Person, Raum, Status; ein Klick öffnet den Teil -->
            <ItemsControl ItemsSource="{Binding GroupParts}" IsVisible="{Binding HasGroupParts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GroupPartRow">
                  <Button Classes="ghost part" Classes.current="{Binding IsCurrent}" Classes.cancelled="{Binding IsCancelled}" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" Padding="8,5" Margin="-8,0"
                          Command="{Binding #Root.((vm:CalendarViewModel)DataContext).Selected.OpenGroupPartCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="Diesen Teil öffnen" AutomationProperties.Name="{Binding AccessibleName}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Time}" Classes="num small" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Guest}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="130" />
                        <ui:Icon Data="{Binding SymbolIcon}" Width="11" Height="11" Foreground="{DynamicResource Fg2Brush}" VerticalAlignment="Center"
                                 IsVisible="{Binding SymbolIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                      <Border Grid.Column="1" Classes="pill" Classes.ok="{Binding IsCheckedIn}" Classes.crit="{Binding IsProblem}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" />
                      </Border>
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" Classes="secondary small" TextWrapping="Wrap" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="{Binding CheckInGroupText}" Command="{Binding CheckInGroupCommand}" IsVisible="{Binding CanCheckInGroup}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Alle Teile der Buchung einchecken, die noch gebucht sind" />
            <Button Content="Alle kassieren" Command="{Binding CheckoutGroupCommand}" IsVisible="{Binding CanCheckoutGroup}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" ToolTip.Tip="Alle eingecheckten Teile auf eine Rechnung" />
            <StackPanel Spacing="6" IsVisible="{Binding CanMoveGroup}" Margin="0,4,0,0">
              <ui:FormField Label="Neuer Beginn der ganzen Buchung">
                <ui:TimeField CommittedText="{Binding GroupStartText}" />
              </ui:FormField>
              <Button Content="Ganze Buchung verschieben" Command="{Binding MoveGroupCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </StackPanel>
            <Button Classes="danger" Content="Ganze Buchung stornieren" Command="{Binding AskCancelGroupCommand}" IsVisible="{Binding CanCancelGroup}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

        <Border Classes="panelcard" IsVisible="{Binding IsSeries}">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ui:Icon Data="{x:Static ui:Icons.Refresh}" Width="16" Height="16" Foreground="{DynamicResource Fg2Brush}" VerticalAlignment="Center" />
              <TextBlock Text="Serie" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding SeriesText}" Classes="small" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="panelcard" IsVisible="{Binding IsEditingSeries}">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ui:Icon Data="{x:Static ui:Icons.Refresh}" Width="16" Height="16" Foreground="{DynamicResource Fg2Brush}" VerticalAlignment="Center" />
              <TextBlock x:Name="SeriesTitle" Text="Wiederholen" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
            <ComboBox ItemsSource="{x:Static vm:AppointmentViewModel.Intervals}" SelectedItem="{Binding SeriesInterval}" HorizontalAlignment="Stretch"
                      AutomationProperties.LabeledBy="{Binding #SeriesTitle}" />
            <CheckBox Content="erst nach dem letzten Besuch" IsChecked="{Binding AfterLastVisit}" />
            <TextBlock Text="{Binding SeriesRuleHint}" Classes="muted small" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
              <RadioButton GroupName="SeriesEnd" Content="Anzahl" IsChecked="{Binding EndByCount}" VerticalAlignment="Center" />
              <ui:FormField Grid.Column="1">
                <ui:NumberField CommittedText="{Binding SeriesCount}" Minimum="1" Maximum="52" IsEnabled="{Binding EndByCount}" ToolTip.Tip="Weitere Termine nach diesem"
                                AutomationProperties.Name="Anzahl weiterer Termine" />
              </ui:FormField>
              <RadioButton Grid.Row="1" GroupName="SeriesEnd" Content="bis" IsChecked="{Binding EndByDate}" VerticalAlignment="Center" />
              <ui:FormField Grid.Row="1" Grid.Column="1">
                <ui:DateField CommittedText="{Binding SeriesUntil}" IsEnabled="{Binding EndByDate}" PlaceholderText="z. B. 30.04.2027"
                              AutomationProperties.Name="Enddatum der Serie" />
              </ui:FormField>
            </Grid>
            <Button Content="Termine prüfen" Command="{Binding PreviewSeriesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <ItemsControl ItemsSource="{Binding SeriesRows}" IsVisible="{Binding HasSeriesRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SeriesRowViewModel">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                    <CheckBox IsChecked="{Binding Take}" IsEnabled="{Binding CanTake}" VerticalAlignment="Top" MinWidth="0" Margin="0,0,6,0"
                              AutomationProperties.Name="{Binding DateText}" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Classes="small num" TextWrapping="Wrap">
                        <Run Text="{Binding DateText}" FontWeight="Medium" />
                        <Run Text="  " />
                        <Run Text="{Binding TimeText}" />
                        <Run Text="  " />
                        <Run Text="{Binding Person}" />
                      </TextBlock>
                      <TextBlock Text="{Binding StateText}" Classes="small" Classes.muted="{Binding !IsProblem}" Classes.warn="{Binding IsProblem}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <UniformGrid Columns="2" ColumnSpacing="8">
              <Button Classes="primary" Content="{Binding CreateSeriesText}" Command="{Binding CreateSeriesCommand}" IsEnabled="{Binding CanCreateSeries}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ui:SaveShortcut.IsSave="True" ToolTip.Tip="Serie anlegen (Strg+S)" ui:DisabledHint.Text="Verfügbar, sobald mindestens ein Termin der Vorschau angehakt ist." />
              <Button Classes="ghost" Content="Abbrechen" Command="{Binding CancelSeriesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </UniformGrid>
          </StackPanel>
        </Border>

        </StackPanel>

      </StackPanel>
    </DataTemplate>

    <!-- Seitenleiste „Meldungen“ (Design-Brief 5.12, Schritt 16): Gruppen nach Schwere mit Zwischentitel und Zähler, je Meldung eine Karte mit einer Aktion und „Wegklicken“ -->
    <DataTemplate DataType="vm:MessagesPanelViewModel">
      <StackPanel Spacing="12">
        <ui:InfoBar Severity="Warning" Message="{x:Static vm:MessagesPanelViewModel.OfflineText}" IsVisible="{Binding IsOffline}" />
        <!-- Notizen heute (Runde 5, Ä31): die Tagesnotizen ohne Uhrzeit ganz oben; Notizen sind keine Meldungen und zählen nicht mit -->
        <StackPanel Spacing="8" IsVisible="{Binding ShowNotes}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Notizen heute" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border Classes="pill" IsVisible="{Binding HasNotes}"><TextBlock Text="{Binding NotesCount}" Classes="num" /></Border>
            </StackPanel>
            <Button Grid.Column="1" x:Name="AddNoteButton" Classes="ghost small" Content="+ Notiz" Command="{Binding AddNoteCommand}" IsVisible="{Binding CanAddNote}"
                    ToolTip.Tip="Neue Tagesnotiz (.)" AutomationProperties.Name="Tagesnotiz hinzufügen" />
          </Grid>
          <Border Classes="panelcard" IsVisible="{Binding IsEditingNote}">
            <StackPanel Spacing="8">
              <ui:FormField Label="Notiz" IsRequired="True" Help="Für alle am Standort sichtbar." Error="{Binding NoteError}">
                <TextBox x:Name="DayNoteBox" Text="{Binding NoteText}" AcceptsReturn="True" MaxLength="500" AutomationProperties.Name="Tagesnotiz"
                         PlaceholderText="z. B. Lieferung Öle um 11, Wartung Sauna" />
              </ui:FormField>
              <UniformGrid Columns="2" ColumnSpacing="8">
                <Button Classes="ghost" Content="Abbrechen" Command="{Binding CancelNoteCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Abbrechen (Esc)" />
                <Button Classes="primary" Content="{Binding NoteSaveText}" Command="{Binding SaveNoteCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        IsDefault="True" IsEnabled="{Binding !IsSavingNote}" ui:SaveShortcut.IsSave="True" ToolTip.Tip="Speichern (Strg+S oder Strg+Enter)" />
              </UniformGrid>
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Notes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DayNoteRow">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                  <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" IsEnabled="{Binding CanChange}" Command="{Binding ToggleCommand}" MinHeight="0" Padding="4,0,0,0"
                            VerticalAlignment="Center" AutomationProperties.Name="{Binding ToggleName}" ToolTip.Tip="Abhaken" />
                  <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Classes.done="{Binding IsDone}" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" IsVisible="{Binding CanChange}">
                    <Button Classes="ghost icon" Width="28" Height="28" MinHeight="28" Command="{Binding EditCommand}" ToolTip.Tip="Notiz ändern" AutomationProperties.Name="{Binding EditName}"
                            IsEnabled="{Binding $parent[ItemsControl].((vm:MessagesPanelViewModel)DataContext).CanChangeNotes}">
                      <ui:Icon Data="{x:Static ui:Icons.Pencil}" Width="16" Height="16" />
                    </Button>
                    <Button Classes="ghost icon" Width="28" Height="28" MinHeight="28" Command="{Binding DeleteCommand}" ToolTip.Tip="Notiz löschen" AutomationProperties.Name="{Binding DeleteName}"
                            IsEnabled="{Binding $parent[ItemsControl].((vm:MessagesPanelViewModel)DataContext).CanChangeNotes}">
                      <ui:Icon Data="{x:Static ui:Icons.Trash}" Width="16" Height="16" />
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <!-- Filter auf eine Person, einen Raum oder ein Material (Klick auf das Symbol im Spaltenkopf) -->
        <Border Classes="hint" IsVisible="{Binding HasFilter}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding FilterText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Classes="small" Content="Filter aufheben" Command="{Binding ClearFilterCommand}" />
          </Grid>
        </Border>
        <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,24" IsVisible="{Binding IsEmpty}">
          <ui:Icon Data="{x:Static ui:Icons.CheckCircle}" Width="24" Height="24" Foreground="{DynamicResource Fg3Brush}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Fg2Brush}" HorizontalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="16" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MessageGroup">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Border Classes="pill"><TextBlock Text="{Binding Count}" Classes="num" /></Border>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MessageItem">
                      <!-- Der Kopfteil der Karte ist ein Knopf (Name: Titel und Text, Hilfetext: der Hinweis); Aktion und „Wegklicken“ liegen daneben, nicht darin -->
                      <Border Classes="panelcard" Padding="0" Opacity="{Binding CardOpacity}">
                        <StackPanel>
                          <Button Classes="messagecard" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding AccessibleName}"
                                  AutomationProperties.HelpText="Details und „Was tun?“ zeigen" ToolTip.Tip="Details und „Was tun?“ zeigen">
                            <StackPanel Spacing="6">
                              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <ui:Icon Data="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" Classes="msgicon" Classes.crit="{Binding IsError}"
                                         Classes.warn="{Binding IsWarning}" Classes.notice="{Binding IsNotice}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Classes="pill" Classes.crit="{Binding IsError}" Classes.warn="{Binding IsWarning}" Classes.accent="{Binding IsNotice}"
                                        VerticalAlignment="Top">
                                  <TextBlock Text="{Binding KindText}" />
                                </Border>
                              </Grid>
                              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding DoneText}" Classes="muted small" IsVisible="{Binding IsDone}" />
                              <TextBlock Text="{Binding SinceText}" Classes="muted small" IsVisible="{Binding !IsDone}" />
                            </StackPanel>
                          </Button>
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,16,12" IsVisible="{Binding !IsDone}">
                            <Button Classes="small" Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" IsVisible="{Binding HasAction}" />
                            <Button Classes="ghost small" Content="Wegklicken" Command="{Binding DismissCommand}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <!-- Detailansicht einer Meldung: Wortlaut, Betroffene mit Links, Auslöser, die Aktion, dazu die Karte „Was tun?“ -->
    <DataTemplate DataType="vm:MessageDetailViewModel">
      <StackPanel Spacing="12">
        <Border Classes="panelcard">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <ui:Icon Data="{Binding Item.Icon}" Width="16" Height="16" VerticalAlignment="Center" Classes="msgicon" Classes.crit="{Binding Item.IsError}"
                       Classes.warn="{Binding Item.IsWarning}" Classes.notice="{Binding Item.IsNotice}" />
              <TextBlock Grid.Column="1" Text="{Binding Item.Title}" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Border Grid.Column="2" Classes="pill" Classes.crit="{Binding Item.IsError}" Classes.warn="{Binding Item.IsWarning}" Classes.accent="{Binding Item.IsNotice}"
                      VerticalAlignment="Top">
                <TextBlock Text="{Binding Item.KindText}" />
              </Border>
            </Grid>
            <TextBlock Text="{Binding Item.Text}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Item.Lines}" IsVisible="{Binding HasLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" Classes="small" Foreground="{DynamicResource Fg2Brush}" TextWrapping="Wrap" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Item.SinceText}" Classes="muted small" />
            <StackPanel Spacing="4" IsVisible="{Binding HasLinks}">
              <TextBlock Text="Betrifft" Classes="group" />
              <ItemsControl ItemsSource="{Binding Links}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SubjectLink">
                    <Button Classes="ghost small" Command="{Binding Open}" HorizontalAlignment="Left" ToolTip.Tip="Im Kalender zeigen">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:Icon Data="{Binding Icon}" Width="16" Height="16" />
                        <TextBlock Text="{Binding Name}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <TextBlock Text="Diese Meldung ist erledigt oder weggeklickt." Classes="muted small" IsVisible="{Binding IsResolved}" />
            <Button Classes="primary" Content="{Binding Item.ActionLabel}" Command="{Binding Item.ActionCommand}" IsVisible="{Binding CanAct}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

        <!-- Tagesstart: die Checkliste des Raums mit Haken und Abnahme -->
        <Border Classes="panelcard" IsVisible="{Binding HasStartRoom}">
          <StackPanel Spacing="6" DataContext="{Binding StartRoom}" x:DataType="vm:RoomStartRow">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding StateText}" Classes="small secondary" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Content="Abnehmen" Command="{Binding ApproveCommand}" IsVisible="{Binding CanApprove}" VerticalAlignment="Center"
                      ToolTip.Tip="Die Standortleitung nimmt den Tagesstart des Raums ab" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StartItemRow">
                  <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" IsEnabled="{Binding CanCheck}" Command="{Binding ToggleCommand}"
                            MinHeight="0" Margin="0,1" ToolTip.Tip="{Binding Info}">
                    <TextBlock Text="{Binding Text}" Classes="small" Classes.done="{Binding IsDone}" TextWrapping="Wrap" />
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <!-- Ohne Recht „Standort verwalten“: Name und PIN der Leitung wie beim Rabatt über der Grenze -->
        <Border Classes="panelcard" DataContext="{Binding Operations}" x:DataType="vm:DayOperationsViewModel" IsVisible="{Binding IsAskingApproval}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding ApprovalTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ui:FormField Label="Leitung">
              <ComboBox ItemsSource="{Binding Approvers}" SelectedItem="{Binding Approver}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="c:QuickSwitchPerson">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </ui:FormField>
            <TextBox Text="{Binding ApprovalPin}" PasswordChar="•" MaxLength="8" Classes="num" PlaceholderText="PIN" AutomationProperties.Name="PIN der Leitung">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ConfirmApprovalCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Abnehmen" Command="{Binding ConfirmApprovalCommand}" ui:DisabledHint.Text="Verfügbar, sobald eine Person gewählt und ihre PIN (mindestens 4 Ziffern) eingetragen ist." />
              <Button Classes="ghost" Content="Abbrechen" Command="{Binding CancelApprovalCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <ui:InfoBar Severity="Error" Message="{Binding Operations.Error}" IsVisible="{Binding Operations.Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- „Was tun?“: Antwort des Assistenten (nur Vorschläge, ausgeführt wird erst nach dem Klick) und das Handbuch zur Meldung -->
        <Border Classes="panelcard">
          <StackPanel Spacing="8">
            <TextBlock Text="Was tun?" FontWeight="Medium" />
            <TextBlock Text="Wird geladen …" Foreground="{DynamicResource Fg2Brush}" IsVisible="{Binding IsAsking}" />
            <!-- Fehler: was nicht ging und der Weg ohne KI, das Handbuch zur Meldung (Design-Brief 5.28) -->
            <StackPanel Spacing="2" IsVisible="{Binding AskFailed}" AutomationProperties.LiveSetting="Polite">
              <TextBlock Text="Der Assistent hat gerade nicht geantwortet." TextWrapping="Wrap" />
              <TextBlock Text="{x:Static svc:AiLabels.WayOutHelpTopic}" Classes="muted small" TextWrapping="Wrap" />
            </StackPanel>
            <local:AiPill IsVisible="{Binding HasAnswer}" />
            <TextBlock Text="{Binding Answer?.Text, TargetNullValue=''}" TextWrapping="Wrap" IsVisible="{Binding HasAnswer}" />
            <ItemsControl ItemsSource="{Binding Suggestions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="8" LineSpacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DetailSuggestion">
                  <Button Content="{Binding Label}" Command="{Binding #Root.((vm:CalendarViewModel)DataContext).MessageDetail.RunSuggestionCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="{Binding Action}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:HelpTeaser Topic="{Binding HelpTopic, FallbackValue={x:Null}}" Section="{Binding HelpSection, FallbackValue={x:Null}}" IsVisible="{Binding HasHelp}" />
            <ItemsControl ItemsSource="{Binding MoreHelp}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="c:AssistantHelpLink">
                  <Button Classes="ghost small" Content="{Binding Title}" HorizontalAlignment="Left"
                          Command="{Binding #Root.((vm:CalendarViewModel)DataContext).MessageDetail.OpenHelpLinkCommand}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <local:AiFooter Disclaimer="{Binding Disclosure}" Why="{x:Static svc:AiLabels.WhyWhatToDo}" IsVisible="{Binding HasAnswer}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- Raum-Infos: Karte links neben der Seitenleiste (Auftraggeber, 27.10.2026). Kopf mit Raumname und Raumart als Pille, darunter die Raumpflege; dann „n Behandlungen“
         (Varianten in einer Zeile, ab sieben Zeilen aufklappbar) und die Termine des Raums an dem Tag in festen Spalten (Zeit, Gast, Behandlung), der Termin im Panel hervorgehoben -->
    <DataTemplate DataType="vm:RoomInfoViewModel">
      <StackPanel Spacing="16" Width="380">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ui:Icon Data="{x:Static ui:Icons.Door}" Foreground="{DynamicResource Fg2Brush}" Width="16" Height="16" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" Classes="h2" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="1" Classes="pill" VerticalAlignment="Top"><TextBlock Text="{Binding Kind}" /></Border>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:Icon Data="{x:Static ui:Icons.Broom}" Foreground="{DynamicResource Fg2Brush}" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Cleaning}" Classes="secondary" TextWrapping="Wrap" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <Border Classes="divider" />
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding TreatmentsTitle}" Classes="h3" />
          <ItemsControl ItemsSource="{Binding VisibleTreatments}" IsVisible="{Binding HasTreatments}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RoomTreatmentRow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,2">
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding Durations}" Classes="secondary num" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="link" HorizontalAlignment="Left" Command="{Binding ToggleTreatmentsCommand}" IsVisible="{Binding CanExpandTreatments}"
                  AutomationProperties.Name="{Binding ToggleTreatmentsText}">
            <TextBlock Text="{Binding ToggleTreatmentsText}" />
          </Button>
        </StackPanel>
        <Border Classes="divider" IsVisible="{Binding HasOthers}" />
        <StackPanel Spacing="8" IsVisible="{Binding HasOthers}">
          <TextBlock Text="{Binding DayTitle}" Classes="h3" />
          <ItemsControl ItemsSource="{Binding VisibleDayRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RoomDayRow">
                <Grid ColumnDefinitions="100,*,*" ColumnSpacing="8" Margin="0,2" AutomationProperties.Name="{Binding AccessibleName}">
                  <Grid.Styles>
                    <Style Selector="TextBlock.current">
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                  </Grid.Styles>
                  <Border Grid.ColumnSpan="3" Margin="-6,-2" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" IsVisible="{Binding IsCurrent}" />
                  <TextBlock Text="{Binding Time}" Classes="num" Classes.current="{Binding IsCurrent}" />
                  <TextBlock Grid.Column="1" Text="{Binding Guest}" TextWrapping="Wrap" Classes.current="{Binding IsCurrent}" />
                  <TextBlock Grid.Column="2" Text="{Binding Treatment}" Classes="secondary" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding MoreDayRowsText}" Classes="secondary" IsVisible="{Binding HasMoreDayRows}" />
        </StackPanel>
        <Button Classes="ghost" Content="In der Verwaltung bearbeiten" Command="{Binding EditInAdminCommand}" IsVisible="{Binding CanEdit}"
                HorizontalAlignment="Left" Margin="-8,0,0,0" />
      </StackPanel>
    </DataTemplate>

    <!-- Abschnitt „Kunde“ im Termin-Panel (Runde 5, Ä34), aufgebaut wie der Tagesüberblick: Kopf mit vier Kennzahlen, aufgeklappt der Rest; Strg+Enter öffnet die Kundenkarte.
         Die Kennzahlen sind ein Tab-Stopp mit Pfeiltasten, damit ihr Tooltip auch per Tastatur erscheint und der Screenreader ihn als Hilfetext liest (W-Muster 12) -->
    <DataTemplate DataType="vm:CustomerSectionViewModel">
      <Border x:Name="CustomerSection" Classes="panelcard" Padding="0" Loaded="OnCustomerSectionLoaded">
        <StackPanel>
          <ui:AccordionHeader x:Name="CustomerHeader" Classes="accordion" IsChecked="{Binding IsOpen, Mode=TwoWay}" AutomationProperties.Name="Kunde"
                              ToolTip.Tip="Besuche, Notiz, Kontakt und letzte Behandlungen des Gastes">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <ui:Icon Data="{x:Static ui:Icons.User}" Foreground="{DynamicResource Fg2Brush}" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Kunde" FontWeight="Medium" VerticalAlignment="Center" />
                <ui:Icon Grid.Column="2" Classes="chevron" Data="{x:Static ui:Icons.ChevronDown}" Foreground="{DynamicResource Fg2Brush}" Width="16" Height="16" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="Wird geladen …" Classes="muted small" IsVisible="{Binding IsLoading}" />
              <UniformGrid Columns="2" RowSpacing="6" ColumnSpacing="8" IsVisible="{Binding ShowStats}" ui:ToolTipBehavior.ReachableGroup="True">
                <StackPanel ToolTip.Tip="Erledigte Besuche insgesamt" ui:ToolTipBehavior.Reachable="True" AutomationProperties.Name="{Binding VisitsText, StringFormat='Besuche gesamt {0}'}"
                            AutomationProperties.ControlTypeOverride="Text" AutomationProperties.AccessibilityView="Content">
                  <TextBlock Text="{Binding VisitsText}" FontSize="22" FontWeight="SemiBold" Classes="num" AutomationProperties.AccessibilityView="Raw" />
                  <TextBlock Text="Besuche gesamt" Classes="muted small" AutomationProperties.AccessibilityView="Raw" />
                </StackPanel>
                <StackPanel ToolTip.Tip="{Binding LastVisitTip}" ui:ToolTipBehavior.Reachable="True" AutomationProperties.Name="{Binding LastVisitText, StringFormat='Letzter Besuch {0}'}"
                            AutomationProperties.ControlTypeOverride="Text" AutomationProperties.AccessibilityView="Content">
                  <TextBlock Text="{Binding LastVisitText}" FontSize="22" FontWeight="SemiBold" Classes="num" AutomationProperties.AccessibilityView="Raw" />
                  <TextBlock Text="Letzter Besuch" Classes="muted small" AutomationProperties.AccessibilityView="Raw" />
                </StackPanel>
                <StackPanel ToolTip.Tip="Termine, zu denen der Gast nicht erschienen ist" ui:ToolTipBehavior.Reachable="True" AutomationProperties.Name="{Binding NoShowsText, StringFormat='Nicht erschienen {0}'}"
                            AutomationProperties.ControlTypeOverride="Text" AutomationProperties.AccessibilityView="Content">
                  <TextBlock Text="{Binding NoShowsText}" FontSize="22" FontWeight="SemiBold" Classes="num" Classes.warn="{Binding HasNoShows}" AutomationProperties.AccessibilityView="Raw" />
                  <TextBlock Text="Nicht erschienen" Classes="muted small" AutomationProperties.AccessibilityView="Raw" />
                </StackPanel>
                <StackPanel ToolTip.Tip="{Binding NextTip}" ui:ToolTipBehavior.Reachable="True" AutomationProperties.Name="{Binding NextText, StringFormat='Nächster Termin {0}'}"
                            AutomationProperties.ControlTypeOverride="Text" AutomationProperties.AccessibilityView="Content">
                  <TextBlock Text="{Binding NextText}" FontSize="22" FontWeight="SemiBold" Classes="num" AutomationProperties.AccessibilityView="Raw" />
                  <TextBlock Text="Nächster Termin" Classes="muted small" AutomationProperties.AccessibilityView="Raw" />
                </StackPanel>
              </UniformGrid>
              <TextBlock Text="{Binding OpenLine}" Classes="small" TextWrapping="Wrap" IsVisible="{Binding HasOpen}" />
            </StackPanel>
          </ui:AccordionHeader>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,16,12" IsVisible="{Binding HasError}">
            <ui:InfoBar Severity="Error" Message="Der Überblick wurde nicht geladen." ActionText="Erneut laden" ActionCommand="{Binding LoadCommand}" />
          </StackPanel>
          <StackPanel Spacing="12" Margin="16,0,16,12" IsVisible="{Binding IsOpen}">
            <Border Classes="divider" />
            <Border Classes="hint" IsVisible="{Binding HasNote}">
              <StackPanel Spacing="2">
                <TextBlock Text="Kundennotiz" Classes="muted small" />
                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NoteTip}" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ui:Icon Data="{x:Static ui:Icons.Note}" Foreground="{DynamicResource Fg2Brush}" Width="16" Height="16" VerticalAlignment="Center" />
              <TextBlock Text="{Binding AnamnesisText}" Classes="small" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Zuletzt" Classes="group" />
              <TextBlock Text="Noch keine Behandlung." Classes="muted small" IsVisible="{Binding !HasRecent}" />
              <ItemsControl ItemsSource="{Binding Recent}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RecentVisitRow">
                    <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,5" Margin="-8,0" Command="{Binding OpenCommand}"
                            ToolTip.Tip="Termin öffnen" AutomationProperties.Name="{Binding Name}">
                      <Grid ColumnDefinitions="78,*">
                        <TextBlock Text="{Binding DateText}" Classes="num small" FontWeight="Medium" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Treatment}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Person}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Kontakt" Classes="group" />
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding HasPhone}">
                <ui:Icon Data="{x:Static ui:Icons.Phone}" Foreground="{DynamicResource Fg2Brush}" Width="16" Height="16" VerticalAlignment="Center" />
                <Button x:Name="PhoneLink" Grid.Column="1" Classes="link" HorizontalAlignment="Left" Command="{Binding CallCommand}" ToolTip.Tip="Anrufen">
                  <TextBlock Text="{Binding Phone}" />
                </Button>
                <Button x:Name="CopyPhoneButton" Grid.Column="2" Classes="ghost icon" Width="28" Height="28" MinHeight="28" Command="{Binding CopyPhoneCommand}" ToolTip.Tip="Telefonnummer kopieren"
                        AutomationProperties.Name="Telefonnummer kopieren">
                  <ui:Icon Data="{x:Static ui:Icons.Copy}" Width="16" Height="16" />
                </Button>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding HasPhone}">
                <ui:Icon Data="{x:Static ui:Icons.Chat}" Foreground="{DynamicResource Fg2Brush}" Width="16" Height="16" VerticalAlignment="Center" />
                <Button x:Name="WhatsAppLink" Grid.Column="1" Classes="link" HorizontalAlignment="Left" Command="{Binding WhatsAppCommand}" ToolTip.Tip="WhatsApp-Chat öffnen">
                  <TextBlock Text="Per WhatsApp schreiben" />
                </Button>
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding HasEmail}">
                <ui:Icon Data="{x:Static ui:Icons.Mail}" Foreground="{DynamicResource Fg2Brush}" Width="16" Height="16" VerticalAlignment="Center" />
                <Button x:Name="MailLink" Grid.Column="1" Classes="link" HorizontalAlignment="Left" Command="{Binding MailCommand}" ToolTip.Tip="E-Mail schreiben">
                  <TextBlock Text="{Binding Email}" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button x:Name="CopyEmailButton" Grid.Column="2" Classes="ghost icon" Width="28" Height="28" MinHeight="28" Command="{Binding CopyEmailCommand}" ToolTip.Tip="E-Mail-Adresse kopieren"
                        AutomationProperties.Name="E-Mail-Adresse kopieren">
                  <ui:Icon Data="{x:Static ui:Icons.Copy}" Width="16" Height="16" />
                </Button>
              </Grid>
              <TextBlock Text="Keine Telefonnummer und keine E-Mail-Adresse hinterlegt." Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding HasNoContact}" />
            </StackPanel>
            <Button x:Name="OpenCardLink" Classes="link" HorizontalAlignment="Left" Command="{Binding OpenCardCommand}" IsVisible="{Binding CanOpenCard}"
                    ToolTip.Tip="Kundenkarte öffnen (Strg+Enter)">
              <TextBlock Text="Kundenkarte öffnen" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Kundenübersicht hinter Initialen und Namen im Terminkopf (dieselbe wie im Posteingang) -->
    <DataTemplate DataType="vm:CustomerOverviewViewModel">
      <local:CustomerOverviewView />
    </DataTemplate>

    <!-- Freie Zeit suchen -->
    <DataTemplate DataType="vm:FreeTimeViewModel">
      <local:FreeTimeView />
    </DataTemplate>

    <!-- KI-Anfrage (Strg+K) -->
    <DataTemplate DataType="vm:CalendarRequestViewModel">
      <StackPanel Spacing="12">
        <!-- Wunsch und erkannte Bausteine in einer Karte (5.12, Punkt 5) -->
        <Border Classes="panelcard">
          <StackPanel Spacing="12">
            <local:AiPill />
            <TextBox x:Name="RequestBox" Text="{Binding Text}" AcceptsReturn="False" TextWrapping="Wrap"
                     PlaceholderText="z. B. Massage morgen 17 Uhr, nicht bei Marco" AutomationProperties.Name="Wunsch" />
            <!-- Erkanntes als Bausteine: Tag, Uhrzeit, Behandlung, Person, Raum, Zahl der Gäste; jeder lässt sich entfernen -->
            <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding HasChips}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WishChip">
                  <Border Classes="wishchip" Classes.excluded="{Binding IsExcluded}" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                      <Button Classes="ghost chipx" IsVisible="{Binding CanRemove}" Click="OnRemoveChip" ToolTip.Tip="Baustein entfernen"
                              AutomationProperties.Name="{Binding Text, StringFormat='Baustein „{0}“ entfernen'}">
                        <ui:Icon Data="{x:Static ui:Icons.Close}" Width="10" Height="10" StrokeThickness="2.2" />
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding ExtrasText}" Classes="small secondary" TextWrapping="Wrap" IsVisible="{Binding ExtrasText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{Binding Answer}" TextWrapping="Wrap" IsVisible="{Binding Answer, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>
        <!-- Fehler: was nicht ging und ein Weg ohne KI (Design-Brief 5.28) -->
        <ui:InfoBar Severity="Error" Message="{Binding Error}" IsVisible="{Binding HasError}" ActionText="Freie Zeit suchen" ActionCommand="{Binding SearchFreeTimeCommand}">
          <ui:InfoBar.Detail>
            <TextBlock Text="{x:Static svc:AiLabels.WayOutFreeTime}" TextWrapping="Wrap" />
          </ui:InfoBar.Detail>
        </ui:InfoBar>

        <!-- Rückfragen als Knöpfe -->
        <ItemsControl ItemsSource="{Binding Questions}" IsVisible="{Binding HasQuestions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RequestQuestion">
              <StackPanel Spacing="6" Margin="0,0,0,6">
                <TextBlock Text="{Binding Text}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Answers}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RequestAnswer">
                      <Button Classes="chip" Content="{Binding Label}" Margin="0,0,6,6" Click="OnAnswerClick" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Fehlt die Behandlung: die passendsten als Karten, darunter alle nach Gruppe -->
        <StackPanel Spacing="8" IsVisible="{Binding NeedsTreatment}">
          <ItemsControl ItemsSource="{Binding TreatmentCards}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TreatmentCard">
                <Button Classes="treatmentcard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Click="OnTreatmentCardClick">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Facts}" Classes="small secondary num" />
                      <TextBlock Grid.Column="1" Text="{Binding RoomKind}" Classes="small muted" />
                    </Grid>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Alle Behandlungen" Classes="group" Margin="0,4,0,0" />
          <ItemsControl ItemsSource="{Binding TreatmentGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TreatmentGroup">
                <StackPanel>
                  <ui:AccordionHeader Classes="more" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsChecked="{Binding IsOpen, Mode=TwoWay}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Header}" FontWeight="Medium" />
                      <ui:Icon Grid.Column="1" Classes="chevron" Data="{x:Static ui:Icons.ChevronRight}" Width="14" Height="14" Foreground="{DynamicResource Fg3Brush}" />
                    </Grid>
                    <ui:AccordionHeader.Styles>
                      <Style Selector="ui|Icon.chevron">
                        <Setter Property="RenderTransform" Value="rotate(90deg)" />
                      </Style>
                      <Style Selector="ToggleButton:checked ui|Icon.chevron">
                        <Setter Property="RenderTransform" Value="rotate(-90deg)" />
                      </Style>
                    </ui:AccordionHeader.Styles>
                  </ui:AccordionHeader>
                  <ItemsControl ItemsSource="{Binding Cards}" IsVisible="{Binding IsOpen}" Margin="0,2,0,6">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TreatmentCard">
                        <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6" Click="OnTreatmentCardClick">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Facts}" Classes="small muted num" Margin="8,0,0,0" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Classes="panelcard" Padding="4" IsVisible="{Binding HasProposals}">
          <ListBox Classes="plain" ItemsSource="{Binding Proposals}" SelectedItem="{Binding Active, Mode=OneWay}">
            <ListBox.Styles>
              <!-- Der Name der Zeile ist ihr sichtbarer Inhalt; sonst liest der Screenreader den Record-Typ -->
              <Style Selector="ListBoxItem" x:DataType="vm:ProposalRow">
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProposalRow">
                <Grid ColumnDefinitions="26,*,Auto" Background="Transparent" Tapped="OnProposalTapped">
                  <Border Classes="keynum" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Number}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding OtherDay}" Classes="small" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}"
                               IsVisible="{Binding HasOtherDay}" />
                    <TextBlock Text="{Binding Time}" FontWeight="SemiBold" Classes="num" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="8" Height="8" Fill="{Binding WhoColor}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Who}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Reason}" Classes="small" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding HasReason}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Price}" Classes="num" VerticalAlignment="Top" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <!-- Gast: mit Gast bucht der Klick gleich für ihn -->
        <Border Classes="panelcard" IsVisible="{Binding HasProposals}">
          <StackPanel>
            <TextBlock Text="Gast (optional)" Classes="label" />
            <ContentControl Content="{Binding Guest}" />
          </StackPanel>
        </Border>
        <!-- Aktionsblock (5.12, Punkt 6): primär in voller Breite, darunter sekundär -->
        <StackPanel Spacing="8" IsVisible="{Binding HasProposals}" Margin="0,4,0,0">
          <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding BookActiveCommand}"
                  Content="{Binding BookText}" />
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding OtherTimesCommand}" Content="Andere Zeiten"
                  ToolTip.Tip="Diese drei nicht mehr vorschlagen" />
        </StackPanel>
        <TextBlock Text="{Binding Hint}" Classes="muted small" TextWrapping="Wrap" />
        <local:AiFooter Disclaimer="{Binding Disclosure}" Why="{x:Static svc:AiLabels.WhyRequest}"
                        IsVisible="{Binding Answer, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:CalendarEntryViewModel">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <ui:FormField Label="{Binding StartLabel}" IsRequired="True">
            <ui:TimeField x:Name="EntryStartBox" CommittedText="{Binding StartText}" />
          </ui:FormField>
          <ui:FormField Label="{Binding EndLabel}" IsRequired="{Binding HasEnd}" IsVisible="{Binding ShowEnd}">
            <ui:TimeField CommittedText="{Binding EndText}" NotBefore="{Binding #EntryStartBox.Value}" />
          </ui:FormField>
        </StackPanel>
        <ui:FormField Label="{Binding TextLabel}" IsVisible="{Binding HasText}" Error="{Binding TextError}">
          <!-- Die Notiz ist mehrzeilig und wächst mit (Ä148), der Grund einer Sperrzeit bleibt eine Zeile -->
          <TextBox x:Name="EntryTextBox" Classes="grow" Text="{Binding Text}" PlaceholderText="{Binding TextHint}" AcceptsReturn="{Binding IsNote}" />
        </ui:FormField>
        <CheckBox IsChecked="{Binding Done}" Content="Erledigt" IsVisible="{Binding ShowDone}" />
        <TextBlock Text="Eine Notiz belegt nichts und lässt sich im Kalender abhaken." Classes="muted small" TextWrapping="Wrap"
                   IsVisible="{Binding IsNote}" />
        <ui:InfoBar Severity="Error" Message="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <ContentControl Content="{Binding Conflict}" IsVisible="{Binding Conflict, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Classes="primary" HorizontalAlignment="Stretch" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}"
                Content="{Binding SaveText}" IsDefault="True" ui:SaveShortcut.IsSave="True" ToolTip.Tip="Speichern (Strg+S)" />
      </StackPanel>
    </DataTemplate>

    <!-- Gemeinsames Fenster für neue Einträge: Umschaltleiste und darunter die Eingabe der gewählten Art -->
    <DataTemplate DataType="vm:NewEntryViewModel">
      <StackPanel Spacing="12">
        <Border Classes="segmented" x:Name="EntryKinds" IsVisible="{Binding CanSwitch}">
          <ItemsControl ItemsSource="{Binding Choices}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NewEntryChoice">
                <ui:TabButton Content="{Binding Label}" IsSelected="{Binding IsOn}" Command="{Binding SelectCommand}" ToolTip.Tip="{Binding ToolTip}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,3" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <ContentControl Content="{Binding Content}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:BookingViewModel">
      <StackPanel Spacing="12">

        <StackPanel>
          <TextBlock Text="Kundin oder Kunde" Classes="label" />
          <ui:SearchField Text="{Binding CustomerQuery}" PlaceholderText="Name, Telefon oder E-Mail suchen" AutomationProperties.Name="Kundin oder Kunde suchen"
                          AddCommand="{Binding StartNewCustomerCommand}" AddText="Neue Kundin oder neuen Kunden anlegen" ShowAdd="{Binding !HasChosenCustomer}" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasChosenCustomer}">
          <Border Classes="hint">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ui:Icon Data="{x:Static ui:Icons.User}" Foreground="{DynamicResource AccentBrush}" Width="16" Height="16" />
              <TextBlock Text="{Binding Customer?.InHouseName, TargetNullValue=''}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <Button Grid.Column="1" Classes="ghost" Content="Ändern" Command="{Binding ChangeCustomerCommand}" Margin="6,0,0,0" />
        </Grid>
        <ListBox Classes="plain" ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}" MaxHeight="200"
                 IsVisible="{Binding IsPicking}">
          <ListBox.Styles>
            <!-- Der Name der Zeile ist ihr sichtbarer Inhalt; sonst liest der Screenreader den Record-Typ -->
            <Style Selector="ListBoxItem" x:DataType="c:CustomerDto">
              <Setter Property="AutomationProperties.Name" Value="{Binding LegalName}" />
              <Setter Property="AutomationProperties.HelpText" Value="{Binding Phone}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="c:CustomerDto">
              <StackPanel>
                <TextBlock FontWeight="Medium">
                  <Run Text="{Binding FirstName, Mode=OneWay}" />
                  <Run Text="{Binding LastName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Phone}" Classes="muted small" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{Binding PreferenceHint}" Classes="small" Classes.warn="{Binding PreferenceIsWarning}" TextWrapping="Wrap"
                   IsVisible="{Binding HasPreferenceHint}" />
        <Border Classes="pill warn" HorizontalAlignment="Left" IsVisible="{Binding CheckAnamnesis}"
                ToolTip.Tip="Der Bogen des Gastes enthält Angaben, die vor dieser Behandlung zu lesen sind">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ui:Icon Data="{x:Static ui:Icons.Note}" Width="14" Height="14" Foreground="{DynamicResource WarnBrush}" />
            <TextBlock Text="Anamnese prüfen" />
          </StackPanel>
        </Border>
        <!-- L5: Gast ohne Telefon und E-Mail; Hinweis am Objekt (meldungen.md, M3), blockiert nichts -->
        <Border Classes="pill warn" HorizontalAlignment="Left" IsVisible="{Binding HasNoContact}"
                ToolTip.Tip="Ohne Telefon oder E-Mail gehen keine Erinnerung und keine Zusage hinaus, bis der Kontakt in der Kundenkarte ergänzt ist">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ui:Icon Data="{x:Static ui:Icons.Warning}" Width="14" Height="14" Foreground="{DynamicResource WarnBrush}" />
            <TextBlock Text="Keine Kontaktmöglichkeit" />
          </StackPanel>
        </Border>
        <Border Classes="panelcard" IsVisible="{Binding HasSuggestions}">
          <StackPanel Spacing="6">
            <TextBlock Text="Vorschläge" FontWeight="SemiBold" />
            <StackPanel Spacing="4" IsVisible="{Binding HasTreatmentSuggestion}">
              <TextBlock Text="{Binding SuggestedTreatmentText}" TextWrapping="Wrap" />
              <Button Content="Übernehmen" Command="{Binding AcceptTreatmentCommand}" AutomationProperties.Name="Behandlung übernehmen" HorizontalAlignment="Left"
                      IsVisible="{Binding SuggestionIsDoable}" />
              <!-- Die Spalte kann den Vorschlag nicht: der Weg zu jemandem, der ihn kann -->
              <Button Content="Freie Zeit suchen" Command="{Binding SearchFreeTimeCommand}" CommandParameter="{Binding SuggestedTreatment}" HorizontalAlignment="Left"
                      AutomationProperties.Name="Freie Zeit für die zuletzt gebuchte Behandlung suchen"
                      IsVisible="{Binding !SuggestionIsDoable}" />
            </StackPanel>
            <TextBlock Text="{Binding HabitualPersonText}" Classes="muted small" IsVisible="{Binding HasHabitualPerson}" />
            <StackPanel Spacing="4" IsVisible="{Binding HasWishSuggestion}">
              <TextBlock Text="{Binding SuggestedWishText}" TextWrapping="Wrap" />
              <Button Content="Übernehmen" Command="{Binding AcceptWishCommand}" AutomationProperties.Name="Wunsch in die Notiz übernehmen" HorizontalAlignment="Left" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="panelcard" IsVisible="{Binding ShowNewCustomer}">
          <StackPanel Spacing="8">
            <UniformGrid Columns="2" ColumnSpacing="8">
              <ui:FormField Label="Vorname">
                <TextBox Text="{Binding NewFirstName}" />
              </ui:FormField>
              <ui:FormField Label="Nachname">
                <TextBox Text="{Binding NewLastName}" />
              </ui:FormField>
            </UniformGrid>
            <ui:FormField Label="Telefon">
              <TextBox Text="{Binding NewPhone}" />
            </ui:FormField>
            <ui:FormField Label="E-Mail">
              <TextBox Text="{Binding NewEmail}" />
            </ui:FormField>
            <Border Classes="hint warn"
                    IsVisible="{Binding Duplicates.HasOptions}">
              <StackPanel Spacing="6">
                <TextBlock Text="Gibt es schon?" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Duplicates.Options}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DuplicateOption">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,4">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                          <TextBlock Text="{Binding Reason}" Classes="muted small" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Übernehmen" Command="{Binding AdoptCommand}" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Anlegen" Command="{Binding CreateCustomerCommand}" />
              <Button Classes="ghost" Content="Abbrechen" Command="{Binding CancelNewCustomerCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <ui:FormField Label="Behandlung">
          <ComboBox ItemsSource="{Binding Options}" SelectedValueBinding="{ReflectionBinding Treatment}" SelectedValue="{Binding Treatment}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TreatmentOption">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Treatment.Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Treatment.DurationMinutes, StringFormat='{}{0} Min.'}" Classes="muted small" Margin="8,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Text="{Binding Hint}" Classes="muted small" IsVisible="{Binding Fits}" />
                  <TextBlock Text="{Binding Hint}" Classes="small warn" IsVisible="{Binding Misfit}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </ui:FormField>
        <!-- Nur was die Spalte kann (Auftraggeber, 27.10.2026); alles andere über die freie Zeit -->
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding ColumnScopeText}" Classes="muted small" TextWrapping="Wrap" />
          <Button Classes="ghost" Content="Freie Zeit suchen" Command="{Binding SearchFreeTimeCommand}" HorizontalAlignment="Left"
                  IsVisible="{Binding CanSearchFreeTime}" />
        </StackPanel>

        <Grid ColumnDefinitions="160,110" ColumnSpacing="12">
          <ui:FormField Label="Datum" IsRequired="True">
            <ui:DateField CommittedText="{Binding DateText}" Minimum="{Binding Today}" />
          </ui:FormField>
          <ui:FormField Grid.Column="1" Label="Beginn" IsRequired="True">
            <ui:TimeField CommittedText="{Binding StartText}" />
          </ui:FormField>
        </Grid>

        <ui:FormField Label="Notiz">
          <TextBox x:Name="BookingNoteBox" Classes="grow" Text="{Binding Note}" AcceptsReturn="True" PlaceholderText="optional, z. B. Wunsch oder Hinweis" />
        </ui:FormField>
        <ui:InfoBar Severity="Info" Message="{Binding DayNotice}" IsVisible="{Binding HasDayNotice}" />
        <!-- Von „KI und Hilfe“ vorausgefüllt (Ä319): Hinweis auf den Vorschlag der KI -->
        <ui:InfoBar Severity="Info" Message="{Binding AssistantNote}" IsVisible="{Binding AssistantNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <!-- Meldung und Knopf „Termin buchen“ stehen fest im Fuß der Seitenleiste (Border BookingFoot unten im Panel, außerhalb des Scrollbereichs, design.md 5.1) -->
      </StackPanel>
    </DataTemplate>
    <!-- Kundin suchen und wählen (Gäste, Eintritte) -->
    <DataTemplate DataType="vm:CustomerSearchViewModel">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasCustomer}">
          <Border Classes="hint">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ui:Icon Data="{x:Static ui:Icons.User}" Foreground="{DynamicResource AccentBrush}" Width="16" Height="16" />
              <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <Button Grid.Column="1" Classes="ghost" Content="Ändern" Command="{Binding ChangeCommand}" Margin="6,0,0,0" />
        </Grid>
        <ui:SearchField Text="{Binding Query}" PlaceholderText="Name, Telefon oder E-Mail suchen" IsVisible="{Binding !HasCustomer}"
                        AutomationProperties.Name="Gast suchen" />
        <ListBox Classes="plain" ItemsSource="{Binding Results}" SelectedItem="{Binding Customer}" MaxHeight="160" IsVisible="{Binding IsPicking}">
          <ListBox.Styles>
            <!-- Der Name der Zeile ist ihr sichtbarer Inhalt; sonst liest der Screenreader den Record-Typ -->
            <Style Selector="ListBoxItem" x:DataType="c:CustomerDto">
              <Setter Property="AutomationProperties.Name" Value="{Binding LegalName}" />
              <Setter Property="AutomationProperties.HelpText" Value="{Binding Phone}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="c:CustomerDto">
              <StackPanel>
                <TextBlock FontWeight="Medium">
                  <Run Text="{Binding FirstName, Mode=OneWay}" />
                  <Run Text="{Binding LastName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Phone}" Classes="muted small" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </DataTemplate>

    <!-- Paar oder Spa-Tag -->
    <DataTemplate DataType="vm:GroupBookingViewModel">
      <StackPanel Spacing="12">
        <TextBlock Text="Alles wird gemeinsam gebucht oder nichts." Classes="muted small" TextWrapping="Wrap" />

        <ui:FormField Label="Wann" IsRequired="True" HorizontalAlignment="Left" Width="160">
          <ui:DateField CommittedText="{Binding DateText}" Minimum="{Binding Today}" />
        </ui:FormField>

        <ItemsControl ItemsSource="{Binding Guests}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GroupGuestViewModel">
              <Border Classes="panelcard guestcard" Margin="0,0,0,8">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="{Binding Label}" Classes="group" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" Content="Name folgt" IsChecked="{Binding NameLater}" Margin="0,0,8,0"
                                  AutomationProperties.Name="{Binding Label, StringFormat='{}{0}: Name folgt'}"
                                  ToolTip.Tip="Gruppe oder Firmen-Event: den Gast ohne Namen buchen und den Namen später im Termin nachtragen" />
                    <Button Grid.Column="2" Classes="ghost icon" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}"
                            ToolTip.Tip="Gast entfernen" AutomationProperties.Name="{Binding Label, StringFormat='{}{0} entfernen'}" Padding="4">
                      <ui:Icon Data="{x:Static ui:Icons.Close}" Width="14" Height="14" />
                    </Button>
                  </Grid>
                  <ContentControl Content="{Binding Search}" IsVisible="{Binding ShowSearch}" />
                  <ui:FormField Label="Behandlung">
                    <ComboBox ItemsSource="{Binding FirstEntry.Choices}" SelectedItem="{Binding FirstEntry.Choice}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{Binding FullName, StringFormat='Behandlung für {0}'}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TreatmentChoice">
                          <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </ui:FormField>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding NameLaterNote}" IsVisible="{Binding NameLaterNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Classes="muted small" TextWrapping="Wrap" Margin="0,-4,0,0" />
        <Button Classes="ghost" Command="{Binding AddGuestCommand}" IsVisible="{Binding CanAddGuest}" HorizontalAlignment="Left" Margin="0,-4,0,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ui:Icon Data="{x:Static ui:Icons.Plus}" Width="16" Height="16" />
            <TextBlock Text="Weiterer Gast" />
          </StackPanel>
        </Button>

        <ItemsControl ItemsSource="{Binding Steps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GroupStepViewModel">
              <Border Classes="panelcard" Margin="0,0,0,8" IsVisible="{Binding !IsFirst}">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}" Classes="group" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost icon" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}"
                            ToolTip.Tip="Abschnitt entfernen" AutomationProperties.Name="{Binding Title, StringFormat='{}{0} entfernen'}" Padding="4">
                      <ui:Icon Data="{x:Static ui:Icons.Close}" Width="14" Height="14" />
                    </Button>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GroupEntryViewModel">
                        <Grid ColumnDefinitions="130,*" Margin="0,0,0,6">
                          <TextBlock Text="{Binding Guest.FullName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Classes="secondary" />
                          <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="{Binding Guest.FullName, StringFormat='Behandlung für {0}'}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:TreatmentChoice">
                                <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,-4,0,0">
          <Button Classes="ghost" Command="{Binding AddStepCommand}" IsVisible="{Binding CanAddStep}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Icon Data="{x:Static ui:Icons.Plus}" Width="16" Height="16" />
              <TextBlock Text="Abschnitt danach" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowGap}">
            <TextBlock x:Name="GroupGapLabel" Text="Pause" Classes="muted small" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding GapOptions}" SelectedItem="{Binding Gap}" MinWidth="80" AutomationProperties.LabeledBy="{Binding #GroupGapLabel}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:Int32">
                  <TextBlock Text="{Binding StringFormat='{}{0} Min.'}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>

        <CheckBox IsChecked="{Binding FlexibleOrder}" IsVisible="{Binding ShowFlexible}" Margin="0,-4,0,0"
                  ToolTip.Tip="Der Planer stellt die Abschnitte so um, dass am wenigsten gewartet wird, höchstens 30 Minuten je Abschnitt.">
          <TextBlock Text="Reihenfolge vom Planer (wenigste Wartezeit)" TextWrapping="Wrap" />
        </CheckBox>

        <StackPanel Spacing="6">
          <TextBlock Text="Freie Zeiten" Classes="label" />
          <TextBlock Text="{Binding SlotsNote}" Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding HasSlotsNote}" />
          <ui:FormField Label="Beginn" IsRequired="True" IsVisible="{Binding IsOffline}" HorizontalAlignment="Left">
            <ui:TimeField CommittedText="{Binding OfflineStartText}" />
          </ui:FormField>
          <ListBox Classes="chips" ItemsSource="{Binding Slots}" SelectedItem="{Binding Slot}" MaxHeight="150">
            <ListBox.Styles>
              <!-- Der Name der Zeile ist ihr sichtbarer Inhalt; sonst liest der Screenreader den Record-Typ -->
              <Style Selector="ListBoxItem" x:DataType="vm:GroupSlotOption">
                <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:GroupSlotOption">
                <TextBlock Text="{Binding Text}" Classes="num" FontWeight="SemiBold" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <Border Classes="panelcard" IsVisible="{Binding Plan.Count}">
          <StackPanel Spacing="6">
            <TextBlock Text="Ablauf" Classes="group" />
            <ItemsControl ItemsSource="{Binding Plan}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Classes="small" Margin="0,0,0,4" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Gemeinsam in einem Raum." Classes="muted small" IsVisible="{Binding SharedRoom}" />
          </StackPanel>
        </Border>

        <ui:FormField Label="Notiz">
          <TextBox x:Name="GroupNoteBox" Classes="grow" Text="{Binding Note}" AcceptsReturn="True" PlaceholderText="optional, z. B. Jahrestag, Sekt auf dem Zimmer" />
        </ui:FormField>
        <!-- Meldung über dem Knopf der Aktion (meldungen.md, M7) -->
        <ui:InfoBar Severity="Error" Message="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <ContentControl Content="{Binding Conflict}" IsVisible="{Binding Conflict, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Classes="primary" Content="{Binding BookText}" Command="{Binding BookCommand}" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" ui:SaveShortcut.IsSave="True" ToolTip.Tip="Buchen (Strg+S)" ui:DisabledHint.Text="{Binding BookBlocker}" />
      </StackPanel>
    </DataTemplate>

    <!-- Sauna und Ruheraum -->
    <DataTemplate DataType="vm:AreasViewModel">
      <StackPanel Spacing="12">
        <TextBlock Text="Lade Bereiche …" Classes="muted small" IsVisible="{Binding !Loaded}" />
        <TextBlock Text="Dieser Standort hat keine Bereiche. Räume lassen sich unter „Verwaltung“ → „Stammdaten“ als Bereich markieren."
                   Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}" />

        <ItemsControl ItemsSource="{Binding Areas}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AreaCard">
              <Border Classes="panelcard" Margin="0,0,0,10">
                <StackPanel Spacing="8">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" Classes="muted small" />
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Width="320" Height="30" HorizontalAlignment="Left">
                      <ItemsControl Classes="positioned" ItemsSource="{Binding Bars}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <Canvas />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Styles>
                          <Style Selector="ItemsControl.positioned > ContentPresenter" x:DataType="vm:AreaLoadBar">
                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                          </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:AreaLoadBar">
                            <Rectangle Classes="load" Classes.high="{Binding IsHigh}" Classes.full="{Binding IsFull}"
                                       Width="{Binding Width}" Height="{Binding Height}" ToolTip.Tip="{Binding Tip}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                    <Grid ColumnDefinitions="*,*" Width="320" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding OpenFrom}" Classes="muted small num" />
                      <TextBlock Grid.Column="1" Text="{Binding OpenUntil}"
                                 Classes="muted small num" HorizontalAlignment="Right" />
                    </Grid>
                  </StackPanel>
                  <TextBlock Text="Noch keine Eintritte." Classes="muted small" IsVisible="{Binding !HasVisits}" />
                  <ItemsControl ItemsSource="{Binding Visits}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AreaVisitRow">
                        <Grid ColumnDefinitions="88,*,Auto,Auto" Margin="0,2" Opacity="{Binding Opacity}">
                          <TextBlock Text="{Binding TimeText}" Classes="num small" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Classes="muted small" IsVisible="{Binding HasDetail}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Button Grid.Column="2" Classes="ghost icon" ToolTip.Tip="Eintritt an der Kassa abrechnen" Command="{Binding CheckoutCommand}"
                                  IsVisible="{Binding CanCheckout}">
                            <ui:Icon Data="{x:Static ui:Icons.Register}" Width="16" Height="16" />
                          </Button>
                          <Button Grid.Column="3" Classes="ghost" Content="Stornieren" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}"
                                  Padding="8,4" FontSize="12" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:InfoBar Severity="Error" Message="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Spacing="10" IsVisible="{Binding ShowForm}">
          <TextBlock Text="Neuer Eintritt" Classes="group" />
          <ContentControl Content="{Binding Search}" />
          <ui:FormField Label="Bereich" IsVisible="{Binding ShowAreaChoice}">
            <ComboBox ItemsSource="{Binding Areas}" SelectedItem="{Binding Area}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AreaCard">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </ui:FormField>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <ui:FormField Label="Von" IsRequired="True">
              <ui:TimeField x:Name="AreaFromBox" CommittedText="{Binding FromText}" />
            </ui:FormField>
            <ui:FormField Grid.Column="1" Label="Bis" IsRequired="True">
              <ui:TimeField CommittedText="{Binding UntilText}" NotBefore="{Binding #AreaFromBox.Value}" />
            </ui:FormField>
            <ui:FormField Grid.Column="2" Label="Personen" IsRequired="True">
              <ui:NumberField x:Name="PersonsBox" Value="{Binding Persons}" Minimum="1" Maximum="20" ShowSpinner="True" Width="NaN" HorizontalAlignment="Stretch" />
            </ui:FormField>
          </Grid>
          <ui:FormField Label="Notiz">
            <TextBox x:Name="AreaNoteBox" Classes="grow" Text="{Binding Note}" AcceptsReturn="True" PlaceholderText="optional, z. B. mit Begleitung" />
          </ui:FormField>
          <!-- Ein ungültiger Wert in „Personen“ (leer, außerhalb 1–20) bleibt im Feld stehen und erreicht Persons nicht: buchen erst, wenn das Feld gültig ist -->
          <Button Classes="primary" Content="Eintritt buchen" Command="{Binding BookCommand}" HorizontalAlignment="Stretch" IsEnabled="{Binding #PersonsBox.IsValid}"
                  HorizontalContentAlignment="Center" ui:SaveShortcut.IsSave="True" ToolTip.Tip="Eintritt buchen (Strg+S)" ui:DisabledHint.Text="Verfügbar, sobald ein Gast, eine gültige Uhrzeit und 1 bis 20 Personen eingetragen sind." />
        </StackPanel>
        <Border Classes="hint"
                IsVisible="{Binding Info, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding Info}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </DataTemplate>
    <!-- Lücken schließen (Ä291): Vorschläge des Servers, je mit Knopf; verschoben wird erst nach dem Klick -->
    <DataTemplate DataType="vm:GapsViewModel">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding Hint}" Classes="muted" TextWrapping="Wrap" />
        <TextBlock Text="Suche Lücken …" Classes="muted" IsVisible="{Binding !IsLoaded}" />
        <ui:InfoBar Severity="Error" Message="Vorschläge konnten nicht geladen werden." IsVisible="{Binding LoadFailed}" />
        <Border x:Name="GapsList" IsVisible="{Binding IsLoaded}">
          <StackPanel Spacing="12">
            <TextBlock Text="Keine Lücke, die sich mit wenigen Minuten Verschieben schließen lässt." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}" />
            <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding ShowRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GapRow">
                  <Border Classes="panelcard" Margin="0,0,0,12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="280" />
                      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" MaxWidth="280" />
                      <TextBlock Text="{Binding Reason}" Classes="muted small" TextWrapping="Wrap" MaxWidth="280" />
                      <Button x:Name="MoveGapButton" Content="{Binding MoveText}" HorizontalAlignment="Left" Command="{Binding MoveCommand}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding Message}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </DataTemplate>
    <!-- Warteliste: Wünsche wie die übrigen Listen der App (Name fett, Behandlung, Zeitraum, Stand als Pille), Aktionen als Knöpfe und im Rechtsklick-Menü -->
    <DataTemplate DataType="vm:WaitlistViewModel">
      <StackPanel Spacing="12">
        <TextBlock Text="Wird etwas frei, schreibt der Server den Wartenden selbst. Hier lassen sich freie Zeiten zeigen, für den Gast buchen und Anfragen abschließen."
                   Classes="muted" TextWrapping="Wrap" />
        <TextBlock Text="Niemand wartet auf einen Termin." Classes="muted" IsVisible="{Binding IsEmpty}" />
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WaitlistRow">
              <Border Classes="panelcard" Margin="0,0,0,12">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Freie Zeiten zeigen" Command="{Binding ShowFreeCommand}" />
                    <MenuItem Header="Buchen" Command="{Binding BookCommand}" />
                    <MenuItem Header="Kundenkarte öffnen" Command="{Binding OpenCustomerCommand}" IsEnabled="{Binding CanOpenCustomer}" />
                    <Separator />
                    <MenuItem Header="{x:Static vm:WaitlistRow.CloseLabel}" Command="{Binding AskCloseCommand}" />
                  </ContextMenu>
                </Border.ContextMenu>
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Classes="ghost" Padding="0" MinHeight="0" Background="Transparent" HorizontalAlignment="Left" Command="{Binding OpenCustomerCommand}"
                            IsEnabled="{Binding CanOpenCustomer}" ToolTip.Tip="Kundenkarte öffnen">
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <Border Grid.Column="1" Classes="pill" Classes.warn="{Binding IsOffered}" VerticalAlignment="Top">
                      <TextBlock Text="{Binding State}" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding Treatment}" />
                  <TextBlock Text="{Binding Period}" Classes="secondary small" />
                  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasPhone}">
                    <ui:Icon Data="{x:Static ui:Icons.Phone}" Width="16" Height="16" Foreground="{DynamicResource Fg2Brush}" />
                    <SelectableTextBlock Text="{Binding Phone}" Classes="small num" />
                  </StackPanel>
                  <TextBlock Text="{Binding FreeText}" IsVisible="{Binding HasFree}" Classes="small ok" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <!-- Knöpfe (5.12, Punkt 6): links sekundär, rechts primär, darunter Ghost -->
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                    <Button Content="Freie Zeiten zeigen" Command="{Binding ShowFreeCommand}" HorizontalAlignment="Left"
                            ToolTip.Tip="Öffnet Freie Zeit suchen mit Behandlung, Gast, Zeitraum und Tageszeit dieses Wunsches" />
                    <Button Grid.Column="1" Classes="primary" Content="Buchen" Command="{Binding BookCommand}" IsVisible="{Binding HasFree}" IsEnabled="{Binding !IsClosing}"
                            ToolTip.Tip="Bucht die freie Zeit gleich für diesen Gast; er steht danach nicht mehr auf der Warteliste" />
                  </Grid>
                  <Button Classes="ghost" Content="{x:Static vm:WaitlistRow.CloseLabel}" Command="{Binding AskCloseCommand}" IsVisible="{Binding !IsClosing}" HorizontalAlignment="Left"
                          ToolTip.Tip="Die Anfrage beenden: Termin gebucht, Gast hat abgesagt oder war nicht erreichbar" />
                  <!-- Abschließen fragt nach dem Grund -->
                  <StackPanel Spacing="6" IsVisible="{Binding IsClosing}">
                    <ui:FormField Label="Grund">
                      <ComboBox ItemsSource="{x:Static vm:WaitlistRow.Reasons}" SelectedItem="{Binding Reason}" HorizontalAlignment="Stretch" AutomationProperties.HelpText="{Binding Reason.Hint}" />
                    </ui:FormField>
                    <TextBlock Text="{Binding Reason.Hint}" Classes="muted small" TextWrapping="Wrap" />
                    <UniformGrid Columns="2" ColumnSpacing="8">
                      <Button Classes="primary" Content="Abschließen" Command="{Binding CloseCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                      <Button Classes="ghost" Content="Abbrechen" Command="{Binding CancelCloseCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </UniformGrid>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <!-- Raumpflege nach der Behandlung: Raumcheck des Raumschranks (ADR 0068), je Zeile Aufgefüllt oder Reicht noch -->
    <DataTemplate DataType="vm:RoomCarePanelViewModel">
      <StackPanel Spacing="12">
        <TextBlock Text="Nach der Behandlung ist im Raumschrank Material unter der Mindestmenge. Auffüllen bucht vom Hauptlager in den Raum; „Reicht noch“ bucht nichts."
                   Classes="muted" TextWrapping="Wrap" />
        <ui:InfoBar Severity="Error" Message="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RestockRow">
              <Border Classes="panelcard" Margin="0,0,0,12" Opacity="{Binding RowOpacity}">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    <Border Grid.Column="1" Classes="pill ok" VerticalAlignment="Top" IsVisible="{Binding IsRefilled}">
                      <TextBlock Text="aufgefüllt" />
                    </Border>
                    <Border Grid.Column="1" Classes="pill" VerticalAlignment="Top" IsVisible="{Binding IsEnough}">
                      <TextBlock Text="reicht" />
                    </Border>
                  </Grid>
                  <StackPanel Spacing="8" IsVisible="{Binding IsOpen}">
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                      <ui:FormField Label="Menge" IsRequired="True">
                        <ui:NumberField x:Name="QuantityBox" Value="{Binding Quantity}" Minimum="0" Maximum="999999" Increment="10" LargeIncrement="100" DecimalPlaces="3"
                                        AutomationProperties.Name="{Binding Line.ItemName, StringFormat='Menge {0} nachfüllen'}" />
                      </ui:FormField>
                      <TextBlock Grid.Column="1" Text="{Binding Unit}" Classes="secondary" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    </Grid>
                    <UniformGrid Columns="2" ColumnSpacing="8">
                      <Button Classes="ok" Content="Aufgefüllt" Command="{Binding RefillCommand}" IsEnabled="{Binding #QuantityBox.IsValid}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              ui:DisabledHint.Text="Verfügbar, sobald die Menge eine gültige Zahl ist." />
                      <Button Content="Reicht noch" Command="{Binding EnoughCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </UniformGrid>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="primary" Content="Raumpflege erledigt" Command="{Binding FinishCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Margin="0,4,0,0" ui:DisabledHint.Text="Verfügbar, sobald jede Zeile beantwortet ist." />
      </StackPanel>
    </DataTemplate>

    <!-- Hover-Karte eines Termins: Kopf in drei Zeilen, oranges Band für alles, was Handeln verlangt, dann nur, was vorhanden ist -->
    <DataTemplate DataType="vm:HoverCard">
      <StackPanel Width="340" Spacing="8" Margin="2,4">
        <StackPanel Spacing="2">
          <Grid ColumnDefinitions="*,Auto">
            <WrapPanel Orientation="Horizontal" ItemSpacing="6" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
              <ui:Icon Data="{Binding SymbolIcon}" Width="14" Height="14" Foreground="{DynamicResource Fg2Brush}" VerticalAlignment="Center"
                       IsVisible="{Binding HasSymbol}" />
              <Border Classes="pill" VerticalAlignment="Center" IsVisible="{Binding HasTag}">
                <TextBlock Text="{Binding Tag}" />
              </Border>
            </WrapPanel>
            <Border Grid.Column="1" Classes="pill" VerticalAlignment="Top" Margin="8,0,0,0" IsVisible="{Binding HasStatus}">
              <TextBlock Text="{Binding Status}" />
            </Border>
          </Grid>
          <!-- Hauptangaben in Grundschrift (14) und fett: Behandlung, Tag mit Uhrzeit, Raum; Dauer und Person normal, in der Raumansicht die Person fett (Ä158) -->
          <TextBlock Text="{Binding Treatment}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding Treatment, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <WrapPanel Orientation="Horizontal" IsVisible="{Binding HasParts}">
            <TextBlock Text="{Binding DayTime}" Classes="num" FontSize="14" FontWeight="SemiBold" Margin="0,0,6,0" />
            <TextBlock Text="{Binding Duration}" Classes="num" FontSize="14" Margin="0,0,6,0" />
            <TextBlock Text="{Binding Person}" FontSize="14" Margin="0,0,6,0" IsVisible="{Binding PersonNormal}" />
            <TextBlock Text="{Binding Person}" FontSize="14" FontWeight="SemiBold" Margin="0,0,6,0" IsVisible="{Binding PersonStrong}" />
            <TextBlock Text="{Binding Room}" FontSize="14" FontWeight="SemiBold" IsVisible="{Binding HasRoom}" />
          </WrapPanel>
          <TextBlock Text="{Binding When}" FontSize="14" FontWeight="SemiBold" Classes="num" TextWrapping="Wrap" IsVisible="{Binding !HasParts}" />
        </StackPanel>

        <!-- Ein oranges Band für alles, was Handeln verlangt, eine Zeile je Punkt -->
        <Border CornerRadius="8" Padding="12,10" Background="{DynamicResource WarnSoftBrush}" IsVisible="{Binding HasAlerts}">
          <ItemsControl ItemsSource="{Binding Alerts}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <ItemsControl ItemsSource="{Binding Infos}" IsVisible="{Binding HasInfos}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Classes="ok small" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Geburtstag heute (mit Alter) oder in den drei Tagen davor und danach (Ä45) -->
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasBirthday}">
          <ui:Icon Data="{x:Static ui:Icons.Gift}" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Birthday}" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding HasAppointment}">
          <ItemsControl ItemsSource="{Binding Appointment}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HoverFact">
                <Grid ColumnDefinitions="96,*" Margin="0,1">
                  <TextBlock Text="{Binding Label}" Classes="muted small" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding HasFlags}">
          <TextBlock Text="Kennzeichen" Classes="group" />
          <ItemsControl ItemsSource="{Binding Flags}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GuestFlag">
                <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                  <Border Classes="flag" Classes.note="{Binding IsNote}" Classes.regular="{Binding IsRegular}" Classes.wide="{Binding IsWide}"
                          VerticalAlignment="Top" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Symbol}" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Tip}" FontSize="12" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding HasGuest}">
          <TextBlock Text="Gast" Classes="group" />
          <!-- Wünsche und Vorlieben einzeilig mit „…“; vollständig in der Kundenkarte -->
          <ItemsControl ItemsSource="{Binding Guest}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HoverFact">
                <Grid ColumnDefinitions="96,*" Margin="0,1">
                  <TextBlock Text="{Binding Label}" Classes="muted small" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="2" IsVisible="{Binding HasFlowBlock}">
          <TextBlock Text="Ablauf" Classes="group" />
          <TextBlock Text="{Binding Flow}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasFlow}" />
          <TextBlock Text="{Binding Preparation}" Classes="secondary small" TextWrapping="Wrap" IsVisible="{Binding HasPreparation}" />
        </StackPanel>

        <StackPanel Spacing="2" IsVisible="{Binding HasServing}">
          <TextBlock Text="Bereitstellen" Classes="group" />
          <TextBlock Text="{Binding Serving}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <Border CornerRadius="8" Padding="12,10" Background="{DynamicResource Surface3Brush}" IsVisible="{Binding HasNote}">
          <TextBlock FontSize="12" TextWrapping="Wrap">
            <Run Text="Notiz: " FontWeight="SemiBold" />
            <Run Text="{Binding Note, Mode=OneWay}" />
          </TextBlock>
        </Border>
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <!-- Steht der Fuß mit „Termin buchen“ darunter, braucht der scrollende Inhalt keinen eigenen Abstand für den Knopf „KI und Hilfe“ -->
    <Style Selector="ScrollViewer.panelbody.withfoot">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="16,12,16,12" />
    </Style>
    <!-- Notizen in den Eingaben der Seitenleiste wachsen mit dem Text von 68 bis 200, danach scrollen sie (Ä148, Nachtrag zu Brief 5.16) -->
    <Style Selector="TextBox.grow[AcceptsReturn=True]">
      <Setter Property="Height" Value="NaN" />
      <Setter Property="MinHeight" Value="68" />
      <Setter Property="MaxHeight" Value="200" />
    </Style>
    <!-- Teile einer gemeinsamen Buchung im Panel: der geöffnete hebt sich ab, stornierte treten zurück -->
    <Style Selector="Button.part.current">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.part.cancelled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- Symbole der Meldungen (Karte und Detail) und Symbol im Spaltenkopf: Farbe nach Schwere, immer zusammen mit dem Symbol -->
    <Style Selector="ui|Icon.msgicon">
      <Setter Property="Foreground" Value="{DynamicResource Fg3Brush}" />
    </Style>
    <Style Selector="ui|Icon.msgicon.notice">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ui|Icon.msgicon.warn, ui|Icon.alerticon">
      <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
    </Style>
    <Style Selector="ui|Icon.msgicon.crit, ui|Icon.alerticon.crit">
      <Setter Property="Foreground" Value="{DynamicResource CritBrush}" />
    </Style>
    <!-- Kopf einer Person oder eines Raums: Klick zeigt deren Termine über sieben Tage; Kopf eines Tages: Klick führt zu diesem Tag -->
    <Style Selector="Grid.filterable">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- Weitere Spalten am Rand des Rasters (R04 Slice 86, Ä154, Variante 2): weicher Verlauf über Kopf und Raster, darauf ein runder Knopf mit Pfeil und „+n“ -->
    <Style Selector="Border.edgefade">
      <Setter Property="Width" Value="56" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.edge">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <!-- Mit der Tastatur scrollen die Pfeiltasten den Kalender; der Knopf ist für die Maus und den Screenreader da -->
      <Setter Property="IsTabStop" Value="False" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,Auto" Margin="0">
    <!-- Hauptbereich: der Kalender bekommt die ganze Breite, Überblick und Listen stecken in der Kopfzeile -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" Margin="16">
      <!-- Kopfzeile: höchstens zwei Zeilen (Design-Brief 7, Ä16), nichts bricht um. Alle Elemente außer Datum, Pfeilen, Suche, Aktualisieren und dem primären Knopf
           sind Kopfzeilen-Chips (5.8, Ä17); bei Platzmangel werden sie kompakt (Symbol und Zahl, Text im Hinweis), danach scrollt Zeile 2 waagrecht. -->
      <StackPanel x:Name="CalendarHeader" Spacing="8" Margin="0,0,0,12" ui:RegionNavigation.IsRegion="True" AutomationProperties.Name="Kopfzeile">
        <!-- Zeile 1: links Heute, Pfeile, Datum; rechts Suche, Aktualisieren, Meldungen und „+ Termin“ -->
        <Grid x:Name="HeaderRow1" ColumnDefinitions="Auto,*,Auto">
          <!-- Die Knöpfe stehen vor dem Tagestitel, damit sie beim Weiterschalten nicht wandern. -->
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" x:Name="DayNav">
            <Button Content="Heute" Command="{Binding TodayCommand}" ToolTip.Tip="Heute (Pos1)" />
            <Button Classes="icon" Command="{Binding PreviousDayCommand}" ToolTip.Tip="Vortag (←)">
              <ui:Icon Data="{x:Static ui:Icons.ChevronLeft}" />
            </Button>
            <Button Classes="icon" Command="{Binding NextDayCommand}" ToolTip.Tip="Nächster Tag (→)">
              <ui:Icon Data="{x:Static ui:Icons.ChevronRight}" />
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="ghost" Padding="6,2" x:Name="DateButton" Margin="0,0,4,0" HorizontalAlignment="Left" HorizontalContentAlignment="Left" ToolTip.Tip="{Binding DayFactsTip}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Spacing="8" Width="300">
                  <StackPanel Spacing="4" IsVisible="{Binding HasLocationChoice}">
                    <TextBlock x:Name="LocationLabel" Text="Standort" Classes="group" />
                    <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding Location}" HorizontalAlignment="Stretch"
                              AutomationProperties.LabeledBy="{Binding #LocationLabel}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="c:LocationDto">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <!-- Datumswahl: ein Klick auf den Tag schließt das Flyout (Code-behind), „Heute“ springt ohne Suchen (Auftraggeber, 23.10.2026) -->
                  <Calendar x:Name="DatePicker" SelectedDate="{Binding PickerDate, Mode=TwoWay}" DisplayDate="{Binding PickerDate, Mode=OneWay}"
                            BorderThickness="0" Background="Transparent" FirstDayOfWeek="Monday" SelectedDatesChanged="OnDatePicked" />
                  <Button x:Name="PickToday" Content="Heute" HorizontalAlignment="Stretch" Click="OnPickToday" IsEnabled="{Binding !IsToday}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
            <!-- Feste Mindestbreite (Ä78): Wochentag und Datum wechseln beim Weiterschalten ihre Länge, der Knopf und mit ihm die geöffnete Auswahl dürfen nicht wandern -->
            <StackPanel MinWidth="340">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding DayTitle}" Classes="h1" TextTrimming="CharacterEllipsis" />
                <ui:Icon Data="{x:Static ui:Icons.ChevronRight}" Width="14" Height="14" Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center">
                  <ui:Icon.RenderTransform>
                    <RotateTransform Angle="90" />
                  </ui:Icon.RenderTransform>
                </ui:Icon>
              </StackPanel>
              <!-- Datum und Standort; der Standort folgt direkt auf das Datum und wird bei Platzmangel gekürzt. Rechts davon steht in dieser Zeile nichts, das wandern könnte. -->
              <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="{Binding DateShort}" Classes="muted" x:Name="DateLine" />
                <!-- Feiertag im Datumstitel (ADR 0075): „Montag, 26. Oktober 2026 · Nationalfeiertag“; der Hinweis am Datum nennt Quelle und Stand, Ferien und Hinweise stehen nur dort -->
                <TextBlock DockPanel.Dock="Left" x:Name="DateFacts" Text="{Binding DayFactsText, StringFormat='· {0}'}" FontWeight="SemiBold" Margin="6,0,0,0" MaxWidth="420"
                           TextTrimming="CharacterEllipsis" IsVisible="{Binding HasDayFactsText}" />
                <TextBlock Text="{Binding LocationSuffix}" Classes="muted" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding HasLocationChoice}" ToolTip.Tip="{Binding LocationName}" />
              </DockPanel>
              <TextBlock Text="{Binding OfflineNote}" Classes="small" Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold"
                         IsVisible="{Binding IsOfflineView}" />
            </StackPanel>
          </Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Panel>
              <ui:SearchField x:Name="SearchBox" Width="{Binding SearchWidth}" Text="{Binding SearchText}" PlaceholderText="Suchen (Strg+F)"
                              AutomationProperties.Name="Im Kalender suchen"
                              ToolTip.Tip="Gast, Telefon oder Behandlung suchen; Enter springt zum ersten Treffer" />
              <Popup PlacementTarget="{Binding #SearchBox}" Placement="BottomEdgeAlignedRight" IsOpen="{Binding HasSearchHits}"
                     IsLightDismissEnabled="False">
                <Border Classes="card" Padding="6" Width="340" BoxShadow="{DynamicResource CardShadow}">
                  <ItemsControl ItemsSource="{Binding SearchHits}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CalendarSearchHit">
                        <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6" Click="OnSearchHitClick">
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </Popup>
            </Panel>
            <Button Classes="icon" Command="{Binding LoadCommand}" ToolTip.Tip="Aktualisieren (F5)">
              <ui:Icon Data="{x:Static ui:Icons.Refresh}" />
            </Button>
            <!-- Meldungen: Fläche warn-soft bei Warnungen, danger-soft bei Fehlern, sonst Chip wie die anderen -->
            <Button x:Name="HeadMessages" Classes="headchip" Classes.warn="{Binding MessagesHaveWarning}" Classes.crit="{Binding MessagesHaveError}" Command="{Binding OpenMessagesCommand}"
                    ToolTip.Tip="{Binding MessagesTip}" AutomationProperties.Name="{Binding MessagesName}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:Icon Data="{x:Static ui:Icons.Bell}" Width="16" Height="16" />
                <TextBlock Text="{Binding MessagesLabel}" IsVisible="{Binding MessagesLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <!-- Es gibt Tagesnotizen (Ä31): kleiner Punkt neben dem Zähler; der Zähler zählt nur Meldungen -->
                <ui:Icon x:Name="MessagesNoteDot" Data="{x:Static ui:Icons.Note}" Width="10" Height="10" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                         IsVisible="{Binding HasDayNotes}" />
              </StackPanel>
            </Button>
            <!-- Termin-Gruppe (Auftraggeber, 29.10.2026): „+ Termin“ mit Menü, daneben als zweite Schaltfläche „Freie Zeit suchen“ (Kalender mit Lupe) -->
            <StackPanel x:Name="AppointmentGroup" Orientation="Horizontal" Spacing="4" IsVisible="{Binding CanBook}">
              <SplitButton Command="{Binding NewAppointmentCommand}" ToolTip.Tip="Neuer Termin (N)" AutomationProperties.Name="Termin">
                <SplitButton.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Command="{Binding NewAppointmentCommand}" AutomationProperties.Name="Termin" AutomationProperties.AcceleratorKey="N">
                      <MenuItem.Header>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="Termin" />
                          <TextBlock Grid.Column="1" Text="N" Classes="menugesture" />
                        </Grid>
                      </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="{Binding OpenFreeTimeCommand}" AutomationProperties.Name="Freie Zeit suchen" AutomationProperties.AcceleratorKey="Strg+N">
                      <MenuItem.Header>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="Freie Zeit suchen" />
                          <TextBlock Grid.Column="1" Text="Strg+N" Classes="menugesture" />
                        </Grid>
                      </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="{Binding OpenRequestCommand}" AutomationProperties.Name="Wunsch eintippen (KI)" AutomationProperties.AcceleratorKey="Strg+K">
                      <MenuItem.Header>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="Wunsch eintippen (KI)" />
                          <TextBlock Grid.Column="1" Text="Strg+K" Classes="menugesture" />
                        </Grid>
                      </MenuItem.Header>
                    </MenuItem>
                    <Separator />
                    <MenuItem Command="{Binding OpenGroupBookingCommand}" AutomationProperties.Name="Paar oder Spa-Tag" AutomationProperties.AcceleratorKey="P">
                      <MenuItem.Header>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="Paar oder Spa-Tag" />
                          <TextBlock Grid.Column="1" Text="P" Classes="menugesture" />
                        </Grid>
                      </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Command="{Binding OpenAreasCommand}" IsVisible="{Binding HasAreas}" AutomationProperties.Name="Sauna-Eintritt" AutomationProperties.AcceleratorKey="S">
                      <MenuItem.Header>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="Sauna-Eintritt" />
                          <TextBlock Grid.Column="1" Text="S" Classes="menugesture" />
                        </Grid>
                      </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Header="Warteliste ansehen" Command="{Binding OpenWaitlistCommand}" />
                    <MenuItem Header="Lücken schließen" Command="{Binding OpenGapsCommand}" IsVisible="{Binding CanBook}" />
                    <MenuItem Command="{Binding OpenDayNoteCommand}" AutomationProperties.Name="Tagesnotiz" AutomationProperties.AcceleratorKey=".">
                      <MenuItem.Header>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="Tagesnotiz" />
                          <TextBlock Grid.Column="1" Text="." Classes="menugesture" />
                        </Grid>
                      </MenuItem.Header>
                    </MenuItem>
                  </MenuFlyout>
                </SplitButton.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ui:Icon Data="{x:Static ui:Icons.Plus}" Width="16" Height="16" />
                  <TextBlock Text="Termin" />
                </StackPanel>
              </SplitButton>
              <Button x:Name="FreeTimeButton" Classes="icon" Command="{Binding OpenFreeTimeCommand}" ToolTip.Tip="Freie Zeit suchen (Strg+N)"
                      AutomationProperties.Name="Freie Zeit suchen" AutomationProperties.AcceleratorKey="Strg+N">
                <ui:Icon Data="{x:Static ui:Icons.CalendarSearch}" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
        <!-- Zeile 2: links Umschalter Team/Räume, Zähler, Sauna, Warteliste; rechts auf derselben Linie der Personenfilter (in der Raumansicht gibt es keinen Raumfilter, dann steht dort nichts) -->
        <ui:OverflowStrip x:Name="HeaderRow2" Spacing="8">
          <Border ui:OverflowStrip.Header="Team" ui:OverflowStrip.Icon="{x:Static ui:Icons.Users}">
            <ui:TabButton x:Name="HeadTeam" Classes="headchip pair" IsSelected="{Binding !ByRoom}" Command="{Binding ShowTeamCommand}" ToolTip.Tip="Eine Spalte je Mitarbeitenden" AutomationProperties.Name="Team">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:Icon Data="{x:Static ui:Icons.Users}" Width="16" Height="16" />
                <TextBlock Text="Team" IsVisible="{Binding !IsCompactHeader}" />
              </StackPanel>
            </ui:TabButton>
          </Border>
          <Border ui:OverflowStrip.Header="Räume" ui:OverflowStrip.Icon="{x:Static ui:Icons.Door}">
            <ui:TabButton x:Name="HeadRooms" Classes="headchip pair" IsSelected="{Binding ByRoom}" Command="{Binding ShowRoomsCommand}" ToolTip.Tip="Eine Spalte je Raum" AutomationProperties.Name="Räume">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:Icon Data="{x:Static ui:Icons.Door}" Width="16" Height="16" />
                <TextBlock Text="Räume" IsVisible="{Binding !IsCompactHeader}" />
              </StackPanel>
            </ui:TabButton>
          </Border>
          <!-- Kalender-Abos (ADR 0075): Liste der Abos des Standorts mit den Schaltern „Zeigen“ (je Zugang) und, für die Leitung, „Aktiv (für alle)“; Punkt, wenn Abos ausgeblendet sind -->
          <Border ui:OverflowStrip.Header="Kalender" ui:OverflowStrip.Icon="{x:Static ui:Icons.CalendarSync}">
            <Button x:Name="HeadSubscriptions" Classes="headchip" IsVisible="{Binding HasSubscriptions}" ToolTip.Tip="{Binding SubscriptionsTip}"
                    AutomationProperties.Name="{Binding SubscriptionsName}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Spacing="8" Width="420">
                    <TextBlock Text="Kalender-Abos" Classes="group" />
                    <TextBlock Text="Feiertage, Ferien und Hinweise im Kalender. „Zeigen“ gilt nur für Sie." Classes="muted small" TextWrapping="Wrap" />
                    <ItemsControl x:Name="SubscriptionList" ItemsSource="{Binding Subscriptions}" AutomationProperties.Name="Kalender-Abos">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SubscriptionRowViewModel">
                          <StackPanel Spacing="2" Margin="0,0,0,8">
                            <Border Classes="divider" Margin="0,0,0,6" />
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                              <ToggleSwitch Grid.Column="1" x:Name="ShowSwitch" Content="Zeigen" IsChecked="{Binding Show}" AutomationProperties.Name="{Binding ShowName}" />
                            </Grid>
                            <!-- Art und Stand über die ganze Breite, damit nichts gekürzt wird (der Schalter steht nur in der Zeile darüber) -->
                            <TextBlock Text="{Binding KindAndStatus}" Classes="muted small" TextWrapping="Wrap" Margin="0,-6,0,0" />
                            <ui:InfoBar Severity="Warning" Message="{Binding ErrorText}" IsVisible="{Binding HasError}" Stacked="True" />
                            <TextBlock Text="{x:Static vm:SubscriptionRowViewModel.HolidayNote}" IsVisible="{Binding IsHoliday}" Classes="muted small" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto">
                              <ToggleSwitch x:Name="ActiveSwitch" Content="Aktiv (für alle)" IsChecked="{Binding IsActive}" IsVisible="{Binding CanManage}"
                                            AutomationProperties.Name="{Binding ActiveName}" />
                              <Button Grid.Column="1" x:Name="ReportButton" Classes="ghost" Content="Falsch melden" Command="{Binding ReportCommand}" Click="OnSubscriptionAction"
                                      ToolTip.Tip="Der Leitung einen Tag melden, der nicht stimmt" />
                            </Grid>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:Icon Data="{x:Static ui:Icons.CalendarSync}" Width="16" Height="16" />
                <TextBlock Text="Kalender" IsVisible="{Binding !IsCompactHeader}" />
                <!-- Ein Punkt (Brief 5.8), wenn mindestens ein Abo für diesen Zugang ausgeblendet ist; der Name des Chips sagt es auch -->
                <Ellipse x:Name="SubscriptionsDot" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" IsVisible="{Binding HasHiddenSubscriptions}" />
              </StackPanel>
            </Button>
          </Border>
          <!-- 7-Tage-Ansicht einer Person oder eines Raums: Etikett und deutlicher Weg zurück -->
          <Border ui:OverflowStrip.Header="{Binding FilterText, StringFormat='{}{0} · Filter aufheben'}" ui:OverflowStrip.Icon="{x:Static ui:Icons.Close}">
            <Button x:Name="HeadFilter" Classes="headchip on" Command="{Binding ClearFilterCommand}" IsVisible="{Binding IsFiltered}"
                    ToolTip.Tip="Zurück zum Tag mit allen Spalten (Esc)">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:Icon Data="{x:Static ui:Icons.Close}" Width="16" Height="16" />
                <TextBlock Text="{Binding FilterText}" />
                <TextBlock Text="· Filter aufheben" />
              </StackPanel>
            </Button>
          </Border>
          <Border ui:OverflowStrip.Header="Tag einpassen">
            <Button x:Name="HeadFit" Classes="headchip" Content="Tag einpassen" Command="{Binding ZoomFitCommand}" IsVisible="{Binding !IsFitted}"
                    ToolTip.Tip="Ganzen Tag ohne Scrollen zeigen (Strg 0)" />
          </Border>
          <Border ui:OverflowStrip.Header="{Binding OverviewChip}" ui:OverflowStrip.Icon="{x:Static ui:Icons.Calendar}">
            <Button Classes="headchip" x:Name="OverviewChip" ToolTip.Tip="{Binding OverviewTip}" AutomationProperties.Name="{Binding OverviewChip}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Spacing="10" Width="420">
                    <!-- Tagesfakten (ADR 0075): „Heute: Nationalfeiertag · Herbstferien bis 2.11.“ -->
                    <TextBlock x:Name="OverviewDayLine" Text="{Binding OverviewDayLine}" IsVisible="{Binding HasOverviewDayLine}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Tagesüberblick" Classes="group" />
                    <UniformGrid Columns="2" RowSpacing="4" ColumnSpacing="4">
                      <Button Classes="ghost stat" Command="{Binding FocusOnCommand}" CommandParameter="{x:Static vm:CalendarFocus.Appointments}" Click="OnOverviewAction"
                              ToolTip.Tip="Im Kalender hervorheben" AutomationProperties.Name="{Binding Overview?.Appointments, StringFormat='Termine, {0}', TargetNullValue='Termine, 0'}">
                        <StackPanel>
                          <TextBlock Text="{Binding Overview.Appointments, FallbackValue=0}" FontSize="22" FontWeight="SemiBold" Classes="num" />
                          <TextBlock Text="Termine" Classes="muted small" />
                        </StackPanel>
                      </Button>
                      <Button Classes="ghost stat" Command="{Binding FocusOnCommand}" CommandParameter="{x:Static vm:CalendarFocus.CheckedIn}" Click="OnOverviewAction"
                              ToolTip.Tip="Im Kalender hervorheben" AutomationProperties.Name="{Binding Overview?.CheckedIn, StringFormat='Eingecheckt, {0}', TargetNullValue='Eingecheckt, 0'}">
                        <StackPanel>
                          <TextBlock Text="{Binding Overview.CheckedIn, FallbackValue=0}" FontSize="22" FontWeight="SemiBold" Classes="num"
                                     Foreground="{DynamicResource OkBrush}" />
                          <TextBlock Text="Eingecheckt" Classes="muted small" />
                        </StackPanel>
                      </Button>
                      <Button Classes="ghost stat" Command="{Binding FocusOnCommand}" CommandParameter="{x:Static vm:CalendarFocus.Expected}" Click="OnOverviewAction"
                              ToolTip.Tip="Im Kalender hervorheben" AutomationProperties.Name="{Binding Overview?.Open, StringFormat='Noch erwartet, {0}', TargetNullValue='Noch erwartet, 0'}">
                        <StackPanel>
                          <TextBlock Text="{Binding Overview.Open, FallbackValue=0}" FontSize="22" FontWeight="SemiBold" Classes="num" />
                          <TextBlock Text="Noch erwartet" Classes="muted small" />
                        </StackPanel>
                      </Button>
                      <Button Classes="ghost stat" Command="{Binding OpenFreeTimeCommand}" Click="OnOverviewAction" ToolTip.Tip="Freie Zeit suchen: wo ist noch Platz?"
                              AutomationProperties.Name="{Binding Overview?.Utilization, StringFormat='Auslastung Team, {0}', TargetNullValue='Auslastung Team, –'}">
                        <StackPanel>
                          <TextBlock Text="{Binding Overview.Utilization, FallbackValue='–'}" FontSize="22" FontWeight="SemiBold" Classes="num" />
                          <TextBlock Text="Auslastung Team" Classes="muted small" />
                        </StackPanel>
                      </Button>
                    </UniformGrid>
                    <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6,4" Margin="-6,0"
                            Command="{Binding FocusOnCommand}" CommandParameter="{x:Static vm:CalendarFocus.Unconfirmed}" Click="OnOverviewAction"
                            IsVisible="{Binding Overview.UsesConfirmation, FallbackValue=False}"
                            AutomationProperties.Name="{Binding Overview?.Unconfirmed, StringFormat='Noch nicht zugesagt, {0}', TargetNullValue='Noch nicht zugesagt, 0'}"
                            ToolTip.Tip="Noch nicht über den Link in der Erinnerung zugesagt: im Kalender hervorheben, z. B. zum Anrufen">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Noch nicht zugesagt" Classes="muted small" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Overview.Unconfirmed, FallbackValue=0}" FontWeight="SemiBold" Classes="num"
                                   Foreground="{DynamicResource WarnBrush}" />
                      </Grid>
                    </Button>
                    <!-- Überfällig (Ä100): die Zahl und ihr Klick bleiben wie sie waren, darunter bis zu fünf Termine, jeder öffnet den Termin; „und n weitere“ steht über der Liste -->
                    <StackPanel x:Name="OverdueSection" Spacing="2" IsVisible="{Binding Overview.Overdue, FallbackValue=False}">
                      <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6,4" Margin="-6,0"
                              Command="{Binding FocusOnCommand}" CommandParameter="{x:Static vm:CalendarFocus.Overdue}" Click="OnOverviewAction"
                              AutomationProperties.Name="{Binding Overview?.Overdue, StringFormat='Überfällig, {0}', TargetNullValue='Überfällig, 0'}"
                              ToolTip.Tip="Begonnen, aber noch nicht eingecheckt: im Kalender hervorheben">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="Überfällig" Classes="muted small" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Overview.Overdue, FallbackValue=0}" FontWeight="SemiBold" Classes="num"
                                     Foreground="{DynamicResource WarnBrush}" />
                        </Grid>
                      </Button>
                      <TextBlock x:Name="OverdueMore" Text="{Binding OverdueMoreText}" Classes="muted small" IsVisible="{Binding HasOverdueMore}" />
                      <ItemsControl x:Name="OverdueItems" ItemsSource="{Binding OverdueList}" KeyDown="OnUpcomingKeyDown" AutomationProperties.Name="Überfällig">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:UpcomingItem">
                            <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6,6" Margin="-6,0"
                                    Click="OnUpcomingClick" ToolTip.Tip="{Binding FullText}" AutomationProperties.Name="{Binding AccessibleName}">
                              <Grid ColumnDefinitions="52,*">
                                <TextBlock Text="{Binding Time}" FontWeight="SemiBold" Classes="num" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                  <TextBlock Text="{Binding CustomerShown}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                  <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse Width="7" Height="7" Fill="{Binding Color}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DetailShown}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                                  </StackPanel>
                                </StackPanel>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CanSeeRevenue}">
                      <TextBlock Text="Umsatz laut Kalender" Classes="muted small" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Overview.PlannedRevenue, FallbackValue=''}" FontWeight="SemiBold" Classes="num" />
                    </Grid>
                    <Border Classes="divider" />
                    <!-- Geburtstag heute (Ä45): nur wenn ein Gast mit Termin Geburtstag hat -->
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding BirthdayLine, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <ui:Icon Data="{x:Static ui:Icons.Gift}" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                      <TextBlock Text="{Binding BirthdayLine}" FontSize="12" TextWrapping="Wrap" MaxWidth="260" />
                    </StackPanel>
                    <TextBlock Text="Als Nächstes" Classes="group" />
                    <TextBlock Text="Keine weiteren Termine." Classes="muted small" IsVisible="{Binding !Upcoming.Count}" />
                    <!-- Ä30: einzeilig bis 44 Zeichen (sonst „…“ und der volle Text im Hinweis); Pfeile ↑ ↓ Pos1 Ende bewegen den Fokus, Enter öffnet den Termin -->
                    <ItemsControl x:Name="UpcomingList" ItemsSource="{Binding Upcoming}" KeyDown="OnUpcomingKeyDown" AutomationProperties.Name="Als Nächstes">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:UpcomingItem">
                          <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6,6" Margin="-6,0"
                                  Click="OnUpcomingClick" ToolTip.Tip="{Binding FullText}" AutomationProperties.Name="{Binding AccessibleName}">
                            <Grid ColumnDefinitions="52,*">
                              <TextBlock Text="{Binding Time}" FontWeight="SemiBold" Classes="num" VerticalAlignment="Top" />
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding CustomerShown}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                  <Ellipse Width="7" Height="7" Fill="{Binding Color}" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding DetailShown}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </StackPanel>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:Icon Data="{x:Static ui:Icons.Calendar}" Width="16" Height="16" />
                <TextBlock Text="{Binding OverviewLabel}" Classes="num" />
              </StackPanel>
            </Button>
          </Border>
          <Border ui:OverflowStrip.Header="{Binding FocusText}" ui:OverflowStrip.Icon="{x:Static ui:Icons.Close}">
            <Button x:Name="HeadFocus" Classes="headchip on" Command="{Binding ClearFocusCommand}" IsVisible="{Binding HasFocus}"
                    ToolTip.Tip="Wieder alle Termine zeigen (Esc)">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:Icon Data="{x:Static ui:Icons.Close}" Width="16" Height="16" />
                <TextBlock Text="{Binding FocusText}" Classes="num" />
              </StackPanel>
            </Button>
          </Border>
          <Border ui:OverflowStrip.Header="{Binding AreaChip}" ui:OverflowStrip.Icon="{x:Static ui:Icons.Steam}">
            <Button x:Name="HeadSauna" Classes="headchip" Command="{Binding OpenAreasCommand}" IsVisible="{Binding HasAreaGlances}" ToolTip.Tip="{Binding AreaTip}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:Icon Data="{x:Static ui:Icons.Steam}" Width="16" Height="16" />
                <TextBlock Text="{Binding AreaLabel}" Classes="num" />
              </StackPanel>
            </Button>
          </Border>
          <Border ui:OverflowStrip.Header="{Binding Waitlist.Count, StringFormat='Warteliste {0}'}" ui:OverflowStrip.Icon="{x:Static ui:Icons.Clock}">
            <Button x:Name="HeadWaitlist" Classes="headchip warn" Command="{Binding OpenWaitlistCommand}" IsVisible="{Binding HasWaitlist}" ToolTip.Tip="{Binding WaitlistTip}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:Icon Data="{x:Static ui:Icons.Clock}" Width="16" Height="16" />
                <TextBlock Text="{Binding WaitlistLabel}" />
              </StackPanel>
            </Button>
          </Border>
          <!-- Stornierte Termine des Tages: Chip nach 5.8, „warn“ nur mit Stornos; der Klick öffnet sie im Verlauf -->
          <Border ui:OverflowStrip.Header="{Binding CancelledCount, StringFormat='Storniert {0}'}" ui:OverflowStrip.Icon="{x:Static ui:Icons.History}">
            <Button x:Name="HeadCancelled" Classes="headchip warn" Command="{Binding OpenCancelledCommand}" IsVisible="{Binding HasCancelled}" ToolTip.Tip="Stornierte Termine dieses Tags im Verlauf ansehen.">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:Icon Data="{x:Static ui:Icons.History}" Width="16" Height="16" />
                <TextBlock Text="{Binding CancelledLabel}" />
              </StackPanel>
            </Button>
          </Border>
          <!-- Schließzeit des Tages (ADR 0073): Kopfzeilen-Chip nach 5.8, Betriebsurlaub „on“, Sonderschließung „warn“, Ausfall „crit“; ein Klick öffnet die Schließzeiten in der Verwaltung -->
          <Border ui:OverflowStrip.Header="{Binding ClosureChip?.Text, TargetNullValue=''}" ui:OverflowStrip.Icon="{x:Static ui:Icons.Lock}">
            <Button x:Name="HeadClosure" Classes="headchip" Classes.on="{Binding ClosureChip?.IsVacation, TargetNullValue=False}" Classes.warn="{Binding ClosureChip?.IsSpecial, TargetNullValue=False}"
                    Classes.crit="{Binding ClosureChip?.IsOutage, TargetNullValue=False}" Command="{Binding OpenClosuresCommand}" IsVisible="{Binding HasClosureChip}"
                    ToolTip.Tip="{Binding ClosureChipTip}" AutomationProperties.Name="{Binding ClosureChipTip}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:Icon Data="{x:Static ui:Icons.Lock}" Width="16" Height="16" />
                <TextBlock Text="{Binding ClosureChipLabel}" />
              </StackPanel>
            </Button>
          </Border>
          <!-- Personen ohne Dienst an diesem Standort: schraffierte Spalten mit Grund (frei, Urlaub, krank, anderer Standort); nur da, wenn es solche gibt -->
          <Border ui:OverflowStrip.Header="{Binding AllStaffText}" ui:OverflowStrip.Icon="{x:Static ui:Icons.Users}" ui:OverflowStrip.PinRight="True">
        <Button x:Name="HeadStaffFilter" Classes="headchip" Classes.on="{Binding ShowAllStaff}" Command="{Binding ToggleAllStaffCommand}" IsVisible="{Binding CanToggleAllStaff}"
                ToolTip.Tip="{Binding AllStaffTip}" AutomationProperties.Name="{Binding AllStaffText}">
          <!-- Umschalt-Chip: gewählt trägt er zusätzlich den Haken (Farbe ist nicht der einzige Träger, Brief 5.1 und 5.8) -->
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ui:Icon Classes="togglecheck" Data="{x:Static ui:Icons.Check}" Width="16" Height="16" IsVisible="{Binding ShowAllStaff}" />
            <ui:Icon Data="{x:Static ui:Icons.Users}" Width="16" Height="16" />
            <TextBlock Text="{Binding AllStaffLabel}" IsVisible="{Binding AllStaffLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Button>
          </Border>
          <!-- Räume, die den ganzen Tag gesperrt sind: „Nur verfügbare Räume“ blendet sie aus; nur in der Raumansicht und nur, wenn es solche gibt -->
          <Border ui:OverflowStrip.Header="{Binding RoomFilterText}" ui:OverflowStrip.Icon="{x:Static ui:Icons.Lock}" ui:OverflowStrip.PinRight="True">
        <Button x:Name="HeadRoomFilter" Classes="headchip" Classes.on="{Binding OnlyAvailableRooms}" Command="{Binding ToggleRoomsCommand}" IsVisible="{Binding CanToggleRooms}"
                ToolTip.Tip="{Binding RoomFilterTip}" AutomationProperties.Name="{Binding RoomFilterText}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ui:Icon Classes="togglecheck" Data="{x:Static ui:Icons.Check}" Width="16" Height="16" IsVisible="{Binding OnlyAvailableRooms}" />
            <ui:Icon Data="{x:Static ui:Icons.Lock}" Width="16" Height="16" />
            <TextBlock Text="{Binding RoomFilterLabel}" IsVisible="{Binding RoomFilterLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Button>
          </Border>
        </ui:OverflowStrip>
      </StackPanel>

      <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,10">
        <!-- Fehler und Warnungen einer Aktion (statt Toast, meldungen.md M1/M2): bleibt stehen, bis es geschlossen wird; Fehler zuerst -->
        <ui:InfoBar Severity="{Binding Problem?.Severity, TargetNullValue=Error}" Title="{Binding Problem?.Title, TargetNullValue=''}" Message="{Binding Problem?.Message, TargetNullValue=''}"
                    ActionText="{Binding Problem?.ActionText, TargetNullValue=''}" ActionCommand="{Binding Problem?.Action}"
                    CloseCommand="{Binding DismissProblemCommand}" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <!-- Rückfrage nach einem Klick auf eine Spalte ohne Dienst (keine Meldung der Seitenleiste, sondern eine Frage zu diesem Klick) -->
        <ui:InfoBar Severity="Warning" Title="Kein Dienst" Message="{Binding OffDuty?.Message, TargetNullValue=''}" ActionText="{Binding OffDuty?.ActionText, TargetNullValue=''}"
                    ActionCommand="{Binding OffDuty?.Action}" CloseCommand="{Binding DismissOffDutyCommand}"
                    IsVisible="{Binding OffDuty, Converter={x:Static ObjectConverters.IsNotNull}}" />

      </StackPanel>

      <!-- Kalender: Kopfzeile und Zeitleiste bleiben beim Scrollen stehen -->
      <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True" ui:RegionNavigation.IsRegion="True" ui:RegionNavigation.FocusTarget="{Binding #Root}"
              AutomationProperties.Name="Kalenderfläche">
        <Panel>
          <!-- Bei offener Tastenhilfe ist der Kalender dahinter weichgezeichnet (nur hinter dem Overlay, Styles.axaml) -->
          <Grid x:Name="CalendarBody" ColumnDefinitions="60,*" RowDefinitions="Auto,*" Classes="blurhost" Classes.blurred="{Binding ShowKeyHelp}">
            <Border Grid.ColumnSpan="2" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" />
            <ScrollViewer Grid.Column="1" x:Name="HeaderScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Columns}" Margin="8,10,24,10">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CalendarColumn">
                    <!-- Kopf einer Spalte, Personen und Räume gleich (Design-Brief 7, Ä12): genau zwei Zeilen bei fester Höhe, Name gekürzt, darunter die Kurzinfo -->
                    <Grid Width="{Binding #Root.((vm:CalendarViewModel)DataContext)?.Scale.ColumnWidth, TargetNullValue=0}" Height="38" ColumnDefinitions="Auto,*"
                          Background="Transparent" PointerPressed="OnColumnHeaderPressed" Classes.filterable="{Binding CanClick}"
                          AutomationProperties.Name="{Binding HeaderTipText}">
                      <ToolTip.Tip>
                        <!-- Hinweis (Ä14): höchstens fünf Zeilen mit Symbol 16 und kurzem Text, die letzte der Klick-Hinweis -->
                        <ItemsControl ItemsSource="{Binding HeaderTipLines}" MaxWidth="320">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HeaderTipLine">
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                                <ui:Icon Data="{Binding Icon}" Width="16" Height="16" Foreground="{DynamicResource Fg2Brush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ToolTip.Tip>
                      <ToolTip.ShowDelay>400</ToolTip.ShowDelay>
                      <Panel VerticalAlignment="Center">
                        <Border Classes="avatar" Background="{Binding Color}" IsVisible="{Binding !IsRoom}">
                          <TextBlock Text="{Binding Initials}" />
                        </Border>
                        <!-- Einzelraum: Tür in Grau; Paarraum: Personen-Paar in der Akzentfarbe -->
                        <Border Classes="avatar" Background="{DynamicResource Surface3Brush}" IsVisible="{Binding IsRoom}">
                          <ui:Icon Data="{x:Static ui:Icons.Door}" Foreground="{DynamicResource Fg2Brush}" Width="16" Height="16" IsVisible="{Binding !IsCouple}" />
                        </Border>
                        <Border Classes="avatar" Background="{DynamicResource AccentSoftBrush}" IsVisible="{Binding IsCouple}">
                          <ui:Icon Data="{x:Static ui:Icons.Users}" Foreground="{DynamicResource AccentBrush}" Width="16" Height="16" />
                        </Border>
                      </Panel>
                      <Grid Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <!-- Hinweis zur Person (R05 Slice 111): Symbol mit dem Hinweis im Tooltip -->
                        <Border x:Name="ColumnNoteSymbol" Grid.Column="1" Background="Transparent" Margin="4,0,0,0" VerticalAlignment="Center" IsVisible="{Binding HasNote}"
                                ToolTip.Tip="{Binding NoteText}" ui:ToolTipBehavior.Reachable="True" AutomationProperties.Name="{Binding NoteText, StringFormat='Hinweis: {0}'}"
                                AutomationProperties.ControlTypeOverride="Text" AutomationProperties.AccessibilityView="Content">
                          <ui:Icon Data="{x:Static ui:Icons.Note}" Width="16" Height="16" Foreground="{DynamicResource Fg2Brush}" />
                        </Border>
                        <!-- Höchstens ein Symbol (Dreieck bei Warnungen, Kreis bei Fehlern); ein Klick öffnet „Meldungen“ gefiltert auf diese Spalte -->
                        <Button Grid.Column="2" Classes="ghost" Padding="0" MinHeight="0" MinWidth="0" Width="22" Height="22" Margin="4,-2,0,-2" VerticalAlignment="Center"
                                IsVisible="{Binding HasAlert}" Click="OnColumnAlertClick" ToolTip.Tip="{Binding Alert?.Tip, TargetNullValue=''}"
                                AutomationProperties.Name="Meldungen zu dieser Spalte">
                          <ui:Icon Data="{Binding Alert?.Icon}" Width="16" Height="16" Classes="alerticon" Classes.crit="{Binding Alert?.IsError, TargetNullValue=False}" />
                        </Button>
                        <!-- Zeile 2: Dienstzeit bzw. Grund (mit Standort und Stecknadel bei Dienst an einem anderen Standort), bei Raum Raumpflege und Behandlungen;
                             bei krank gemeldeten Personen mit offenen Terminen der Weg zum Ausfall-Assistenten -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="Auto,*" ColumnSpacing="4" IsVisible="{Binding !HasAffected}">
                          <ui:Icon Data="{x:Static ui:Icons.Pin}" Width="16" Height="16" Foreground="{DynamicResource Fg2Brush}" VerticalAlignment="Center" IsVisible="{Binding HasPlace}" />
                          <TextBlock Grid.Column="1" Text="{Binding SecondLine}" Classes="muted small num" Classes.absent="{Binding HasReasonLine}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <!-- Verweis zum Ausfall-Assistenten: ein Link (Brief 5.24), unterstrichen erst bei Hover und Fokus -->
                        <Button Grid.Row="1" Grid.ColumnSpan="3" Classes="link" Click="OnAffectedClick" IsVisible="{Binding HasAffected}"
                                HorizontalAlignment="Left" ToolTip.Tip="Ausfall-Assistent: Ersatz für die Termine vorschlagen">
                          <TextBlock Text="{Binding AffectedText}" Classes="small num" TextTrimming="CharacterEllipsis" />
                        </Button>
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- Zeitleiste -->
            <ScrollViewer Grid.Row="1" x:Name="GutterScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                          BorderBrush="{DynamicResource LineBrush}">
              <Canvas Height="{Binding DayHeight}" Margin="0,10,0,24" Width="60">
                <ItemsControl Classes="positioned" ItemsSource="{Binding Hours}" Height="{Binding DayHeight}" Width="60" ClipToBounds="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.Styles>
                    <Style Selector="ItemsControl.positioned > ContentPresenter" x:DataType="vm:HourMark">
                      <Setter Property="Canvas.Top" Value="{Binding Top}" />
                    </Style>
                  </ItemsControl.Styles>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HourMark">
                      <TextBlock Text="{Binding Label}" Classes="muted small num" Width="50" TextAlignment="Right" Margin="0,-8,0,0" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Canvas.Top="{Binding NowTop, TargetNullValue=0}" IsVisible="{Binding ShowNow}" Background="{DynamicResource CritBrush}"
                        CornerRadius="3" Padding="4,1" Canvas.Left="8" Margin="0,-9,0,0">
                  <TextBlock Text="{Binding NowText}" Foreground="{DynamicResource AccentFgBrush}" FontSize="12" FontWeight="SemiBold" Classes="num" />
                </Border>
              </Canvas>
            </ScrollViewer>

            <!-- Spalten -->
            <ScrollViewer Grid.Row="1" Grid.Column="1" x:Name="BodyScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <Panel x:Name="Host" Width="{Binding ColumnsWidth}" Height="{Binding DayHeight}" Margin="8,10,24,24"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent">
                <ItemsControl ItemsSource="{Binding Columns}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CalendarColumn">
                      <Panel Width="{Binding #Root.((vm:CalendarViewModel)DataContext)?.Scale.ColumnWidth, TargetNullValue=0}" Height="{Binding #Root.((vm:CalendarViewModel)DataContext)?.DayHeight, TargetNullValue=0}">
                        <Border CornerRadius="4" ClipToBounds="True">
                          <ui:TimeGrid Available="{Binding Available}" PixelsPerMinute="{Binding #Root.((vm:CalendarViewModel)DataContext)?.Scale.PixelsPerMinute, TargetNullValue=0}" />
                        </Border>
                        <Border Classes="absentcol" IsVisible="{Binding IsAbsent}" Classes.sick="{Binding IsSick}" CornerRadius="4" IsHitTestVisible="False" />
                        <ItemsControl Classes="positioned" ItemsSource="{Binding Stripes}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <Canvas />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.Styles>
                            <Style Selector="ItemsControl.positioned > ContentPresenter" x:DataType="vm:CalendarStripe">
                              <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                          </ItemsControl.Styles>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CalendarStripe">
                              <!-- Raumpflege: grau offen, grün erledigt, orange überfällig, nur Text und Fläche (Ä13); ein Klick hakt ab, der Hinweis sagt es -->
                              <Border Classes="stripe" Classes.prep="{Binding IsPreparation}" Classes.after="{Binding IsAfter}" Classes.care="{Binding HasCare}" Classes.caredone="{Binding IsCareDone}" Classes.careoverdue="{Binding IsCareOverdue}"
                                      Width="{Binding #Root.((vm:CalendarViewModel)DataContext)?.Scale.ItemWidth, TargetNullValue=0}" Height="{Binding Height}"
                                      Margin="3,0,3,0" ToolTip.Tip="{Binding Tip}" ToolTip.ShowDelay="300" ToolTip.Placement="RightEdgeAlignedTop"
                                      ToolTip.ServiceEnabled="{Binding #Root.((vm:CalendarViewModel)DataContext)?.HoverCardsEnabled, TargetNullValue=False}"
                                      AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.ControlTypeOverride="Text" AutomationProperties.AccessibilityView="Content">
                                <TextBlock Text="{Binding DisplayText}" IsVisible="{Binding ShowText}" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Classes="positioned" ItemsSource="{Binding Items}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <Canvas />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.Styles>
                            <Style Selector="ItemsControl.positioned > ContentPresenter" x:DataType="vm:CalendarItem">
                              <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                          </ItemsControl.Styles>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CalendarItem">
                              <!-- Zwei Termine einer Person nebeneinander (Einwirkzeit): Breite und Versatz aus der Spaltenbreite und der Bahn -->
                              <Panel Height="{Binding Height}">
                                <Panel.Width>
                                  <MultiBinding Converter="{x:Static vm:Converters.LaneWidth}">
                                    <Binding Path="#Root.((vm:CalendarViewModel)DataContext)?.Scale.ItemWidth" />
                                    <Binding Path="Place" />
                                  </MultiBinding>
                                </Panel.Width>
                                <Panel.Margin>
                                  <MultiBinding Converter="{x:Static vm:Converters.LaneMargin}">
                                    <Binding Path="#Root.((vm:CalendarViewModel)DataContext)?.Scale.ItemWidth" />
                                    <Binding Path="Place" />
                                  </MultiBinding>
                                </Panel.Margin>
                                <!-- Für Screenreader ein Listeneintrag mit Namen und Zustand „ausgewählt“ (R01 Slice 17, W50) -->
                                <ui:AppointmentCard Classes="appt" Classes.checkedin="{Binding IsCheckedIn}" Classes.done="{Binding IsDone}"
                                        IsSelected="{Binding IsSelected}" AutomationProperties.Name="{Binding AccessibleName}"
                                        Classes.noshow="{Binding IsNoShow}" Classes.block="{Binding IsBlock}" Classes.selected="{Binding IsSelected}"
                                        Classes.overdue="{Binding IsOverdue}" Classes.grouped="{Binding IsGroupHighlighted}"
                                        Classes.pause="{Binding IsBreak}" Classes.affected="{Binding IsAffected}"
                                        ToolTip.Tip="{Binding Hover}" ToolTip.ShowDelay="500" ToolTip.BetweenShowDelay="400"
                                        ToolTip.Placement="RightEdgeAlignedTop" ToolTip.HorizontalOffset="6"
                                        ToolTip.ServiceEnabled="{Binding #Root.((vm:CalendarViewModel)DataContext)?.HoverCardsEnabled, TargetNullValue=False}"
                                        Opacity="{Binding Opacity}">
                                  <Panel>
                                    <!-- Einwirkzeit: Person frei, Raum belegt; liegt unter dem Text der Karte -->
                                    <Border Classes="processing" IsVisible="{Binding HasProcessing}" Margin="{Binding ProcessingMargin}" Height="{Binding ProcessingHeight}">
                                      <TextBlock Text="{Binding ProcessingText}" IsVisible="{Binding ShowProcessingText}" />
                                    </Border>
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" VerticalAlignment="Top" IsVisible="{Binding IsCompact}">
                                      <Border Classes="who" Background="{Binding WhoColor}" IsVisible="{Binding ShowWho}" ToolTip.Tip="{Binding Who}">
                                        <TextBlock Text="{Binding WhoInitials}" />
                                      </Border>
                                      <Ellipse Grid.Column="1" Width="7" Height="7" Fill="{Binding GroupColor}" Margin="0,0,5,0" VerticalAlignment="Center"
                                               IsVisible="{Binding IsGroup}" />
                                      <TextBlock Grid.Column="2" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center">
                                        <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{DynamicResource Fg2Brush}" />
                                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                      </TextBlock>
                                      <!-- ♀/♂ aus der Anrede: eigene Spalte vor den Kennzeichen, bleibt beim Kürzen des Namens stehen -->
                                      <ui:Icon Grid.Column="3" Data="{Binding SymbolIcon}" Width="10" Height="10" Foreground="{DynamicResource Fg2Brush}"
                                               Margin="4,0,0,0" VerticalAlignment="Center"
                                               IsVisible="{Binding SymbolIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                      <ItemsControl Grid.Column="4" ItemsSource="{Binding Flags}" VerticalAlignment="Top" IsVisible="{Binding HasFlags}" Margin="4,0,-2,0">
                                        <ItemsControl.ItemsPanel>
                                          <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" />
                                          </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate x:DataType="vm:GuestFlag">
                                            <Border Classes="flag" Classes.note="{Binding IsNote}" Classes.regular="{Binding IsRegular}" Classes.wide="{Binding IsWide}" ToolTip.Tip="{Binding Tip}">
                                              <TextBlock Text="{Binding Symbol}" />
                                            </Border>
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                      <ui:Icon Grid.Column="5" Classes="birthday" Data="{x:Static ui:Icons.Gift}" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,0"
                                               VerticalAlignment="Center" IsVisible="{Binding BirthdayToday}" ToolTip.Tip="Geburtstag heute" AutomationProperties.Name="Geburtstag heute" />
                                    </Grid>
                                    <StackPanel IsVisible="{Binding !IsCompact}" Spacing="1">
                                      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                                        <Border Classes="who" Background="{Binding WhoColor}" IsVisible="{Binding ShowWho}" ToolTip.Tip="{Binding Who}">
                                          <TextBlock Text="{Binding WhoInitials}" />
                                        </Border>
                                        <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding GroupColor}" Margin="0,0,5,0" VerticalAlignment="Center"
                                                 IsVisible="{Binding IsGroup}" />
                                        <TextBlock Grid.Column="2" TextTrimming="CharacterEllipsis">
                                          <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <!-- ♀/♂ aus der Anrede: klein und grau, ohne Rahmen, eigene Spalte vor den Kennzeichen; der Wunsch „Therapeutin/Therapeut“ ist ein Kennzeichen rechts -->
                                        <ui:Icon Grid.Column="3" Data="{Binding SymbolIcon}" Width="11" Height="11" Foreground="{DynamicResource Fg2Brush}"
                                                 Margin="4,0,0,0" VerticalAlignment="Center"
                                                 IsVisible="{Binding SymbolIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <ItemsControl Grid.Column="4" ItemsSource="{Binding Flags}" VerticalAlignment="Top" IsVisible="{Binding HasFlags}" Margin="4,0,-2,0">
                                          <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                              <StackPanel Orientation="Horizontal" Spacing="2" />
                                            </ItemsPanelTemplate>
                                          </ItemsControl.ItemsPanel>
                                          <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GuestFlag">
                                              <Border Classes="flag" Classes.note="{Binding IsNote}" Classes.regular="{Binding IsRegular}" Classes.wide="{Binding IsWide}" ToolTip.Tip="{Binding Tip}">
                                                <TextBlock Text="{Binding Symbol}" />
                                              </Border>
                                            </DataTemplate>
                                          </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Geburtstag heute (Ä45): nur am Tag selbst, ohne Text; das Alter steht in Hover-Karte und Panel -->
                                        <ui:Icon Grid.Column="5" Classes="birthday" Data="{x:Static ui:Icons.Gift}" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,0"
                                                 VerticalAlignment="Center" IsVisible="{Binding BirthdayToday}" ToolTip.Tip="Geburtstag heute" AutomationProperties.Name="Geburtstag heute" />
                                      </Grid>
                                      <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource Fg2Brush}" TextTrimming="CharacterEllipsis"
                                                 IsVisible="{Binding ShowSubtitle}" />
                                      <TextBlock Text="{Binding MetaText}" FontSize="12" Foreground="{DynamicResource Fg2Brush}"
                                                 TextTrimming="CharacterEllipsis" Classes="num" Classes.overdue="{Binding IsOverdue}" />
                                    </StackPanel>
                                  </Panel>
                                </ui:AppointmentCard>
                                <Border Classes="selring" IsVisible="{Binding IsSelected}" IsHitTestVisible="False" />
                              </Panel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Classes="positioned" ItemsSource="{Binding Notes}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <Canvas />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.Styles>
                            <Style Selector="ItemsControl.positioned > ContentPresenter" x:DataType="vm:CalendarNoteItem">
                              <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                          </ItemsControl.Styles>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CalendarNoteItem">
                              <!-- Zettel: neben Terminen und Sperrzeiten in der schmalen Bahn rechts, mit Ende über die Dauer, Text oben -->
                              <Border Classes="sticky" Classes.done="{Binding Done}" Opacity="{Binding Opacity}" Height="{Binding Height}"
                                      ToolTip.Tip="{Binding Tip}" ToolTip.ShowDelay="400"
                                      AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.ControlTypeOverride="Text" AutomationProperties.AccessibilityView="Content">
                                <Border.Width>
                                  <MultiBinding Converter="{x:Static vm:Converters.LaneWidth}">
                                    <Binding Path="#Root.((vm:CalendarViewModel)DataContext)?.Scale.ItemWidth" />
                                    <Binding Path="Place" />
                                  </MultiBinding>
                                </Border.Width>
                                <Border.Margin>
                                  <MultiBinding Converter="{x:Static vm:Converters.LaneMargin}">
                                    <Binding Path="#Root.((vm:CalendarViewModel)DataContext)?.Scale.ItemWidth" />
                                    <Binding Path="Place" />
                                  </MultiBinding>
                                </Border.Margin>
                                <TextBlock TextTrimming="CharacterEllipsis" FontSize="12">
                                  <Run Text="{Binding Time, Mode=OneWay}" FontWeight="SemiBold" />
                                  <Run Text="{Binding Text, Mode=OneWay}" />
                                </TextBlock>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Raumsperre (ADR 0076): die gesperrte Zeit ist schraffiert (nicht mehr verfügbar im Raster); hier Rand und Kapsel mit Art und Grund, über den Terminen wie beim Schließband, nicht anklickbar -->
                        <ItemsControl Classes="positioned" ItemsSource="{Binding RoomClosures}" IsHitTestVisible="False">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <Canvas />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.Styles>
                            <Style Selector="ItemsControl.positioned > ContentPresenter" x:DataType="vm:RoomClosureSpanItem">
                              <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                          </ItemsControl.Styles>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoomClosureSpanItem">
                              <Panel Width="{Binding #Root.((vm:CalendarViewModel)DataContext)?.Scale.ColumnWidth, TargetNullValue=0}" Height="{Binding Height}" AutomationProperties.Name="{Binding Tip}">
                                <Border Classes="closureedge" Classes.special="{Binding IsRenovation}" Classes.outage="{Binding IsDamage}" />
                                <Border Classes="closurelabelbox" Classes.special="{Binding IsRenovation}" Classes.outage="{Binding IsDamage}" IsVisible="{Binding ShowLabel}">
                                  <TextBlock Classes="closurelabel" Classes.special="{Binding IsRenovation}" Classes.outage="{Binding IsDamage}" Text="{Binding Label}" />
                                </Border>
                              </Panel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Jetzt-Linie, freie Zeiten, Vorschau beim Zeigen und Ziehen -->
                <Canvas IsHitTestVisible="False">
                  <!-- Schließbänder (ADR 0073): die Schließzeit über allen Spalten, Farbe nach Art; nicht anklickbar, die Termine darunter bleiben bedienbar -->
                  <ItemsControl x:Name="ClosureBandList" Classes="positioned" ItemsSource="{Binding ClosureBands}" Width="{Binding ColumnsWidth}" Height="{Binding DayHeight}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                      <Style Selector="ItemsControl.positioned > ContentPresenter" x:DataType="vm:ClosureBandItem">
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                      </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ClosureBandItem">
                        <Panel Width="{Binding $parent[ItemsControl].Width}" Height="{Binding Height}" AutomationProperties.Name="{Binding Tip}">
                          <Border Classes="closurefill" Classes.special="{Binding IsSpecial}" Classes.outage="{Binding IsOutage}" />
                          <Border Classes="closureedge" Classes.special="{Binding IsSpecial}" Classes.outage="{Binding IsOutage}" />
                          <Border Classes="closurelabelbox" Classes.special="{Binding IsSpecial}" Classes.outage="{Binding IsOutage}" IsVisible="{Binding ShowLabel}">
                            <TextBlock Classes="closurelabel" Classes.special="{Binding IsSpecial}" Classes.outage="{Binding IsOutage}" Text="{Binding Label}" />
                          </Border>
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl Classes="positioned" ItemsSource="{Binding SlotMarks}" Width="{Binding ColumnsWidth}" Height="{Binding DayHeight}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                      <Style Selector="ItemsControl.positioned > ContentPresenter" x:DataType="vm:SlotMark">
                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                      </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SlotMark">
                        <Panel Width="{Binding Width}" Height="{Binding Height}" Margin="3,1,3,0">
                          <Rectangle RadiusX="5" RadiusY="5" Fill="{DynamicResource OkSoftBrush}" Opacity="0.75" IsVisible="{Binding !IsActive}" />
                          <Rectangle RadiusX="5" RadiusY="5" Fill="{DynamicResource AccentSoftBrush}" Stroke="{DynamicResource AccentBrush}"
                                     StrokeThickness="2" IsVisible="{Binding IsActive}" />
                          <TextBlock Text="{Binding Text}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"
                                     Margin="8,3" Classes="num" TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding Text, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Canvas.Top="{Binding NowTop, TargetNullValue=0}" IsVisible="{Binding ShowNow}" Height="2" Width="{Binding ColumnsWidth}"
                          Background="{DynamicResource CritBrush}" />
                  <!-- Beim Ziehen: die gebundene Zeit mit Vor- und Nachbereitung über und unter dem Ghost -->
                  <Border Canvas.Left="{Binding Ghost?.Left, TargetNullValue=0}" Canvas.Top="{Binding Ghost?.BeforeTop, TargetNullValue=0}"
                          Width="{Binding Scale.ItemWidth}" Height="{Binding Ghost?.BeforeHeight, TargetNullValue=0}" Margin="3,1,3,0" CornerRadius="3,3,0,0"
                          Background="{DynamicResource Surface3Brush}" Opacity="0.7" IsHitTestVisible="False"
                          IsVisible="{Binding Ghost, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <Border Canvas.Left="{Binding Ghost?.Left, TargetNullValue=0}" Canvas.Top="{Binding Ghost?.AfterTop, TargetNullValue=0}"
                          Width="{Binding Scale.ItemWidth}" Height="{Binding Ghost?.AfterHeight, TargetNullValue=0}" Margin="3,1,3,0" CornerRadius="0,0,3,3"
                          Background="{DynamicResource Surface3Brush}" Opacity="0.7" IsHitTestVisible="False"
                          IsVisible="{Binding Ghost, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <Panel Canvas.Left="{Binding Ghost?.Left, TargetNullValue=0}" Canvas.Top="{Binding Ghost?.Top, TargetNullValue=0}"
                         Width="{Binding Scale.ItemWidth}" Height="{Binding Ghost?.Height, TargetNullValue=0}" Margin="3,1,3,0"
                         IsVisible="{Binding Ghost, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <!-- Vorschau beim Planen: ist die Zeit schon belegt, steht die Karte in Warnfarbe -->
                    <Rectangle RadiusX="5" RadiusY="5" Fill="{DynamicResource AccentSoftBrush}" Stroke="{DynamicResource AccentBrush}"
                               StrokeThickness="1.5" StrokeDashArray="4,3" IsVisible="{Binding Ghost?.IsWarning, Converter={x:Static BoolConverters.Not}, TargetNullValue=False}" />
                    <Rectangle RadiusX="5" RadiusY="5" Fill="{DynamicResource WarnSoftBrush}" Stroke="{DynamicResource WarnBrush}"
                               StrokeThickness="1.5" StrokeDashArray="4,3" IsVisible="{Binding Ghost?.IsWarning, TargetNullValue=False}" />
                    <TextBlock Text="{Binding Ghost?.Text, TargetNullValue=''}" Foreground="{DynamicResource AccentBrush}" FontSize="12"
                               FontWeight="SemiBold" Margin="8,2" Classes="num" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" IsVisible="{Binding Ghost?.IsWarning, Converter={x:Static BoolConverters.Not}, TargetNullValue=False}" />
                    <TextBlock Text="{Binding Ghost?.Text, TargetNullValue=''}" Foreground="{DynamicResource WarnBrush}" FontSize="12"
                               FontWeight="SemiBold" Margin="8,2" Classes="num" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" IsVisible="{Binding Ghost?.IsWarning, TargetNullValue=False}" />
                  </Panel>
                </Canvas>
              </Panel>
            </ScrollViewer>

            <!-- Weitere Spalten (Ä154): nur an einem Rand mit verborgenen Spalten; die Verläufe lassen unten und rechts 16 px für die Scrollbalken frei; Hinweis und Screenreader nennen ihre Namen, ein Klick schiebt um eine Breite -->
            <Border x:Name="EdgeFadePrevious" Grid.Column="1" Grid.RowSpan="2" Classes="edgefade" HorizontalAlignment="Left" Margin="0,0,0,16"
                    IsVisible="{Binding LeftEdge, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Offset="0" Color="Black" />
                  <GradientStop Offset="1" Color="Transparent" />
                </LinearGradientBrush>
              </Border.OpacityMask>
            </Border>
            <Border x:Name="EdgeFadeNext" Grid.Column="1" Grid.RowSpan="2" Classes="edgefade" HorizontalAlignment="Right" Margin="0,0,16,16"
                    IsVisible="{Binding RightEdge, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Offset="0" Color="Transparent" />
                  <GradientStop Offset="1" Color="Black" />
                </LinearGradientBrush>
              </Border.OpacityMask>
            </Border>
            <Button x:Name="EdgePrevious" Grid.Row="1" Grid.Column="1" Classes="edge" HorizontalAlignment="Left" Margin="12,0,0,0" Click="OnEdgePreviousClick"
                    IsVisible="{Binding LeftEdge, Converter={x:Static ObjectConverters.IsNotNull}}"
                    ToolTip.Tip="{Binding LeftEdge?.Tip, TargetNullValue=''}" AutomationProperties.Name="{Binding LeftEdge?.Tip, TargetNullValue=''}">
              <StackPanel>
                <ui:Icon Data="{x:Static ui:Icons.ChevronLeft}" Width="16" Height="16" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding LeftEdge?.Badge, TargetNullValue=''}" Classes="num" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="EdgeNext" Grid.Row="1" Grid.Column="1" Classes="edge" HorizontalAlignment="Right" Margin="0,0,12,0" Click="OnEdgeNextClick"
                    IsVisible="{Binding RightEdge, Converter={x:Static ObjectConverters.IsNotNull}}"
                    ToolTip.Tip="{Binding RightEdge?.Tip, TargetNullValue=''}" AutomationProperties.Name="{Binding RightEdge?.Tip, TargetNullValue=''}">
              <StackPanel>
                <ui:Icon Data="{x:Static ui:Icons.ChevronRight}" Width="16" Height="16" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding RightEdge?.Badge, TargetNullValue=''}" Classes="num" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- Tastenhilfe („?“), Runde 5 Ä35: Gruppentitel in der Stufe Zwischentitel, zwei gleich breite Spalten, die Tastenspalte hat überall die Breite der längsten Taste
               (SharedSizeGroup), die Beschreibungen beginnen bündig und brauchen höchstens zwei Zeilen; unten der Link zum Handbuch -->
          <!-- Scrim hinter der Tastenhilfe: ein Klick darauf schließt sie wie Esc -->
          <!-- avalonia-lint-disable AV-APP-39 (Tastatur schließt mit Esc, der Scrim ist nur die Maus-Alternative) -->
          <Border x:Name="KeyHelpScrim" Classes="scrim" IsVisible="{Binding ShowKeyHelp}" PointerPressed="OnKeyHelpScrimPressed" />
          <Border IsVisible="{Binding ShowKeyHelp}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Classes="card" Padding="20" Margin="24,0"
                  BoxShadow="{DynamicResource CardShadow}" MaxWidth="900" x:Name="KeyHelp">
            <Border.Resources>
              <DataTemplate x:Key="KeyGroup" x:DataType="vm:KeyHintGroup">
                <StackPanel Spacing="6" Margin="0,0,0,16">
                  <TextBlock Text="{Binding Title}" Classes="h3" />
                  <ItemsControl ItemsSource="{Binding Keys}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:KeyHint">
                        <Grid Margin="0,0,0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="KeyColumn" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Border Classes="kbd" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Key}" />
                          </Border>
                          <TextBlock Grid.Column="1" Margin="12,1,0,0" Text="{Binding Text}" Classes="small" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </Border.Resources>
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Tasten im Kalender" Classes="h2" />
                <Button Grid.Column="1" Classes="ghost icon" Command="{Binding ToggleKeyHelpCommand}" ToolTip.Tip="Schließen (Esc)" AutomationProperties.Name="Tastenhilfe schließen">
                  <ui:Icon Data="{x:Static ui:Icons.Close}" />
                </Button>
              </Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="24" Grid.IsSharedSizeScope="True">
                  <ItemsControl ItemsSource="{x:Static vm:CalendarViewModel.KeysLeft}" ItemTemplate="{StaticResource KeyGroup}" />
                  <ItemsControl Grid.Column="1" ItemsSource="{x:Static vm:CalendarViewModel.KeysRight}" ItemTemplate="{StaticResource KeyGroup}" />
                </Grid>
              </ScrollViewer>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Text="Buchstaben-Tasten wirken nur, wenn kein Eingabefeld den Fokus hat." Classes="muted small" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button x:Name="KeyManualLink" Grid.Column="1" Classes="link" Content="Alle Tasten im Handbuch" Command="{Binding OpenKeyManualCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Rückmeldung unten -->
          <Border x:Name="ToastBar" Classes="toast" Classes.shown="{Binding HasToast}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,16,12"
                  CornerRadius="8" Padding="16,10,6,10"
                  BoxShadow="{DynamicResource RaisedShadow}" MaxWidth="760" PointerEntered="OnToastEntered" PointerExited="OnToastExited"
                  AutomationProperties.LiveSetting="Polite">
            <!-- Eine Zeile, höchstens eine Aktion („Rückgängig“); Entscheidungen gehören in ein Flyout am Termin (meldungen.md, M1) -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="msg" Text="{Binding Toast}" Foreground="{DynamicResource ToastFgBrush}" VerticalAlignment="Center" MaxWidth="540" AutomationProperties.Name="Meldung"
                         ToolTip.Tip="{Binding Toast}" />
              <Button Classes="ghost" Command="{Binding UndoMoveCommand}" IsVisible="{Binding CanUndo}" Foreground="{DynamicResource ToastFgBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ui:Icon Data="{x:Static ui:Icons.Undo}" Width="16" Height="16" />
                  <TextBlock Text="Rückgängig" />
                </StackPanel>
              </Button>
              <Button Classes="ghost icon" Command="{Binding CloseToastCommand}" Foreground="{DynamicResource ToastFgBrush}" ToolTip.Tip="Schließen">
                <ui:Icon Data="{x:Static ui:Icons.Close}" Width="16" Height="16" />
              </Button>
            </StackPanel>
          </Border>
        </Panel>
      </Border>

      <!-- Unterleiste: die wichtigsten Tasten für die aktuelle Lage -->
      <Panel Grid.Row="3" Margin="2,8,2,0">
        <ItemsControl ItemsSource="{Binding KeyHints}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="16" LineSpacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:KeyHint">
              <!-- Jeder Eintrag ist ein Knopf und tut dasselbe wie die Taste (Ä96); gesperrt nennt der Hinweis den Grund -->
              <Button Classes="ghost" Padding="4,2" IsEnabled="{Binding IsEnabled}" ToolTip.Tip="{Binding Tip}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{Binding AccessibleName}"
                      Command="{Binding #Root.((vm:CalendarViewModel)DataContext)?.PressKeyHintCommand}" CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Classes="kbd">
                    <TextBlock Text="{Binding Key}" />
                  </Border>
                  <TextBlock Text="{Binding Text}" Classes="muted small" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>
    </Grid>

    <!-- Seitenleiste rechts, für alle Leisten gleich: fester Kopf mit Titel, Untertitel und Schließen-Kreuz, darunter scrollt der Inhalt -->
    <Border Grid.Column="1" x:Name="SidePanel" Width="{Binding PanelWidth}" Padding="0" Classes="sidepanel" ui:SaveShortcut.IsScope="True"
            Classes.open="{Binding HasPanel}" Classes.instant="{Binding Presence.UsingKeyboard}" IsVisible="{Binding Presence.IsVisible}"
            ui:RegionNavigation.IsRegion="True" AutomationProperties.Name="{Binding ActivePanel?.PanelTitle, TargetNullValue=Seitenleiste}">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <!-- Alle Leisten außer dem Termin: der einfache Kopf mit Titel und Untertitel -->
        <ui:SidePanelHeader Grid.Row="0" Margin="20,16,12,12" x:Name="PanelHeader" DataContext="{Binding ActivePanel}" x:DataType="vm:ISidePanel"
                            Title="{Binding PanelTitle}" Subtitle="{Binding PanelSubtitle}" CloseTip="{Binding PanelCloseTip}" CloseCommand="{Binding #Root.((vm:CalendarViewModel)DataContext)?.RequestClosePanelCommand}"
                            IsVisible="{Binding #Root.((vm:CalendarViewModel)DataContext)?.HasAppointmentHeader, Converter={x:Static BoolConverters.Not}, TargetNullValue=False}">
          <!-- Aktion der Seite links vom Kreuz, z. B. „Neu beginnen“ bei KI und Hilfe (Ä359); die meisten Seiten haben keine -->
          <ui:SidePanelHeader.Action>
            <Button x:Name="PanelHeaderAction" Classes="ghost" Margin="0,0,4,0" Content="{Binding PanelActionText}" Command="{Binding PanelAction}" IsVisible="{Binding HasPanelAction}"
                    ToolTip.Tip="{Binding PanelActionTip}" AutomationProperties.Name="{Binding PanelActionText}" />
          </ui:SidePanelHeader.Action>
        </ui:SidePanelHeader>
        <!-- Termin: Initialen und Gastname groß, ♀/♂ und Stift beim Namen, Behandlung darunter, Status und Dauer als Pillen, ✕ fest rechts oben.
             Ein Klick auf Initialen oder Namen zeigt die Kundenübersicht (Flyout wie bei den Raum-Infos). -->
        <Border Grid.Row="1" x:Name="AppointmentHeaderHost" IsVisible="{Binding HasAppointmentHeader}">
          <Grid x:Name="AppointmentHeader" ColumnDefinitions="*,Auto" Margin="20,16,12,12" DataContext="{Binding Selected}" x:DataType="vm:AppointmentViewModel">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Classes="ghost" Padding="0" MinHeight="0" MinWidth="0" CornerRadius="22" VerticalAlignment="Top" Click="OnGuestOverviewClick"
                        IsEnabled="{Binding CanShowOverview}" ToolTip.Tip="Kundenübersicht" AutomationProperties.Name="Kundenübersicht">
                  <Border Classes="avatar" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="{Binding Initials}" FontSize="16" Foreground="{DynamicResource AccentBrush}" />
                  </Border>
                  <Button.Flyout>
                    <Flyout Placement="LeftEdgeAlignedTop">
                      <ContentControl Content="{Binding Overview}" />
                    </Flyout>
                  </Button.Flyout>
                </Button>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <!-- Name (höchstens zwei Zeilen), ♀/♂ und Stift stehen direkt dahinter und bleiben auch bei langem Namen sichtbar -->
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="GuestName" Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" MaxWidth="212"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Cursor="Hand" PointerPressed="OnGuestNamePressed"
                               ToolTip.Tip="Kundenübersicht">
                      <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="LeftEdgeAlignedTop">
                          <ContentControl Content="{Binding Overview}" />
                        </Flyout>
                      </FlyoutBase.AttachedFlyout>
                    </TextBlock>
                    <ui:Icon Data="{Binding SymbolIcon}" Width="16" Height="16" Foreground="{DynamicResource Fg2Brush}" VerticalAlignment="Top" Margin="0,5,0,0"
                             IsVisible="{Binding SymbolIcon, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Anrede des Gastes" />
                    <Button Classes="ghost icon" Command="{Binding EditCustomerCommand}" IsVisible="{Binding CanEditCustomer}" VerticalAlignment="Top" Margin="0,1,0,0"
                            ToolTip.Tip="Anrede, Rufname, Telefon und weitere Angaben eintragen"
                            AutomationProperties.Name="Kundendaten ergänzen">
                      <ui:Icon Data="{x:Static ui:Icons.Pencil}" Width="16" Height="16" />
                    </Button>
                  </StackPanel>
                  <TextBlock Text="{Binding Treatment}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost icon" VerticalAlignment="Top" Command="{Binding #Root.((vm:CalendarViewModel)DataContext)?.RequestClosePanelCommand}" ToolTip.Tip="Schließen (Esc)"
                    AutomationProperties.Name="Schließen">
              <ui:Icon Data="{x:Static ui:Icons.Close}" />
            </Button>
          </Grid>
        </Border>
        <Border Grid.Row="2" Classes="divider" />
        <!-- Chip-Zeile unter dem Kopf (5.12, Punkt 3): Status und Dauer des Termins als Pillen, 8 px Abstand -->
        <Border Grid.Row="3" x:Name="AppointmentChips" Padding="20,8,20,0" IsVisible="{Binding HasAppointmentHeader}">
          <WrapPanel ItemSpacing="8" LineSpacing="4" DataContext="{Binding Selected}" x:DataType="vm:AppointmentViewModel">
            <Border Classes="pill booked" Classes.ok="{Binding IsCheckedIn}" Classes.crit="{Binding IsProblem}">
              <TextBlock Text="{Binding StatusText}" />
            </Border>
            <Border Classes="pill">
              <TextBlock Text="{Binding Duration}" />
            </Border>
          </WrapPanel>
        </Border>
        <!-- Unten 32 Rand: der runde Knopf „KI und Hilfe“ der Shell (48 px, 20 px vom Rand) ragt 32 px über die Reiterschiene in die Leiste, seit sie ohne Rand am Fenster anliegt; so endet der scrollende Inhalt oberhalb (das Kundenformular behält seine Aktionsleiste im Fuß) (bis Slice 31 den Knopf verlegt, Ä74) -->
        <Grid Grid.Row="4" RowDefinitions="*,Auto">
          <ScrollViewer Classes="panelbody" Classes.withfoot="{Binding Booking, Converter={x:Static ObjectConverters.IsNotNull}}" Padding="16,12,16,32" Margin="0,0,0,32"
                        IsVisible="{Binding !Selected?.IsEditingCustomer, TargetNullValue=True}">
            <Panel>
              <ContentControl Content="{Binding Selected}" />
              <ContentControl Content="{Binding NewEntry}" />
              <ContentControl Content="{Binding WaitlistPanel}" />
              <ContentControl Content="{Binding GapsPanel}" />
              <ContentControl Content="{Binding FreeTime}" />
              <ContentControl Content="{Binding Absence}" />
              <ContentControl Content="{Binding Request}" />
              <ContentControl Content="{Binding MessagesPanel}" />
              <ContentControl Content="{Binding MessageDetail}" />
              <ContentControl Content="{Binding RoomCarePanel}" />
              <ContentControl Content="{Binding CompanionPanel}" />
            </Panel>
          </ScrollViewer>
          <!-- Kundendaten ergänzen: dasselbe Formular wie in der Kundenkarte; das Panel wird dafür breiter, die Aktionsleiste steht fest im Fuß -->
          <Border IsVisible="{Binding Selected?.IsEditingCustomer, TargetNullValue=False}">
            <local:CustomerContactForm x:Name="PanelCustomerForm" Docked="True" DataContext="{Binding Selected?.CustomerForm}" HorizontalAlignment="Stretch" />
          </Border>
          <!-- Neuer Termin: Meldung über dem Knopf der Aktion (meldungen.md, M7) und „Termin buchen“ fest im Fuß (design.md 5.1: Trennlinie oben, Innenabstand 12/16; unten 32 für den Knopf „KI und Hilfe“); außerhalb der Öffnungszeit oder des Dienstes als Warnung mit „Trotzdem buchen“ (Slice 85) -->
          <Border Grid.Row="1" x:Name="BookingFoot" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}" Padding="16,12,16,32"
                  IsVisible="{Binding Booking, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="8" DataContext="{Binding Booking}" x:DataType="vm:BookingViewModel">
              <ui:InfoBar Severity="Warning" Message="{Binding OutsideHours}" ActionText="Trotzdem buchen" ActionCommand="{Binding BookAnywayCommand}"
                          IsVisible="{Binding OutsideHours, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ui:InfoBar Severity="Error" Message="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ContentControl Content="{Binding Conflict}" IsVisible="{Binding Conflict, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <Button Classes="primary" Content="Termin buchen" Command="{Binding BookCommand}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" ui:SaveShortcut.IsSave="True" ToolTip.Tip="Termin buchen (Strg+S)" ui:DisabledHint.Text="Verfügbar, sobald Gast, Behandlung und Beginn gewählt sind." />
            </StackPanel>
          </Border>
        </Grid>
        <!-- Reiter unten (5.12, Punkt 7), im Quelltext nach dem Inhalt, damit Tab ihn zuletzt erreicht: jede offene Seite ein Reiter; rechts bleibt Platz für den Knopf „KI und Hilfe“, der über der Ecke der Leiste schwebt -->
        <Border Grid.Row="5" x:Name="PanelRail" Classes="panelrail" Padding="8,4,60,4" ui:RegionNavigation.IsRegion="True" AutomationProperties.Name="Offene Seiten">
          <Grid ColumnDefinitions="*,Auto">
            <!-- Höchstens zwei Reiter: der gewählte und der davor benutzte, der zuletzt geöffnete links (Ä15); kein waagrechtes Scrollen -->
            <ItemsControl ItemsSource="{Binding VisibleTabs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SidePanelTab">
                  <ui:TabButton Classes="paneltab" IsSelected="{Binding IsSelected}" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Name}"
                                Command="{Binding #Root.((vm:CalendarViewModel)DataContext)?.SelectPanelTabCommand}" CommandParameter="{Binding}">
                    <!-- Ä19: bei Platzmangel wird der Text gekürzt (voller Name im Tooltip), darunter zeigt der Reiter nur sein Symbol; der Chip „⋯ n“ zählt die übrigen -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <!-- Ä149: Punkt „in Bearbeitung“ oben rechts am Symbol, auch wenn der Reiter nur das Symbol zeigt -->
                      <Panel Width="16" Height="16">
                        <ui:Icon Data="{Binding Icon}" Width="16" Height="16" />
                        <Ellipse x:Name="InProgressDot" Width="6" Height="6" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,-2,-2,0" IsVisible="{Binding IsInProgress}" />
                      </Panel>
                      <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                 MaxWidth="{Binding #Root.((vm:CalendarViewModel)DataContext)?.TabTextMaxWidth, TargetNullValue=0}"
                                 IsVisible="{Binding #Root.((vm:CalendarViewModel)DataContext)?.TabsCompact, Converter={x:Static BoolConverters.Not}, TargetNullValue=False}" />
                    </StackPanel>
                  </ui:TabButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Mehr als zwei offen: Chip „⋯ n“ mit Klappliste aller offenen Seiten, daneben Pfeile zum Blättern durch die Reihe -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="4,0,0,0" IsVisible="{Binding HasTabOverflow}">
              <Button x:Name="PanelMore" Classes="paneltab" ToolTip.Tip="Alle offenen Seiten" AutomationProperties.Name="Alle offenen Seiten">
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedRight">
                    <ItemsControl ItemsSource="{Binding OpenPanels}" MinWidth="200">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SidePanelTab">
                          <ui:TabButton Classes="paneltab entry" IsSelected="{Binding IsSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding #Root.((vm:CalendarViewModel)DataContext)?.SelectPanelTabCommand}" CommandParameter="{Binding}" Click="OnPanelTabPicked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Panel Width="16" Height="16">
                                <ui:Icon Data="{Binding Icon}" Width="16" Height="16" />
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Margin="0,-2,-2,0" IsVisible="{Binding IsInProgress}" />
                              </Panel>
                              <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                            </StackPanel>
                          </ui:TabButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Flyout>
                </Button.Flyout>
                <TextBlock Text="{Binding TabOverflowText}" VerticalAlignment="Center" />
              </Button>
              <Button x:Name="PanelPrevious" Classes="paneltab" Width="28" Padding="0" HorizontalContentAlignment="Center" Command="{Binding PreviousPanelTabCommand}"
                      ToolTip.Tip="Vorige Seite (Strg+Umschalt+Tab)" AutomationProperties.Name="Vorige Seite">
                <ui:Icon Data="{x:Static ui:Icons.ChevronLeft}" Width="16" Height="16" />
              </Button>
              <Button x:Name="PanelNext" Classes="paneltab" Width="28" Padding="0" HorizontalContentAlignment="Center" Command="{Binding NextPanelTabCommand}"
                      ToolTip.Tip="Nächste Seite (Strg+Tab)" AutomationProperties.Name="Nächste Seite">
                <ui:Icon Data="{x:Static ui:Icons.ChevronRight}" Width="16" Height="16" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

      </Grid>
    </Border>
  </Grid>
</UserControl>
