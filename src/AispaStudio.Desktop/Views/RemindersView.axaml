<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.RemindersView"
             x:DataType="vm:RemindersViewModel"
             ui:SaveShortcut.IsScope="True">
  <!--
    Erinnerungen (R05 Slice 96, P8 17.11.2026): zwei Karten, Terminerinnerungen und Wiederbuchungs-Hinweise. Der Wiederbuchungs-Hinweis hat einen Standardabstand und eine kurze Liste von
    Ausnahmen je Kategorie oder Behandlung (Tage leer = kein Hinweis). Unter jeder Karte steht eine Zeile mit den Zahlen der letzten 30 Tage und dem Knopf „Versandprotokoll“, der die
    Seitenleiste mit der Liste aller verschickten Nachrichten öffnet (Filter, Zeitraum, Export). Ist ein Webmodul aus (T-081, Stufe „Start“: keine Wiederbuchung), fehlt seine Karte. Ein gemeinsames „Speichern“ im Fuß, Strg+S speichert.
  -->
  <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
    <ScrollViewer x:Name="MainScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="20" Margin="0,0,16,16" MaxWidth="720" HorizontalAlignment="Left">
        <ui:InfoBar Severity="Error" Title="Erinnerungen nicht geladen" Message="{Binding LoadError}" IsVisible="{Binding HasLoadError}"
                    ActionText="Erneut laden" ActionCommand="{Binding LoadCommand}" />
        <TextBlock Text="Lade Einstellungen …" Classes="muted" IsVisible="{Binding !IsLoaded}" />

        <StackPanel Spacing="20" IsVisible="{Binding IsLoaded}">
          <!-- Terminerinnerungen -->
          <Border x:Name="ReminderCard" Classes="card" Padding="20" IsVisible="{Binding RemindersOn}">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Terminerinnerungen" Classes="h2" VerticalAlignment="Center" />
                <ui:HelpButton Grid.Column="1" Topic="erinnerungen" Section="terminerinnerungen" />
              </Grid>
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Gäste bekommen vor dem Termin eine Erinnerung mit Link zum Ansehen oder Absagen. Das ist keine Werbung und braucht keine Einwilligung." />
              <CheckBox x:Name="EnabledField" Content="Erinnerungen verschicken" IsChecked="{Binding Enabled}" />
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <ui:FormField Label="Erste Erinnerung (Stunden)" Help="So viele Stunden vor dem Termin, 0 = keine.">
                  <ui:NumberField x:Name="FirstHoursField" Value="{Binding FirstHours}" Minimum="0" Maximum="168" Width="200" HorizontalAlignment="Left" />
                </ui:FormField>
                <ui:FormField Grid.Column="1" Label="Zweite Erinnerung (Stunden)" Help="So viele Stunden vor dem Termin, 0 = keine." Error="{Binding SecondHoursError}">
                  <ui:NumberField x:Name="SecondHoursField" Value="{Binding SecondHours}" Minimum="0" Maximum="168" Width="200" HorizontalAlignment="Left" />
                </ui:FormField>
                <ui:FormField Grid.Row="1" Label="Kanal">
                  <ComboBox x:Name="ChannelField" ItemsSource="{x:Static vm:RemindersViewModel.Channels}" SelectedItem="{Binding Channel}" HorizontalAlignment="Stretch" />
                </ui:FormField>
              </Grid>

              <!-- WhatsApp-Vorlage, nur für WhatsApp -->
              <StackPanel Spacing="8" IsVisible="{Binding IsWhatsApp}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Vorlage für WhatsApp" Classes="h3" VerticalAlignment="Center" />
                  <ui:HelpButton Grid.Column="1" Topic="erinnerungen" Section="whatsapp-vorlage" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <ui:FormField Label="WhatsApp-Vorlage" Help="Bei Meta der Name, bei Twilio die Content-SID." IsRequired="True" Error="{Binding TemplateError}">
                    <TextBox x:Name="TemplateField" Text="{Binding WhatsAppTemplate}" />
                  </ui:FormField>
                  <ui:FormField Grid.Column="1" Label="Sprache der Vorlage" IsRequired="True" Error="{Binding LanguageError}">
                    <TextBox x:Name="LanguageField" Text="{Binding WhatsAppLanguage}" />
                  </ui:FormField>
                </Grid>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Platzhalter der Vorlage: {{1}} Vorname, {{2}} Behandlung, {{3}} Datum und Uhrzeit, {{4}} Standort, {{5}} Link zum Termin." />
              </StackPanel>

              <Border Classes="divider" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock x:Name="ReminderSummaryText" Text="{Binding ReminderSummary}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <Border Classes="pill crit" IsVisible="{Binding HasReminderFailed}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ReminderFailed}" />
                  </Border>
                </StackPanel>
                <Button x:Name="ReminderLogButton" Grid.Column="1" Content="Versandprotokoll" Command="{Binding OpenReminderLogCommand}"
                        AutomationProperties.Name="Versandprotokoll der Terminerinnerungen öffnen" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Wiederbuchungs-Hinweise -->
          <Border x:Name="RebookCard" Classes="card" Padding="20" IsVisible="{Binding RebookingOn}">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Text="Wiederbuchungs-Hinweise" Classes="h2" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="pill warn" VerticalAlignment="Center">
                  <TextBlock Text="Werbung, nur mit Einwilligung" />
                </Border>
                <ui:HelpButton Grid.Column="3" Topic="erinnerungen" Section="naechste-behandlung" />
              </Grid>
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Gäste bekommen nach dem Abstand ohne neuen Termin eine Mail mit Buchungslink." />
              <CheckBox x:Name="RebookEnabledField" Content="Wiederbuchungs-Hinweise verschicken" IsChecked="{Binding RebookEnabled}" />

              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Hinweis nach" VerticalAlignment="Center" />
                  <ui:NumberField x:Name="DefaultDaysField" Value="{Binding RebookDefaultDays}" Minimum="7" Maximum="730" Width="100"
                                  AutomationProperties.Name="Standardabstand in Tagen" />
                  <TextBlock Text="Tagen ohne neuen Termin" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Zwischen 7 und 730 Tage. Leer: nur die Ausnahmen unten bekommen einen Hinweis." />
              </StackPanel>

              <!-- Ausnahmen vom Standard: eine Kategorie oder eine Behandlung; Tage leer heißen kein Hinweis -->
              <StackPanel Spacing="8">
                <TextBlock Text="Ausnahmen" Classes="label" />
                <Border x:Name="ExceptionTable" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" IsVisible="{Binding HasExceptions}">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,200,32" Margin="12,8">
                      <TextBlock Text="Ausnahme" Classes="label" />
                      <TextBlock Grid.Column="1" Text="Abstand" Classes="label" />
                    </Grid>
                    <ItemsControl x:Name="ExceptionList" ItemsSource="{Binding Exceptions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RebookExceptionRow">
                          <StackPanel>
                            <Border Classes="divider" />
                            <Grid ColumnDefinitions="*,200,32" Margin="12,6">
                              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <ui:NumberField Value="{Binding Days}" Minimum="7" Maximum="730" Width="90" AutomationProperties.Name="{Binding DaysName}" />
                                <TextBlock Text="Tage" VerticalAlignment="Center" IsVisible="{Binding !HasNoHint}" />
                                <TextBlock Text="kein Hinweis" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding HasNoHint}" />
                              </StackPanel>
                              <Button Grid.Column="2" Classes="ghost icon" Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding RemoveName}"
                                      ToolTip.Tip="Ausnahme entfernen">
                                <ui:Icon Data="{x:Static ui:Icons.Close}" Width="14" Height="14" />
                              </Button>
                            </Grid>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasExceptions}"
                           Text="Keine Ausnahmen: alle Behandlungen folgen dem Standard." />
                <ComboBox x:Name="AddExceptionField" ItemsSource="{Binding ExceptionChoices}" SelectedItem="{Binding NewException}" PlaceholderText="+ Ausnahme"
                          IsVisible="{Binding HasExceptionChoices}" HorizontalAlignment="Left" MinWidth="240" MaxDropDownHeight="320"
                          AutomationProperties.Name="Ausnahme hinzufügen" />
              </StackPanel>

              <Border Classes="divider" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock x:Name="RebookSummaryText" Text="{Binding RebookSummary}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <Border Classes="pill crit" IsVisible="{Binding HasRebookFailed}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RebookFailed}" />
                  </Border>
                </StackPanel>
                <Button x:Name="RebookLogButton" Grid.Column="1" Content="Versandprotokoll" Command="{Binding OpenRebookLogCommand}"
                        AutomationProperties.Name="Versandprotokoll der Wiederbuchungs-Hinweise öffnen" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Spacing="12" MaxWidth="720" HorizontalAlignment="Left" Margin="0,12,16,0" IsVisible="{Binding IsLoaded}">
      <ui:InfoBar Severity="Error" Title="Nicht gespeichert" Message="{Binding Error}" IsVisible="{Binding HasError}"
                  ActionText="Erneut versuchen" ActionCommand="{Binding SaveCommand}" CloseCommand="{Binding CloseErrorCommand}" />
      <ui:SaveBar SaveCommand="{Binding SaveCommand}" DiscardCommand="{Binding DiscardCommand}" CanDiscard="{Binding HasUnsavedChanges}" Status="{Binding StatusText}" />
    </StackPanel>

    <!-- Versandprotokoll als Seitenleiste (Brief 5.12): Terminerinnerungen und Wiederbuchungs-Hinweise in einer Liste -->
    <ui:SidePanel Grid.Column="1" Grid.RowSpan="2" x:Name="LogPanel" Title="Versandprotokoll" IsOpen="{Binding Log.IsOpen, Mode=TwoWay}">
      <ui:SidePanel.HeaderAction>
        <ui:HelpButton Topic="erinnerungen" Section="versandprotokoll" Margin="0,0,4,0" VerticalAlignment="Center" />
      </ui:SidePanel.HeaderAction>
      <ui:SidePanel.Body>
        <Grid RowDefinitions="Auto,*">
          <StackPanel Margin="20,12,20,8" Spacing="12">
            <ListBox x:Name="LogFilters" Classes="chips" ItemsSource="{x:Static vm:DispatchLogViewModel.Filters}" SelectedItem="{Binding Log.SelectedFilter}"
                     AutomationProperties.Name="Art der Nachrichten">
              <ListBox.Styles>
                <Style Selector="ListBoxItem" x:DataType="vm:DispatchFilterOption">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DispatchFilterOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <ui:FormField Label="Zeitraum">
                <ComboBox x:Name="LogPeriod" ItemsSource="{x:Static vm:DispatchLogViewModel.Periods}" SelectedItem="{Binding Log.Period}" HorizontalAlignment="Stretch" />
              </ui:FormField>
              <ui:ExportButton x:Name="LogExportButton" Grid.Column="1" DataContext="{Binding Log.Export}" VerticalAlignment="Bottom" />
            </Grid>
            <ui:InfoBar Severity="Error" Title="Nicht geladen" Message="{Binding Log.Error}" IsVisible="{Binding Log.HasError}"
                        ActionText="Erneut laden" ActionCommand="{Binding Log.LoadCommand}" />
            <TextBlock Text="{Binding Log.ExportStatus}" Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding Log.ExportStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" x:Name="LogScroll" Classes="panelbody" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,0,20,16">
              <TextBlock Text="Wird geladen …" Classes="muted" IsVisible="{Binding !Log.IsLoaded}" />
              <TextBlock x:Name="LogEmpty" Text="{Binding Log.EmptyText}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Log.ShowEmpty}" />
              <ItemsControl x:Name="LogList" ItemsSource="{Binding Log.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DispatchLogRow">
                    <StackPanel>
                      <Border Classes="divider" />
                      <Button Classes="ghost" Command="{Binding ToggleCommand}" Focusable="{Binding HasDetail}" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" Padding="0,8" AutomationProperties.Name="{Binding ToggleName}" ToolTip.Tip="{Binding ToggleTip}">
                        <Grid ColumnDefinitions="68,*,Auto" ColumnSpacing="8">
                          <TextBlock Text="{Binding When}" Classes="muted small" VerticalAlignment="Top" Margin="0,2,0,0" />
                          <StackPanel Grid.Column="1" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBlock Text="{Binding Chevron}" Classes="muted" AutomationProperties.AccessibilityView="Raw" />
                              <TextBlock Text="{Binding Recipient}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}" Classes="muted small" TextWrapping="Wrap" />
                          </StackPanel>
                          <Border Grid.Column="2" Classes="pill" Classes.ok="{Binding IsSent}" Classes.crit="{Binding IsFailed}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding StateText}" />
                          </Border>
                        </Grid>
                      </Button>
                      <StackPanel Margin="76,0,0,8" Spacing="2" IsVisible="{Binding IsExpanded}">
                        <TextBlock Text="{Binding Text}" Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding Text, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Text="{Binding Reason}" Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding Reason, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </ui:SidePanel.Body>
    </ui:SidePanel>
  </Grid>
</UserControl>
