<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.ServerLinkView"
             x:DataType="vm:ServerLinkViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
      <StackPanel>
        <TextBlock Text="Netz" Classes="h1" />
        <TextBlock Text="Hier steht, mit welchem Server diese App verbunden ist. Zu Hause gibt man in derselben App die Serveradresse des Spas ein und meldet sich wie im Spa an."
                   Classes="muted" TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:Icon Data="{x:Static ui:Icons.Wifi}" Width="18" Height="18" />
            <TextBlock Text="Verbindung" Classes="h2" />
            <ui:HelpButton Topic="im-netz" Section="verbinden-server" />
          </StackPanel>
          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
          <ui:InfoBar Severity="Error" Message="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="Verbindung lösen trägt die Adresse auf diesem PC aus und startet die App neu. Danach fragt der Startbildschirm wieder nach einem Server."
                     Classes="muted small" TextWrapping="Wrap" />
          <Button Content="Verbindung lösen" Command="{Binding ReleaseCommand}" HorizontalAlignment="Left"
                  ui:DisabledHint.Text="Verfügbar, wenn ein Server oder Haupt-PC eingetragen ist." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
