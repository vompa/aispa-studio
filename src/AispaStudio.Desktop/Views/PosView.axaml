<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:c="using:AispaStudio.Contracts"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             xmlns:views="using:AispaStudio.Desktop.Views"
             x:Class="AispaStudio.Desktop.Views.PosView"
             x:DataType="vm:PosViewModel"
             x:Name="Root"
             Container.Name="PosPage" Container.Sizing="Width">
  <UserControl.Styles>
    <!-- Zeilen von „Heute abzurechnen“: Wartende mit Akzentleiste links, spätere zurückgenommen (Slice 137) -->
    <Style Selector="Border.dayrow">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.dayrow.waiting">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.dayrow:not(.waiting):not(.done) > Grid > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
    </Style>
    <Style Selector="Border#PayColumn">
      <Setter Property="Grid.Row" Value="2" />
      <Setter Property="Grid.Column" Value="3" />
      <Setter Property="Width" Value="340" />
    </Style>
    <Style Selector="ScrollViewer#PageScroll">
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <!-- Schmale Kassa (Ä345): Bezahlen rückt unter Rechnung und Panel, die Seite rollt dann als Ganzes, die Liste behält ihre Breite.
         Grenze ohne Panel: Rand 32 + Liste 380 + Rechnung 310 + Leiste 44 + Bezahlen 340 + Abstände 48 = 1154 px;
         mit offenem Panel: Panel 232 statt der Leiste 44 = 1342 px -->
    <ContainerQuery Name="PosPage" Query="max-width:1159">
      <Style Selector="ScrollViewer#PageScroll.checkout">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      </Style>
      <Style Selector="Border#PayColumn">
        <Setter Property="Grid.Row" Value="3" />
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,12,0,0" />
      </Style>
      <Style Selector="Border#TodayColumn">
        <Setter Property="Grid.RowSpan" Value="2" />
      </Style>
    </ContainerQuery>
    <ContainerQuery Name="PosPage" Query="max-width:1349">
      <Style Selector="ScrollViewer#PageScroll.checkout.salesopen">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      </Style>
      <Style Selector="ScrollViewer#PageScroll.salesopen Border#PayColumn">
        <Setter Property="Grid.Row" Value="3" />
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,12,0,0" />
      </Style>
      <Style Selector="ScrollViewer#PageScroll.salesopen Border#TodayColumn">
        <Setter Property="Grid.RowSpan" Value="2" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>
  <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" Classes.checkout="{Binding IsCheckout}" Classes.salesopen="{Binding IsSalesColumnOpen}">
  <Grid ColumnSpacing="16" RowDefinitions="Auto,Auto,*,Auto" Margin="16">
    <Grid.ColumnDefinitions>
      <!-- Liste mindestens 380 px; Platz geben zuerst Rechnung und Artikel-Panel ab (Ä345) -->
      <ColumnDefinition Width="2*" MinWidth="380" MaxWidth="520" />
      <ColumnDefinition Width="3*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <!-- Kopfzeile -->
    <Grid Grid.ColumnSpan="4" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="Kassa" Classes="h1" />
        <TextBlock Text="{Binding DateText}" Classes="muted" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Classes="segmented" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal">
            <ui:TabButton Content="Kassieren" IsSelected="{Binding IsCheckout}" Command="{Binding ShowCheckoutCommand}" />
            <ui:TabButton Content="Belege" IsSelected="{Binding IsReceipts}" Command="{Binding ShowReceiptsCommand}" />
            <ui:TabButton Content="Kassenlade &amp; Abschluss" IsSelected="{Binding IsClosing}" Command="{Binding ShowClosingCommand}" />
          </StackPanel>
        </Border>
        <ComboBox ItemsSource="{Binding Registers}" SelectedItem="{Binding Register}" MinWidth="200" ToolTip.Tip="Kasse" AutomationProperties.Name="Kasse">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="c:CashRegisterDto">
              <TextBlock Text="{Binding Code, StringFormat='Kasse {0}'}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Classes="icon" Command="{Binding LoadDayCommand}" ToolTip.Tip="Aktualisieren">
          <ui:Icon Data="{x:Static ui:Icons.Refresh}" />
        </Button>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Spacing="8">
      <ProgressBar IsIndeterminate="True" Margin="0,0,0,12" IsVisible="{Binding IsWorking}" AutomationProperties.Name="Der Termin wird eingecheckt" />
      <ui:InfoBar Severity="Error" Margin="0,0,0,12" Message="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <ui:InfoBar Severity="Warning" Margin="0,0,0,12" Message="{Binding Warning}" IsVisible="{Binding ShowWarning}" />
    </StackPanel>

    <!-- Links: was heute abzurechnen ist, die Hauptliste der Kassa (Slice 137, Ä344); die Gruppen teilt der Server ein -->
    <Border x:Name="TodayColumn" Grid.Row="2" Classes="card" Padding="0" IsVisible="{Binding IsCheckout}">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Margin="16,14,16,8" Spacing="8">
          <TextBlock Text="Heute abzurechnen" Classes="h2" />
          <TextBox x:Name="PosScanField" Text="{Binding ScanText}" PlaceholderText="Gast, Code oder Artikel" AutomationProperties.Name="Gast, Code oder Artikel suchen"
                   ToolTip.Tip="Tippen filtert die Liste; ein gescannter Code kommt mit Menge 1 auf die Rechnung.">
            <TextBox.InnerLeftContent>
              <ui:Icon Data="{x:Static ui:Icons.Search}" Width="16" Height="16" Foreground="{DynamicResource Fg3Brush}" Margin="8,0,0,0" />
            </TextBox.InnerLeftContent>
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ScanCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
        </StackPanel>
        <ScrollViewer x:Name="TodayScroll" Grid.Row="1" Padding="8,0,8,12" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8">
            <TextBlock Text="Alle Termine und Eintritte von heute sind abgerechnet." Classes="muted small" Margin="8,4" TextWrapping="Wrap" IsVisible="{Binding ShowAllBilled}" />
            <TextBlock Text="Nichts passt zur Suche. Enter sucht den Text als Code." Classes="muted small" Margin="8,4" TextWrapping="Wrap" IsVisible="{Binding ShowNoHits}" />
            <ListBox x:Name="TodayList" Classes="plain today" ItemsSource="{Binding Unbilled}" AutomationProperties.Name="Heute abzurechnen"
                     IsVisible="{Binding Unbilled.Count}" Tapped="OnTodayListTapped">
              <ListBox.Styles>
                <Style Selector="ListBoxItem" x:DataType="vm:UnbilledItem">
                  <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                  <Setter Property="Padding" Value="0" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:UnbilledItem">
                  <StackPanel>
                    <TextBlock x:Name="GroupTitleText" Text="{Binding GroupTitle}" Classes="group" Margin="10,10,10,4" IsVisible="{Binding HasGroupTitle}" />
                    <Border Classes="dayrow" Classes.waiting="{Binding IsDone}">
                      <Grid ColumnDefinitions="44,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Time}" FontWeight="SemiBold" Classes="num" />
                        <TextBlock Grid.Column="1" Text="{Binding Customer}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{Binding Price}" Classes="num" FontWeight="Medium" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SecondLine}" Classes="secondary small" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding FinishedText}" Classes="small" FontWeight="Medium"
                                   Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding HasFinishedText}" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Spacing="2" IsVisible="{Binding ArticleHits.Count}">
              <TextBlock Text="Artikel" Classes="group" Margin="10,10,10,4" />
              <ItemsControl x:Name="ArticleList" ItemsSource="{Binding ArticleHits}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="c:ArticleDto">
                    <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,7"
                            Command="{Binding #Root.((vm:PosViewModel)DataContext)?.AddArticleCommand}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Name, StringFormat='{}{0} auf die Rechnung'}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Classes="num secondary">
                          <TextBlock.Text>
                            <MultiBinding Converter="{x:Static vm:Converters.MoneyText}">
                              <Binding Path="Price" />
                              <Binding Path="#Root.((vm:PosViewModel)DataContext)?.Currency" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel IsVisible="{Binding HasDone}">
              <ui:AccordionHeader x:Name="DoneHeader" Classes="accordion" IsChecked="{Binding IsDoneOpen, Mode=TwoWay}" AutomationProperties.Name="{Binding DoneTitle}"
                                  Padding="10,8" HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock x:Name="DoneTitleText" Text="{Binding DoneTitle}" Classes="group" VerticalAlignment="Center" />
                  <ui:Icon Grid.Column="1" Classes="chevron" Data="{x:Static ui:Icons.ChevronRight}" Width="14" Height="14" Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center" />
                </Grid>
              </ui:AccordionHeader>
              <ItemsControl x:Name="DoneList" ItemsSource="{Binding Done}" IsVisible="{Binding IsDoneOpen}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:UnbilledItem">
                    <Border Classes="dayrow done" AutomationProperties.Name="{Binding AccessibleName}">
                      <Grid ColumnDefinitions="44,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Time}" Classes="num muted" />
                        <TextBlock Grid.Column="1" Text="{Binding Customer}" Classes="secondary" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{Binding Price}" Classes="num muted" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SecondLine}" Classes="muted small" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="2" IsVisible="{Binding OpenBills.Count}">
              <TextBlock Text="Geparkte Rechnungen" Classes="group" Margin="10,10,10,4" />
              <ItemsControl ItemsSource="{Binding OpenBills}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="c:BillDto">
                    <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,7"
                            Command="{Binding #Root.((vm:PosViewModel)DataContext)?.OpenBillCommand}" CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding CustomerName, FallbackValue='Laufkundschaft', TargetNullValue='Laufkundschaft'}" FontWeight="Medium" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Classes="num secondary">
                          <TextBlock.Text>
                            <MultiBinding Converter="{x:Static vm:Converters.MoneyText}">
                              <Binding Path="Open" />
                              <Binding Path="#Root.((vm:PosViewModel)DataContext)?.Currency" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Mitte: Rechnung oder Beleg -->
    <Panel x:Name="BillColumn" Grid.Row="2" Grid.Column="1" IsVisible="{Binding IsCheckout}">
      <!-- Ohne Rechnung nur ein kleiner Hinweis, die Karte erscheint erst mit dem Beleg (Slice 137) -->
      <Border Classes.card="{Binding HasReceipt}" Padding="24" IsVisible="{Binding !HasBill}" VerticalAlignment="Top">
        <Panel>
          <TextBlock x:Name="NoBillHint" Text="Keine offene Rechnung. In „Heute abzurechnen“ einen Gast wählen oder einen Code scannen." Classes="muted"
                     TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasReceipt}" />

          <!-- Beleg nach dem Bezahlen -->
          <StackPanel Spacing="12" IsVisible="{Binding #Root.((vm:PosViewModel)DataContext)?.HasReceipt, TargetNullValue=False}" DataContext="{Binding Receipt}" x:DataType="vm:ReceiptViewModel">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ui:Icon Data="{x:Static ui:Icons.Check}" Foreground="{DynamicResource OkBrush}" Width="22" Height="22" />
                  <TextBlock Text="Bezahlt" Classes="h1" Foreground="{DynamicResource OkBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Subtitle}" Classes="muted small" />
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost icon" Command="{Binding #Root.((vm:PosViewModel)DataContext)?.CloseReceiptCommand}"
                      ToolTip.Tip="Schließen" VerticalAlignment="Top">
                <ui:Icon Data="{x:Static ui:Icons.Close}" />
              </Button>
            </Grid>
            <views:ReceiptPaper />
            <Border Classes="card" Padding="16" Width="420" IsVisible="{Binding CanAddRecipient}">
              <StackPanel Spacing="8">
                <TextBlock Text="Rechnung mit Empfänger" Classes="h2" />
                <ui:InfoBar Severity="Warning" Message="{Binding InvoiceHint}" IsVisible="{Binding InvoiceHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="muted small" TextWrapping="Wrap"
                           Text="Für Firmenkunden: Name, Anschrift und UID einmal ergänzen; der Beleg wird damit zur Rechnung." />
                <Button Content="Empfänger erfassen" HorizontalAlignment="Left"
                        Command="{Binding #Root.((vm:PosViewModel)DataContext)?.StartInvoiceCommand}" CommandParameter="{Binding}"
                        IsVisible="{Binding !#Root.((vm:PosViewModel)DataContext)?.IsInvoicing, TargetNullValue=False}" />
                <StackPanel Spacing="6" IsVisible="{Binding #Root.((vm:PosViewModel)DataContext)?.IsInvoicing, TargetNullValue=False}">
                  <ui:FormField Label="Name oder Firma" IsRequired="True">
                    <TextBox Text="{Binding #Root.((vm:PosViewModel)DataContext)?.RecipientName}" />
                  </ui:FormField>
                  <ui:FormField Label="Anschrift" IsRequired="True">
                    <TextBox Text="{Binding #Root.((vm:PosViewModel)DataContext)?.RecipientAddress}" AcceptsReturn="True" />
                  </ui:FormField>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <ui:FormField Label="UID-Nummer">
                      <TextBox Text="{Binding #Root.((vm:PosViewModel)DataContext)?.RecipientVatId}" PlaceholderText="z. B. ATU12345678" />
                    </ui:FormField>
                    <Button Grid.Column="1" Content="UID prüfen" Command="{Binding #Root.((vm:PosViewModel)DataContext)?.CheckVatIdCommand}" VerticalAlignment="Bottom"
                            ToolTip.Tip="Über VIES prüfen; eine gültige Abfrage wird als Nachweis an die Rechnung gehängt" />
                  </Grid>
                  <TextBlock Text="{Binding #Root.((vm:PosViewModel)DataContext)?.VatCheckText}" Classes="small" TextWrapping="Wrap"
                             Classes.ok="{Binding #Root.((vm:PosViewModel)DataContext)?.VatCheckOk, TargetNullValue=False}"
                             Classes.crit="{Binding #Root.((vm:PosViewModel)DataContext)?.VatCheckFailed, TargetNullValue=False}" />
                  <CheckBox Content="{Binding #Root.((vm:PosViewModel)DataContext)?.RememberRecipientText}"
                            IsChecked="{Binding #Root.((vm:PosViewModel)DataContext)?.RememberRecipient}"
                            IsVisible="{Binding #Root.((vm:PosViewModel)DataContext)?.CanRememberRecipient, TargetNullValue=False}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Empfänger übernehmen" Command="{Binding #Root.((vm:PosViewModel)DataContext)?.AddRecipientCommand}" />
                    <Button Classes="ghost" Content="Abbrechen" Command="{Binding #Root.((vm:PosViewModel)DataContext)?.CancelInvoiceCommand}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Command="{Binding #Root.((vm:PosViewModel)DataContext)?.PrintReceiptCommand}" CommandParameter="{Binding}"
                      IsEnabled="{Binding #Root.((vm:PosViewModel)DataContext)?.HasPrinter, TargetNullValue=False}"
                      ui:DisabledHint.Text="Verfügbar, sobald unter „Geräte“ ein Bondrucker eingerichtet ist.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ui:Icon Data="{x:Static ui:Icons.Printer}" Width="16" Height="16" />
                  <TextBlock Text="Drucken" />
                </StackPanel>
              </Button>
              <TextBlock Text="{Binding #Root.((vm:PosViewModel)DataContext)?.PrintText}" AutomationProperties.LiveSetting="Polite" Classes="muted" VerticalAlignment="Center" />
              <TextBlock Text="{x:Static vm:PosViewModel.NoPrinterHint}" Classes="muted small" VerticalAlignment="Center"
                         IsVisible="{Binding !#Root.((vm:PosViewModel)DataContext)?.HasPrinter, TargetNullValue=False}" />
            </StackPanel>
          </StackPanel>
        </Panel>
      </Border>

      <Border Classes="card" Padding="0" IsVisible="{Binding HasBill}">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,18,16,12">
            <Border Classes="avatar" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}">
              <ui:Icon Data="{x:Static ui:Icons.User}" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding CustomerText}" Classes="h2" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding CustomerLegalText}" Classes="secondary small" ToolTip.Tip="Gültiger Name, so steht er auf Belegen mit Empfänger"
                         IsVisible="{Binding CustomerLegalText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="Offene Rechnung" Classes="muted small" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <Button Classes="ghost" Content="Parken" Command="{Binding ParkBillCommand}" ToolTip.Tip="Rechnung offen lassen und später weiterkassieren" />
              <Button Classes="danger" Content="Verwerfen" Command="{Binding AskDiscardBillCommand}" />
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="1" Padding="12,0">
            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BillLineItem">
                  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="8,10">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <StackPanel>
                        <TextBlock FontWeight="Medium" TextWrapping="Wrap">
                          <Run Text="{Binding Quantity, Mode=OneWay}" />
                          <Run Text="{Binding Description, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Tax}" Classes="muted small" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Amount}" FontWeight="SemiBold" Classes="num" VerticalAlignment="Center" Margin="12,0" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Classes="ghost icon" ToolTip.Tip="Rabatt auf diese Position" IsVisible="{Binding CanDiscount}"
                                AutomationProperties.Name="{Binding Description, StringFormat='Rabatt auf {0}'}"
                                Command="{Binding #Root.((vm:PosViewModel)DataContext)?.EditDiscountCommand}" CommandParameter="{Binding}">
                          <ui:Icon Data="{x:Static ui:Icons.Percent}" Width="16" Height="16" />
                        </Button>
                        <Button Classes="ghost icon" ToolTip.Tip="Position entfernen" AutomationProperties.Name="{Binding Description, StringFormat='{}{0} entfernen'}"
                                Command="{Binding #Root.((vm:PosViewModel)DataContext)?.RemoveLineCommand}" CommandParameter="{Binding}">
                          <ui:Icon Data="{x:Static ui:Icons.Close}" Width="16" Height="16" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Border Grid.Row="2" Background="{DynamicResource HeroBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                  CornerRadius="0,0,12,12">
            <StackPanel Spacing="10">
            <!-- Vorschlag der laufenden Aktion (ADR 0071): nur mit Klick, den Rabatt rechnet der Server -->
            <ItemsControl ItemsSource="{Binding PromotionHints}" IsVisible="{Binding HasPromotionHints}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PromotionHint">
                  <Border Classes="hint">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                      <ui:Icon Data="{x:Static ui:Icons.Percent}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource AccentBrush}" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Classes="muted small" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="small" Content="Anwenden" VerticalAlignment="Center" AutomationProperties.Name="{Binding ApplyName}"
                              ToolTip.Tip="Rabatt der Aktion auf die passenden Positionen setzen; der Beleg nennt die Aktion"
                              Command="{Binding #Root.((vm:PosViewModel)DataContext)?.ApplyPromotionCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- „Passt dazu“ (Slice 115): Artikel zur Behandlung mit Bestand am Verkaufsregal; auf die Rechnung nur mit Klick -->
            <ItemsControl ItemsSource="{Binding RecommendationHints}" IsVisible="{Binding HasRecommendationHints}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecommendationHint">
                  <Border Classes="hint">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                      <ui:Icon Data="{x:Static ui:Icons.Register}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource AccentBrush}" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Classes="muted small" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="small" Content="Dazugeben" VerticalAlignment="Center" AutomationProperties.Name="{Binding AddName}"
                              ToolTip.Tip="Den Artikel mit Menge 1 auf die Rechnung legen"
                              Command="{Binding #Root.((vm:PosViewModel)DataContext)?.AddRecommendationCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="card" Padding="12,10" IsVisible="{Binding IsDiscounting}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding DiscountTitle}" Classes="label" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <RadioButton GroupName="DiscountKind" Content="in %" IsChecked="{Binding DiscountInPercent}" />
                  <RadioButton GroupName="DiscountKind" Content="als Betrag" IsChecked="{Binding DiscountInAmount}" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                  <ui:FormField>
                    <Panel>
                      <ui:NumberField CommittedText="{Binding DiscountInput}" IsVisible="{Binding DiscountInPercent}" Minimum="0" Maximum="100" DecimalPlaces="2" PlaceholderText="0"
                                      AutomationProperties.Name="Rabatt in Prozent" ToolTip.Tip="Rabatt auf die Position; leer oder 0 nimmt ihn zurück" />
                      <ui:MoneyField CommittedText="{Binding DiscountInput}" IsVisible="{Binding DiscountInAmount}" PlaceholderText="0,00"
                                     AutomationProperties.Name="Rabatt als Betrag" ToolTip.Tip="Rabatt auf die Position; leer oder 0 nimmt ihn zurück" />
                    </Panel>
                  </ui:FormField>
                  <TextBlock Grid.Column="1" Text="{Binding DiscountPreview}" Classes="muted num" VerticalAlignment="Center" MinWidth="70" />
                  <Button Grid.Column="2" Content="Übernehmen" Classes="primary" Command="{Binding ApplyDiscountCommand}" ui:DisabledHint.Text="Verfügbar, sobald der Rabatt lesbar ist (und, wenn nötig, die Freigabe mit PIN)." />
                  <Button Grid.Column="3" Content="Abbrechen" Classes="ghost" Command="{Binding CancelDiscountCommand}" />
                </Grid>
                <TextBlock Text="{Binding DiscountLimitHint}" Classes="muted small" TextWrapping="Wrap"
                           IsVisible="{Binding DiscountLimitHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Grid ColumnDefinitions="*,120" ColumnSpacing="6" IsVisible="{Binding NeedsApproval}">
                  <ui:FormField Label="Freigabe durch" IsRequired="True">
                    <ComboBox ItemsSource="{Binding Approvers}" SelectedItem="{Binding Approver}" HorizontalAlignment="Stretch"
                              ToolTip.Tip="Inhaber oder Standortleitung gibt mit der eigenen PIN frei">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="c:QuickSwitchPerson">
                          <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </ui:FormField>
                  <ui:FormField Grid.Column="1" Label="PIN" IsRequired="True">
                    <TextBox Text="{Binding ApprovalPin}" PasswordChar="•" MaxLength="8" Classes="num" />
                  </ui:FormField>
                </Grid>
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <TextBlock Text="Summe" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="22" FontWeight="SemiBold" Classes="num" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Grid.Row="1" Text="davon offen" Classes="muted small" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OpenText}" Classes="muted small num" HorizontalAlignment="Right" />
            </Grid>
            <TextBlock Text="{Binding CashDiscountText}" Classes="small" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"
                       IsVisible="{Binding CashDiscountText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Panel>

    <!-- Rechts neben der Rechnung: Artikel und Gutscheine, einklappbar (Slice 129), zu Beginn zugeklappt (Slice 137) -->
    <Border x:Name="SalesColumn" Grid.Row="2" Grid.Column="2" Classes.collapsed="{Binding !IsSalesColumnOpen}" IsVisible="{Binding IsCheckout}">
      <Border.Styles>
        <Style Selector="Border#SalesColumn">
          <Setter Property="Width" Value="232" />
        </Style>
        <Style Selector="Border#SalesColumn.collapsed">
          <Setter Property="Width" Value="44" />
        </Style>
        <!-- Eingeklappt füllt die Leiste die ganze Höhe der Spalte -->
        <Style Selector="Border#SalesColumn.collapsed > Grid > Border#SalesHeaderCard">
          <Setter Property="Grid.RowSpan" Value="2" />
        </Style>
      </Border.Styles>
      <Grid RowDefinitions="Auto,*">
        <Border x:Name="SalesHeaderCard" Classes="card" Padding="0">
          <ui:AccordionHeader x:Name="SalesColumnHeader" Classes="accordion" IsChecked="{Binding IsSalesColumnOpen, Mode=TwoWay}"
                              AutomationProperties.Name="Artikel und Gutscheine" ToolTip.Tip="{Binding SalesColumnTip}"
                              Padding="10,10" VerticalAlignment="Stretch">
            <Panel>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding IsSalesColumnOpen}">
                <ui:Icon Data="{x:Static ui:Icons.Register}" Width="20" Height="20" />
                <TextBlock x:Name="SalesColumnTitle" Grid.Column="1" Text="Artikel und Gutscheine" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ui:Icon Grid.Column="2" Classes="chevron" Data="{x:Static ui:Icons.ChevronRight}" Width="14" Height="14" Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center" />
              </Grid>
              <StackPanel Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding !IsSalesColumnOpen}">
                <ui:Icon Data="{x:Static ui:Icons.Register}" Width="20" Height="20" />
                <ui:Icon Data="{x:Static ui:Icons.ChevronRight}" Width="14" Height="14" Foreground="{DynamicResource Fg3Brush}" />
                <LayoutTransformControl>
                  <LayoutTransformControl.LayoutTransform>
                    <RotateTransform Angle="90" />
                  </LayoutTransformControl.LayoutTransform>
                  <TextBlock Text="Artikel und Gutscheine" Classes="muted" />
                </LayoutTransformControl>
              </StackPanel>
            </Panel>
          </ui:AccordionHeader>
        </Border>
        <ScrollViewer x:Name="SalesScroll" Grid.Row="1" Margin="0,12,0,0" Padding="0,0,10,0" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsSalesColumnOpen}">
          <StackPanel Spacing="12">
            <Border Classes="card" Padding="16,12" IsVisible="{Binding Articles.Count}">
              <StackPanel Spacing="8">
                <TextBlock Text="Artikel" Classes="group" />
                <ItemsControl ItemsSource="{Binding Articles}">
                  <!-- Eine Spalte, der Name ganz in einer Zeile, der Preis darunter: zwei Kacheln nebeneinander brachen die Namen mitten im Wort (Befund B6);
                       neben dem Preis ließe die 232 px schmale Spalte dem Namen zu wenig Platz. -->
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="c:ArticleDto">
                      <Button Classes="tile" MinHeight="34" Padding="10,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                              Command="{Binding #Root.((vm:PosViewModel)DataContext)?.AddArticleCommand}" CommandParameter="{Binding}">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="12" />
                          <TextBlock Classes="num muted small">
                            <TextBlock.Text>
                              <MultiBinding Converter="{x:Static vm:Converters.MoneyText}">
                                <Binding Path="Price" />
                                <Binding Path="#Root.((vm:PosViewModel)DataContext)?.Currency" />
                              </MultiBinding>
                            </TextBlock.Text>
                          </TextBlock>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card" Padding="16,12">
              <StackPanel Spacing="8">
                <TextBlock Text="Gutschein verkaufen" Classes="group" />
                <!-- Gilt für Wert-, Behandlungsgutschein und Paket; Vorbelegung und Hinweis kommen vom Server (Frist im Land der Kasse). -->
                <ui:FormField Label="Einzulösen bis" Help="{Binding VoucherExpiryRule}" Warning="{Binding VoucherExpiryWarning}">
                  <ui:DateField CommittedText="{Binding VoucherValidUntil}" ToolTip.Tip="Steht auf Beleg und Gutschein; leer heißt unbefristet" />
                </ui:FormField>
                <!-- Knöpfe unter dem Feld: neben „… verkaufen“ bliebe dem Feld in der schmalen Spalte zu wenig Platz. -->
                <StackPanel Spacing="8">
                  <ui:FormField Label="{Binding Currency, StringFormat='Wert ({0})'}">
                    <ui:MoneyField CommittedText="{Binding VoucherValue}" PlaceholderText="z. B. 50,00" Width="NaN" HorizontalAlignment="Stretch"
                                   ToolTip.Tip="Wertgutschein über einen frei gewählten Betrag" />
                  </ui:FormField>
                  <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding SellVoucherCommand}" ToolTip.Tip="Wertgutschein auf die Rechnung setzen"
                          ui:DisabledHint.Text="Verfügbar, sobald ein Betrag über 0 eingetragen ist.">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                      <ui:Icon Data="{x:Static ui:Icons.Gift}" Width="16" Height="16" />
                      <TextBlock Grid.Column="1" Text="Wertgutschein verkaufen" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </StackPanel>
                <StackPanel Spacing="8">
                  <ui:FormField Label="Behandlung">
                    <ComboBox ItemsSource="{Binding Treatments}" SelectedItem="{Binding VoucherTreatment}" HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="c:TreatmentDto">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </ui:FormField>
                  <Button Content="Behandlung verkaufen" Command="{Binding SellTreatmentVoucherCommand}" HorizontalAlignment="Left"
                          ToolTip.Tip="Gutschein für genau diese Behandlung zum Preis dieses Standorts" ui:DisabledHint.Text="Verfügbar, sobald eine Behandlung gewählt ist." />
                </StackPanel>
                <TextBlock Text="Paket für die gewählte Behandlung (gehört dem Gast der Rechnung)" Classes="muted small" TextWrapping="Wrap" />
                <WrapPanel ItemSpacing="12" LineSpacing="8">
                  <ui:FormField Label="Anzahl" IsRequired="True">
                    <ui:NumberField CommittedText="{Binding PackageUnits}" Minimum="2" Maximum="50" ToolTip.Tip="Anzahl Behandlungen, z. B. 10" />
                  </ui:FormField>
                  <ui:FormField Label="{Binding Currency, StringFormat='Paketpreis ({0})'}">
                    <ui:MoneyField CommittedText="{Binding PackagePrice}" ToolTip.Tip="Leer: Einzelpreis mal Anzahl" />
                  </ui:FormField>
                  <Button Content="Paket verkaufen" Command="{Binding SellPackageCommand}" VerticalAlignment="Bottom"
                          ToolTip.Tip="Paket auf die Rechnung setzen; es wird beim Verkauf versteuert und je Termin abgezogen" ui:DisabledHint.Text="Verfügbar, sobald eine Behandlung und eine Anzahl gewählt sind." />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
    <!-- Rechts: bezahlen -->
    <Border x:Name="PayColumn" Classes="card" VerticalAlignment="Top" IsEnabled="{Binding HasBill}"
            IsVisible="{Binding IsCheckout}">
      <StackPanel Spacing="12">
        <TextBlock Text="Bezahlen" Classes="h2" />
        <ItemsControl ItemsSource="{Binding PackageHints}" IsVisible="{Binding HasPackageHints}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PackageHint">
              <Border Background="{DynamicResource OkSoftBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold" />
                  <Button Content="{Binding ButtonText}" HorizontalAlignment="Left"
                          ToolTip.Tip="Paket als Gutschein-Zahlung eintragen; je Termin wird eine Behandlung abgezogen"
                          Command="{Binding #Root.((vm:PosViewModel)DataContext)?.UsePackageCommand}" CommandParameter="{Binding}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="card" Padding="10,8" Background="{DynamicResource OkSoftBrush}"
                IsVisible="{Binding PlatformPrepaidText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding PlatformPrepaidText}" TextWrapping="Wrap" />
        </Border>
        <ItemsControl ItemsSource="{Binding Payments}" GotFocus="OnPaymentFieldGotFocus">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PaymentEntry">
              <StackPanel Spacing="4" Margin="0,0,0,10" IsVisible="{Binding IsOffered}">
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                  <ui:FormField Label="{Binding Title}">
                    <ui:MoneyField CommittedText="{Binding Amount}" PlaceholderText="0,00" IsReadOnly="{Binding IsLocked}" />
                  </ui:FormField>
                  <Button Grid.Column="1" Content="Rest" VerticalAlignment="Bottom" ToolTip.Tip="Den noch offenen Betrag eintragen" IsEnabled="{Binding !IsLocked}"
                          Command="{Binding #Root.((vm:PosViewModel)DataContext)?.FillRestCommand}" CommandParameter="{Binding}" />
                </Grid>
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding ShowTerminalButton}"
                        ToolTip.Tip="Betrag (ohne Eingabe den offenen Rest) an das Kartenterminal schicken"
                        Command="{Binding #Root.((vm:PosViewModel)DataContext)?.StartCardPaymentCommand}" CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:Icon Data="{x:Static ui:Icons.Card}" Width="16" Height="16" />
                    <TextBlock Text="Am Terminal zahlen" />
                  </StackPanel>
                </Button>
                <ui:InfoBar Severity="{Binding TerminalSeverity}" Message="{Binding TerminalText}" IsVisible="{Binding CardPayment, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ActionText="{Binding TerminalActionText}" ActionCommand="{Binding #Root.((vm:PosViewModel)DataContext)?.CancelCardPaymentCommand}" ActionParameter="{Binding}" />
                <!-- Sofortüberweisung (Ä290): Empfänger, IBAN, Betrag und Zahlungstext kommen vom Server; ein QR-Bild folgt erst mit einer Entscheidung über das Paket -->
                <Button x:Name="TransferDetailsButton" HorizontalAlignment="Left" Content="Zahlungsdaten anzeigen" IsVisible="{Binding IsInstantTransfer}"
                        ToolTip.Tip="Empfänger, IBAN und Betrag zum Überweisen anzeigen (ohne Eingabe der offene Rest)"
                        Command="{Binding #Root.((vm:PosViewModel)DataContext)?.ShowTransferCommand}" CommandParameter="{Binding}" />
                <Border Classes="card" Padding="10,8" IsVisible="{Binding HasTransfer}">
                  <StackPanel Spacing="4">
                    <ItemsControl ItemsSource="{Binding TransferLines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Schwarz auf weißem, deckendem Grund mit Ruhezone: in hellem und dunklem Schema scanbar -->
                    <Image x:Name="TransferQrImage" Source="{Binding TransferQr}" Width="200" Height="200" HorizontalAlignment="Left" Stretch="Uniform"
                           RenderOptions.BitmapInterpolationMode="None" AutomationProperties.Name="QR-Code für die Sofortüberweisung" />
                    <ui:FormField Label="Zahlungstext (EPC)">
                      <TextBox x:Name="TransferPayloadBox" Text="{Binding TransferPayload, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MaxHeight="120"
                               AutomationProperties.Name="Zahlungstext (EPC)" />
                    </ui:FormField>
                  </StackPanel>
                </Border>
                <ui:FormField Label="Gutschein-Code" IsRequired="True" IsVisible="{Binding IsVoucher}" Help="{Binding VoucherHelp}" Error="{Binding VoucherError}">
                  <TextBox Text="{Binding VoucherCode}" PlaceholderText="z. B. K7M3-Q9XA-B2CD" LostFocus="OnVoucherCodeLostFocus" />
                </ui:FormField>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="divider" />
        <TextBlock Text="{Binding CoverText}" Classes="secondary" />
        <TextBlock Text="{Binding ChangeText}" AutomationProperties.LiveSetting="Polite" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource OkBrush}"
                   IsVisible="{Binding ChangeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button Classes="primary" Command="{Binding PayCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="46"
                ui:DisabledHint.Text="Verfügbar, sobald die Zahlungen den Betrag decken und jeder Betrag lesbar ist.">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:Icon Data="{x:Static ui:Icons.Check}" />
            <TextBlock Text="Bezahlen und Beleg erstellen" FontSize="14" />
          </StackPanel>
        </Button>
        <TextBlock Text="Der Beleg wird am Server signiert und im Kassenjournal gespeichert." Classes="muted small" TextWrapping="Wrap" Margin="0,0,56,0" />
      </StackPanel>
    </Border>
    <!-- Belege des Tages: ansehen, drucken, stornieren -->
    <Grid Grid.Row="2" Grid.ColumnSpan="4" ColumnDefinitions="380,*" IsVisible="{Binding IsReceipts}">
      <Border Classes="card" Padding="8" Margin="0,0,16,0">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,0,4,0">
            <TextBlock Text="{Binding ReceiptsTitle}" Classes="group" Margin="0,8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Classes="icon" Command="{Binding ShowPreviousReceiptDayCommand}" ToolTip.Tip="Tag davor" AutomationProperties.Name="Tag davor">
              <ui:Icon Data="{x:Static ui:Icons.ChevronLeft}" />
            </Button>
            <Button Grid.Column="2" Classes="icon" Command="{Binding ShowNextReceiptDayCommand}" ToolTip.Tip="Tag danach" AutomationProperties.Name="Tag danach">
              <ui:Icon Data="{x:Static ui:Icons.ChevronRight}" />
            </Button>
          </Grid>
          <ListBox Grid.Row="1" Classes="plain" ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceiptItem}">
            <ListBox.Styles>
              <!-- Der Name der Zeile ist ihr sichtbarer Inhalt; sonst liest der Screenreader den Record-Typ -->
              <Style Selector="ListBoxItem" x:DataType="vm:ReceiptListItem">
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ReceiptListItem">
                <Grid ColumnDefinitions="56,*,Auto">
                  <TextBlock Text="{Binding Time}" Classes="num" FontWeight="Medium" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Number}" FontWeight="Medium" />
                      <Border Classes="pill crit" IsVisible="{Binding IsVoid}"><TextBlock Text="Storno" /></Border>
                      <Border Classes="pill" IsVisible="{Binding IsVoided}"><TextBlock Text="storniert" /></Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Payments}" Classes="muted small" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Total}" Classes="num" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <TextBlock Grid.Column="1" Text="{Binding ReceiptsEmptyText}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding !Receipts.Count}" />
      <ScrollViewer Grid.Column="1" IsVisible="{Binding SelectedReceiptItem, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="12" DataContext="{Binding SelectedReceipt}" x:DataType="vm:ReceiptViewModel" HorizontalAlignment="Left">
          <StackPanel>
            <TextBlock Text="{Binding Title}" Classes="h2" />
            <TextBlock Text="{Binding Subtitle}" Classes="muted small" />
          </StackPanel>
          <views:ReceiptPaper />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Command="{Binding #Root.((vm:PosViewModel)DataContext)?.PrintReceiptCommand}" CommandParameter="{Binding}"
                    IsEnabled="{Binding #Root.((vm:PosViewModel)DataContext)?.HasPrinter, TargetNullValue=False}"
                    ToolTip.Tip="Bondrucker unter „Geräte“ einrichten">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:Icon Data="{x:Static ui:Icons.Printer}" Width="16" Height="16" />
                <TextBlock Text="Drucken" />
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding #Root.((vm:PosViewModel)DataContext)?.PrintText}" AutomationProperties.LiveSetting="Polite" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static vm:PosViewModel.NoPrinterHint}" Classes="muted small" VerticalAlignment="Center"
                       IsVisible="{Binding !#Root.((vm:PosViewModel)DataContext)?.HasPrinter, TargetNullValue=False}" />
          </StackPanel>
          <Border Classes="card" Padding="16" Width="420" IsVisible="{Binding CanAddRecipient}">
            <StackPanel Spacing="8">
              <TextBlock Text="Rechnung mit Empfänger" Classes="h2" />
              <ui:InfoBar Severity="Warning" Message="{Binding InvoiceHint}" IsVisible="{Binding InvoiceHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="muted small" TextWrapping="Wrap"
                         Text="Für Firmenkunden: Name, Anschrift und UID einmal ergänzen; der Beleg wird damit zur Rechnung." />
              <Button Content="Empfänger erfassen" HorizontalAlignment="Left"
                      Command="{Binding #Root.((vm:PosViewModel)DataContext)?.StartInvoiceCommand}" CommandParameter="{Binding}"
                      IsVisible="{Binding !#Root.((vm:PosViewModel)DataContext)?.IsInvoicing, TargetNullValue=False}" />
              <StackPanel Spacing="6" IsVisible="{Binding #Root.((vm:PosViewModel)DataContext)?.IsInvoicing, TargetNullValue=False}">
                <ui:FormField Label="Name oder Firma" IsRequired="True">
                  <TextBox Text="{Binding #Root.((vm:PosViewModel)DataContext)?.RecipientName}" />
                </ui:FormField>
                <ui:FormField Label="Anschrift" IsRequired="True">
                  <TextBox Text="{Binding #Root.((vm:PosViewModel)DataContext)?.RecipientAddress}" AcceptsReturn="True" />
                </ui:FormField>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <ui:FormField Label="UID-Nummer">
                    <TextBox Text="{Binding #Root.((vm:PosViewModel)DataContext)?.RecipientVatId}" PlaceholderText="z. B. ATU12345678" />
                  </ui:FormField>
                  <Button Grid.Column="1" Content="UID prüfen" Command="{Binding #Root.((vm:PosViewModel)DataContext)?.CheckVatIdCommand}" VerticalAlignment="Bottom"
                          ToolTip.Tip="Über VIES prüfen; eine gültige Abfrage wird als Nachweis an die Rechnung gehängt" />
                </Grid>
                <TextBlock Text="{Binding #Root.((vm:PosViewModel)DataContext)?.VatCheckText}" Classes="small" TextWrapping="Wrap"
                           Classes.ok="{Binding #Root.((vm:PosViewModel)DataContext)?.VatCheckOk, TargetNullValue=False}"
                           Classes.crit="{Binding #Root.((vm:PosViewModel)DataContext)?.VatCheckFailed, TargetNullValue=False}" />
                <CheckBox Content="{Binding #Root.((vm:PosViewModel)DataContext)?.RememberRecipientText}"
                          IsChecked="{Binding #Root.((vm:PosViewModel)DataContext)?.RememberRecipient}"
                          IsVisible="{Binding #Root.((vm:PosViewModel)DataContext)?.CanRememberRecipient, TargetNullValue=False}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Empfänger übernehmen" Command="{Binding #Root.((vm:PosViewModel)DataContext)?.AddRecipientCommand}" />
                  <Button Classes="ghost" Content="Abbrechen" Command="{Binding #Root.((vm:PosViewModel)DataContext)?.CancelInvoiceCommand}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
          <!-- Online bezahlt (Ä285): vor dem Storno der Weg des Geldes, danach der Stand der Erstattung -->
          <Border x:Name="OnlineRefundCard" Classes="card" Padding="16" Width="420" IsVisible="{Binding #Root.((vm:PosViewModel)DataContext)?.HasOnlineRefund, TargetNullValue=False}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding #Root.((vm:PosViewModel)DataContext)?.OnlineRefundTitle}" FontWeight="Medium" TextWrapping="Wrap" />
              <TextBlock Text="{Binding #Root.((vm:PosViewModel)DataContext)?.OnlineRefundText}" Classes="muted small" TextWrapping="Wrap" />
              <ui:InfoBar Severity="Warning" Message="{Binding #Root.((vm:PosViewModel)DataContext)?.OnlineRefundProblem}" IsVisible="{Binding #Root.((vm:PosViewModel)DataContext)?.OnlineRefundProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <Button x:Name="RetryRefundButton" Content="Erstattung erneut anstoßen" HorizontalAlignment="Left" Command="{Binding #Root.((vm:PosViewModel)DataContext)?.RetryOnlineRefundCommand}"
                      IsVisible="{Binding #Root.((vm:PosViewModel)DataContext)?.CanRetryOnlineRefund, TargetNullValue=False}" />
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="16" Width="420" IsVisible="{Binding CanVoid}">
            <StackPanel Spacing="8">
              <TextBlock Text="Beleg stornieren" Classes="h2" />
              <TextBlock Classes="muted small" TextWrapping="Wrap"
                         Text="Es entsteht ein Stornobeleg mit Begründung. Ohne Kassenaufsicht nur eigene Belege der letzten 15 Minuten." />
              <ui:FormField Label="Grund" IsRequired="True">
                <TextBox Text="{Binding #Root.((vm:PosViewModel)DataContext)?.VoidReasonInput}" PlaceholderText="z. B. falsche Behandlung erfasst" />
              </ui:FormField>
              <Button Classes="danger" Content="Stornieren" HorizontalAlignment="Left"
                      Command="{Binding #Root.((vm:PosViewModel)DataContext)?.AskVoidReceiptCommand}" ui:DisabledHint.Text="{Binding #Root.((vm:PosViewModel)DataContext)?.VoidDisabledHint}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Kassenlade und Tagesabschluss -->
    <Grid Grid.Row="2" Grid.ColumnSpan="4" ColumnDefinitions="*,380" IsVisible="{Binding IsClosing}">
      <ScrollViewer Margin="0,0,16,0">
        <Border Classes="card" Padding="20" VerticalAlignment="Top" IsVisible="{Binding HasReport}">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ui:Icon Data="{x:Static ui:Icons.Check}" Foreground="{DynamicResource OkBrush}" Width="22" Height="22" IsVisible="{Binding IsClosed}" />
              <TextBlock Text="{Binding ReportTitle}" Classes="h2" />
            </StackPanel>
            <TextBlock Text="{Binding ReportPeriod}" Classes="muted small" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
              <TextBlock Text="Umsatz" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding ReportRevenue}" FontSize="22" FontWeight="SemiBold" Classes="num" />
            </Grid>
            <TextBlock Text="Zahlungsarten" Classes="group" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding ReportPayments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ReceiptRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="{Binding Label}" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="num" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Steuern" Classes="group" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding ReportTaxes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ReceiptRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="{Binding Label}" Classes="secondary" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="num secondary" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Erlöskonten" Classes="group" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding ReportAccounts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ReceiptRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="{Binding Label}" Classes="secondary" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="num secondary" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Bargeld in der Lade" Classes="group" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding ReportCash}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ReceiptRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="{Binding Label}" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="num" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="divider" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Soll-Bestand" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding ExpectedCashText}" FontWeight="SemiBold" Classes="num" />
            </Grid>
            <TextBlock Text="{Binding DifferenceText}" FontWeight="SemiBold" HorizontalAlignment="Right"
                       IsVisible="{Binding IsClosed}" />
          </StackPanel>
        </Border>
      </ScrollViewer>

      <StackPanel Grid.Column="1" Spacing="16">
        <Border Classes="card" IsVisible="{Binding !IsClosed}">
          <StackPanel Spacing="10">
            <TextBlock Text="Tagesabschluss" Classes="h2" />
            <TextBlock Text="Bargeld in der Lade zählen und eintragen. Der Abschluss wird unveränderlich gespeichert."
                       Classes="muted small" TextWrapping="Wrap" />
            <ui:FormField Label="{Binding Currency, StringFormat='Gezählter Bestand ({0})'}" IsRequired="True">
              <ui:MoneyField CommittedText="{Binding CountedCash}" PlaceholderText="0,00" />
            </ui:FormField>
            <TextBlock Text="{Binding DifferenceText}" FontWeight="SemiBold"
                       IsVisible="{Binding DifferenceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ui:FormField Label="Notiz">
              <TextBox Text="{Binding ClosingNote}" PlaceholderText="z. B. Grund einer Differenz" />
            </ui:FormField>
            <Button Classes="primary" Content="Tagesabschluss durchführen" Command="{Binding CloseDayCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ui:DisabledHint.Text="Verfügbar, sobald der gezählte Bargeldbestand eingetragen ist." />
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding MovementTitle}" Classes="h2" />
            <!-- L6: Entnehmen darf nur die Kassenaufsicht; der Tab fehlt sonst, statt erst beim Buchen zu scheitern.
                 B19: Bleibt nur „Einlage“, entfällt die ganze Auswahl; die Überschrift „Einlage“ genügt. -->
            <Border Classes="segmented" HorizontalAlignment="Left" IsVisible="{Binding MaySuperviseCash}">
              <StackPanel Orientation="Horizontal">
                <ui:TabButton Content="Einlage" IsSelected="{Binding !MovementIsWithdrawal}" Click="OnDeposit" />
                <ui:TabButton Content="Entnahme" IsSelected="{Binding MovementIsWithdrawal}" Click="OnWithdrawal" />
              </StackPanel>
            </Border>
            <ui:FormField Label="{Binding Currency, StringFormat='Betrag ({0})'}" IsRequired="True">
              <ui:MoneyField CommittedText="{Binding MovementAmount}" PlaceholderText="z. B. 50,00" />
            </ui:FormField>
            <ui:FormField Label="Grund" IsRequired="True">
              <TextBox Text="{Binding MovementReason}" PlaceholderText="z. B. Wechselgeld oder Abschöpfung zur Bank" />
            </ui:FormField>
            <Button Content="Buchen" Command="{Binding AddMovementCommand}" HorizontalAlignment="Left" ui:DisabledHint.Text="Verfügbar, sobald Betrag und Grund eingetragen sind." />
            <TextBlock Text="Kein Umsatz. Entnehmen darf nur, wer die Kassenaufsicht hat." Classes="muted small" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
  </ScrollViewer>
</UserControl>
