<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AispaStudio.Desktop.ViewModels"
             xmlns:ui="using:AispaStudio.Desktop.Controls"
             x:Class="AispaStudio.Desktop.Views.TreatmentsView"
             x:DataType="vm:TreatmentsViewModel"
             ui:SaveShortcut.IsScope="True">
  <!--
    Behandlungen (R05 Slice 94; neu geordnet 17.11.2026, Nachtrag zu ADR 0098): links der Knopf „Neue Behandlung“ fest über der Suche und der Liste nach Kategorie (einklappbar, mit
    Anzahl; je Zeile Dauer und Preis rechts), darunter „Nicht mehr angebotene zeigen“; rechts die gewählte Behandlung (TreatmentEditorView) mit „Speichern“ an der Karte, Strg+S speichert
    (SaveShortcut). Die Liste füllt die Höhe und rollt in sich.
  -->
  <Grid RowDefinitions="Auto,*">
    <StackPanel Spacing="8" Margin="0,0,16,0">
      <ui:InfoBar Severity="Error" Title="Behandlungen nicht geladen" Message="{Binding LoadError}" IsVisible="{Binding HasLoadError}"
                  ActionText="Erneut laden" ActionCommand="{Binding LoadCommand}" />
      <TextBlock Text="Lade Behandlungen …" Classes="muted" IsVisible="{Binding !IsLoaded}" />
      <ui:InfoBar Severity="Warning" Message="{Binding Notice}" IsVisible="{Binding HasNotice}" CloseCommand="{Binding CloseNoticeCommand}" Margin="0,0,0,8" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="300,*" IsVisible="{Binding IsLoaded}">
      <Border Classes="card" Padding="8" Margin="0,0,16,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
          <Button x:Name="NewButton" Classes="primary" Command="{Binding NewCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  AutomationProperties.Name="Neue Behandlung">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ui:Icon Data="{x:Static ui:Icons.Plus}" Width="16" Height="16" />
              <TextBlock Text="Neue Behandlung" />
            </StackPanel>
          </Button>
          <ui:SearchField Grid.Row="1" x:Name="TreatmentSearch" Text="{Binding Search}" PlaceholderText="Behandlung suchen" ShowAdd="False"
                          AutomationProperties.Name="Behandlungen durchsuchen" />
          <ListBox Grid.Row="2" x:Name="TreatmentList" Classes="plain" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                   AutomationProperties.Name="Behandlungen">
            <ListBox.Styles>
              <!-- Der Name der Zeile ist ihr Titel, Dauer und Preis bzw. der Zustand der Kategorie die Beschreibung. Eine Kategorie ist eine Überschrift: ein Klick klappt sie auf oder zu,
                   die Pfeiltasten überspringen sie (kein Fokus). -->
              <Style Selector="ListBoxItem" x:DataType="vm:TreatmentEntry">
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
                <Setter Property="Focusable" Value="{Binding IsTreatment}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TreatmentEntry">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                  <ui:Icon Data="{x:Static ui:Icons.ChevronDown}" Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding IsExpandedHeading}" />
                  <ui:Icon Data="{x:Static ui:Icons.ChevronRight}" Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding IsCollapsed}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Classes.group="{Binding IsHeading}" Classes.muted="{Binding IsNotOffered}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Title}" />
                    <TextBlock Text="Nicht angeboten" Classes="muted small" IsVisible="{Binding IsNotOffered}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Meta}" Classes="muted small num" VerticalAlignment="Center" IsVisible="{Binding IsTreatment}" />
                  <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="muted small num" VerticalAlignment="Center" IsVisible="{Binding IsHeading}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="2" Text="Keine Behandlung gefunden." Classes="muted" Margin="8,4" IsVisible="{Binding HasNoMatches}" />
          <CheckBox Grid.Row="3" x:Name="ShowInactiveBox" Content="Nicht mehr angebotene zeigen" IsChecked="{Binding ShowInactive}" />
        </Grid>
      </Border>

      <ContentControl Grid.Column="1" x:Name="EditorHost" Content="{Binding Editor}" />
    </Grid>
  </Grid>
</UserControl>
